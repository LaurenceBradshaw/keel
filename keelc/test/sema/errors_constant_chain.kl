// A chain of constants is checked in the type it is written for, not in i32 first.
i64 below() { return 0 - 3000000000 - 1; }
i64 product() { return 2 * 3 * 1000000000; }
i64 negated() { return -( 0 - 3000000000 ); }
u32 sum() { return 1 + 2 + 3; }
u64 shifted() { return 1 << 3 << 2; }

u32 beside( u32 x )
{
    return x + 2 * 3;
}

// A comparison still answers rather than refusing.
bool impossible( u64 n )
{
    return n < 0 - 1;
}

i32 main()
{
    u8 over = 200 + 50 + 10;
    u32 under = -( 1 - 2 );
    i8 step = 100 + 100 - 1;
    u64 wide = 1 << 40 << 30;
    i32 zero = 1 / ( 2 - 2 );
    u32 negation = -( 2 - 1 );
    return 0;
}
