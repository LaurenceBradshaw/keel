// Declared in every program, which sees them without an import.

/// Text that can be read: the type lends its bytes without copying them.
interface textual
{
    const ref u8[] as_text() const;
};

/// Text: a run of bytes and their count.
///
/// A string literal is a `str`, and only a literal makes one. Its `size` counts the bytes after
/// escapes are decoded, a `\0` included.
class str implements textual
{
    /// The first byte.
    public const u8[*] const data;
    /// How many bytes there are.
    public const u64 size;

    private str( const u8[*] const data, const u64 size )
    {
        this.data = data;
        this.size = size;
    }

    /// Returns the text as a read-only reference to the run of bytes.
    public const ref u8[] as_text() const
    {
        unsafe
        {
            return data[0..size];
        }
    }
};

extern void kl_rt_write( i32 stream, const u8[*] data, u64 size );
extern void kl_rt_write_i64( i32 stream, i64 value );
extern void kl_rt_write_u64( i32 stream, u64 value );
extern void kl_rt_write_f64( i32 stream, f64 value );

/// Writes text to standard output, ending no line.
void print( const ref textual text )
{
    const ref u8[] r = text.as_text();
    unsafe
    {
        kl_rt_write( 1, r.data, r.size );
    }
}

/// Writes an integer in decimal.
void print( i64 value )
{
    unsafe
    {
        kl_rt_write_i64( 1, value );
    }
}

/// Writes an integer in decimal.
void print( u64 value )
{
    unsafe
    {
        kl_rt_write_u64( 1, value );
    }
}

/// Writes a float in the fewest digits that read back as the same value.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void print( f64 value )
{
    unsafe
    {
        kl_rt_write_f64( 1, value );
    }
}

/// Writes `true` or `false`.
void print( bool value )
{
    print( value ? "true" : "false" );
}

/// Writes text to standard error, ending no line.
///
/// Standard output is flushed first, so what both show stays in order.
void eprint( const ref textual text )
{
    const ref u8[] r = text.as_text();
    unsafe
    {
        kl_rt_write( 2, r.data, r.size );
    }
}

/// Writes an integer in decimal.
void eprint( i64 value )
{
    unsafe
    {
        kl_rt_write_i64( 2, value );
    }
}

/// Writes an integer in decimal.
void eprint( u64 value )
{
    unsafe
    {
        kl_rt_write_u64( 2, value );
    }
}

/// Writes a float in the fewest digits that read back as the same value.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void eprint( f64 value )
{
    unsafe
    {
        kl_rt_write_f64( 2, value );
    }
}

/// Writes `true` or `false`.
void eprint( bool value )
{
    eprint( value ? "true" : "false" );
}

/// Writes text and then a newline, as `print` does.
void println( const ref textual text )
{
    print( text );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( i64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( u64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( f64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( bool value )
{
    print( value );
    print( "\n" );
}

/// Writes text and then a newline, as `eprint` does.
void eprintln( const ref textual text )
{
    eprint( text );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( i64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( u64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( f64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( bool value )
{
    eprint( value );
    eprint( "\n" );
}

/// The outcome of something that can fail: a `T`, or an `E` saying why not.
///
/// `try` takes the value out of an `ok`, or returns an `err` from the function it is in. A
/// `result` left unused is refused; `_ = f();` discards one on purpose.
enum result<T, E>
{
    /// Succeeded, with a value.
    ok( T value ),
    /// Failed, with why.
    err( E error )
};

/// How one value compares with another, as `operator<=>` answers.
///
/// `a < b`, `a <= b`, `a > b` and `a >= b` all come from `a <=> b`. On a float, `<=>` panics if
/// either operand is a NaN, which has no order, while `<` and its kin answer `false`.
enum ordering
{
    /// The left operand comes first.
    less,
    /// Neither comes first.
    equal,
    /// The right operand comes first.
    greater
};

/// One `T` on the heap, owned: dropping the box drops the value and frees its memory.
///
/// A `box<Circle>` goes wherever a `box<Shape>` is wanted when `Circle` implements `Shape`, and the
/// value is then called and dropped through `Shape`'s vtable. `box` is the one type that takes an
/// interface as its type argument.
class box<T>
{
    /// Moves `value` onto the heap.
    public box( move T value )
    {
        unsafe
        {
            // A raw slot, so the write drops nothing: there is nothing there yet.
            T[*] slot = alloc<T>( 1 );
            slot[0] = move value;
            p_ = &slot[0];
        }
    }

    ~box()
    {
        unsafe
        {
            destroy( p_ );
            free( p_ );
        }
    }

    /// The value, where it lives.
    public T* get() const
    {
        return p_;
    }

    private T* p_;
};

/// A type whose values can be tested for equality.
///
/// `a != b` comes from `a == b`. Numbers, `bool`, pointers and enums without payloads are
/// equatable without writing anything.
interface equatable
{
    /// Whether this value equals `other`.
    bool operator==( const ref self other ) const;
};

/// A type whose values have an order.
///
/// `a < b`, `a <= b`, `a > b` and `a >= b` come from `a <=> b`. Numbers are comparable without
/// writing anything.
interface comparable implements equatable
{
    /// How this value compares with `other`.
    ordering operator<=>( const ref self other ) const;
};

/// Mixes what a value feeds it into a `u64`: SipHash-1-3, keyed so that values chosen to collide
/// under one key do not collide under another.
///
/// It works in 64-bit words. A word fed with `write` hashes as its eight little-endian bytes would.
class hasher
{
    /// A hasher keyed by the two halves of a 128-bit key.
    public hasher( u64 key_low, u64 key_high )
    {
        v0_ = key_low ^ 0x736f6d6570736575;
        v1_ = key_high ^ 0x646f72616e646f6d;
        v2_ = key_low ^ 0x6c7967656e657261;
        v3_ = key_high ^ 0x7465646279746573;
        bytes_ = 0;
    }

    /// Feeds one word.
    public void write( u64 value )
    {
        u64 v0 = v0_;
        u64 v1 = v1_;
        u64 v2 = v2_;
        u64 v3 = v3_;

        v3 ^= value;
        round( ref v0, ref v1, ref v2, ref v3 );
        v0 ^= value;

        v0_ = v0;
        v1_ = v1;
        v2_ = v2;
        v3_ = v3;
        bytes_ += 8;
    }

    /// Feeds bytes, zero-padded to a whole word, and then their count, so that no run of bytes fed
    /// this way is a prefix of another.
    public void write_bytes( const ref u8[] bytes )
    {
        u64 word = 0;
        u64 filled = 0;

        for( u64 i = 0; i < bytes.size; i++ )
        {
            word |= cast<u64>( bytes[i] ) << ( 8 * filled );
            filled += 1;

            if( filled == 8 )
            {
                write( word );
                word = 0;
                filled = 0;
            }
        }

        if( filled > 0 )
        {
            write( word );
        }

        write( bytes.size );
    }

    /// The hash of everything fed so far. Feeding more afterwards is allowed.
    public u64 finish() const
    {
        u64 v0 = v0_;
        u64 v1 = v1_;
        u64 v2 = v2_;
        u64 v3 = v3_;
        // SipHash's last block: the count of bytes, modulo 256, in the top byte.
        u64 m = bytes_ << 56;

        v3 ^= m;
        round( ref v0, ref v1, ref v2, ref v3 );
        v0 ^= m;

        v2 ^= 0xff;
        round( ref v0, ref v1, ref v2, ref v3 );
        round( ref v0, ref v1, ref v2, ref v3 );
        round( ref v0, ref v1, ref v2, ref v3 );

        return v0 ^ v1 ^ v2 ^ v3;
    }

    private static u64 rotate( u64 x, u64 by )
    {
        return ( x << by ) | ( x >> ( 64 - by ) );
    }

    // One SipRound, over locals so that `finish` changes no field.
    private static void round( ref u64 v0, ref u64 v1, ref u64 v2, ref u64 v3 )
    {
        v0 += v1;
        v1 = rotate( v1, 13 );
        v1 ^= v0;
        v0 = rotate( v0, 32 );

        v2 += v3;
        v3 = rotate( v3, 16 );
        v3 ^= v2;

        v0 += v3;
        v3 = rotate( v3, 21 );
        v3 ^= v0;

        v2 += v1;
        v1 = rotate( v1, 17 );
        v1 ^= v2;
        v2 = rotate( v2, 32 );
    }

    private u64 v0_;
    private u64 v1_;
    private u64 v2_;
    private u64 v3_;
    private u64 bytes_;
};

/// A type whose values can be fed to a `hasher`.
///
/// Values that are `==` must feed the same words, so a type that writes its own `==` writes its own
/// `hash` too. Numbers, `bool`, pointers and enums without payloads are hashable without writing
/// anything, and feed their value, tag or address; a float feeds its bits with `-0.0` as `0.0`, and
/// panics on a NaN.
interface hashable implements equatable
{
    /// Feeds this value to `h`.
    void hash( ref hasher h ) const;
};
