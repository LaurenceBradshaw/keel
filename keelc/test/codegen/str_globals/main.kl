// A `str` global from a string literal or a `const str`'s name, written as one C initialiser of its
// bytes and their count. `NAME` and `Tagged` come from another module.
import t::console;
import words;

const str GREETING = "hello";
str       copied   = GREETING;
str       escaped  = "a\tb\n";
str       empty    = "";
str       theirs   = NAME;

class Names
{
    public static str first = "ada";

    public i32 n;
};

i32 main()
{
    t::print( GREETING );
    t::print( copied );
    t::print( escaped.size );
    t::print( empty.size );
    t::print( theirs );
    t::print( Names::first );

    copied = "changed";
    t::print( copied );

    Tagged<u8>::label = "other";
    t::print( Tagged<u8>::label );
    t::print( Tagged<i32>::label );
    return 0;
}
