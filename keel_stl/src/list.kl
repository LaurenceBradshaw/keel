import optional;

/// A growable array of `T` that owns its elements and the block holding them.
///
/// Elements sit side by side, indexed from 0. A full list doubles its capacity, so `push` takes
/// amortised constant time. Dropping the list drops every element.
class list<T>
{
    /// An empty list. Allocates nothing until the first element arrives.
    list() 
    {
        data_ = nullptr;
        count_ = 0;
        cap_ = 0;
    }

    /// An empty list with room for `capacity` elements before it reallocates.
    public static list<T> with_capacity( u64 capacity )
    {
        list<T> result = list<T>();
        result.cap_ = capacity;
        result.count_ = 0;

        unsafe
        {
            result.data_ = alloc<T>( capacity );
        }

        return result;
    }

    ~list()
    {
        if( data_ != nullptr )
        {
            unsafe
            {
                destroy( data_, count_ );
                free( data_ );
            }
        }
    }

    /// Adds `value` at the end, growing the storage if it is full.
    public void push( move T value )
    {
        reallocate_if_needed();
        
        unsafe
        {
            data_[count_] = move value;
        }
        count_ += 1;
    }

    /// Removes the last element and returns it.
    ///
    /// # Panics
    ///
    /// If the list is empty; `try_pop` answers `none` instead.
    public T pop()
    {
        assert( count_ > 0 );
        count_ -= 1;
        unsafe
        {
            return move data_[count_];
        }
    }

    /// Removes the last element and returns it, or `none` if the list is empty.
    public optional<T> try_pop()
    {
        if( count_ == 0 )
        {
            return optional::none;
        }

        return optional::some( pop() );
    }

    /// Puts `value` at `index`, moving every element from there one place later.
    ///
    /// # Panics
    ///
    /// If `index` is greater than `size()`. An index equal to it adds at the end.
    public void insert( u64 index, move T value )
    {
        assert( index <= count_ );

        reallocate_if_needed();

        unsafe
        {
            for( u64 i = count_; i > index; i-- )
            {
                data_[i] = move data_[i - 1];
            }

            data_[index] = move value;
        }

        count_ += 1;
    }

    /// Moves every element of `other` onto the end, in order.
    public void append( move list<T> other )
    {
        reserve( count_ + other.count_ );

        unsafe
        {
            for( u64 i = 0; i < other.count_; i++ )
            {
                data_[count_ + i] = move other.data_[i];
            }
        }

        count_ += other.count_;
        other.count_ = 0; // Its slots are raw now, so its destructor only frees the block.
    }

    /// Drops every element from index `n` on, keeping the first `n`; the capacity is unchanged.
    /// Does nothing if `n` is at least `size()`.
    public void truncate( u64 n )
    {
        if( n >= count_ )
        {
            return;
        }

        unsafe
        {
            destroy( data_ + n, count_ - n );
        }

        count_ = n;
    }

    /// A pointer to the first element.
    ///
    /// # Panics
    ///
    /// If the list is empty.
    public T* first() const
    {
        assert( count_ > 0 );

        unsafe
        {
            return &data_[0];
        }
    }

    /// A pointer to the last element.
    ///
    /// # Panics
    ///
    /// If the list is empty.
    public T* last() const
    {
        assert( count_ > 0 );

        unsafe
        {
            return &data_[count_ - 1];
        }
    }

    /// A pointer to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is not less than `size()`.
    public T* operator[]( u64 index ) const
    {
        assert( index < count_ );

        unsafe
        {
            return &data_[index];
        }
    }

    /// Removes the element at `index` and returns it, moving every later element one place earlier.
    /// Keeps the order and takes linear time; `swap_remove` does neither.
    ///
    /// # Panics
    ///
    /// If `index` is not less than `size()`.
    public T remove( u64 index )
    {
        assert( index < count_ );

        unsafe
        {
            T result = move data_[index];

            for( u64 i = index; i < count_ - 1; i++ )
            {
                data_[i] = move data_[i + 1];
            }

            count_ -= 1;
            return result;
        }
    }

    /// Removes the element at `index` and returns it, moving the last element into its place.
    /// Takes constant time and does not keep the order.
    ///
    /// # Panics
    ///
    /// If `index` is not less than `size()`.
    public T swap_remove( u64 index )
    {
        assert( index < count_ );

        count_ -= 1;
        unsafe
        {
            T result = move data_[index];

            if( index != count_ )
            {
                data_[index] = move data_[count_];
            }

            return result;
        }
    }

    /// Puts `value` at `index` and returns the element that was there.
    ///
    /// # Panics
    ///
    /// If `index` is not less than `size()`.
    public T replace( u64 index, move T value )
    {
        assert( index < count_ );

        unsafe
        {
            T result = move data_[index];
            data_[index] = move value;
            return result;
        }
    }

    /// Exchanges the elements at `a` and `b`.
    ///
    /// # Panics
    ///
    /// If either is not less than `size()`.
    public void swap( u64 a, u64 b )
    {
        assert( a < count_ );
        assert( b < count_ );

        if( a == b )
        {
            return;
        }

        unsafe
        {
            T temp = move data_[a];
            data_[a] = move data_[b];
            data_[b] = move temp;
        }
    }

    /// Reverses the order of the elements in place.
    public void reverse()
    {
        if( count_ < 2 )
        {
            return;
        }

        for( u64 i = 0; i < count_ / 2; i++ )
        {
            swap( i, count_ - 1 - i );
        }
    }

    /// The number of elements.
    public u64 size() const
    {
        return count_;
    }

    /// How many elements fit before the list reallocates.
    public u64 capacity() const
    {
        return cap_;
    }

    /// Whether the list holds no elements.
    public bool is_empty() const
    {
        return count_ == 0;
    }

    /// Makes room for at least `n` elements in all, not `n` more.
    /// Does nothing if the capacity is already that large.
    public void reserve( u64 n )
    {
        if( n > cap_ )
        {
            reallocate( n );
        }
    }

    /// Reduces the capacity to the number of elements, freeing the block if there are none.
    public void shrink_to_fit()
    {
        if( count_ == cap_ )
        {
            return;
        }

        if( count_ == 0 )
        {
            unsafe
            {
                free( data_ );
            }
            data_ = nullptr;
            cap_ = 0;
            return;
        }
        
        reallocate( count_ );
    }

    /// Drops every element; the capacity is kept.
    public void clear()
    {
        unsafe
        {
            destroy( data_, count_ );
        }
        count_ = 0;
    }

    /// Moves the elements into a new block of `n` slots and frees the old one.
    private void reallocate( u64 n )
    {
        T[*] new_data;
        unsafe
        {
            new_data = alloc<T>( n );
        }

        if( data_ != nullptr )
        {
            for( u64 i = 0; i < count_; i++ )
            {
                unsafe
                {
                    new_data[i] = move data_[i];
                }
            }
            
            // Slots are raw after the above move, so we don't need to destroy them.
            unsafe
            {
                free( data_ );
            }
        }

        data_ = new_data;
        cap_ = n;
    }

    /// Doubles the capacity if the list is full, or makes it 1 if it is 0.
    private void reallocate_if_needed()
    {
        if( count_ == cap_ )
        {
            reallocate( cap_ > 0 ? cap_ * 2 : 1 );
        }
    }

    // Slots below `count_` are live, the rest are raw.
    private T[*] data_;
    private u64 count_;
    private u64 cap_;
};