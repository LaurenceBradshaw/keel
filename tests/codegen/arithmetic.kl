// Three-address form (PLAN §7.1): one operation per statement, so C's unspecified evaluation
// order cannot matter and every §6.4 conversion is written down.
i32 mix( i32 a, i64 b, u8 c )
{
    i64 wide = a + b;
    u8  byte = c;
    byte += 1;
    return a * 2;
}

i32 main()
{
    return mix( 1, 2, 3 );
}
