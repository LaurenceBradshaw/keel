// D77: a literal that leaves a field out gets its default, run after the written values.
import kl::console;
import kl::string;

i32 tick( i32 n )
{
    kl::println( n );
    return n;
}

struct Point
{
    i32 x = tick( 1 );
    i32 y;
    str name = "point";
};

struct Origin
{
    i32 x = 0;
    i32 y = 0;
};

class Named
{
    public kl::string label = kl::string( "owned" );
    public i32        n;
};

struct Box<T> where T : copyable
{
    T   v;
    T*  at   = nullptr;
    i32 kind = 7;
};

i32 main()
{
    Point a = Point { .y = tick( 2 ) }; // prints 2, then 1
    Point b = Point { .y = 3, .x = 4 }; // the default does not run
    Origin o = Origin {};
    Named  c = Named { .n = 5 };
    Box<f64> box = Box<f64> { .v = 1.5 };

    kl::println( a.name );
    kl::println( c.label );

    if( a.x != 1 || a.y != 2 || b.x != 4 || o.x + o.y != 0 || c.n != 5 || box.kind != 7 || box.at != nullptr )
    {
        return 1;
    }

    return 0;
}
