// A known value given for a size the call made a constant must equal it.
class Grid<T, u64... S(dyn)> where T : copyable
{
    T[64] cells;

    public Grid( T fill )
    {
        cells = [ fill, .. ];
    }
};

Grid<T, S...> filled<T, u64... S>( T fill, S... n ) where T : copyable
{
    return Grid<T, S...>( fill );
}

struct Line<u64 N(dyn)>
{
    u64 start;
};

Line<N> line<u64 N>( u64 start, N n )
{
    return Line<N> { start };
}

const u64 four = 4;

i32 main()
{
    Grid<i32, 4, 3> a = filled<i32, 4, 3>( 0, 5, 3 );
    Grid<i32, 4, 3> b = filled<i32, 4, 3>( 0, four, (four - 2) );
    Line<2> l = line<2>( 1, 3 );
    Grid<i32, 4, 3> fine = filled<i32, 4, 3>( 0, four, 3 );
    return 0;
}
