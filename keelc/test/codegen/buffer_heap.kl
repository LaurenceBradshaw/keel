// A prelude `buffer` on the heap: a count past 2048 bytes, a run-time count, a count of 0, and
// elements that are not numbers. Moving one moves its pointer, and dropping it frees once.
import t::console;

struct Point
{
    i32 x;
    i32 y;
};

f64 total<u64 N>( const ref buffer<f64, N> b )
{
    f64 sum = 0.0;
    for( f64 x : b.as_run() )
    {
        sum += x;
    }
    return sum + cast<f64>( N );
}

buffer<f64, dyn> made( u64 n )
{
    buffer<f64, dyn> b = buffer<f64, dyn>( n, 1.0 );
    b[n - 1] = 10.0;
    return b;
}

i32 main()
{
    buffer<f64, 513> over = buffer<f64, 513>( 513, 2.0 );
    over[0] = 0.0;
    t::print( total( over ) );

    u64 n = 6;
    buffer<f64, dyn> run_time = made( n );
    buffer<f64, dyn> moved = move run_time;
    t::print( total( moved ) );

    buffer<f64, 0> none = buffer<f64, 0>( 0, 1.0 );
    t::print( none.as_run().size );

    buffer<Point, 3> points = buffer<Point, 3>( 3, Point { 1, 2 } );
    points[2].y = 20;
    i32 sum = 0;
    for( const ref Point p : points.as_run() )
    {
        sum += p.x + p.y;
    }
    t::print( sum );
    return 0;
}
