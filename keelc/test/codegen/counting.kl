// D59: `for( T i : a..b )` counts up by one, each bound evaluated once, lower first. Each check
// asserts, so the run's exit code says the counts were right.
// Counts its calls, so a bound evaluated twice shows.
u64 bump( ref u64 calls, u64 value )
{
    calls += 1;
    return value;
}

i32 main()
{
    u64 sum = 0;
    for( u64 i : 0..5 )
    {
        sum += i;
    }
    assert( sum == 10 );

    i32 odd = 0;
    for( auto i : 0..10 )
    {
        if( i % 2 == 0 )
        {
            continue;
        }
        if( i == 7 )
        {
            break;
        }
        odd += i;
    }
    assert( odd == 1 + 3 + 5 );

    u64 calls = 0;
    u64 steps = 0;
    for( u64 i : bump( ref calls, 1 )..bump( ref calls, 4 ) )
    {
        steps += 1;
    }
    assert( calls == 2 );
    assert( steps == 3 );

    for( u64 i : 3..3 )
    {
        assert( false );
    }

    u64 top = 0;
    for( u64 i : 0xffff_ffff_ffff_fffe..0xffff_ffff_ffff_ffff )
    {
        top += 1;
    }
    assert( top == 1 );

    u8 n = 4;
    u8 last = 0;
    for( u8 i : 0..n )
    {
        last = i;
    }
    assert( last == 3 );

    i32 neg = 0;
    for( i32 i : -3..0 )
    {
        neg += i;
    }
    assert( neg == -6 );
    return 0;
}
