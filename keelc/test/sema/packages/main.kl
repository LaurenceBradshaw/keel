// Every refusal a package brings, in one program. What is accepted is in codegen/packages.
import route;
import atlas::geom;
import atlas::nope;
import foo::geom;
import atlas::core::list;

// A type may not take a package's name.
struct atlas
{
    i32 x;
};

i32 main()
{
    i32 a = area( 1 );         // atlas's, named bare
    i32 b = atlas::hidden();   // in atlas::deep, which only route.kl imports
    i32 c = atlas::nothing();  // no module of atlas this file imports declares it
    Point p = atlas::origin(); // atlas's type, named bare
    atlas::Missing m;          // no module of atlas this file imports declares it
    atlas::Missing<i32> g;     // the same, reported once though it is generic
    return a + b + c + p.x + count;
}
