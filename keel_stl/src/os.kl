// Files, paths and directories, through the runtime's calls. Each call answers 0 or an `errno`
// value, which only the runtime turns into a kind, since the numbers differ between systems.

import list;
import string;

// The runtime's calls; a run crosses as its data and size.
private extern i32 kl_rt_file_open( const ref u8[] path, i32 mode, i32* fd );
private extern i32 kl_rt_file_read( i32 fd, ref u8[] buffer, u64* count );
private extern i32 kl_rt_file_write( i32 fd, const ref u8[] data );
private extern i32 kl_rt_file_close( i32 fd );
private extern i32 kl_rt_error_kind( i32 code );
private extern i32 kl_rt_input_fill( u8[*]* data, u64* size );
private extern void kl_rt_input_take( u64 count );
private extern i32 kl_rt_path_kind( const ref u8[] path, i32* kind );
private extern i32 kl_rt_create_directory( const ref u8[] path );
private extern i32 kl_rt_delete_directory( const ref u8[] path );
private extern i32 kl_rt_delete_file( const ref u8[] path );
private extern i32 kl_rt_directory_open( const ref u8[] path, u64* handle );
private extern i32 kl_rt_directory_next( u64 handle, u8[*]* name, u64* size );
private extern void kl_rt_directory_close( u64 handle );

/// A failure any call to the system can meet.
enum os_error
{
    /// A signal arrived before the call finished; trying again may succeed.
    interrupted,
    /// The system had no memory for the call.
    out_of_memory,
    /// Any other failure, with the system's own `errno` value.
    other( i32 code )
};

/// Why a call on a file, a path or a directory failed.
enum file_error
{
    /// Nothing exists at the path.
    not_found,
    /// The file or a directory on its path does not allow it.
    denied,
    /// Something is already at the path, and `file_mode::create_new` or `create_directory` was
    /// asked for.
    exists,
    /// The path names a directory where a file was wanted.
    is_directory,
    /// A name on the path, or the path itself, should be a directory and is not one.
    not_directory,
    /// The directory to delete still holds something.
    not_empty,
    /// A failure that is not particular to files.
    os( os_error error )
};

// A runtime status as an `os_error`, asking the runtime for its kind.
private os_error os_error_of( i32 code )
{
    i32 kind = 0;
    unsafe
    {
        kind = kl_rt_error_kind( code );
    }

    switch( kind )
    {
        case 6:
            return os_error::interrupted;
        case 7:
            return os_error::out_of_memory;
        default:
            return os_error::other( code );
    }
}

// A runtime status as a `file_error`; the kinds not particular to files become `os`.
private file_error file_error_of( i32 code )
{
    i32 kind = 0;
    unsafe
    {
        kind = kl_rt_error_kind( code );
    }

    switch( kind )
    {
        case 1:
            return file_error::not_found;
        case 2:
            return file_error::denied;
        case 3:
            return file_error::exists;
        case 4:
            return file_error::is_directory;
        case 5:
            return file_error::not_directory;
        case 8:
            return file_error::not_empty;
        default:
            return file_error::os( os_error_of( code ) );
    }
}

// The index of the last `/` in `text`, or `text.size` when there is none.
private u64 last_slash( const ref u8[] text )
{
    u64 i = text.size;
    while( i > 0 )
    {
        i -= 1;

        if( text[i] == '/' )
        {
            return i;
        }
    }

    return text.size;
}

/// A file-system path, held as written and never normalised: `a/../b` stays as it is.
///
/// A literal converts to one, so `kl::path p = "a";` works.
class path implements textual, from<str>
{
    private path( move string text )
    {
        text_ = move text;
    }

    /// The path `text`, which is how a literal becomes one.
    public static path from( str text )
    {
        return path::of( text );
    }

    /// The path `text`, from a `kl::string`, another path or anything `textual`.
    public static path of( const ref textual text )
    {
        return path( string( text ) );
    }

    /// The path's bytes, as written.
    public const ref u8[] as_text() const
    {
        return text_.as_text();
    }

    /// `part` joined on with one `/`. An absolute `part`, or an empty path, gives `part` alone.
    public path operator/( const ref textual part ) const
    {
        const ref u8[] part_bytes = part.as_text();
        if( text_.is_empty() || ( part_bytes.size != 0 && part_bytes[0] == '/' ) )
        {
            return path::of( part );
        }

        string joined = string( text_ );
        joined += text_.ends_with( "/" ) ? "" : "/";
        joined.append( part_bytes );
        return path( move joined );
    }

    /// Everything before the last `/`: `a/b` gives `a`, `/a` and `/` give `/`, and `a` gives the
    /// empty path.
    public path parent() const
    {
        const ref u8[] bytes = text_.as_text();
        u64 slash = last_slash( bytes );

        if( slash == bytes.size )
        {
            return path::of( "" );
        }

        return path( text_.substring( 0, slash == 0 ? 1 : slash ) );
    }

    /// Everything after the last `/`, or the whole path with none: `a/` has the empty name.
    public string file_name() const
    {
        const ref u8[] bytes = text_.as_text();
        u64 slash = last_slash( bytes );

        if( slash == bytes.size )
        {
            return string( text_ );
        }

        return text_.substring( slash + 1, bytes.size - slash - 1 );
    }

    /// The file name from its last `.`, the dot included: `b.tar.gz` gives `.gz`. Empty with no
    /// dot, and a leading dot does not count, so `.bashrc`, `.` and `..` have none.
    public string extension() const
    {
        string name = file_name();

        if( name == ".." )
        {
            return string();
        }

        u64 dot = name.size();
        while( dot > 1 )
        {
            dot--;

            if( name[dot] == '.' )
            {
                return name.substring( dot, name.size() - dot );
            }
        }

        return string();
    }

    private string text_;
};

/// What, if anything, is at a path. A symbolic link counts as what it points to.
enum path_kind
{
    /// Nothing, including a path through something that is not a directory.
    missing,
    /// A regular file.
    file,
    /// A directory.
    directory,
    /// Anything else, such as a device or a pipe.
    other
};

/// What is at `name`. Nothing there is `path_kind::missing`, not an error.
result<path_kind, file_error> path_kind_of( const ref textual name )
{
    i32 kind = 0;
    i32 status = 0;

    unsafe
    {
        status = kl_rt_path_kind( name.as_text(), &kind );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    switch( kind )
    {
        case 1:
            return result::ok( path_kind::file );
        case 2:
            return result::ok( path_kind::directory );
        case 3:
            return result::ok( path_kind::other );
        default:
            return result::ok( path_kind::missing );
    }
}

/// Whether anything is at `name`; `false` too when the system cannot say.
bool exists( const ref textual name )
{
    switch( path_kind_of( name ) )
    {
        case result::ok( kind ):
            return kind != path_kind::missing;
        case result::err( e ):
            return false;
    }
}

/// Whether `name` is a regular file; `false` too when the system cannot say.
bool is_file( const ref textual name )
{
    switch( path_kind_of( name ) )
    {
        case result::ok( kind ):
            return kind == path_kind::file;
        case result::err( e ):
            return false;
    }
}

/// Whether `name` is a directory; `false` too when the system cannot say.
bool is_directory( const ref textual name )
{
    switch( path_kind_of( name ) )
    {
        case result::ok( kind ):
            return kind == path_kind::directory;
        case result::err( e ):
            return false;
    }
}

/// How `file::open` opens a file. Every mode but `read` creates a file that does not exist.
enum file_mode
{
    /// Read only, from the start.
    read,
    /// Write only, emptying the file first.
    write,
    /// Write only, every write going at the end.
    append,
    /// Write only, failing with `file_error::exists` if the file is there already.
    create_new
};

// The bytes a file reads at a time.
private const u64 FILE_BUFFER = 65536;

/// An open file, closed when it is dropped.
///
/// Made by `file::open`, or for the program's own streams by `standard_input`, `standard_output`
/// and `standard_error`, which never close them. Reads go through a buffer, and writes straight to
/// the system.
class file
{
    // `owns` is false only for a descriptor the program must never close.
    private file( i32 fd, bool owns )
    {
        fd_ = fd;
        owns_ = owns;
        buffer_ = nullptr;
        start_ = 0;
        end_ = 0;
        shared_ = false;
    }

    ~file()
    {
        unsafe
        {
            if( owns_ )
            {
                // A destructor has nowhere to report a failed close.
                kl_rt_file_close( fd_ );
            }

            if( buffer_ != nullptr && !shared_ )
            {
                free( buffer_ );
            }
        }
    }

    /// Opens the file at `name` in `mode`.
    public static result<file, file_error> open( const ref textual name, file_mode mode )
    {
        i32 fd = 0;
        i32 status = 0;

        unsafe
        {
            status = kl_rt_file_open( name.as_text(), cast<i32>( mode ), &fd );
        }

        if( status != 0 )
        {
            return result::err( file_error_of( status ) );
        }

        return result::ok( file( fd, true ) );
    }

    /// The program's standard input. Every one shares a buffer, so none loses what another read.
    public static file standard_input()
    {
        file f = file( 0, false );
        f.shared_ = true;
        return f;
    }

    /// The program's standard output, flushed by every write.
    public static file standard_output()
    {
        return file( 1, false );
    }

    /// The program's standard error. Standard output is flushed first, so the two keep their order.
    public static file standard_error()
    {
        return file( 2, false );
    }

    /// Reads into `into`, answering how many bytes it put there: at most `into.size`, and 0 only
    /// at the end of the file. Fewer than asked for is not the end; ask again.
    public result<u64, file_error> read( ref u8[] into )
    {
        try fill();
        const u64 count = end_ - start_ < into.size ? end_ - start_ : into.size;

        for( u64 i : 0..count )
        {
            unsafe
            {
                into[i] = buffer_[start_ + i];
            }
        }

        take( count );
        return result::ok( count );
    }

    /// Writes all of `data`.
    public result<void, file_error> write( const ref textual data )
    {
        i32 status = 0;
        unsafe
        {
            status = kl_rt_file_write( fd_, data.as_text() );
        }

        if( status != 0 )
        {
            return result::err( file_error_of( status ) );
        }

        return result::ok();
    }

    /// Reads the rest of the file.
    public result<string, file_error> read_all()
    {
        string text = string();

        while( true )
        {
            try fill();

            if( start_ == end_ )
            {
                break;
            }

            unsafe
            {
                text.append( buffer_[start_..end_] );
            }

            take( end_ - start_ );
        }

        return result::ok( move text );
    }

    /// Reads up to the next `\n`, which is dropped, into `line`, replacing what it held. `false`
    /// only when the input ends before any byte, so a last line without `\n` is still a line.
    public result<bool, file_error> read_line( ref string line )
    {
        line.clear();
        bool any = false;

        while( true )
        {
            try fill();

            if( start_ == end_ )
            {
                return result::ok( any );
            }

            any = true;
            for( u64 i : start_..end_ )
            {
                unsafe
                {
                    if( buffer_[i] == '\n' )
                    {
                        line.append( buffer_[start_..i] );
                        take( i + 1 - start_ );
                        return result::ok( true );
                    }
                }
            }

            unsafe
            {
                line.append( buffer_[start_..end_] );
            }
            take( end_ - start_ );
        }
    }

    // Makes `buffer_[start_..end_]` hold something, unless the input has ended.
    private result<void, file_error> fill()
    {
        i32 status = 0;
        if( shared_ )
        {
            unsafe
            {
                status = kl_rt_input_fill( &buffer_, &end_ );
            }

            if( status != 0 )
            {
                return result::err( file_error_of( status ) );
            }

            start_ = 0;
            return result::ok();
        }

        if( start_ == end_ )
        {
            u64 count = 0;
            unsafe
            {
                if( buffer_ == nullptr )
                {
                    buffer_ = alloc<u8>( FILE_BUFFER );
                }

                status = kl_rt_file_read( fd_, ref buffer_[0..FILE_BUFFER], &count );

                if( status != 0 )
                {
                    return result::err( file_error_of( status ) );
                }

                start_ = 0;
                end_ = count;
            }
        }

        return result::ok();
    }

    // Drops the first `count` buffered bytes, which the caller has used.
    private void take( u64 count )
    {
        start_ += count;

        if( shared_ )
        {
            unsafe
            {
                kl_rt_input_take( count );
            }
        }
    }

    private i32 fd_;
    private bool owns_;
    private u8[*] buffer_; // `nullptr` until first read
    private u64 start_;    // the buffered bytes are `buffer_[start_..end_]`
    private u64 end_;
    private bool shared_; // reading through the runtime's shared standard-input buffer
};

/// The whole of the file at `name`.
result<string, file_error> read_file( const ref textual name )
{
    file f = try file::open( name, file_mode::read );
    return f.read_all();
}

/// Writes `data` to the file at `name`, replacing what it held, or creating it.
result<void, file_error> write_file( const ref textual name, const ref textual data )
{
    file f = try file::open( name, file_mode::write );
    return f.write( data );
}

/// Deletes the file at `name`. A directory is `file_error::is_directory`.
result<void, file_error> delete_file( const ref textual name )
{
    i32 status = 0;
    unsafe
    {
        status = kl_rt_delete_file( name.as_text() );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    return result::ok();
}

/// Creates the directory `name`, whose parent must exist. Anything already there is
/// `file_error::exists`.
result<void, file_error> create_directory( const ref textual name )
{
    i32 status = 0;

    unsafe
    {
        status = kl_rt_create_directory( name.as_text() );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    return result::ok();
}

/// Deletes the empty directory `name`. One still holding something is `file_error::not_empty`,
/// and a file is `file_error::not_directory`.
result<void, file_error> delete_directory( const ref textual name )
{
    i32 status = 0;
    unsafe
    {
        status = kl_rt_delete_directory( name.as_text() );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    return result::ok();
}

/// Every entry in the directory `name` but `.` and `..`, each joined onto `name`, in the system's
/// order.
result<list<path>, file_error> list_directory( const ref textual name )
{
    u64 handle = 0;
    i32 status = 0;

    unsafe
    {
        status = kl_rt_directory_open( name.as_text(), &handle );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    const path base = path::of( name );
    list<path> entries = list<path>();

    while( true )
    {
        u8[*] bytes = nullptr;
        u64 size = 0;
        string entry = string();

        unsafe
        {
            status = kl_rt_directory_next( handle, &bytes, &size );

            entry.append( bytes[0..size] );
        }

        if( status != 0 || size == 0 )
        {
            break;
        }

        entries.push( base / entry );
    }

    unsafe
    {
        kl_rt_directory_close( handle );
    }

    if( status != 0 )
    {
        return result::err( file_error_of( status ) );
    }

    return result::ok( move entries );
}
