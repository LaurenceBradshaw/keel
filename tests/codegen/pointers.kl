// `*T` points at exactly one T. No arithmetic, no indexing - those belong to a many-item pointer,
// which v0 does not have. Self-checking: exit 0 means every answer was right.
struct Point { f64 x; f64 y; };
struct Cell { i32 n; };

i32 read( i32* q ) { return *q; }

void bump( i32* q ) { *q = *q + 1; }

i32 main()
{
    i32 v = 41;
    i32* q = &v;

    if( *q != 41 ) { return 1; }
    if( read( q ) != 41 ) { return 2; }

    bump( q );
    if( v != 42 ) { return 3; }   // written through the pointer, not into a copy

    *q = 7;
    if( v != 7 ) { return 4; }

    i32** r = &q;
    if( **r != 7 ) { return 5; }

    auto s = Point { 1.0, 2.0 };
    f64* f = &s.y;
    *f = 9.0;
    if( s.y != 9.0 ) { return 6; }

    i32* n = nullptr;
    if( n != nullptr ) { return 7; }

    // Writing through a pointer *to a struct*. `.` binds tighter than unary `*` in C, so the
    // place this lowers to has to be parenthesised or it means `*( p.x )`.
    Point* p = &s;
    (*p).x = 3.0;
    if( s.x != 3.0 ) { return 8; }

    // The same place on both sides.
    (*p).x = (*p).x + 1.0;
    if( s.x != 4.0 ) { return 9; }

    // And the two statement forms that build their own place.
    Cell  c = Cell { 10 };
    Cell* d = &c;
    (*d).n += 5;
    if( c.n != 15 ) { return 10; }

    (*d).n++;
    if( c.n != 16 ) { return 11; }

    return 0;
}
