// `kl::time`: both clocks never go backwards, `duration` arithmetic, positive resolutions and a
// plausible wall time. Each check returns its own code.
import kl::time;

i32 main()
{
    kl::instant a = kl::instant::now();
    kl::raw_instant r = kl::raw_instant::now();
    for( u64 i = 0; i < 10000; i++ )
    {
        kl::instant b = kl::instant::now();
        if( b < a )
        {
            return 1;
        }
        a = b;

        kl::raw_instant s = kl::raw_instant::now();
        if( s < r )
        {
            return 2;
        }
        r = s;
    }

    kl::instant later = kl::instant::now();
    if( ( later - a ).nanoseconds() < 0 || a - a != kl::duration::of_nanoseconds( 0 ) )
    {
        return 3;
    }

    kl::duration two = kl::duration::of_nanoseconds( 2 );
    kl::duration five = kl::duration::of_nanoseconds( 5 );
    if( two + five - five != two || !( two < five ) || ( two - five ).nanoseconds() != -3 )
    {
        return 4;
    }

    if( kl::instant::resolution().nanoseconds() <= 0
        || kl::raw_instant::resolution().nanoseconds() <= 0 )
    {
        return 5;
    }

    // 2026-01-01 UTC.
    if( kl::wall_time() < 1767225600000000000 )
    {
        return 6;
    }

    return 0;
}
