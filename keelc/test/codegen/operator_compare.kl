// `a <=> b` answers an `ordering`: on numbers, mixed signs and a float included, and on an aggregate
// as a call of its `operator<=>`, which `<`, `<=`, `>` and `>=` call too. On a struct, a class, a
// generic instance and a generic function's `T`. Exits with the failing check.
struct version
{
    i32 major;
    i32 minor;

    ordering operator<=>( const ref version other ) const
    {
        ordering first = major <=> other.major;

        if( first != ordering::equal )
        {
            return first;
        }

        return minor <=> other.minor;
    }
};

class name
{
    name( u8 c )
    {
        first = c;
    }

    public ordering operator<=>( const ref name other ) const
    {
        return first <=> other.first;
    }

    private u8 first;
};

class pair<T> where T : copyable & comparable
{
    pair( T a, T b )
    {
        left  = a;
        right = b;
    }

    public ordering operator<=>( const ref pair<T> other ) const
    {
        ordering first = left <=> other.left;

        if( first != ordering::equal )
        {
            return first;
        }

        return right <=> other.right;
    }

    private T left;
    private T right;
};

ordering compare<T>( T a, T b ) where T : comparable
{
    return a <=> b;
}

i32 rank( ordering o )
{
    switch( o )
    {
        case ordering::less:
            return 0 - 1;
        case ordering::equal:
            return 0;
        case ordering::greater:
            return 1;
    }
}

bool before( const ref name a, const ref name b )
{
    return a < b;
}

i32 main()
{
    i32 small = 0 - 1;
    u64 big   = 1;
    u8  byte  = 200;
    f64 half  = 0.5;

    if( rank( small <=> 3 ) != 0 - 1 || rank( 3 <=> 3 ) != 0 || rank( byte <=> 100 ) != 1 )
    {
        return 1;
    }

    if( ( small <=> big ) != ordering::less || ( big <=> small ) != ordering::greater )
    {
        return 2;
    }

    if( ( half <=> 0.25 ) != ordering::greater || ( half <=> half ) != ordering::equal )
    {
        return 3;
    }

    version a = version { 1, 2 };
    version b = version { 1, 3 };

    if( ( a <=> b ) != ordering::less || ( b <=> a ) != ordering::greater || ( a <=> a ) != ordering::equal )
    {
        return 4;
    }

    if( !( a < b ) || !( a <= b ) || a > b || a >= b || !( a <= a ) || !( a >= a ) || a < a )
    {
        return 5;
    }

    name n = name( 65 );

    if( !before( n, name( 66 ) ) || before( n, name( 65 ) ) || !( n > name( 64 ) ) )
    {
        return 6;
    }

    pair<i32> p = pair<i32>( 1, 2 );

    if( p >= pair<i32>( 1, 3 ) || p < pair<i32>( 0, 9 ) || ( p <=> pair<i32>( 1, 2 ) ) != ordering::equal )
    {
        return 7;
    }

    if( compare<i32>( 2, 1 ) != ordering::greater || compare<f64>( 0.5, 1.5 ) != ordering::less )
    {
        return 8;
    }

    return 0;
}
