// Matrix loops over row-major runs: element `(r, c)` of an `R` by `C` matrix is at `r * C + c`.
// `dest` must not be `a` or `b`.

/// `dest` (`rows` by `cols`) = `a` (`rows` by `inner`) times `b` (`inner` by `cols`). Loops `i`,
/// `k`, `j`, so the innermost walks `b` and `dest` in order.
///
/// ### Panics
///
/// If a size is not its shape's.
void matmul<T>( ref T[] dest, const ref T[] a, const ref T[] b, u64 rows, u64 inner, u64 cols ) where T : numeric
{
    if( a.size != rows * inner || b.size != inner * cols || dest.size != rows * cols )
    {
        panic( "the shapes differ" );
    }

    for( u64 i : 0..dest.size )
    {
        dest[i] = 0;
    }

    for( u64 i : 0..rows )
    {
        for( u64 k : 0..inner )
        {
            T x = a[i * inner + k];
            for( u64 j : 0..cols )
            {
                dest[i * cols + j] += x * b[k * cols + j];
            }
        }
    }
}

/// `dest` (`cols` by `rows`) = `a` (`rows` by `cols`) transposed.
///
/// ### Panics
///
/// If a size is not its shape's.
void transpose<T>( ref T[] dest, const ref T[] a, u64 rows, u64 cols ) where T : copyable
{
    if( a.size != rows * cols || dest.size != rows * cols )
    {
        panic( "the shapes differ" );
    }

    for( u64 r : 0..rows )
    {
        for( u64 c : 0..cols )
        {
            dest[c * rows + r] = a[r * cols + c];
        }
    }
}

/// `dest` = the `n` by `n` identity.
///
/// ### Panics
///
/// If `dest` is not `n` by `n`.
void identity<T>( ref T[] dest, u64 n ) where T : numeric
{
    eye( ref dest, n, n );
}

/// `dest` (`rows` by `cols`) = 1 on the diagonal and 0 elsewhere.
///
/// ### Panics
///
/// If `dest` is not `rows` by `cols`.
void eye<T>( ref T[] dest, u64 rows, u64 cols ) where T : numeric
{
    if( dest.size != rows * cols )
    {
        panic( "the shapes differ" );
    }

    for( u64 r : 0..rows )
    {
        for( u64 c : 0..cols )
        {
            dest[r * cols + c] = r == c ? 1 : 0;
        }
    }
}

/// Factors `a`, `n` by `n`, in place with partial pivoting: U on and above the diagonal, and below
/// it L's multipliers, L's diagonal being 1. Row `i` of the factors is row `perm[i]` of `a`.
/// Answers the permutation's sign, or 0 when a pivot is exactly zero, the factors then unfinished.
///
/// ### Panics
///
/// If `a` does not hold `n` by `n`, or `perm` does not hold `n`.
T lu<T>( ref T[] a, ref u64[] perm, u64 n ) where T : floating
{
    if( a.size != n * n || perm.size != n )
    {
        panic( "the shapes differ" );
    }

    for( u64 i : 0..n )
    {
        perm[i] = i;
    }

    T sign = 1;
    for( u64 j : 0..n )
    {
        u64 p = j;
        for( u64 i : j + 1..n )
        {
            if( magnitude( a[i * n + j] ) > magnitude( a[p * n + j] ) )
            {
                p = i;
            }
        }
        if( a[p * n + j] == 0 )
        {
            return 0;
        }

        if( p != j )
        {
            for( u64 c : 0..n )
            {
                T t          = a[j * n + c];
                a[j * n + c] = a[p * n + c];
                a[p * n + c] = t;
            }
            u64 t   = perm[j];
            perm[j] = perm[p];
            perm[p] = t;
            sign    = -sign;
        }

        for( u64 i : j + 1..n )
        {
            T f          = a[i * n + j] / a[j * n + j];
            a[i * n + j] = f;
            for( u64 c : j + 1..n )
            {
                a[i * n + c] -= f * a[j * n + c];
            }
        }
    }
    return sign;
}

/// `dest`, `n` by `k`, = the `x` with `A x = b`, for `b` `n` by `k`, from `lu`'s factors of `A`
/// and its `perm`.
///
/// ### Panics
///
/// If a size is not its shape's.
void lu_solve<T>( ref T[] dest, const ref T[] factors, const ref u64[] perm, const ref T[] b, u64 n, u64 k ) where T : floating
{
    if( factors.size != n * n || perm.size != n || b.size != n * k || dest.size != n * k )
    {
        panic( "the shapes differ" );
    }

    for( u64 i : 0..n )
    {
        for( u64 c : 0..k )
        {
            dest[i * k + c] = b[perm[i] * k + c];
        }
    }

    // L y = P b, then U x = y.
    for( u64 i : 0..n )
    {
        for( u64 j : 0..i )
        {
            T f = factors[i * n + j];
            for( u64 c : 0..k )
            {
                dest[i * k + c] -= f * dest[j * k + c];
            }
        }
    }
    for( u64 m : 0..n )
    {
        u64 i = n - 1 - m;
        for( u64 j : i + 1..n )
        {
            T f = factors[i * n + j];
            for( u64 c : 0..k )
            {
                dest[i * k + c] -= f * dest[j * k + c];
            }
        }
        for( u64 c : 0..k )
        {
            dest[i * k + c] /= factors[i * n + i];
        }
    }
}

/// The determinant from `lu`'s factors and the sign it answered.
T lu_determinant<T>( const ref T[] factors, u64 n, T sign ) where T : floating
{
    if( sign == 0 )
    {
        return 0;
    }

    T d = sign;
    for( u64 i : 0..n )
    {
        d *= factors[i * n + i];
    }
    return d;
}

/// The square root of the sum of squares, scaled as LAPACK's `nrm2` is so that no square
/// overflows or underflows: a NaN answers NaN, else an infinity infinity.
f64 norm<T>( const ref T[] a ) where T : floating
{
    f64 scale    = 0;
    f64 sum      = 1;
    f64 infinite = 0;
    for( T e : a )
    {
        f64 x = cast<f64>( e );
        if( x != x )
        {
            return x;
        }

        f64 m = x < 0 ? -x : x;
        if( m == 0 )
        {
            continue;
        }
        if( m - m != 0 )
        {
            infinite = m;
        }
        else if( m > scale )
        {
            sum   = 1 + sum * ( scale / m ) * ( scale / m );
            scale = m;
        }
        else
        {
            sum += ( m / scale ) * ( m / scale );
        }
    }
    return infinite != 0 ? infinite : scale * sqrt_f64( sum );
}

/// `dest` = `a` x `b`, each of size 3.
///
/// ### Panics
///
/// If a size is not 3.
void cross<T>( ref T[] dest, const ref T[] a, const ref T[] b ) where T : numeric
{
    if( a.size != 3 || b.size != 3 || dest.size != 3 )
    {
        panic( "cross takes vectors of size 3" );
    }

    dest[0] = a[1] * b[2] - a[2] * b[1];
    dest[1] = a[2] * b[0] - a[0] * b[2];
    dest[2] = a[0] * b[1] - a[1] * b[0];
}

/// `dest`, `a.size` by `b.size`, = each element of `a` times each of `b`.
///
/// ### Panics
///
/// If `dest` is not that size.
void outer<T>( ref T[] dest, const ref T[] a, const ref T[] b ) where T : numeric
{
    if( dest.size != a.size * b.size )
    {
        panic( "the shapes differ" );
    }

    for( u64 i : 0..a.size )
    {
        for( u64 j : 0..b.size )
        {
            dest[i * b.size + j] = a[i] * b[j];
        }
    }
}

/// `dest`, row-major over `shape`, = `a` read at `strides`: the element at index `(i0, i1, ...)`
/// is `a[i0 * strides[0] + i1 * strides[1] + ...]`. A permuted array reads its source's strides
/// in the new order, and a slice its source's from the slice's first element.
///
/// ### Panics
///
/// If `shape` and `strides` differ in length, `dest` does not hold `shape`, or a read falls
/// outside `a`.
void gather<T>( ref T[] dest, const ref T[] a, const ref u64[] shape, const ref u64[] strides ) where T : copyable
{
    if( strided_count( shape, strides ) != dest.size )
    {
        panic( "the shapes differ" );
    }
    if( dest.size == 0 )
    {
        return;
    }
    if( shape.size == 0 )
    {
        dest[0] = a[0];
        return;
    }

    u64 inner  = shape[shape.size - 1];
    u64 stride = strides[shape.size - 1];
    for( u64 row : 0..dest.size / inner )
    {
        u64 base = strided_base( row, shape, strides );
        for( u64 j : 0..inner )
        {
            dest[row * inner + j] = a[base + j * stride];
        }
    }
}

/// `dest` read at `strides`, as `gather` reads `a`, = `a`, row-major over `shape`.
///
/// ### Panics
///
/// If `shape` and `strides` differ in length, `a` does not hold `shape`, or a write falls outside
/// `dest`.
void scatter<T>( ref T[] dest, const ref T[] a, const ref u64[] shape, const ref u64[] strides ) where T : copyable
{
    if( strided_count( shape, strides ) != a.size )
    {
        panic( "the shapes differ" );
    }
    if( a.size == 0 )
    {
        return;
    }
    if( shape.size == 0 )
    {
        dest[0] = a[0];
        return;
    }

    u64 inner  = shape[shape.size - 1];
    u64 stride = strides[shape.size - 1];
    for( u64 row : 0..a.size / inner )
    {
        u64 base = strided_base( row, shape, strides );
        for( u64 j : 0..inner )
        {
            dest[base + j * stride] = a[row * inner + j];
        }
    }
}

/// Every element of `dest` read at `strides` over `shape`, as `gather` reads `a`, = `x`.
///
/// ### Panics
///
/// If `shape` and `strides` differ in length, or a write falls outside `dest`.
void fill_strided<T>( ref T[] dest, T x, const ref u64[] shape, const ref u64[] strides ) where T : copyable
{
    u64 n = strided_count( shape, strides );
    if( n == 0 )
    {
        return;
    }
    if( shape.size == 0 )
    {
        dest[0] = x;
        return;
    }

    u64 inner  = shape[shape.size - 1];
    u64 stride = strides[shape.size - 1];
    for( u64 row : 0..n / inner )
    {
        u64 base = strided_base( row, shape, strides );
        for( u64 j : 0..inner )
        {
            dest[base + j * stride] = x;
        }
    }
}

/// `dest[i] = op( dest[i], x )`, `dest` row-major over `shape` and `x` read from `a` at
/// `strides`, as `gather` reads it. A stride of 0 repeats an element along its axis, which is how
/// a smaller array broadcasts.
///
/// ### Panics
///
/// If `shape` and `strides` differ in length, `dest` does not hold `shape`, or a read falls
/// outside `a`.
void zip_strided_into<T, F>( ref T[] dest, const ref T[] a, const ref u64[] shape, const ref u64[] strides, F op ) where T : copyable, where F : fn( T, T ) -> T
{
    if( strided_count( shape, strides ) != dest.size )
    {
        panic( "the shapes differ" );
    }
    if( dest.size == 0 )
    {
        return;
    }
    if( shape.size == 0 )
    {
        dest[0] = op( dest[0], a[0] );
        return;
    }

    u64 inner  = shape[shape.size - 1];
    u64 stride = strides[shape.size - 1];
    for( u64 row : 0..dest.size / inner )
    {
        u64 base = strided_base( row, shape, strides );
        for( u64 j : 0..inner )
        {
            dest[row * inner + j] = op( dest[row * inner + j], a[base + j * stride] );
        }
    }
}

/// `dest[i] = op( x, y )`, `dest` row-major over `shape`, `x` read from `a` at `a_strides` and `y`
/// from `b` at `b_strides`, as `gather` reads them.
///
/// ### Panics
///
/// If either stride list differs from `shape` in length, `dest` does not hold `shape`, or a read
/// falls outside `a` or `b`.
void zip_strided<T, F>( ref T[] dest, const ref T[] a, const ref u64[] a_strides, const ref T[] b, const ref u64[] b_strides, const ref u64[] shape, F op ) where T : copyable, where F : fn( T, T ) -> T
{
    if( strided_count( shape, a_strides ) != dest.size || strided_count( shape, b_strides ) != dest.size )
    {
        panic( "the shapes differ" );
    }
    if( dest.size == 0 )
    {
        return;
    }
    if( shape.size == 0 )
    {
        dest[0] = op( a[0], b[0] );
        return;
    }

    u64 inner = shape[shape.size - 1];
    u64 sa    = a_strides[shape.size - 1];
    u64 sb    = b_strides[shape.size - 1];
    for( u64 row : 0..dest.size / inner )
    {
        u64 ba = strided_base( row, shape, a_strides );
        u64 bb = strided_base( row, shape, b_strides );
        for( u64 j : 0..inner )
        {
            dest[row * inner + j] = op( a[ba + j * sa], b[bb + j * sb] );
        }
    }
}

private T magnitude<T>( T x ) where T : floating
{
    return x < 0 ? -x : x;
}

// The product of `shape`. Panics when `strides` differs in length.
private u64 strided_count( const ref u64[] shape, const ref u64[] strides )
{
    if( shape.size != strides.size )
    {
        panic( "the shapes differ" );
    }

    u64 n = 1;
    for( u64 d : shape )
    {
        n *= d;
    }
    return n;
}

// Where row `row` of `shape` (every index but the last) starts, read at `strides`.
private u64 strided_base( u64 row, const ref u64[] shape, const ref u64[] strides )
{
    u64 last = shape.size - 1;
    u64 base = 0;
    u64 rest = row;
    for( u64 k : 0..last )
    {
        u64 axis = last - 1 - k;
        base += rest % shape[axis] * strides[axis];
        rest /= shape[axis];
    }
    return base;
}
