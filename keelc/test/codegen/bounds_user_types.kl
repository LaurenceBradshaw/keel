// D40: under a bound, `==` and the comparisons at a type with a conformance of its own call its
// operator, and at a type the compiler makes conform they compare directly. An enum whose own
// `equatable` block makes two variants equal has that `==` everywhere, generic or not, and reaches
// the tags through `cast`; one whose own `comparable` block ranks it keeps the compiler's `==`.
// Exits with the failing check.
struct Version implements comparable, equatable
{
    i32 major;
    i32 minor;

    bool operator==( const ref Version other ) const
    {
        return major == other.major && minor == other.minor;
    }

    ordering operator<=>( const ref Version other ) const
    {
        if( major != other.major )
        {
            return major <=> other.major;
        }

        return minor <=> other.minor;
    }
};

struct Pair<T> implements equatable where T : equatable & copyable
{
    T left;
    T right;

    bool operator==( const ref Pair<T> other ) const
    {
        return left == other.left && right == other.right;
    }
};

// Hearts and Diamonds are both red, and equal as colours.
enum Suit
{
    Hearts,
    Diamonds,
    Spades,
};

implements equatable for Suit
{
    bool operator==( const ref Suit other ) const
    {
        return cast<u8>( this ) == cast<u8>( other ) || cast<u8>( this ) + cast<u8>( other ) == 1;
    }
};

enum Rank
{
    Low,
    High,
};

implements comparable for Rank
{
    ordering operator<=>( const ref Rank other ) const
    {
        return cast<u8>( this ) <=> cast<u8>( other );
    }
};

bool same<T>( const ref T a, const ref T b ) where T : equatable
{
    return a == b;
}

bool differ<T>( const ref T a, const ref T b ) where T : equatable
{
    return a != b;
}

bool before<T>( const ref T a, const ref T b ) where T : comparable
{
    return a < b && a <= b && !( a > b ) && !( a >= b ) && ( a <=> b ) == ordering::less;
}

i32 main()
{
    Version a = Version { 1, 2 };
    Version b = Version { 1, 3 };

    if( !before( a, b ) || before( b, a ) || !same( a, a ) || same( a, b ) || !differ( a, b ) )
    {
        return 1;
    }

    i32 x = 1;
    i32 y = 2;

    if( !before( x, y ) || before( y, x ) || !same( x, x ) || differ( x, x ) )
    {
        return 2;
    }

    Pair<i32> p = Pair { 1, 2 };
    Pair<i32> q = Pair { 1, 3 };

    if( !same( p, p ) || same( p, q ) || !differ( p, q ) )
    {
        return 3;
    }

    Suit h = Suit::Hearts;
    Suit d = Suit::Diamonds;
    Suit s = Suit::Spades;

    if( !( h == d ) || h != d || h == s || !( h != s ) )
    {
        return 4;
    }

    if( !same( h, d ) || same( h, s ) || differ( h, d ) || !differ( d, s ) )
    {
        return 5;
    }

    Rank low  = Rank::Low;
    Rank also = Rank::Low;
    Rank high = Rank::High;

    if( !( low < high ) || high <= low || !before( low, high ) || before( high, low ) )
    {
        return 6;
    }

    if( !( low == also ) || low == high || !same( high, high ) || same( low, high ) )
    {
        return 7;
    }

    return 0;
}
