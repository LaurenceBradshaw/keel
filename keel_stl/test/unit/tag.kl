// An owning key, ordered by its number.
import kl::string;

class tag implements comparable, equatable
{
    public tag( u64 n )
    {
        n_ = n;
        text_ = kl::string::from( n );
    }

    public u64 n() const
    {
        return n_;
    }

    public bool operator==( const ref tag other ) const
    {
        return n_ == other.n_;
    }

    public ordering operator<=>( const ref tag other ) const
    {
        return n_ <=> other.n_;
    }

    private u64 n_;
    private kl::string text_;
};
