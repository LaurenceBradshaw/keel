// M11's scalar replacement of a struct local copied whole, in a release build: a whole copy of a
// split local becomes one copy per field, so a local named only through fields and whole copies
// splits, a chain of moves one link a round. A local passed whole to a call that stays a call stays
// whole. Each returns its own code.

struct Point
{
    i32 x;
    i32 y;
};

enum Shape
{
    dot( Point at ),
    none
};

class Box
{
    public Box( i32 v )
    {
        value = v;
    }

    public i32 value;
};

i32 mixed( i32 a, i32 b )
{
    i32 c = a * b + a;
    i32 d = c - b * 3;
    i32 e = d * d + c;
    i32 f = e / 7 + d;
    i32 g = f * a - e;
    i32 h = g * b + f * c;
    return h + c * d - f;
}

i32 sum( Point p )
{
    return p.x + p.y;
}

// Over the size limit, so it stays a call.
i32 spread( Point p )
{
    return mixed( p.x, 1 ) + mixed( p.y, 2 ) + mixed( p.x, 3 );
}

Box made( i32 v )
{
    Box b = Box( v );
    return b;
}

Box pass( Box b )
{
    return b;
}

// `sum` is inlined, and its parameter, a whole copy of `p`, splits with it.
i32 argument( i32 a )
{
    Point p = Point { a, 1 };
    return sum( p ) == a + 1 ? 0 : 1;
}

// `made`'s result moves into `pass`'s parameter, then out through its result into `b`: the check
// folds.
i32 chain()
{
    Box b = pass( made( 5 ) );
    return b.value == 5 ? 0 : 2;
}

// The binding is a copy of the payload, and splits; the enum stays whole.
i32 opened( i32 a )
{
    Shape s = Shape::dot( Point { a, 2 } );
    switch( s )
    {
        case Shape::dot( at ):
            return at.x + at.y == a + 2 ? 0 : 3;
        case Shape::none:
            return 3;
    }
}

Point built( i32 a )
{
    Point p = Point { a, 1 };
    p.y     = p.x + 1;
    return p;
}

i32 returned( i32 a )
{
    Point p = built( a );
    return p.y == a + 1 ? 0 : 4;
}

// `q` is a changed copy of `p`, read beside it; both split, and the check folds.
i32 copied( i32 a )
{
    Point p = Point { a, 1 };
    Point q = p;
    q.x     = 7;
    return p.x + q.x == a + 7 ? 0 : 5;
}

i32 passed( i32 a )
{
    Point p = Point { a, 1 };
    return spread( p ) == mixed( a, 1 ) + mixed( 1, 2 ) + mixed( a, 3 ) ? 0 : 6;
}

i32 main()
{
    i32 code = argument( 5 );
    if( code == 0 )
    {
        code = chain();
    }
    if( code == 0 )
    {
        code = opened( 5 );
    }
    if( code == 0 )
    {
        code = returned( 5 );
    }
    if( code == 0 )
    {
        code = copied( 5 );
    }
    if( code == 0 )
    {
        code = passed( 5 );
    }

    return code;
}
