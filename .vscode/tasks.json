{
    "version": "2.0.0",
    "tasks": [
        {
            // A debug build of the program, so gdb steps it by .kl line. Uses the debug preset's
            // keelc; build that first.
            "label": "keelc: build examples/debugging.kl",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/bin/keelc",
            "args": [
                "--debug",
                "--package",
                "kl=keel_stl/src",
                "examples/debugging.kl",
                "-o",
                "build/examples/debugging"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // The same with the windows-debug preset's keelc, writing a .pdb beside the .exe.
            "label": "keelc: build examples/debugging.kl on Windows",
            "type": "process",
            "command": "${workspaceFolder}/build/windows-debug/bin/keelc.exe",
            "args": [
                "--debug",
                "--package",
                "kl=keel_stl/src",
                "examples/debugging.kl",
                "-o",
                "build/examples/debugging.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
