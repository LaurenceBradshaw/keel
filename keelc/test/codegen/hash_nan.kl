// A NaN has no hash, as it has no order: `hash` on one prints the file, the line and the call as
// written, and aborts.
import t::console;

f64 quotient( f64 a, f64 b )
{
    return a / b;
}

u64 digest<T>( const ref T v ) where T : hashable
{
    hasher h = hasher( 1, 2 );
    v.hash( ref h );
    return h.finish();
}

i32 main()
{
    f64 nan = quotient( 0.0, 0.0 );

    t::println( "before" );

    if( digest( nan ) == 0 )
    {
        return 1;
    }

    return 0;
}
