import list;
import optional;

enum parse_error
{
    no_digits,
    invalid_digit( u64 index ),
    overflow
};

class string
{
    string() 
    {
        bytes_ = list<u8>();
    }

    string( str text )
    {
        bytes_ = list<u8>::with_capacity( text.size );
        for( u64 i = 0; i < text.size; i++ )
        {
            unsafe
            {
                bytes_.push( text.data[ i ] );
            }
        }
    }

    public static string with_capacity( u64 capacity )
    {
        string result = string();
        result.bytes_ = list<u8>::with_capacity( capacity );
        return result;
    }

    public static string from( u64 value )
    {
        if( value == 0 )
        {
            return string( "0" );
        }

        string result = string();
        while( value > 0 )
        {
            result.push( cast<u8>( 48 + value % 10 ) );
            value /= 10;
        }

        result.bytes_.reverse();

        return result;
    }

    public static string from( i64 value )
    {
        if( value >= 0 )
        {
            return from( cast<u64>( value ) );
        }

        u64 magnitude = 0 - wrap<u64>( value );
        string result = string();
        result.push( 45 ); // '-'
        result.append( from( magnitude ) );

        return result;
    }

    public result<i64, parse_error> parse_i64() const
    {
        const bool is_negative = !is_empty() && bytes_[0] == 45; // '-'
        const u64 start = is_negative ? 1 : 0;
        const u64 limit = is_negative ? 9223372036854775808 : 9223372036854775807;

        if( size() == start )
        {
            return result::err( parse_error::no_digits );
        }

        u64 magnitude = 0;
        for( u64 i = start; i < size(); i++ )
        {
            const u8 byte = bytes_[i];
            if( byte < 48 || byte > 57 ) // '0'..'9'
            {
                return result::err( parse_error::invalid_digit( i ) );
            }
            
            const u64 digit = byte - 48;

            if( magnitude > (limit - digit) / 10 )
            {
                return result::err( parse_error::overflow );
            }

            magnitude = magnitude * 10 + digit;
        }

        return result::ok( is_negative ? wrap<i64>( 0 - magnitude ) : cast<i64>( magnitude ) );
    }

    public void push( u8 value )
    {
        bytes_.push( value );
    }

    public u8 pop()
    {
        return bytes_.pop();
    }

    public void append( const ref string other )
    {
        for( u64 i = 0; i < other.size(); i++ )
        {
            bytes_.push( other[i] );
        }
    }

    public void clear()
    {
        bytes_ = list<u8>();
    }

    public const u8* operator[]( u64 index ) const
    {
        return &bytes_[index];
    }

    public u64 size() const
    {
        return bytes_.size();
    }

    public bool is_empty() const
    {
        return bytes_.is_empty();
    }

    public bool operator==( const ref string other ) const
    {
        if( size() != other.size() )
        {
            return false;
        }

        for( u64 i = 0; i < size(); i++ )
        {
            if( bytes_[i] != other[i] )
            {
                return false;
            }
        }

        return true;
    }

    public bool starts_with( str prefix ) const
    {
        return matches_at( 0, prefix );
    }

    public bool ends_with( str suffix ) const
    {
        if( suffix.size > size() )
        {
            return false;
        }

        return matches_at( size() - suffix.size, suffix );
    }

    public optional<u64> find( str needle ) const
    {
        if( needle.size > size() )
        {
            return optional::none;
        }

        for( u64 i = 0; i <= size() - needle.size; i++ )
        {
            if( matches_at( i, needle ) )
            {
                return optional::some( i );
            }
        }

        return optional::none;
    }

    public string substring( u64 start, u64 count ) const
    {
        assert( start <= size() );
        assert( count <= size() - start );

        string result = string::with_capacity( count );
        for( u64 i = 0; i < count; i++ )
        {
            result.push( bytes_[start + i] );
        }

        return result;
    }

    private bool matches_at( u64 at, str text ) const
    {
        if( at + text.size > size() )
        {
            return false;
        }

        unsafe
        {
            for( u64 i = 0; i < text.size; i++ )
            {
                if( bytes_[at + i] != text.data[i] )
                {
                    return false;
                }
            }
        }

        return true;
    }

    private list<u8> bytes_;
};