// M11's constant folding under --overflow-checks: an `overflows` check of two constants is known,
// so a sum that fits loses its check and the panic it guards.
i32 add( i32 a, i32 b )
{
    return a + b;
}

i32 main()
{
    if( add( 2147483646, 1 ) != 2147483647 )
    {
        return 1;
    }

    return 0;
}
