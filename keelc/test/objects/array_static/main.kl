// An array global's elements through objects: a.klo defines `Tagged<i32>::labels` weakly from the
// value words.klo recorded, and `copied` from `GRID`'s, a fill nested in a literal.
import a;
import words;

i32 main()
{
    if( label_size() != 5 || Tagged<i32>::labels[0].size != 3 )
    {
        return 1;
    }

    if( copied[0][1] != 2 || copied[1][0] != 3 || copied[1][1] != 3 || GRID[1][1] != 3 )
    {
        return 2;
    }

    return 0;
}
