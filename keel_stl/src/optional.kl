/// A value of type `T`, or nothing.
enum optional<T>
{
    /// Holds a value.
    some( T value ),
    /// Holds nothing.
    none
};

/// Takes the value out of an optional, panicking if there is none.
///
/// ### Panics
///
/// If `o` is `none`, at the line that called it.
@located
T unwrap<T>( move optional<T> o )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            panic( "unwrap on an empty optional", @caller() );
    }
}

/// Takes the value out of an optional, panicking with a given message if there is none.
///
/// ### Panics
///
/// If `o` is `none`, with `message`, at the line that called it.
@located
T expect<T>( move optional<T> o, str message )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            panic( message, @caller() );
    }
}

/// Takes the value out of an optional, or a fallback if there is none.
///
/// Returns `fallback` if `o` is `none`; an unused `fallback` is dropped.
T value_or<T>( move optional<T> o, move T fallback )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            return fallback;
    }
}

/// Whether an optional holds a value.
bool is_some<T>( const ref optional<T> o )
{
    switch( o )
    {
        case optional::some( v ):
            return true;
        case optional::none:
            return false;
    }
}

/// Whether an optional holds nothing.
bool is_none<T>( const ref optional<T> o )
{
    switch( o )
    {
        case optional::some( v ):
            return false;
        case optional::none:
            return true;
    }
}
/// Two optionals are equal when both are empty, or both hold equal values.
implements<T> equatable for optional<T> where T : equatable
{
    bool operator==( const ref optional<T> other ) const
    {
        switch( this )
        {
            case optional::some( mine ):
                switch( other )
                {
                    case optional::some( theirs ):
                        return mine == theirs;
                    case optional::none:
                        return false;
                }
            case optional::none:
                switch( other )
                {
                    case optional::some( _ ):
                        return false;
                    case optional::none:
                        return true;
                }
        }
    }
};

/// An empty optional comes before any that holds a value; two that hold values order by them.
implements<T> comparable for optional<T> where T : comparable
{
    ordering operator<=>( const ref optional<T> other ) const
    {
        switch( this )
        {
            case optional::some( mine ):
                switch( other )
                {
                    case optional::some( theirs ):
                        return mine <=> theirs;
                    case optional::none:
                        return ordering::greater;
                }
            case optional::none:
                switch( other )
                {
                    case optional::some( _ ):
                        return ordering::less;
                    case optional::none:
                        return ordering::equal;
                }
        }
    }
};

/// An optional hashes whether it holds a value, then the value.
implements<T> hashable for optional<T> where T : hashable
{
    void hash( ref hasher h ) const
    {
        switch( this )
        {
            case optional::some( value ):
                h.write( 1 );
                value.hash( ref h );
                break;
            case optional::none:
                h.write( 0 );
                break;
        }
    }
};
