import hash_control;

/// A hash table of keys of type `K`, each held at most once.
///
/// `kl::map` without the values: keys are kept in insertion order until a removal moves the last
/// key into the removed one's place, `key_at` counts over them, each set hashes under its own
/// random key, and `insert` takes amortised constant time. Dropping the set drops every key.
class set<K> where K : hashable
{
    /// --- Construction ---

    /// An empty set. Allocates nothing until the first key arrives.
    public set()
    {
        control_ = hash_control::fresh();
        keys_ = nullptr;
    }

    /// An empty set with room for `capacity` keys before it grows.
    public static set<K> with_capacity( u64 capacity )
    {
        set<K> result = set<K>();
        result.reserve( capacity );
        return result;
    }

    ~set()
    {
        drop_all();
        if( keys_ != nullptr )
        {
            unsafe
            {
                free( keys_ );
            }
        }
    }

    /// --- Size and capacity ---

    /// The number of keys.
    public u64 size() const
    {
        return control_.size();
    }

    /// Whether the set holds no keys.
    public bool is_empty() const
    {
        return control_.size() == 0;
    }

    /// How many keys fit before the set grows. Removing a key may lower it until the set is rebuilt.
    public u64 capacity() const
    {
        return control_.capacity();
    }

    /// Makes room for at least `n` keys in all, not `n` more.
    /// Does nothing if the capacity is already that large.
    public void reserve( u64 n )
    {
        if( n > control_.capacity() )
        {
            resize( hash_control::slots_for( n ) );
        }
    }

    /// --- Lookup ---

    /// Whether the set holds `key`.
    public bool contains( const ref K key ) const
    {
        return slot_of( key ) != control_.slots();
    }

    /// --- By position ---

    /// A pointer to key `i`, counting from 0 in insertion order until a removal. `const`, since a
    /// changed key would sit in the wrong slot.
    ///
    /// ### Panics
    ///
    /// If `i` is not less than `size()`.
    public const K* key_at( u64 i ) const
    {
        if( i >= control_.size() )
        {
            panic( "index out of range" );
        }

        unsafe
        {
            return &keys_[i];
        }
    }

    /// --- Changing ---

    /// Adds `key`, and returns whether it was new. A key already present is kept, and `key` is
    /// dropped.
    public bool insert( move K key )
    {
        const u64 hash = hash_of( key );

        if( slot_of_hashed( key, hash ) != control_.slots() )
        {
            return false;
        }

        if( control_.needs_growth() )
        {
            resize( control_.grown_slots() );
        }

        const u64 entry = control_.occupy( control_.free_slot( hash ), hash );

        unsafe
        {
            keys_[entry] = move key;
        }

        return true;
    }

    /// Removes `key`, and returns whether the set held it. The last key takes its place.
    public bool remove( const ref K key )
    {
        const u64 slot = slot_of( key );

        if( slot == control_.slots() )
        {
            return false;
        }

        const u64 entry = control_.vacate( slot );
        const u64 last = control_.size();

        unsafe
        {
            destroy( keys_ + entry, 1 );

            if( entry != last )
            {
                keys_[entry] = move keys_[last]; // the last entry is raw after this
            }
        }

        return true;
    }

    /// Drops every key; the capacity is kept.
    public void clear()
    {
        drop_all();
        control_.clear();
    }

    /// --- Internals ---

    private u64 hash_of( const ref K key ) const
    {
        hasher h = control_.start_hash();
        key.hash( ref h );
        return h.finish();
    }

    // The slot holding `key`, or the slot count if there is none.
    private u64 slot_of_hashed( const ref K key, u64 hash ) const
    {
        const u64 end = control_.slots();
        if( control_.size() == 0 )
        {
            return end;
        }

        hash_probe probe = control_.probe( hash );
        u64 slot = probe.next();

        while( slot != end )
        {
            unsafe
            {
                if( keys_[control_.entry( slot )] == key )
                {
                    return slot;
                }
            }

            slot = probe.next();
        }

        return end;
    }

    // As `slot_of_hashed`, without hashing when the set is empty.
    private u64 slot_of( const ref K key ) const
    {
        if( control_.size() == 0 )
        {
            return control_.slots();
        }

        return slot_of_hashed( key, hash_of( key ) );
    }

    // Moves every key into an array sized for a table of `slots` slots, at the same index.
    private void resize( u64 slots )
    {
        K[*] keys;

        unsafe
        {
            keys = alloc<K>( hash_control::usable( slots ) );
        }

        for( u64 i : 0..control_.size() )
        {
            unsafe
            {
                keys[i] = move keys_[i]; // the old entries are raw after this
            }
        }

        if( keys_ != nullptr )
        {
            unsafe
            {
                free( keys_ );
            }
        }

        keys_ = keys;
        control_ = control_.resized( slots );
    }

    private void drop_all()
    {
        for( u64 i : 0..control_.size() )
        {
            unsafe
            {
                destroy( keys_ + i, 1 );
            }
        }
    }

    // Entries `0..control_.size()` of `keys_` are live.
    private hash_control control_;
    private K[*] keys_;
};
