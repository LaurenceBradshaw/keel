// PLAN §6.7 and D26. A literal argument goes to the closest overload that holds its value: the type
// it would be with nothing to say, else the narrowest, signed before unsigned. A negative literal
// never reaches an unsigned one, and arithmetic on literals ranks as a lone literal does.
import t::console;

i32 width( i8 _ )
{
    return 8;
}

i32 width( i16 _ )
{
    return 16;
}

i32 width( i64 _ )
{
    return 64;
}

i32 width( u64 _ )
{
    return 65;
}

i32 nearest( i32 _ )
{
    return 32;
}

i32 nearest( i8 _ )
{
    return 8;
}

i32 main()
{
    t::println( 42 );
    t::println( -42 );
    t::println( 9223372036854775808 );
    t::println( 1 + 2 );

    assert( width( 1 ) == 8 );
    assert( width( 300 ) == 16 );
    assert( width( -40000 ) == 64 );
    assert( width( 9223372036854775808 ) == 65 );
    assert( width( 100 + 100 ) == 16 );
    assert( nearest( 1 ) == 32 );

    return 0;
}
