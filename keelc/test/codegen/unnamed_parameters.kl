// A parameter named `_` or nothing is still passed, so the call matches its signature, and
// nothing warns. Exits 0 when every answer is right.
interface shape
{
    i32 area( i32 scale );
};

class square implements shape
{
    i32 side;

    square( i32 side )
    {
        this.side = side;
    }

    public i32 area( i32 _ )
    {
        return side * side;
    }
};

i32 second( i32 _, i32 b )
{
    return b;
}

i32 third( i32, i32, i32 c )
{
    return c;
}

i32 main()
{
    square s = square( 3 );
    shape* as_shape = &s;

    if( second( 1, 2 ) != 2 || third( 1, 2, 3 ) != 3 || as_shape.area( 10 ) != 9 )
    {
        return 1;
    }

    return 0;
}
