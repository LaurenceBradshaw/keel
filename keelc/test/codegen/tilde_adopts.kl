// A `~` over an integer literal takes its context's type, as a minus does: `~0` is all ones at
// whatever width is wanted.
u8 mask() { return ~0; }

i32 main()
{
    u8  m = ~0;
    u32 n = ~0;
    i8  s = ~0;
    u64 w = ~( 1 << 3 );
    u16 k = ~0x00FF & 0x0FF0;

    if( m != 255 || n != 4294967295 || s != -1 || w != 18446744073709551607 || k != 3840 || mask() != 255 )
    {
        return 1;
    }

    return 0;
}
