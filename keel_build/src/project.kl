import kl::string;
import kl::os;
import kl::optional;
import kl::pair;
import kl::list;

class Project
{
    private Project( 
        move kl::string name, move kl::path root, bool has_tests, move kl::list<kl::pair<kl::string, kl::path>> packages 
    )
    {
        name_ = move name;
        root_ = move root;
        has_tests_ = has_tests;
        packages_ = move packages;
    }

    public static result<Project, kl::string> open( move kl::path root )
    {
        if( !kl::is_file( root / "src/main.kl" ) )
        {
            return result::err( "no src/main.kl in the project root" );
        }

        const bool tests = kl::is_file( root / "test/main.kl" );

        kl::list<kl::pair<kl::string, kl::path>> found = kl::list<kl::pair<kl::string, kl::path>>();
        // `src/` and `test/` are the program's package, named as keelc names them.
        kl::string program = package_name( root / "src", root.file_name() );
        try add_packages( root, program, ref found );
        return result::ok( Project( move program, move root, tests, move found ) );
    }

    // Each folder in the root that holds a `.kl` is a package; `src/`'s subfolders are nested in the
    // program's, which keelc finds itself.
    private static result<void, kl::string> add_packages(
        const ref kl::path folder, const ref kl::string project, ref kl::list<kl::pair<kl::string, kl::path>> found
    )
    {
        switch( move kl::list_directory( folder ) )
        {
            case result::ok( entries ):
                for( u64 i : 0..entries.size() )
                {
                    kl::path entry = entries.pop();
                    const bool reserved = entry.file_name() == "src" || entry.file_name() == "test" || 
                                          entry.file_name() == "build";
                    if( !kl::is_directory( entry ) || reserved || 
                        entry.file_name().starts_with( "." ) || !holds_keel( entry ) )
                    {
                        continue;
                    }

                    kl::string named = package_name( entry, entry.file_name() );
                    if( named == "kl" )
                    {
                        return result::err( "a package named kl cannot be in a project: kl is the standard library" );
                    }
                    if( named == project )
                    {
                        return result::err( "the package in " + entry.file_name() + " has the project's name, " + named );
                    }

                    for( u64 j : 0..found.size() )
                    {
                        if( found.as_run()[j].first == named )
                        {
                            return result::err( "two of the project's packages are named " + named );
                        }
                    }

                    found.push( kl::pair<kl::string, kl::path>( move named, move entry ) );
                }
                return result::ok();
            case result::err( error ):
                return result::err( "cannot list " + folder );
        }
    }

    public const ref kl::string name() const
    {
        return name_;
    }

    public const ref kl::path root() const
    {
        return root_;
    }

    // Whether `test/main.kl` exists.
    public bool has_tests() const
    {
        return has_tests_;
    }

    // Each package's name and folder.
    public const ref kl::list<kl::pair<kl::string, kl::path>> packages() const
    {
        return packages_;
    }

    // What `@package( name );` in the folder's packageinfo.kl declares, else `otherwise`. keelc
    // reports a malformed declaration.
    private static kl::string package_name( const ref kl::path folder, move kl::string otherwise )
    {
        switch( move kl::read_file( folder / "packageinfo.kl" ) )
        {
            case result::ok( text ):
                switch( text.find( "@package(" ) )
                {
                    case kl::optional::some( at ):
                        const kl::string rest = text.substring( at + 9, text.size() - at - 9 );
                        switch( rest.find( ")" ) )
                        {
                            case kl::optional::some( end ):
                                return rest.substring( 0, end ).trim();
                            case kl::optional::none:
                                break;
                        }
                        break;
                    case kl::optional::none:
                        break;
                }
                break;
            case result::err( error ):
                break;
        }
        return otherwise;
    }

    private static bool holds_keel( const ref kl::path folder )
    {
        if( !kl::is_directory( folder ) )
        {
            return false;
        }

        switch( kl::list_directory( folder ) )
        {
            case result::ok( entries ):
                for( u64 i : 0..entries.size() )
                {
                    const ref kl::path entry = entries[i];
                    if( kl::is_file( entry ) && entry.extension() == ".kl" )
                    {
                        return true;
                    }
                }
                return false;
            case result::err( error ):
                return false;
        }
    }

    private kl::string name_;
    private kl::path root_;
    private bool has_tests_;
    private kl::list<kl::pair<kl::string, kl::path>> packages_;
};