/// A value of type `T`, or nothing.
enum optional<T>
{
    /// Holds a value.
    some( T value ),
    /// Holds nothing.
    none
};

/// The value `o` holds.
///
/// # Panics
///
/// If `o` is `none`.
T unwrap<T>( move optional<T> o )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            panic( "unwrap on an empty optional" );
    }
}

/// The value `o` holds.
///
/// # Panics
///
/// If `o` is `none`, with `message`.
T expect<T>( move optional<T> o, str message )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            panic( message );
    }
}

/// The value `o` holds, or `fallback` if it is `none`. An unused `fallback` is dropped.
T value_or<T>( move optional<T> o, move T fallback )
{
    switch( move o )
    {
        case optional::some( v ):
            return v;
        case optional::none:
            return fallback;
    }
}

/// Whether `o` holds a value.
bool is_some<T>( const ref optional<T> o )
{
    switch( o )
    {
        case optional::some( v ):
            return true;
        case optional::none:
            return false;
    }
}

/// Whether `o` holds nothing.
bool is_none<T>( const ref optional<T> o )
{
    switch( o )
    {
        case optional::some( v ):
            return false;
        case optional::none:
            return true;
    }
}