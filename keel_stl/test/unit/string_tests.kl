// `kl::string`: `split`, `rfind`, `replace`, trimming and stripping, and `kl::join`. An empty separator
// or pattern panics, so `programs/string_split_empty_separator` and `string_replace_empty_pattern` cover it.
import kl::list;
import kl::optional;
import kl::string;
import kl::test::context;

private void check_split( ref kl::test::context c, str text, str separator, const ref str[] expected )
{
    kl::string s = kl::string::from( text );
    kl::list<kl::string> pieces = s.split( separator );
    c.require( pieces.size() == expected.size );
    for( u64 i : 0..expected.size )
    {
        c.check_eq( pieces.as_run()[i], expected[i] );
    }
}

private void split_gives_the_pieces_between( ref kl::test::context c )
{
    str[3] plain = [ "a", "bc", "d" ];
    check_split( ref c, "a,bc,d", ",", plain );
    str[1] whole = [ "abc" ];
    check_split( ref c, "abc", ",", whole );
}

private void split_keeps_empty_pieces( ref kl::test::context c )
{
    str[3] middle = [ "a", "", "b" ];
    check_split( ref c, "a,,b", ",", middle );
    str[3] trailing = [ "a", "b", "" ];
    check_split( ref c, "a\nb\n", "\n", trailing );
    str[2] leading = [ "", "a" ];
    check_split( ref c, ",a", ",", leading );
    str[1] empty = [ "" ];
    check_split( ref c, "", ",", empty );
}

private void split_on_a_longer_separator( ref kl::test::context c )
{
    str[3] words = [ "a", "b", "c" ];
    check_split( ref c, "a::b::c", "::", words );
    str[2] overlap = [ "", "a" ];
    check_split( ref c, "aaa", "aa", overlap );
    str[1] longer = [ "ab" ];
    check_split( ref c, "ab", "abc", longer );
}

private void check_rfind( ref kl::test::context c, str text, str needle, u64 expected )
{
    kl::string s = kl::string::from( text );
    kl::optional<u64> found = s.rfind( needle );
    c.require( kl::is_some( found ) );
    c.check_eq( kl::unwrap( move found ), expected );
}

private void rfind_finds_the_last( ref kl::test::context c )
{
    check_rfind( ref c, "abc", "a", 0 );
    check_rfind( ref c, "abc", "c", 2 );
    check_rfind( ref c, "a.b.c", ".", 3 );
    check_rfind( ref c, "aaa", "aa", 1 );
    check_rfind( ref c, "abc", "", 3 );
    check_rfind( ref c, "", "", 0 );
    kl::string s = "ab";
    c.check( kl::is_none( s.rfind( "abc" ) ) );
    c.check( kl::is_none( s.rfind( "x" ) ) );
}

private void check_replace( ref kl::test::context c, str text, str pattern, str replacement, str expected )
{
    kl::string s = kl::string::from( text );
    c.check_eq( s.replace( pattern, replacement ), expected );
}

private void replace_every_occurrence( ref kl::test::context c )
{
    check_replace( ref c, "a.b.c", ".", "-", "a-b-c" );
    check_replace( ref c, "abc", "x", "-", "abc" );
    check_replace( ref c, "", "x", "-", "" );
    check_replace( ref c, "aaa", "aa", "b", "ba" );
    check_replace( ref c, "a.b", ".", "::", "a::b" );
    check_replace( ref c, "a::b::", "::", "", "ab" );
    check_replace( ref c, "abab", "ab", "abab", "abababab" );
}

private void check_trims( ref kl::test::context c, str text, str start, str end, str both )
{
    kl::string s = kl::string::from( text );
    c.check_eq( s.trim_start(), start );
    c.check_eq( s.trim_end(), end );
    c.check_eq( s.trim(), both );
}

private void trim_removes_ascii_whitespace( ref kl::test::context c )
{
    check_trims( ref c, "  a b  ", "a b  ", "  a b", "a b" );
    check_trims( ref c, "\t\n\x0B\x0C\r a \t\n\x0B\x0C\r", "a \t\n\x0B\x0C\r", "\t\n\x0B\x0C\r a", "a" );
    check_trims( ref c, "   ", "", "", "" );
    check_trims( ref c, "", "", "", "" );
    check_trims( ref c, "ab", "ab", "ab", "ab" );
}

private void strip_answers_the_rest( ref kl::test::context c )
{
    kl::string s = "--name=value";
    c.check_eq( kl::unwrap( s.strip_prefix( "--name=" ) ), "value" );
    c.check_eq( kl::unwrap( s.strip_suffix( "=value" ) ), "--name" );
    c.check_eq( kl::unwrap( s.strip_prefix( "--name=value" ) ), "" );
    c.check_eq( kl::unwrap( s.strip_suffix( "" ) ), "--name=value" );
    c.check( kl::is_none( s.strip_prefix( "-x" ) ) );
    c.check( kl::is_none( s.strip_suffix( "valu" ) ) );
    c.check( kl::is_none( s.strip_prefix( "--name=value!" ) ) );
}

private void join_puts_the_separator_between( ref kl::test::context c )
{
    str[3] three = [ "a", "b", "c" ];
    c.check_eq( kl::join( three, ", " ), "a, b, c" );
    c.check_eq( kl::join( three, "" ), "abc" );
    str[1] one = [ "a" ];
    c.check_eq( kl::join( one, ", " ), "a" );
    str[2] empties = [ "", "" ];
    c.check_eq( kl::join( empties, "-" ), "-" );

    kl::list<kl::string> none = kl::list<kl::string>();
    c.check_eq( kl::join( none.as_run(), ", " ), "" );
    kl::list<kl::string> owned = kl::list<kl::string>();
    owned.push( "x" );
    owned.push( "yz" );
    c.check_eq( kl::join( owned.as_run(), " " ), "x yz" );
}
