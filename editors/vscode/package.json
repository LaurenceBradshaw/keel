{
    "name": "keel",
    "displayName": "Keel",
    "description": "Keel language support: highlighting and editing rules for .kl files.",
    "version": "0.0.1",
    "publisher": "keel",
    "license": "Apache-2.0 WITH LLVM-exception",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "keel",
                "aliases": [
                    "Keel",
                    "keel"
                ],
                "extensions": [
                    ".kl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "keel",
                "scopeName": "source.keel",
                "path": "./syntaxes/keel.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "storage.modifier.mode.keel",
                        "settings": {
                            "fontStyle": "italic"
                        }
                    }
                ]
            }
        }
    }
}
