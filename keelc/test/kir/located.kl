// `@located` lowers to a hidden last parameter of type `location`. A call from a plain function
// builds one from its own line; one from an `@located` function passes its own on, and
// `panic( message, at )` carries it in the terminator.

@located
void expect( bool ok, str why )
{
    if( !ok )
    {
        panic( why, @caller() );
    }
}

@located
void expect_positive( i64 v )
{
    expect( v > 0, "not positive" );
}

@located
u32 line_of_call()
{
    return @caller().line;
}

@located
T same<T>( move T v )
{
    expect( @caller().line == 52, "wrong line" );
    return v;
}

struct Counter
{
    i32 n;

    @located
    void bump()
    {
        expect( n < 2, "bumped too often" );
        n += 1;
    }
};

i32 main()
{
    if( line_of_call() != 47 )
    {
        return 1;
    }

    if( same<i32>( 3 ) != 3 || !same<bool>( true ) )
    {
        return 2;
    }

    Counter c = Counter { 0 };
    c.bump();
    c.bump();

    expect_positive( 5 );
    expect_positive( -1 );
    return 0;
}
