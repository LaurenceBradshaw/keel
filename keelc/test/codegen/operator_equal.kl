// `a == b` on an aggregate calls `operator==` on the left operand, and `a != b` negates it - on a
// struct, a class, a generic instance, a `const ref` receiver and a temporary on the right.
struct point
{
    i32 x;
    i32 y;

    bool operator==( const ref point other ) const
    {
        return x == other.x && y == other.y;
    }
};

class name
{
    name( u8 c )
    {
        first = c;
    }

    public bool operator==( const ref name other ) const
    {
        return first == other.first;
    }

    private u8 first;
};

class pair<T> where T : Copyable & Equatable
{
    pair( T a, T b )
    {
        left  = a;
        right = b;
    }

    public bool operator==( const ref pair<T> other ) const
    {
        return left == other.left && right == other.right;
    }

    private T left;
    private T right;
};

bool same( const ref name a, const ref name b )
{
    return a == b;
}

i32 main()
{
    point a = point { 1, 2 };
    point b = point { 1, 2 };
    point c = point { 1, 3 };

    if( !( a == b ) || a != b || a == c || !( a != c ) )
    {
        return 1;
    }

    name n = name( 65 );
    name m = name( 65 );

    if( n != m || !same( n, m ) || n == name( 66 ) )
    {
        return 2;
    }

    pair<i32> p = pair<i32>( 1, 2 );

    if( p != pair<i32>( 1, 2 ) || p == pair<i32>( 2, 1 ) )
    {
        return 3;
    }

    return 0;
}
