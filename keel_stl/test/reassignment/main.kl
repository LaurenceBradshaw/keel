// Assigning onto a library type that holds elements destroys them first, once, whatever the
// right side is: another value moved in, a fresh temporary, or the same value moved onto itself.
// Each `owned` holds a heap block, so a missed destroy leaks under valgrind as well as miscounting.
import kl::list;
import kl::ring;
import kl::string;

i32 live;

class owned
{
    owned( u64 n )
    {
        id = n;
        unsafe
        {
            block = alloc<u64>( 1 );
        }
        live += 1;
    }

    ~owned()
    {
        unsafe
        {
            free( block );
        }
        live -= 1;
    }

    public u64 id;
    private u64[*] block;
};

i32 list_onto_full()
{
    kl::list<owned> kept = kl::list<owned>();
    kept.push( move owned( 1 ) );
    kept.push( move owned( 2 ) );
    kl::list<owned> other = kl::list<owned>();
    other.push( move owned( 3 ) );

    kept = move other;
    if( live != 1 || kept.size() != 1 || kept[0].id != 3 )
    {
        return 1;
    }

    kept = kl::list<owned>();
    if( live != 0 || !kept.is_empty() )
    {
        return 2;
    }

    return 0;
}

i32 list_onto_itself()
{
    kl::list<owned> values = kl::list<owned>();
    values.push( move owned( 7 ) );

    values = move values;
    if( live != 1 || values.size() != 1 || values[0].id != 7 )
    {
        return 3;
    }

    return 0;
}

// A zero capacity is an empty list that still grows.
i32 list_zero_capacity()
{
    kl::list<owned> values = kl::list<owned>::with_capacity( 0 );
    if( values.capacity() != 0 )
    {
        return 4;
    }

    values.push( move owned( 1 ) );
    values.push( move owned( 2 ) );
    if( values.capacity() != 2 || live != 2 )
    {
        return 5;
    }

    return 0;
}

// The ring's elements wrap past the end of its block, so destroying them takes both runs.
i32 ring_onto_full()
{
    kl::ring<owned> kept = kl::ring<owned>::with_capacity( 3 );
    kept.push_back( move owned( 1 ) );
    kept.push_back( move owned( 2 ) );
    kept.push_front( move owned( 0 ) );
    kl::ring<owned> other = kl::ring<owned>::with_capacity( 1 );
    other.push_back( move owned( 9 ) );

    kept = move other;
    if( live != 1 || kept.size() != 1 || kept[0].id != 9 )
    {
        return 6;
    }

    kept = kl::ring<owned>::with_capacity( 2 );
    if( live != 0 )
    {
        return 7;
    }

    return 0;
}

i32 strings()
{
    kl::string text = kl::string( "hello" );
    text = kl::string( "world" );
    text = move text;
    if( !( text == kl::string( "world" ) ) )
    {
        return 8;
    }

    text = kl::string::with_capacity( 0 );
    text.push( 65 );
    if( text.size() != 1 )
    {
        return 9;
    }

    return 0;
}

i32 main()
{
    i32 code = list_onto_full();
    if( code == 0 )
    {
        code = list_onto_itself();
    }
    if( code == 0 )
    {
        code = list_zero_capacity();
    }
    if( code == 0 )
    {
        code = ring_onto_full();
    }
    if( code == 0 )
    {
        code = strings();
    }
    if( code == 0 && live != 0 )
    {
        code = 10;
    }

    return code;
}
