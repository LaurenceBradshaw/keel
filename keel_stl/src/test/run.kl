// The runner, which gives each test a process of its own: this program, started again.

import context;
import kl::console;
import kl::list;
import kl::optional;
import kl::os;
import kl::string;

// The runtime's calls.
private extern never kl_rt_exit( i32 code );

// A child's first argument, then the test's place in the list, then for one `expect_panic`
// started, which call it is for (context.kl starts those).
private const str CHILD = "--kl-test-child";

/// A test and the name `run` reports it by.
struct entry
{
    /// Matched by the runner's filters and printed in its report.
    str name;
    /// The test itself.
    fn( ref context ) -> void body;
};

// Whether `name` contains any filter; with none, every test is selected.
private bool selected( str name, const ref kl::list<kl::string> filters )
{
    if( filters.is_empty() )
    {
        return true;
    }

    kl::string text = kl::string::from( name );
    const ref kl::string[] each = filters.as_run();

    for( u64 i : 0..each.size )
    {
        if( kl::is_some( text.find( each[i] ) ) )
        {
            return true;
        }
    }

    return false;
}

// Runs the test at `index` and answers how it ended: 0 passed, 1 a check failed, 134 a panic, or
// 128 and a signal.
private i32 run_one( const ref entry[] tests, u64 index, bool fork )
{
    if( !fork )
    {
        context checks = context( index, 0 );
        tests[index].body( ref checks );
        return checks.failed() ? 1 : 0;
    }

    kl::string program = kl::string();
    switch( kl::program_path() )
    {
        case result::ok( found ):
            program.append( found.as_text() );
            break;
        case result::err( e ):
            panic( "cannot find this program to run a test" );
    }

    kl::string[2] arguments = [ kl::string::from( CHILD ), kl::string::from( index ) ];
    switch( kl::run( program, arguments ) )
    {
        case result::ok( code ):
            return code;
        case result::err( e ):
            panic( "cannot start this program again for a test" );
    }
}

// `text` as a number, or `fallback` when it is not one.
private u64 number_or( str text, u64 fallback )
{
    switch( kl::string::from( text ).parse_i64() )
    {
        case result::ok( n ):
            return n < 0 ? fallback : cast<u64>( n );
        case result::err( e ):
            return fallback;
    }
}

// In a child: the one test, or one `expect_panic`'s body within it, then the end of the program.
private never run_child( const ref entry[] tests, const ref str[] args )
{
    const u64 bad = 0xFFFFFFFFFFFFFFFF;
    const u64 index = number_or( args[1], bad );
    const u64 call = args.size == 3 ? number_or( args[2], bad ) : 0;
    if( args.size > 3 || index >= tests.size || call == bad )
    {
        kl::eprint( "kl::test: a child's arguments are a test and a call" );
        unsafe
        {
            kl_rt_exit( 2 );
        }
    }

    context checks = context( index, call );
    tests[index].body( ref checks );
    unsafe
    {
        kl_rt_exit( checks.failed() ? 1 : 0 );
    }
}

/// Runs the tests that `args` selects, each in a process of its own, and answers `main`'s exit
/// code: 0 when every test passed, 1 when any failed, 2 for an unknown option.
///
/// The process is this program started again with arguments of `run`'s own, so `main` must hand
/// `run` its arguments unchanged, and what `main` does before calling `run` happens in each.
///
/// Each argument is an option or a filter. A test runs when its name contains any filter, or when
/// there is none.
/// - `--list` prints the selected names and runs nothing.
/// - `--no-fork` runs every test in this process, so a `panic` ends the run; for a debugger.
///
/// Each test's result is a line on stdout, `pass <name>` or `FAIL <name>`, then the counts.
i32 run( const ref entry[] tests, const ref str[] args )
{
    if( args.size >= 2 && kl::same_text( args[0], CHILD ) )
    {
        run_child( tests, args );
    }

    bool listing = false;
    bool fork = true;
    kl::list<kl::string> filters = kl::list<kl::string>();

    for( u64 i = 0; i < args.size; i++ )
    {
        kl::string arg = kl::string::from( args[i] );
        if( arg == "--list" )
        {
            listing = true;
        }
        else if( arg == "--no-fork" )
        {
            fork = false;
        }
        else if( arg.starts_with( "--" ) )
        {
            kl::eprint( "unknown option: " + arg );
            return 2;
        }
        else
        {
            filters.push( move arg );
        }
    }

    if( listing )
    {
        for( u64 i : 0..tests.size )
        {
            if( selected( tests[i].name, filters ) )
            {
                kl::print( tests[i].name );
            }
        }
        return 0;
    }

    u64 n_passed = 0;
    u64 n_failed = 0;
    for( u64 i : 0..tests.size )
    {
        if( !selected( tests[i].name, filters ) )
        {
            continue;
        }

        kl::string name = kl::string::from( tests[i].name );
        i32 code = run_one( tests, i, fork );
        if( code == 0 )
        {
            kl::print( "pass " + name );
            n_passed++;
            continue;
        }
        else if( code == 1 )
        {
            kl::print( "FAIL " + name );
        }
        else if( code == 134 )
        {
            kl::print( "FAIL " + name + " (panic)" );
        }
        else if( code >= 128 )
        {
            kl::print( "FAIL " + name + " (signal " + kl::string::from( code - 128 ) + ")" );
        }
        else
        {
            kl::print( "FAIL " + name + " (exit " + kl::string::from( code ) + ")" );
        }
        n_failed++;
    }

    kl::print( kl::string::from( n_passed ) + " passed, " + kl::string::from( n_failed ) + " failed" );
    return n_failed == 0 ? 0 : 1;
}
