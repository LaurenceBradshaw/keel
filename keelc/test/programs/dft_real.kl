// DFTs of real input, planned as loops over the outputs to N / 2, the rest their conjugates; each gives
// what the same loop unmarked gives, forward (I = 1) and inverse (I = 2).

import kl::console;
import kl::math;
import kl::trig;

@real_arithmetic
void solved<u64 N, u64 I>( const ref f64[N] x, ref f64[N] yr, ref f64[N] yi )
{
    for( u64 k = 0; k < N; k += 1 )
    {
        f64 sr = 0.0;
        f64 si = 0.0;
        for( u64 j = 0; j < N; j += 1 )
        {
            const f64 t = ( 2.0 * cast<f64>( I ) - 3.0 ) * 2.0 * kl::pi * cast<f64>( j * k % N ) / cast<f64>( N );
            sr += x[j] * kl::cos( t );
            si += x[j] * kl::sin( t );
        }
        yr[k] = sr;
        yi[k] = si;
    }
}

void naive<u64 N, u64 I>( const ref f64[N] x, ref f64[N] yr, ref f64[N] yi )
{
    for( u64 k = 0; k < N; k += 1 )
    {
        f64 sr = 0.0;
        f64 si = 0.0;
        for( u64 j = 0; j < N; j += 1 )
        {
            const f64 t = ( 2.0 * cast<f64>( I ) - 3.0 ) * 2.0 * kl::pi * cast<f64>( j * k % N ) / cast<f64>( N );
            sr += x[j] * kl::cos( t );
            si += x[j] * kl::sin( t );
        }
        yr[k] = sr;
        yi[k] = si;
    }
}

f64 gap( f64 a, f64 b )
{
    return a > b ? a - b : b - a;
}

bool agrees<u64 N, u64 I>()
{
    f64[N] x = [ 0.0, .. ];
    for( u64 i = 0; i < N; i += 1 )
    {
        x[i] = cast<f64>( i % 7 ) * 0.5 - 1.0;
    }
    f64[N] ar = [ 0.0, .. ];
    f64[N] ai = [ 0.0, .. ];
    f64[N] br = [ 0.0, .. ];
    f64[N] bi = [ 0.0, .. ];
    solved<N, I>( x, ref ar, ref ai );
    naive<N, I>( x, ref br, ref bi );
    for( u64 k = 0; k < N; k += 1 )
    {
        if( gap( ar[k], br[k] ) > 1e-9 || gap( ai[k], bi[k] ) > 1e-9 )
        {
            kl::print( k );
            return false;
        }
    }
    return true;
}

i32 main()
{
    return agrees<256, 1>() && agrees<97, 2>() ? 0 : 1;
}
