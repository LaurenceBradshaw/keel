// Reductions. A sum adds pairwise, as numpy does, so a float's rounding error grows with log n, not n;
// the other reductions run in index order.

/// The total of every element; 0 when there are none.
T sum<T>( const ref T[] a ) where T : numeric
{
    // Inline below 8, where pairwise adds in order too, so a small vector's sum is not a call.
    if( a.size < 8 )
    {
        T total = 0;
        for( u64 i : 0..a.size )
        {
            total += a[i];
        }
        return total;
    }
    return pairwise( start( a ), start( a ), 1, a.size, fn[]( T x, T _ ) -> T { return x; } );
}

/// The sum of `a[i] * b[i]`.
///
/// ### Panics
///
/// If the sizes differ.
T dot<T>( const ref T[] a, const ref T[] b ) where T : numeric
{
    if( a.size != b.size )
    {
        panic( "the shapes differ" );
    }

    if( a.size < 8 )
    {
        T total = 0;
        for( u64 i : 0..a.size )
        {
            total += a[i] * b[i];
        }
        return total;
    }
    return pairwise( start( a ), start( b ), 1, a.size, fn[]( T x, T y ) -> T { return x * y; } );
}

/// The product of every element; 1 when there are none.
T prod<T>( const ref T[] a ) where T : numeric
{
    T total = 1;
    for( u64 i : 0..a.size )
    {
        total *= a[i];
    }
    return total;
}

// The axis kernels read `a` as `outer` by `n` by `inner`, row-major; `dest` is `outer` by `inner`.

/// `dest[o, i]` is `a[o, 0, i]`, `a[o, 1, i]`, ... joined by `op` in index order.
///
/// ### Panics
///
/// If `n` is 0 or the sizes differ.
void fold_axis<T, F>( ref T[] dest, const ref T[] a, u64 outer, u64 n, u64 inner, F op ) where T : copyable, where F : fn( T, T ) -> T
{
    if( n == 0 )
    {
        panic( "the axis is empty" );
    }
    if( a.size != outer * n * inner || dest.size != outer * inner )
    {
        panic( "the shapes differ" );
    }

    for( u64 o : 0..outer )
    {
        for( u64 i : 0..inner )
        {
            dest[o * inner + i] = a[o * n * inner + i];
        }
        for( u64 k : 1..n )
        {
            for( u64 i : 0..inner )
            {
                dest[o * inner + i] = op( dest[o * inner + i], a[( o * n + k ) * inner + i] );
            }
        }
    }
}

/// Every element joined by `op` in index order.
///
/// ### Panics
///
/// If `a` is empty.
T fold<T, F>( const ref T[] a, F op ) where T : copyable, where F : fn( T, T ) -> T
{
    if( a.size == 0 )
    {
        panic( "the array is empty" );
    }

    T[1] d = [a[0]];
    fold_axis( ref d, a, 1, a.size, 1, op );
    return d[0];
}

/// `dest[o, i]` is the first `k` whose `a[o, k, i]` no later element is `better` than.
///
/// ### Panics
///
/// If `n` is 0 or the sizes differ.
void arg_best_axis<T, F>( ref u64[] dest, const ref T[] a, u64 outer, u64 n, u64 inner, F better ) where T : copyable, where F : fn( T, T ) -> bool
{
    if( n == 0 )
    {
        panic( "the axis is empty" );
    }
    if( a.size != outer * n * inner || dest.size != outer * inner )
    {
        panic( "the shapes differ" );
    }

    for( u64 o : 0..outer )
    {
        for( u64 i : 0..inner )
        {
            u64 at = 0;
            for( u64 k : 1..n )
            {
                if( better( a[( o * n + k ) * inner + i], a[( o * n + at ) * inner + i] ) )
                {
                    at = k;
                }
            }
            dest[o * inner + i] = at;
        }
    }
}

/// The index of the first element no later one is `better` than.
///
/// ### Panics
///
/// If `a` is empty.
u64 arg_best<T, F>( const ref T[] a, F better ) where T : copyable, where F : fn( T, T ) -> bool
{
    if( a.size == 0 )
    {
        panic( "the array is empty" );
    }

    u64[1] d = [0];
    arg_best_axis( ref d, a, 1, a.size, 1, better );
    return d[0];
}

/// `a[o, k, i] = op( a[o, k - 1, i], a[o, k, i] )` for each `k` from 1, in place: the running
/// totals for `+`.
///
/// ### Panics
///
/// If the size differs.
void scan_axis<T, F>( ref T[] a, u64 outer, u64 n, u64 inner, F op ) where T : copyable, where F : fn( T, T ) -> T
{
    if( a.size != outer * n * inner )
    {
        panic( "the shapes differ" );
    }

    for( u64 o : 0..outer )
    {
        for( u64 k : 1..n )
        {
            for( u64 i : 0..inner )
            {
                u64 at = ( o * n + k ) * inner + i;
                a[at]  = op( a[at - inner], a[at] );
            }
        }
    }
}

/// `dest[o, i]` is the mean square distance of `a[o, k, i]` from their mean, which is taken
/// first; a NaN when `n` is 0.
///
/// ### Panics
///
/// If the sizes differ.
void variance_axis<T>( ref T[] dest, const ref T[] a, u64 outer, u64 n, u64 inner ) where T : floating
{
    if( a.size != outer * n * inner || dest.size != outer * inner )
    {
        panic( "the shapes differ" );
    }

    const T[*] base = start( a );
    for( u64 o : 0..outer )
    {
        for( u64 i : 0..inner )
        {
            const T[*] first;
            unsafe
            {
                first = base + ( o * n * inner + i );
            }
            T mean  = pairwise( first, first, inner, n, fn[]( T x, T _ ) -> T { return x; } ) / cast<T>( n );
            T total = pairwise(
                first,
                first,
                inner,
                n,
                fn[mean]( T x, T _ ) -> T
                {
                    T d = x - mean;
                    return d * d;
                }
            );
            dest[o * inner + i] = total / cast<T>( n );
        }
    }
}

/// The mean square distance of the elements from their mean; a NaN when there are none.
T variance<T>( const ref T[] a ) where T : floating
{
    T[1] d = [0];
    variance_axis( ref d, a, 1, a.size, 1 );
    return d[0];
}

// The first element's address, through which `pairwise` reads with the size already checked; null for an
// empty run.
private const T[*] start<T>( const ref T[] a )
{
    if( a.size == 0 )
    {
        return nullptr;
    }
    unsafe
    {
        return cast<const T[*]>( &a[0] );
    }
}

// `at( a[j], b[j] )` summed for `j = k * stride`, `k` in `0..n`, pairwise as numpy adds: a run of up to
// 128 in eight running totals joined as a tree, a longer one as its halves' totals, split at a multiple
// of 8. Each of `a` and `b` holds the `n` elements it reads; one range check per run, by the caller, stands
// for the eight a turn would make.
private T pairwise<T, F>( const T[*] a, const T[*] b, u64 stride, u64 n, F at ) where T : numeric, where F : fn( T, T ) -> T
{
    unsafe
    {
        if( n > 128 )
        {
            u64 half = n / 2 - n / 2 % 8;
            return pairwise( a, b, stride, half, at ) + pairwise( a + half * stride, b + half * stride, stride, n - half, at );
        }

        T   total = 0;
        u64 k     = 0;
        if( n >= 8 )
        {
            T r0 = at( a[0], b[0] );
            T r1 = at( a[stride], b[stride] );
            T r2 = at( a[2 * stride], b[2 * stride] );
            T r3 = at( a[3 * stride], b[3 * stride] );
            T r4 = at( a[4 * stride], b[4 * stride] );
            T r5 = at( a[5 * stride], b[5 * stride] );
            T r6 = at( a[6 * stride], b[6 * stride] );
            T r7 = at( a[7 * stride], b[7 * stride] );
            for( k = 8; k + 8 <= n; k += 8 )
            {
                u64 j = k * stride;
                r0 += at( a[j], b[j] );
                r1 += at( a[j + stride], b[j + stride] );
                r2 += at( a[j + 2 * stride], b[j + 2 * stride] );
                r3 += at( a[j + 3 * stride], b[j + 3 * stride] );
                r4 += at( a[j + 4 * stride], b[j + 4 * stride] );
                r5 += at( a[j + 5 * stride], b[j + 5 * stride] );
                r6 += at( a[j + 6 * stride], b[j + 6 * stride] );
                r7 += at( a[j + 7 * stride], b[j + 7 * stride] );
            }
            total = ( ( r0 + r1 ) + ( r2 + r3 ) ) + ( ( r4 + r5 ) + ( r6 + r7 ) );
        }
        for( ; k < n; k += 1 )
        {
            total += at( a[k * stride], b[k * stride] );
        }
        return total;
    }
}
