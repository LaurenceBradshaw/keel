}

/// `kl::pow` of each element of `a` and the matching one of `b`.
ndarray<T> pow<T>( const ref ndarray<T> a, const ref ndarray<T> b ) where T : floating
{
    if( !kernel::equal( a.shape(), b.shape() ) )
    {
        panic( "the shapes differ" );
    }

    return a.map( b, fn[]( T x, T y ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( y ) ) ); } );
}

/// `kl::pow` of each element and `s`: `kl::pow( a, 2.0 )`.
ndarray<T> pow<T>( const ref ndarray<T> a, T s ) where T : floating
{
    return a.map( fn[ s ]( T x ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( s ) ) ); } );
}

/// `kl::atan2` of each element of `y` and the matching one of `x`.
ndarray<T> atan2<T>( const ref ndarray<T> y, const ref ndarray<T> x ) where T : floating
{
    if( !kernel::equal( y.shape(), x.shape() ) )
    {
        panic( "the shapes differ" );
    }

    return y.map( x, fn[]( T b, T a ) { return kernel::narrowed<T>( kl::atan2( cast<f64>( b ), cast<f64>( a ) ) ); } );
}

// The number of elements `shape` holds.
private u64 count( const ref u64[] shape )
{
    u64 n = 1;
    for( u64 d : shape )
    {
        n *= d;
    }
    return n;
}
