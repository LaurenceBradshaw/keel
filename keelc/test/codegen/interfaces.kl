// M9.5: an interface used both ways. Through `const ref Shape`, `ref Shape` and `Shape*` a call goes
// through the implementer's vtable; through `where T : Shape` each instance calls the implementer's
// method directly. A generic implementer gets one vtable per instance. Exits with the failing check.
interface Shape
{
    f64 area() const;
    void grow( f64 by );
};

class Circle implements Shape
{
    f64 r;

    public Circle( f64 radius ) { r = radius; }

    public f64 area() const { return 3.0 * r * r; }
    public void grow( f64 by ) { r = r + by; }
};

struct Square implements Shape
{
    f64 side;

    f64 area() const { return side * side; }
    void grow( f64 by ) { side = side + by; }
};

struct Pair<T> implements Shape where T : copyable
{
    T a;
    T b;

    f64 area() const { return 2.0; }
    void grow( f64 _ ) { }
};

f64 measure( const ref Shape s ) { return s.area(); }

void enlarge( ref Shape s ) { s.grow( 1.0 ); }

f64 through_pointer( Shape* s ) { return s.area(); }

f64 statically<T>( const ref T t ) where T : Shape { return t.area(); }

i32 main()
{
    Circle c = Circle( 1.0 );
    Square q = Square { 2.0 };

    if( measure( c ) != 3.0 ) { return 1; }
    if( measure( q ) != 4.0 ) { return 2; }

    enlarge( ref c );
    enlarge( ref q );

    if( measure( c ) != 12.0 ) { return 3; }
    if( measure( q ) != 9.0 ) { return 4; }

    Shape* p = &q;
    if( through_pointer( p ) != 9.0 ) { return 5; }

    Shape* none = nullptr;
    if( none != nullptr || p == nullptr ) { return 12; }
    if( through_pointer( &c ) != 12.0 ) { return 6; }

    if( statically( c ) != 12.0 ) { return 7; }
    if( statically( q ) != 9.0 ) { return 8; }

    const ref Shape held = c;
    if( held.area() != 12.0 ) { return 9; }

    Pair<i32> two = Pair { 1, 2 };
    if( measure( two ) != 2.0 ) { return 10; }
    if( statically( two ) != 2.0 ) { return 11; }

    return 0;
}
