// Numbers beyond the operators.

/// --- Bits ---

/// The bits of `x`, sign first: `bits_of( 1.0 )` is `0x3FF0000000000000`.
u64 bits_of( f64 x )
{
    unsafe
    {
        return *cast<u64*>( &x );
    }
}

/// The `f64` whose bits are `x`.
f64 from_bits( u64 x )
{
    unsafe
    {
        return *cast<f64*>( &x );
    }
}

/// The bits of `x`, sign first: the `f32` 1.0 has `0x3F800000`.
u32 bits_of( f32 x )
{
    unsafe
    {
        return *cast<u32*>( &x );
    }
}

/// The `f32` whose bits are `x`.
f32 from_bits( u32 x )
{
    unsafe
    {
        return *cast<f32*>( &x );
    }
}

/// --- Trigonometry ---

/// The sine of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN, and `-0.0` stays `-0.0`.
f64 sin( f64 x )
{
    u32 ix = high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e500000 )
        {
            return x;
        }
        return sine_kernel( x, 0.0, false );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    reduction r = reduced( x );
    i32 quadrant = r.n & 3;
    if( quadrant == 0 )
    {
        return sine_kernel( r.hi, r.lo, true );
    }
    if( quadrant == 1 )
    {
        return cosine_kernel( r.hi, r.lo );
    }
    if( quadrant == 2 )
    {
        return -sine_kernel( r.hi, r.lo, true );
    }
    return -cosine_kernel( r.hi, r.lo );
}

/// The cosine of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN.
f64 cos( f64 x )
{
    u32 ix = high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e46a09e )
        {
            return 1.0;
        }
        return cosine_kernel( x, 0.0 );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    reduction r = reduced( x );
    i32 quadrant = r.n & 3;
    if( quadrant == 0 )
    {
        return cosine_kernel( r.hi, r.lo );
    }
    if( quadrant == 1 )
    {
        return -sine_kernel( r.hi, r.lo, true );
    }
    if( quadrant == 2 )
    {
        return -cosine_kernel( r.hi, r.lo );
    }
    return sine_kernel( r.hi, r.lo, true );
}

/// The tangent of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN, and `-0.0` stays `-0.0`.
f64 tan( f64 x )
{
    u32 ix = high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e400000 )
        {
            return x;
        }
        return tangent_kernel( x, 0.0, 1 );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    reduction r = reduced( x );
    return tangent_kernel( r.hi, r.lo, 1 - ( ( r.n & 1 ) << 1 ) );
}

/// The angle in [-π/2, π/2] whose sine is given.
///
/// Within an ulp of the true value. Outside [-1, 1], or at NaN, it is NaN.
f64 asin( f64 x )
{
    u32 hx = high_word( x );
    u32 ix = hx & 0x7fffffff;
    if( ix >= 0x3ff00000 )
    {
        if( ( ( ix - 0x3ff00000 ) | low_word( x ) ) == 0 )
        {
            return x * PIO2_HI + x * PIO2_LO;
        }
        return ( x - x ) / ( x - x );
    }
    if( ix < 0x3fe00000 )
    {
        if( ix < 0x3e500000 )
        {
            return x;
        }
        return x + x * arcsine_ratio( x * x );
    }
    f64 t = ( 1.0 - magnitude( x ) ) * 0.5;
    f64 s = square_root( t );
    f64 angle = 0.0;
    if( ix >= 0x3fef3333 )
    {
        angle = PIO2_HI - ( 2.0 * ( s + s * arcsine_ratio( t ) ) - PIO2_LO );
    }
    else
    {
        f64 w = low_word_cleared( s );
        f64 c = ( t - w * w ) / ( s + w );
        f64 p = 2.0 * s * arcsine_ratio( t ) - ( PIO2_LO - 2.0 * c );
        f64 q = PIO4_HI - 2.0 * w;
        angle = PIO4_HI - ( p - q );
    }
    return ( hx >> 31 ) == 0 ? angle : -angle;
}

/// The angle in [0, π] whose cosine is given.
///
/// Within an ulp of the true value. Outside [-1, 1], or at NaN, it is NaN.
f64 acos( f64 x )
{
    u32 hx = high_word( x );
    u32 ix = hx & 0x7fffffff;
    if( ix >= 0x3ff00000 )
    {
        if( ( ( ix - 0x3ff00000 ) | low_word( x ) ) == 0 )
        {
            return ( hx >> 31 ) == 0 ? 0.0 : PI + 2.0 * PIO2_LO;
        }
        return ( x - x ) / ( x - x );
    }
    if( ix < 0x3fe00000 )
    {
        if( ix <= 0x3c600000 )
        {
            return PIO2_HI + PIO2_LO;
        }
        return PIO2_HI - ( x - ( PIO2_LO - x * arcsine_ratio( x * x ) ) );
    }
    if( ( hx >> 31 ) != 0 )
    {
        f64 z = ( 1.0 + x ) * 0.5;
        f64 s = square_root( z );
        f64 w = arcsine_ratio( z ) * s - PIO2_LO;
        return PI - 2.0 * ( s + w );
    }
    f64 z = ( 1.0 - x ) * 0.5;
    f64 s = square_root( z );
    f64 df = low_word_cleared( s );
    f64 c = ( z - df * df ) / ( s + df );
    f64 w = arcsine_ratio( z ) * s + c;
    return 2.0 * ( df + w );
}

/// The angle in [-π/2, π/2] whose tangent is given.
///
/// Within an ulp of the true value. NaN gives NaN, and `-0.0` stays `-0.0`.
f64 atan( f64 x )
{
    u32 hx = high_word( x );
    u32 ix = hx & 0x7fffffff;
    bool negative = ( hx >> 31 ) != 0;
    if( ix >= 0x44100000 )
    {
        if( ix > 0x7ff00000 || ( ix == 0x7ff00000 && low_word( x ) != 0 ) )
        {
            return x + x;
        }
        return negative ? -ATANHI[3] - ATANLO[3] : ATANHI[3] + ATANLO[3];
    }
    i32 id = -1;
    if( ix < 0x3fdc0000 )
    {
        if( ix < 0x3e400000 )
        {
            return x;
        }
    }
    else
    {
        x = magnitude( x );
        if( ix < 0x3ff30000 )
        {
            if( ix < 0x3fe60000 )
            {
                id = 0;
                x = ( 2.0 * x - 1.0 ) / ( 2.0 + x );
            }
            else
            {
                id = 1;
                x = ( x - 1.0 ) / ( x + 1.0 );
            }
        }
        else if( ix < 0x40038000 )
        {
            id = 2;
            x = ( x - 1.5 ) / ( 1.0 + 1.5 * x );
        }
        else
        {
            id = 3;
            x = -1.0 / x;
        }
    }
    f64 z = x * x;
    f64 w = z * z;
    f64 s1 = z * ( AT[0] + w * ( AT[2] + w * ( AT[4] + w * ( AT[6] + w * ( AT[8] + w * AT[10] ) ) ) ) );
    f64 s2 = w * ( AT[1] + w * ( AT[3] + w * ( AT[5] + w * ( AT[7] + w * AT[9] ) ) ) );
    if( id < 0 )
    {
        return x - x * ( s1 + s2 );
    }
    f64 angle = ATANHI[at( id, 4 )] - ( ( x * ( s1 + s2 ) - ATANLO[at( id, 4 )] ) - x );
    return negative ? -angle : angle;
}

// sin on [-π/4, π/4] of `x + y`, `y` the tail of `x` when `tail`.
private f64 sine_kernel( f64 x, f64 y, bool tail )
{
    f64 z = x * x;
    f64 w = z * z;
    f64 r = S2 + z * ( S3 + z * S4 ) + z * w * ( S5 + z * S6 );
    f64 v = z * x;
    if( !tail )
    {
        return x + v * ( S1 + z * r );
    }
    return x - ( ( z * ( 0.5 * y - v * r ) - y ) - v * S1 );
}

// cos on [-π/4, π/4] of `x + y`.
private f64 cosine_kernel( f64 x, f64 y )
{
    f64 z = x * x;
    f64 w = z * z;
    f64 r = z * ( C1 + z * ( C2 + z * C3 ) ) + w * w * ( C4 + z * ( C5 + z * C6 ) );
    f64 hz = 0.5 * z;
    w = 1.0 - hz;
    return w + ( ( ( 1.0 - w ) - hz ) + ( z * r - x * y ) );
}

// tan on [-π/4, π/4] of `x + y` when `iy` is 1, and -1/tan when it is -1.
private f64 tangent_kernel( f64 x, f64 y, i32 iy )
{
    u32 hx = high_word( x );
    bool big = ( hx & 0x7fffffff ) >= 0x3fe59428;
    if( big )
    {
        if( ( hx >> 31 ) != 0 )
        {
            x = -x;
            y = -y;
        }
        x = ( PIO4 - x ) + ( PIO4LO - y );
        y = 0.0;
    }
    f64 z = x * x;
    f64 w = z * z;
    f64 r = T[1] + w * ( T[3] + w * ( T[5] + w * ( T[7] + w * ( T[9] + w * T[11] ) ) ) );
    f64 v = z * ( T[2] + w * ( T[4] + w * ( T[6] + w * ( T[8] + w * ( T[10] + w * T[12] ) ) ) ) );
    f64 s = z * x;
    r = y + z * ( s * ( r + v ) + y );
    r += T[0] * s;
    w = x + r;
    if( big )
    {
        v = cast<f64>( iy );
        return ( ( hx >> 31 ) != 0 ? -1.0 : 1.0 ) * ( v - 2.0 * ( x - ( w * w / ( w + v ) - r ) ) );
    }
    if( iy == 1 )
    {
        return w;
    }
    // -1/w to full accuracy
    z = low_word_cleared( w );
    v = r - ( z - x );
    f64 a = -1.0 / w;
    f64 t = low_word_cleared( a );
    s = 1.0 + t * z;
    return t + a * ( s + t * v );
}

// p/q for asin and acos.
private f64 arcsine_ratio( f64 t )
{
    f64 p = t * ( PS0 + t * ( PS1 + t * ( PS2 + t * ( PS3 + t * ( PS4 + t * PS5 ) ) ) ) );
    f64 q = 1.0 + t * ( QS1 + t * ( QS2 + t * ( QS3 + t * QS4 ) ) );
    return p / q;
}

// `x` less the nearest multiple `n` of π/2, as `hi + lo`; `|x|` is past π/4 and finite or not.
private struct reduction
{
    i32 n;
    f64 hi;
    f64 lo;
};

private reduction reduced( f64 x )
{
    u32 ix = high_word( x ) & 0x7fffffff;
    bool negative = ( high_word( x ) >> 31 ) != 0;
    // Up to 9π/4, one or two steps of a fixed multiple, unless x is near one and cancels.
    if( ix <= 0x400f6a7a )
    {
        if( ( ix & 0xfffff ) != 0x921fb )
        {
            return near_multiple( x, negative, ix <= 0x4002d97c ? 1 : 2 );
        }
    }
    else if( ix <= 0x401c463b )
    {
        if( ix <= 0x4015fdbc )
        {
            if( ix != 0x4012d97c )
            {
                return near_multiple( x, negative, 3 );
            }
        }
        else if( ix != 0x401921fb )
        {
            return near_multiple( x, negative, 4 );
        }
    }
    if( ix < 0x413921fb )
    {
        return medium( x, ix );
    }
    if( ix >= 0x7ff00000 )
    {
        return reduction { 0, x - x, x - x };
    }
    // Large: |x| as three 24-bit pieces, scaled so the first is [2^23, 2^24).
    i32 e0 = wrap<i32>( ix >> 20 ) - 1046;
    f64 z = from_bits( ( cast<u64>( ( ix & 0xfffff ) | 0x41600000 ) << 32 ) | ( bits_of( x ) & 0xffffffff ) );
    f64[4] tx = [ 0.0, .. ];
    for( u64 i = 0; i < 2; i++ )
    {
        tx[i] = truncated( z );
        z = ( z - tx[i] ) * TWO24;
    }
    tx[2] = z;
    i32 nx = 3;
    while( tx[at( nx - 1, 4 )] == 0.0 )
    {
        nx--;
    }
    reduction r = reduced_large( tx, e0, nx );
    if( negative )
    {
        return reduction { -r.n, -r.hi, -r.lo };
    }
    return r;
}

private reduction near_multiple( f64 x, bool negative, i32 k )
{
    f64 m = cast<f64>( k );
    if( !negative )
    {
        f64 z = x - m * PIO2_1;
        f64 hi = z - m * PIO2_1T;
        return reduction { k, hi, ( z - hi ) - m * PIO2_1T };
    }
    f64 z = x + m * PIO2_1;
    f64 hi = z + m * PIO2_1T;
    return reduction { -k, hi, ( z - hi ) + m * PIO2_1T };
}

// Cody–Waite, |x| below 2^20·π/2, in up to three rounds of 33 bits of π/2.
private reduction medium( f64 x, u32 ix )
{
    f64 rounded = x * INVPIO2 + TOINT;
    f64 k = rounded - TOINT;
    i32 n = wrap<i32>( bits_of( rounded ) );
    f64 r = x - k * PIO2_1;
    f64 w = k * PIO2_1T;
    i32 j = wrap<i32>( ix >> 20 );
    f64 hi = r - w;
    if( j - exponent_of( hi ) > 16 )
    {
        f64 t = r;
        w = k * PIO2_2;
        r = t - w;
        w = k * PIO2_2T - ( ( t - r ) - w );
        hi = r - w;
        if( j - exponent_of( hi ) > 49 )
        {
            t = r;
            w = k * PIO2_3;
            r = t - w;
            w = k * PIO2_3T - ( ( t - r ) - w );
            hi = r - w;
        }
    }
    return reduction { n, hi, ( r - hi ) - w };
}

// Payne–Hanek: `x` is |x| in `nx` 24-bit pieces, scaled by 2^-e0, multiplied by enough bits of 2/π.
private reduction reduced_large( const ref f64[4] x, i32 e0, i32 nx )
{
    i32 jk = 4;
    i32 jp = jk;
    i32 jx = nx - 1;
    i32 jv = ( e0 - 3 ) / 24;
    if( jv < 0 )
    {
        jv = 0;
    }
    i32 q0 = e0 - 24 * ( jv + 1 );

    f64[32] f = [ 0.0, .. ];
    f64[32] fq = [ 0.0, .. ];
    f64[32] q = [ 0.0, .. ];
    i32[32] iq = [ 0, .. ];

    i32 j = jv - jx;
    for( i32 i = 0; i <= jx + jk; i++ )
    {
        f[at( i, 32 )] = j < 0 ? 0.0 : cast<f64>( IPIO2[at( j, 128 )] );
        j++;
    }
    for( i32 i = 0; i <= jk; i++ )
    {
        f64 product = 0.0;
        for( i32 k = 0; k <= jx; k++ )
        {
            product += x[at( k, 4 )] * f[at( jx + i - k, 32 )];
        }
        q[at( i, 32 )] = product;
    }

    i32 jz = jk;
    i32 n = 0;
    i32 ih = 0;
    f64 z = 0.0;
    while( true )
    {
        // q[] into 24-bit pieces iq[], last first
        z = q[at( jz, 32 )];
        i32 i = 0;
        for( i32 jj = jz; jj > 0; jj-- )
        {
            f64 high = truncated( TWON24 * z );
            iq[at( i, 32 )] = whole( z - TWO24 * high );
            z = q[at( jj - 1, 32 )] + high;
            i++;
        }
        z = scaled( z, q0 );
        z -= 8.0 * truncated( z * 0.125 );
        n = whole( truncated( z ) );
        z -= cast<f64>( n );
        ih = 0;
        if( q0 > 0 )
        {
            i32 top = iq[at( jz - 1, 32 )] >> ( 24 - q0 );
            n += top;
            iq[at( jz - 1, 32 )] -= top << ( 24 - q0 );
            ih = iq[at( jz - 1, 32 )] >> ( 23 - q0 );
        }
        else if( q0 == 0 )
        {
            ih = iq[at( jz - 1, 32 )] >> 23;
        }
        else if( z >= 0.5 )
        {
            ih = 2;
        }
        if( ih > 0 )
        {
            // the fraction past one half: 1 - q
            n += 1;
            bool carry = false;
            for( i32 k = 0; k < jz; k++ )
            {
                i32 piece = iq[at( k, 32 )];
                if( carry )
                {
                    iq[at( k, 32 )] = 0xffffff - piece;
                }
                else if( piece != 0 )
                {
                    carry = true;
                    iq[at( k, 32 )] = 0x1000000 - piece;
                }
            }
            if( q0 == 1 )
            {
                iq[at( jz - 1, 32 )] &= 0x7fffff;
            }
            else if( q0 == 2 )
            {
                iq[at( jz - 1, 32 )] &= 0x3fffff;
            }
            if( ih == 2 )
            {
                z = 1.0 - z;
                if( carry )
                {
                    z -= scaled( 1.0, q0 );
                }
            }
        }
        if( z != 0.0 )
        {
            break;
        }
        i32 any = 0;
        for( i32 k = jz - 1; k >= jk; k-- )
        {
            any |= iq[at( k, 32 )];
        }
        if( any != 0 )
        {
            break;
        }
        // every piece past jk cancelled: take more terms of 2/π
        i32 more = 1;
        while( iq[at( jk - more, 32 )] == 0 )
        {
            more++;
        }
        for( i32 k = jz + 1; k <= jz + more; k++ )
        {
            f[at( jx + k, 32 )] = cast<f64>( IPIO2[at( jv + k, 128 )] );
            f64 product = 0.0;
            for( i32 m = 0; m <= jx; m++ )
            {
                product += x[at( m, 4 )] * f[at( jx + k - m, 32 )];
            }
            q[at( k, 32 )] = product;
        }
        jz += more;
    }

    if( z == 0.0 )
    {
        jz -= 1;
        q0 -= 24;
        while( iq[at( jz, 32 )] == 0 )
        {
            jz--;
            q0 -= 24;
        }
    }
    else
    {
        z = scaled( z, -q0 );
        if( z >= TWO24 )
        {
            f64 high = truncated( TWON24 * z );
            iq[at( jz, 32 )] = whole( z - TWO24 * high );
            jz += 1;
            q0 += 24;
            iq[at( jz, 32 )] = whole( high );
        }
        else
        {
            iq[at( jz, 32 )] = whole( truncated( z ) );
        }
    }

    f64 scale = scaled( 1.0, q0 );
    for( i32 i = jz; i >= 0; i-- )
    {
        q[at( i, 32 )] = scale * cast<f64>( iq[at( i, 32 )] );
        scale *= TWON24;
    }
    for( i32 i = jz; i >= 0; i-- )
    {
        f64 product = 0.0;
        for( i32 k = 0; k <= jp && k <= jz - i; k++ )
        {
            product += PIO2[at( k, 8 )] * q[at( i + k, 32 )];
        }
        fq[at( jz - i, 32 )] = product;
    }
    f64 sum = 0.0;
    for( i32 i = jz; i >= 0; i-- )
    {
        sum += fq[at( i, 32 )];
    }
    f64 hi = ih == 0 ? sum : -sum;
    sum = fq[0] - sum;
    for( i32 i = 1; i <= jz; i++ )
    {
        sum += fq[at( i, 32 )];
    }
    return reduction { n & 7, hi, ih == 0 ? sum : -sum };
}

// The square root of a positive normal `x`, rounded to nearest: digit by digit, so slow but exact.
private f64 square_root( f64 x )
{
    u64 b = bits_of( x );
    i64 k = wrap<i64>( b >> 52 ) - 1075;
    u64 f = ( b & 0x000f_ffff_ffff_ffff ) | 0x0010_0000_0000_0000;
    if( ( k & 1 ) != 0 )
    {
        f = f << 1;
        k -= 1;
    }
    // x is f·2^k, k even and f below 2^54; q is the root of f·2^54 truncated, one bit past the 53 kept.
    u64 q = 0;
    u64 rest = 0;
    for( u64 i = 0; i < 54; i++ )
    {
        rest = ( rest << 2 ) | ( i < 27 ? ( f >> ( 52 - 2 * i ) ) & 3 : cast<u64>( 0 ) );
        u64 trial = ( q << 2 ) | 1;
        q = q << 1;
        if( rest >= trial )
        {
            rest -= trial;
            q = q | 1;
        }
    }
    // An exact root has at most 27 bits, so the extra bit is never a tie.
    return from_bits( ( wrap<u64>( k / 2 + 1048 ) << 52 ) + ( q >> 1 ) + ( q & 1 ) );
}

private u32 high_word( f64 x )
{
    return wrap<u32>( bits_of( x ) >> 32 );
}

private u32 low_word( f64 x )
{
    return wrap<u32>( bits_of( x ) );
}

private f64 low_word_cleared( f64 x )
{
    return from_bits( bits_of( x ) & 0xffff_ffff_0000_0000 );
}

private f64 magnitude( f64 x )
{
    return from_bits( bits_of( x ) & 0x7fff_ffff_ffff_ffff );
}

private i32 exponent_of( f64 x )
{
    return wrap<i32>( ( high_word( x ) >> 20 ) & 0x7ff );
}

// `x` times 2^n, for |n| below 1000.
private f64 scaled( f64 x, i32 n )
{
    return x * from_bits( wrap<u64>( n + 1023 ) << 52 );
}

// The whole part of `x`, which is at least 0 and below 2^52.
private f64 truncated( f64 x )
{
    f64 t = ( x + TWO52 ) - TWO52;
    return t > x ? t - 1.0 : t;
}

// A whole `x`, at least 0 and below 2^31, as an integer.
private i32 whole( f64 x )
{
    return wrap<i32>( bits_of( x + TWO52 ) );
}

// `i` below a power-of-two `size`, masked so the index needs no bounds check.
private u64 at( i32 i, u64 size )
{
    return wrap<u64>( i ) & ( size - 1 );
}

