// A call whose type argument can't be deduced reports that, not an ambiguous outer call.
import t::console;

interface U { i32 f() const; };

implements U for i32 { i32 f() const { return this + 1; } };

i32 through_bound<T>( T x ) where T : U & copyable { return x.f(); }

i32 main()
{
    t::println( through_bound( 4 ) ); // error
    return 0;
}
