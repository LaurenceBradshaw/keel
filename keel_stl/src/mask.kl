// What the array types' comparisons answer: one bit per element, in the array's shape.

import kl::_core::bits as kernel;
import kl::_core::compare as kernel;
import kl::_core::elementwise as kernel;
import bitset;
import list;

/// One bit per element of an `ndarray`, in a shape set at run time, held row-major.
///
/// `&`, `|`, `^` and `~` combine masks bit by bit, and two masks of different shapes panic.
/// `kl::select( m, a, b )` picks between two arrays by one, and `a.selected( m )` keeps the
/// elements of `a` it sets.
class mask
{
    list<u64> words_;
    list<u64> shape_;
    u64       size_;

    /// Every bit clear, in `shape`. No shape is rank 0, one bit.
    public mask( u64... shape )
    {
        shape_ = list<u64>::with_capacity( shape.size );
        size_  = 1;
        for( u64 d : shape )
        {
            shape_.push( d );
            size_ *= d;
        }

        u64 n  = ( size_ + 63 ) / 64;
        words_ = list<u64>::with_capacity( n );
        for( u64 k : 0..n )
        {
            words_.push( 0 );
        }
    }

    /// A second mask with the same bits.
    public mask copy() const
    {
        mask r = mask( shape_.as_run() );
        kernel::zip_into( ref r.words_.as_run(), words_.as_run(), fn[]( u64 _, u64 y ) { return y; } );
        return r;
    }

    /// --- Shape and bits ---

    /// The length of each dimension.
    public const ref u64[] shape() const
    {
        return shape_.as_run();
    }

    /// The number of dimensions.
    public u64 rank() const
    {
        return shape_.size();
    }

    /// The number of bits.
    public u64 size() const
    {
        return size_;
    }

    /// The bit at `index`, one per dimension. Panics on another count or an index outside its
    /// dimension.
    public bool at( u64... index ) const
    {
        if( index.size != shape_.size() )
        {
            panic( "the index count differs from the rank" );
        }

        u64 flat = 0;
        for( u64 k : 0..index.size )
        {
            if( index[k] >= shape_[k] )
            {
                panic( "index out of range" );
            }
            flat = flat * shape_[k] + index[k];
        }
        return kernel::test( words_.as_run(), flat );
    }

    /// The bit at `i`, counted row-major. Panics when `i` is not less than `size()`.
    public bool test( u64 i ) const
    {
        if( i >= size_ )
        {
            panic( "index out of range" );
        }
        return kernel::test( words_.as_run(), i );
    }

    /// Sets the bit at `i`, counted row-major, if `on`, and clears it otherwise. Panics when `i`
    /// is not less than `size()`.
    public void assign( u64 i, bool on )
    {
        if( i >= size_ )
        {
            panic( "index out of range" );
        }
        kernel::assign( ref words_.as_run(), i, on );
    }

    /// --- The whole mask ---

    /// The number of bits set.
    public u64 count() const
    {
        return kernel::count( words_.as_run(), size_ );
    }

    /// Whether any bit is set.
    public bool any() const
    {
        return kernel::any( words_.as_run(), size_ );
    }

    /// Whether every bit is set; true when there are none.
    public bool all() const
    {
        return kernel::all( words_.as_run(), size_ );
    }

    /// Whether `o` has this shape and the same bits set.
    public bool operator==( const ref mask o ) const
    {
        return kernel::equal( shape_.as_run(), o.shape_.as_run() ) && kernel::equal( words_.as_run(), o.words_.as_run(), size_ );
    }

    /// The bits set in both.
    public mask operator&( const ref mask o ) const
    {
        mask r = combined( o );
        kernel::zip_into( ref r.words_.as_run(), o.words_.as_run(), fn[]( u64 x, u64 y ) { return x & y; } );
        return r;
    }

    /// The bits set in either.
    public mask operator|( const ref mask o ) const
    {
        mask r = combined( o );
        kernel::zip_into( ref r.words_.as_run(), o.words_.as_run(), fn[]( u64 x, u64 y ) { return x | y; } );
        return r;
    }

    /// The bits set in exactly one.
    public mask operator^( const ref mask o ) const
    {
        mask r = combined( o );
        kernel::zip_into( ref r.words_.as_run(), o.words_.as_run(), fn[]( u64 x, u64 y ) { return x ^ y; } );
        return r;
    }

    /// Every bit flipped.
    public mask operator~() const
    {
        mask r = copy();
        kernel::map_into( ref r.words_.as_run(), fn[]( u64 x ) { return ~x; } );
        return r;
    }

    /// --- Internals ---

    // A copy, after checking that `o` has this shape.
    private mask combined( const ref mask o ) const
    {
        if( !kernel::equal( shape_.as_run(), o.shape_.as_run() ) )
        {
            panic( "the shapes differ" );
        }
        return copy();
    }
};

/// One bit per element of a `vec<T, N>`: what its comparisons answer.
///
/// `&`, `|`, `^` and `~` combine masks bit by bit. `kl::vec_mask<3> {}` has every bit clear.
struct vec_mask<u64 N>
{
    /// The bits, bit `i` for element `i`.
    bitset<N> bits = bitset<N> {};

    /// The number of bits, `N`.
    u64 size() const
    {
        return N;
    }

    /// The bit for element `i`, which panics outside `size()`.
    bool at( u64 i ) const
    {
        return bits.test( i );
    }

    /// The number of bits set.
    u64 count() const
    {
        return bits.count();
    }

    /// Whether any bit is set.
    bool any() const
    {
        return bits.any();
    }

    /// Whether every bit is set.
    bool all() const
    {
        return bits.all();
    }

    /// Whether the same bits are set.
    bool operator==( const ref vec_mask<N> o ) const
    {
        return bits == o.bits;
    }

    /// The bits set in both.
    vec_mask<N> operator&( const ref vec_mask<N> o ) const
    {
        return vec_mask<N> { bits & o.bits };
    }

    /// The bits set in either.
    vec_mask<N> operator|( const ref vec_mask<N> o ) const
    {
        return vec_mask<N> { bits | o.bits };
    }

    /// The bits set in exactly one.
    vec_mask<N> operator^( const ref vec_mask<N> o ) const
    {
        return vec_mask<N> { bits ^ o.bits };
    }

    /// Every bit flipped.
    vec_mask<N> operator~() const
    {
        return vec_mask<N> { ~bits };
    }
};

/// One bit per element of a `mat<T, R, C>`, row after row: what its comparisons answer.
///
/// `&`, `|`, `^` and `~` combine masks bit by bit. `kl::mat_mask<2, 3> {}` has every bit clear.
struct mat_mask<u64 R, u64 C>
{
    /// The bits, bit `r * C + c` for row `r`, column `c`.
    bitset<(R * C)> bits = bitset<(R * C)> {};

    /// The number of rows, `R`.
    u64 rows() const
    {
        return R;
    }

    /// The number of columns, `C`.
    u64 cols() const
    {
        return C;
    }

    /// The number of bits, `R * C`.
    u64 size() const
    {
        return R * C;
    }

    /// The bit for row `r`, column `c`, which panics outside the shape.
    bool at( u64 r, u64 c ) const
    {
        if( r >= R || c >= C )
        {
            panic( "index out of range" );
        }

        return bits.test( r * C + c );
    }

    /// The number of bits set.
    u64 count() const
    {
        return bits.count();
    }

    /// Whether any bit is set.
    bool any() const
    {
        return bits.any();
    }

    /// Whether every bit is set.
    bool all() const
    {
        return bits.all();
    }

    /// Whether the same bits are set.
    bool operator==( const ref mat_mask<R, C> o ) const
    {
        return bits == o.bits;
    }

    /// The bits set in both.
    mat_mask<R, C> operator&( const ref mat_mask<R, C> o ) const
    {
        return mat_mask<R, C> { bits & o.bits };
    }

    /// The bits set in either.
    mat_mask<R, C> operator|( const ref mat_mask<R, C> o ) const
    {
        return mat_mask<R, C> { bits | o.bits };
    }

    /// The bits set in exactly one.
    mat_mask<R, C> operator^( const ref mat_mask<R, C> o ) const
    {
        return mat_mask<R, C> { bits ^ o.bits };
    }

    /// Every bit flipped.
    mat_mask<R, C> operator~() const
    {
        return mat_mask<R, C> { ~bits };
    }
};
