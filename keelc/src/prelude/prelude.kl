// Declared in every program, which sees them without an import.

/// Text: a run of bytes and their count.
///
/// A string literal is a `str`, and only a literal makes one. Its `size` counts the bytes after
/// escapes are decoded, a `\0` included.
class str
{
    /// The first byte.
    public const u8[*] const data;
    /// How many bytes there are.
    public const u64 size;

    private str( const u8[*] const data, const u64 size )
    {
        this.data = data;
        this.size = size;
    }
};

extern void kl_rt_write( i32 stream, const u8[*] data, u64 size );
extern void kl_rt_write_i64( i32 stream, i64 value );
extern void kl_rt_write_u64( i32 stream, u64 value );
extern void kl_rt_write_f64( i32 stream, f64 value );

/// Writes text to standard output, ending no line.
void print( str s )
{
    unsafe
    {
        kl_rt_write( 1, s.data, s.size );
    }
}

/// Writes an integer in decimal.
void print( i64 value )
{
    unsafe
    {
        kl_rt_write_i64( 1, value );
    }
}

/// Writes an integer in decimal.
void print( u64 value )
{
    unsafe
    {
        kl_rt_write_u64( 1, value );
    }
}

/// Writes a float in the fewest digits that read back as the same value.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void print( f64 value )
{
    unsafe
    {
        kl_rt_write_f64( 1, value );
    }
}

/// Writes `true` or `false`.
void print( bool value )
{
    print( value ? "true" : "false" );
}

/// Writes text to standard error, ending no line.
///
/// Standard output is flushed first, so what both show stays in order.
void eprint( str s )
{
    unsafe
    {
        kl_rt_write( 2, s.data, s.size );
    }
}

/// Writes an integer in decimal.
void eprint( i64 value )
{
    unsafe
    {
        kl_rt_write_i64( 2, value );
    }
}

/// Writes an integer in decimal.
void eprint( u64 value )
{
    unsafe
    {
        kl_rt_write_u64( 2, value );
    }
}

/// Writes a float in the fewest digits that read back as the same value.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void eprint( f64 value )
{
    unsafe
    {
        kl_rt_write_f64( 2, value );
    }
}

/// Writes `true` or `false`.
void eprint( bool value )
{
    eprint( value ? "true" : "false" );
}

/// Writes text and then a newline, as `print` does.
void println( str s )
{
    print( s );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( i64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( u64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( f64 value )
{
    print( value );
    print( "\n" );
}

/// Writes a value and then a newline, as `print` does.
void println( bool value )
{
    print( value );
    print( "\n" );
}

/// Writes text and then a newline, as `eprint` does.
void eprintln( str s )
{
    eprint( s );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( i64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( u64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( f64 value )
{
    eprint( value );
    eprint( "\n" );
}

/// Writes a value and then a newline, as `eprint` does.
void eprintln( bool value )
{
    eprint( value );
    eprint( "\n" );
}

/// The outcome of something that can fail: a `T`, or an `E` saying why not.
///
/// `try` takes the value out of an `ok`, or returns an `err` from the function it is in. A
/// `result` left unused is refused; `_ = f();` discards one on purpose.
enum result<T, E>
{
    /// Succeeded, with a value.
    ok( T value ),
    /// Failed, with why.
    err( E error )
};
