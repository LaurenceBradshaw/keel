import list;

class string
{
    string() 
    {
        bytes = list<u8>();
    }

    string( str text )
    {
        bytes = list<u8>::with_capacity( text.size );
        for( u64 i = 0; i < text.size; i++ )
        {
            unsafe
            {
                bytes.push( text.data[ i ] );
            }
        }
    }

    public static string with_capacity( u64 capacity )
    {
        string result = string();
        result.bytes = list<u8>::with_capacity( capacity );
        return result;
    }

    public void push( u8 value )
    {
        bytes.push( value );
    }

    public void append( const ref string other )
    {
        for( u64 i = 0; i < other.size(); i++ )
        {
            bytes.push( other[i] );
        }
    }

    public const u8* operator[]( u64 index ) const
    {
        return &bytes[index];
    }

    public u64 size() const
    {
        return bytes.size();
    }

    public bool is_empty() const
    {
        return bytes.is_empty();
    }

    public bool operator==( const ref string other ) const
    {
        if( size() != other.size() )
        {
            return false;
        }

        for( u64 i = 0; i < size(); i++ )
        {
            if( bytes[i] != other[i] )
            {
                return false;
            }
        }

        return true;
    }

    private list<u8> bytes;
};