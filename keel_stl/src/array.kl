    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::round( cast<f64>( x ) ) ); } );
}

/// `kl::pow` of each element and the matching one of `b`, the two broadcast.
array<T, broadcast( S, U )...> pow<T, u64... S, u64... U>( const ref array<T, S...> a, const ref array<T, U...> b ) where T : floating
{
    return a.zipped( b, fn[]( T x, T y ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( y ) ) ); } );
}

/// `kl::pow` of each element and `s`: `kl::pow( a, 2.0 )`.
array<T, S...> pow<T, u64... S>( const ref array<T, S...> a, T s ) where T : floating
{
    return a.map( fn[ s ]( T x ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( s ) ) ); } );
}

/// `kl::atan2` of each element of `y` and the matching one of `x`, the two broadcast.
array<T, broadcast( S, U )...> atan2<T, u64... S, u64... U>( const ref array<T, S...> y, const ref array<T, U...> x ) where T : floating
{
    return y.zipped( x, fn[]( T b, T a ) { return kernel::narrowed<T>( kl::atan2( cast<f64>( b ), cast<f64>( a ) ) ); } );
}

