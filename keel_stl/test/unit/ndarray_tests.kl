// `kl::ndarray`: building at constant and `dyn` sizes, indexing, the operators and broadcasting,
// products and linear algebra, comparing and masks, the three forms of each reduction, changing
// the shape, slices and windows, sorting, converting, the scalar maths, walking, mixing constant
// and `dyn` sizes, the integer operators, norms that neither overflow nor underflow, and masks at
// the word edges; the NaN-skipping reductions, gathering and putting by index, and interp.
import kl::math;
import kl::ndarray;
import kl::optional;
import kl::pair;
import kl::test::context;

private void building( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::zeros( 2, 3 );
    c.check_eq( a.size(), 6 );
    c.check_eq( a.rank(), 2 );
    c.check_eq( a.rows(), 2 );
    c.check_eq( a.cols(), 3 );
    c.check_eq( a.sum(), 0 );

    // A value the program reads is `dyn`; the rest stay constants.
    u64                    rows = 4;
    kl::ndarray<f64, dyn, 3> d    = kl::filled( 0.5, rows, 3 );
    c.check_eq( d.size(), 12 );
    c.check_eq( d.extent( 0 ), 4 );
    c.check_eq( d.sum(), 6.0 );

    kl::ndarray<i32, 2, 2> m = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    c.check( m == kl::ndarray<i32, 2, 2>::of( [ 1, 2, 3, 4 ] ) );
    c.check( kl::of( [ 1, 2, 3 ] ) == kl::shaped( [ 1, 2, 3 ], 3 ) );
    c.check( kl::ndarray<i32, 2>::ones() == kl::of( [ 1, 1 ] ) );

    kl::ndarray<i32, 3, 3> eye = kl::eye( 3, 3 );
    c.check_eq( eye.trace(), 3 );
    c.check( kl::arange( 0, 5 ).as_shape<5>() == kl::of( [ 0, 1, 2, 3, 4 ] ) );
    kl::ndarray<f64, 3> l = kl::linspace( 0.0, 1.0, 3 );
    c.check( l == kl::of( [ 0.0, 0.5, 1.0 ] ) );

    // Past the inline limit, or `dyn`, the elements are on the heap; nothing else changes.
    kl::ndarray<f64, 600> big = kl::zeros( 600 );
    big[599]                = 2.0;
    kl::ndarray<f64, 600> moved = move big;
    c.check_eq( moved.sum(), 2.0 );

    c.expect_panic( "the shape does not fit the elements", fn[]() { _ = kl::shaped( [ 1, 2, 3 ], 2, 2 ); } );
}

private void indexing( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::zeros( 2, 3 );
    a[1, 2]               = 5;
    a[0, 1] += 2;
    a.as_run()[0] = 1;
    c.check( a == kl::of( [ [ 1, 2, 0 ], [ 0, 0, 5 ] ] ) );
    c.check_eq( a.block( 1 ).size, 3 );
    c.check_eq( a.block( 1 )[2], 5 );

    c.expect_panic(
        "index out of range",
        fn[]()
        {
            kl::ndarray<i32, 2, 2> m = kl::zeros( 2, 2 );
            m[0, 2]                = 1;
        }
    );
    c.expect_panic(
        "the index count differs from the rank",
        fn[]()
        {
            kl::ndarray<i32, 2, 2> m = kl::zeros( 2, 2 );
            m[0]                   = 1;
        }
    );
}

private void arithmetic( ref kl::test::context c )
{
    kl::ndarray<i32, 3> a = kl::of( [ 1, 2, 3 ] );
    kl::ndarray<i32, 3> b = kl::of( [ 10, 20, 30 ] );
    c.check( a + b == kl::of( [ 11, 22, 33 ] ) );
    c.check( b - a == kl::of( [ 9, 18, 27 ] ) );
    c.check( a * b == kl::of( [ 10, 40, 90 ] ) );
    c.check( b / a == kl::of( [ 10, 10, 10 ] ) );
    c.check( a * 2 == kl::of( [ 2, 4, 6 ] ) );
    c.check( 2 * a == a * 2 );
    c.check( 10 - a == kl::of( [ 9, 8, 7 ] ) );
    c.check( b % 7 == kl::of( [ 3, 6, 2 ] ) );
    c.check( ( a & 1 ) == kl::of( [ 1, 0, 1 ] ) );

    kl::ndarray<i32, 3> s = a.copy();
    s += b;
    s -= a;
    s *= 2;
    s /= b;
    c.check( s == kl::of( [ 2, 2, 2 ] ) );

    kl::ndarray<f64, 2, 2> m = kl::of( [ [ 1.0, -2.0 ], [ 3.0, -4.0 ] ] );
    c.check( -m == m * -1.0 );

    // A row broadcast down a matrix, and a column across one.
    kl::ndarray<i32, 2, 3> g   = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::ndarray<i32, 2, 3> row = g + a;
    c.check( row == kl::of( [ [ 2, 4, 6 ], [ 5, 7, 9 ] ] ) );
    kl::ndarray<i32, 2, 1> col = kl::of( [ [ 10 ], [ 20 ] ] );
    c.check( g + col == kl::of( [ [ 11, 12, 13 ], [ 24, 25, 26 ] ] ) );
    g += a;
    c.check( g == row );

    // At run-time sizes the same rule is checked when it runs.
    u64                    n = 3;
    kl::ndarray<i32, dyn>    v = kl::filled( 1, n );
    kl::ndarray<i32, 2, dyn> w = kl::filled( 2, 2, n );
    kl::ndarray<i32, 2, dyn> x = w + v;
    c.check_eq( x.sum(), 18 );
    c.expect_panic(
        "the shapes do not broadcast",
        fn[]()
        {
            u64                 k = 2;
            kl::ndarray<i32, dyn> p = kl::zeros( k );
            kl::ndarray<i32, 3>   q = kl::zeros( 3 );
            _                     = p + q;
        }
    );
}

private void products( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::ndarray<i32, 3, 2> b = kl::of( [ [ 7, 8 ], [ 9, 10 ], [ 11, 12 ] ] );
    c.check( kl::matmul( a, b ) == kl::of( [ [ 58, 64 ], [ 139, 154 ] ] ) );
    c.check( a.transposed() == kl::of( [ [ 1, 4 ], [ 2, 5 ], [ 3, 6 ] ] ) );

    kl::ndarray<i32, 3> ones = kl::of( [ 1, 1, 1 ] );
    c.check( kl::matmul( a, ones ) == kl::of( [ 6, 15 ] ) );
    c.check( kl::matmul( ones, b ) == kl::of( [ 27, 30 ] ) );
    c.check_eq( ones.dot( ones ), 3 );
    c.check( kl::outer( ones, kl::of( [ 1, 2 ] ) ) == kl::of( [ [ 1, 2 ], [ 1, 2 ], [ 1, 2 ] ] ) );
    c.check( kl::cross( kl::of( [ 1, 0, 0 ] ), kl::of( [ 0, 1, 0 ] ) ) == kl::of( [ 0, 0, 1 ] ) );

    // A `dyn` number of rows meets fixed columns; the inner sizes are compared when it runs.
    u64                    rows = 2;
    kl::ndarray<i32, dyn, 3> d    = kl::filled( 1, rows, 3 );
    kl::ndarray<i32, dyn, 2> e    = kl::matmul( d, b );
    c.check_eq( e.extent( 0 ), 2 );
    c.check_eq( e[1, 1], 30 );

    // A rank 3 transpose reverses every axis.
    kl::ndarray<i32, 2, 3, 4> t = kl::zeros( 2, 3, 4 );
    t[1, 2, 3]                = 7;
    kl::ndarray<i32, 4, 3, 2> r = t.transposed();
    c.check_eq( r[3, 2, 1], 7 );
}

private void linear_algebra( ref kl::test::context c )
{
    kl::ndarray<f64, 2, 2> m = kl::of( [ [ 4.0, 7.0 ], [ 2.0, 6.0 ] ] );
    c.check( kl::abs( kl::determinant( m ) - 10.0 ) < 1e-12 );

    kl::optional<kl::ndarray<f64, 2, 2>> inv = kl::inverse( m );
    kl::ndarray<f64, 2, 2>           eye = kl::eye( 2, 2 );
    c.check( kl::matmul( m, kl::unwrap( move inv ) ).approx_equal( eye ) );

    kl::ndarray<f64, 2> b = kl::of( [ 1.0, 2.0 ] );
    kl::ndarray<f64, 2> x = kl::unwrap( kl::solve( m, b ) );
    c.check( kl::matmul( m, x ).approx_equal( b ) );

    kl::ndarray<f64, 3, 2> a = kl::of( [ [ 1.0, 1.0 ], [ 1.0, 2.0 ], [ 1.0, 3.0 ] ] );
    kl::ndarray<f64, 3>    y = kl::of( [ 1.0, 2.0, 2.0 ] );
    kl::ndarray<f64, 2>    f = kl::unwrap( kl::lstsq( a, y ) );
    c.check( f.approx_equal( kl::of( [ 2.0 / 3.0, 0.5 ] ) ) );

    kl::pair<kl::ndarray<f64, 3, 2>, kl::ndarray<f64, 2, 2>> qr = kl::qr( a );
    c.check( kl::matmul( qr.first, qr.second ).approx_equal( a ) );
    c.check( kl::abs( kl::hat_diagonal( a ).sum() - 2.0 ) < 1e-12 );

    kl::ndarray<f64, 2, 2> singular = kl::of( [ [ 1.0, 2.0 ], [ 2.0, 4.0 ] ] );
    c.check( kl::is_none( kl::inverse( singular ) ) );
    c.check( kl::diagonal( kl::diag( b ) ) == b );
}

private void comparing( ref kl::test::context c )
{
    kl::ndarray<f64, 2> x = kl::of( [ 1.0, 1000.0 ] );
    kl::ndarray<f64, 2> y = kl::of( [ 1.0 + 1e-10, 1000.0 + 1e-6 ] );
    c.check( !( x == y ) );
    c.check( x.approx_equal( y ) );
    c.check( !x.approx_equal( y, 0.0, 1e-9 ) );

    kl::ndarray<i32, 4>      a = kl::of( [ 1, 5, 3, 8 ] );
    kl::mask<4>      m = a.greater( 2 );
    c.check_eq( m.count(), 3 );
    c.check( m.any() && !m.all() );
    c.check( !m.test( 0 ) && m.at( 1 ) );
    c.check_eq( ( m & a.less( 6 ) ).count(), 2 );
    c.check_eq( ( ~m ).count(), 1 );
    c.check( a.selected( m ).as_shape<3>() == kl::of( [ 5, 3, 8 ] ) );
    c.check( kl::select( m, a, kl::ndarray<i32, 4>::zeros() ) == kl::of( [ 0, 5, 3, 8 ] ) );
    c.check_eq( a.equal_each( a ).count(), 4 );
    c.check_eq( a.differs( 5 ).count(), 3 );

    kl::ndarray<f64, 3> n = kl::of( [ 1.0, kl::nan(), kl::inf() ] );
    c.check_eq( kl::is_nan( n ).count(), 1 );
    c.check_eq( kl::is_inf( n ).count(), 1 );
}

private void reducing( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    c.check_eq( a.sum(), 21 );
    c.check_eq( a.prod(), 720 );
    c.check_eq( a.min(), 1 );
    c.check_eq( a.max(), 6 );
    c.check_eq( a.argmax(), 5 );

    // A constant axis keeps the other size in the type; a run-time one makes it `dyn`.
    kl::ndarray<i32, 3> columns = a.sum<0>();
    kl::ndarray<i32, 2> rows    = a.sum<1>();
    c.check( columns == kl::of( [ 5, 7, 9 ] ) );
    c.check( rows == kl::of( [ 6, 15 ] ) );
    u64                 axis = 1;
    kl::ndarray<i32, dyn> by   = a.sum( axis );
    c.check( by.as_shape<2>() == kl::of( [ 6, 15 ] ) );
    c.check( a.max<0>() == kl::of( [ 4, 5, 6 ] ) );
    c.check( a.argmin<1>() == kl::ndarray<u64, 2>::of( [ 0, 0 ] ) );
    c.check( a.prod( 0 ).as_shape<3>() == kl::of( [ 4, 10, 18 ] ) );
    c.check( a.cumsum() == kl::of( [ 1, 3, 6, 10, 15, 21 ] ) );
    c.check( a.cumsum( 0 ) == kl::of( [ [ 1, 2, 3 ], [ 5, 7, 9 ] ] ) );

    kl::ndarray<f64, 2, 2> f = kl::of( [ [ 1.0, 2.0 ], [ 3.0, 4.0 ] ] );
    c.check_eq( f.mean(), 2.5 );
    c.check_eq( f.var(), 1.25 );
    c.check( f.mean<0>() == kl::of( [ 2.0, 3.0 ] ) );
    c.check( f.std<1>() == kl::of( [ 0.5, 0.5 ] ) );

    // At a `dyn` row count, the constant axis keeps the fixed size.
    u64                    n = 3;
    kl::ndarray<f64, dyn, 2> d = kl::filled( 1.0, n, 2 );
    kl::ndarray<f64, 2>      s = d.sum<0>();
    c.check( s == kl::of( [ 3.0, 3.0 ] ) );
    kl::ndarray<f64, dyn> t = d.sum<1>();
    c.check_eq( t.size(), 3 );

    c.expect_panic( "axis out of range", fn[]() { _ = kl::ndarray<i32, 2>::zeros().sum( 1 ); } );
}

private void changing_the_shape( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::ndarray<i32, 6>    f = a.flattened();
    c.check( f == kl::of( [ 1, 2, 3, 4, 5, 6 ] ) );
    kl::ndarray<i32, 3, 2> r = a.reshaped( 3, 2 );
    c.check_eq( r[2, 1], 6 );
    kl::ndarray<i32, 1, 2, 3> e = a.expanded<0>();
    c.check_eq( e[0, 1, 2], 6 );

    // To `dyn` and back, checked.
    kl::ndarray<i32, dyn, dyn> d = a.as_dyn();
    c.check_eq( d.extent( 1 ), 3 );
    kl::ndarray<i32, 2, 3> back = d.as_shape<2, 3>();
    c.check( back == a );
    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            u64                 k = 4;
            kl::ndarray<i32, dyn> v = kl::zeros( k );
            _                     = v.as_shape<3>();
        }
    );

    kl::ndarray<i32, 2, 2> s = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    c.check( kl::concatenated( s, s ).sum() == 20 );
    kl::ndarray<i32, 2, 2, 2> st = kl::stacked( s, s );
    c.check_eq( st[1, 1, 0], 3 );
}

private void slices( ref kl::test::context c )
{
    kl::ndarray<i32, 3, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ], [ 7, 8, 9 ] ] );
    kl::ndarray<i32, dyn, dyn> s = a.sliced( 1..3, 0..2 );
    c.check( s.as_shape<2, 2>() == kl::of( [ [ 4, 5 ], [ 7, 8 ] ] ) );

    kl::ndarray<i32, 2, 2> w = a.window<2, 2>( 0, 1 );
    c.check( w == kl::of( [ [ 2, 3 ], [ 5, 6 ] ] ) );
    a.set_window( kl::ndarray<i32, 2, 2>::zeros(), 1, 1 );
    c.check_eq( a.sum(), 1 + 2 + 3 + 4 + 7 );
    a.fill( 9, 0..1, 0..3 );
    c.check_eq( a[0, 2], 9 );
    a.assign( kl::of( [ [ 1 ], [ 1 ] ] ), 1..3, 0..1 );
    c.check_eq( a[2, 0], 1 );

    c.expect_panic( "the window passes the end", fn[]() { _ = kl::ndarray<i32, 2, 2>::zeros().window<2, 2>( 1, 0 ); } );
    c.expect_panic( "the range is past its size", fn[]() { _ = kl::ndarray<i32, 2>::zeros().sliced( 0..3 ); } );
}

private void sorting( ref kl::test::context c )
{
    kl::ndarray<f64, 4> a = kl::of( [ 3.0, kl::nan(), 1.0, 3.0 ] );
    kl::ndarray<f64, 4> s = a.sorted();
    c.check_eq( s[0], 1.0 );
    c.check( s[3] != s[3] );
    c.check( a.argsort() == kl::ndarray<u64, 4>::of( [ 2, 0, 3, 1 ] ) );
    c.check_eq( a.unique().size(), 3 );
    c.check( kl::of( [ 0, 4, 0, 2 ] ).nonzero().as_shape<2>() == kl::ndarray<u64, 2>::of( [ 1, 3 ] ) );
}

private void converting( ref kl::test::context c )
{
    kl::ndarray<f64, 3> a = kl::of( [ -1.5, 0.5, 2.5 ] );
    c.check( a.rounded<i32>() == kl::of( [ -2, 1, 3 ] ) );
    c.check( a.truncated<i32>() == kl::of( [ -1, 0, 2 ] ) );
    c.check( a.floored<i64>() == kl::ndarray<i64, 3>::of( [ -2, 0, 2 ] ) );
    c.check( kl::of( [ 1, 2 ] ).to<f64>() == kl::of( [ 1.0, 2.0 ] ) );
    c.check( a.abs() == kl::of( [ 1.5, 0.5, 2.5 ] ) );
    c.check( a.clip( 0.0, 1.0 ) == kl::of( [ 0.0, 0.5, 1.0 ] ) );
    c.check( a.sign() == kl::of( [ -1.0, 1.0, 1.0 ] ) );
    c.check( kl::of( [ 3.0, 4.0 ] ).norm() == 5.0 );
}

private void maths( ref kl::test::context c )
{
    kl::ndarray<f64, 2> a = kl::of( [ 1.0, 4.0 ] );
    c.check( kl::sqrt( a ) == kl::of( [ 1.0, 2.0 ] ) );
    c.check( kl::pow( a, 2.0 ) == kl::of( [ 1.0, 16.0 ] ) );
    c.check( kl::pow( a, a ) == kl::of( [ 1.0, 256.0 ] ) );
    c.check( kl::exp( kl::log( a ) ).approx_equal( a ) );
    c.check( kl::minimum( a, kl::of( [ 2.0, 2.0 ] ) ) == kl::of( [ 1.0, 2.0 ] ) );
    c.check( kl::maximum( a, kl::of( [ 2.0, 2.0 ] ) ) == kl::of( [ 2.0, 4.0 ] ) );
}

private void walking( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 2> a     = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    i32                  total = 0;
    for( i32 x : a )
    {
        total = total * 10 + x;
    }
    c.check_eq( total, 1234 );
    for( ref i32 x : a )
    {
        x *= 2;
    }
    c.check_eq( a.sum(), 20 );
}

private void mixing( ref kl::test::context c )
{
    u64                    rows = 2;
    kl::ndarray<f64, dyn, 2> d    = kl::filled( 1.0, rows, 2 );
    kl::ndarray<f64, 2, 2>   k    = kl::filled( 2.0, 2, 2 );
    c.check_eq( d.dot( k ), 8.0 );
    c.check( d.less( k ).all() );
    c.check( kl::stacked( d, k ).sum() == 12.0 );
    c.check( kl::select( d.less( k ), k, d ).sum() == 8.0 );
    c.check( kl::maximum( d, kl::of( [ 3.0, 0.0 ] ) ).equal_each( kl::of( [ [ 3.0, 1.0 ], [ 3.0, 1.0 ] ] ) ).all() );
    k += d;
    c.check_eq( k.sum(), 12.0 );
    d += kl::of( [ 1.0, 2.0 ] );
    c.check_eq( d.sum(), 10.0 );

    c.expect_panic(
        "`dot` needs `S == U`, but `S` is 3, 2 and `U` is 2, 2",
        fn[]()
        {
            u64                    three = 3;
            kl::ndarray<f64, dyn, 2> tall  = kl::zeros( three, 2 );
            kl::ndarray<f64, 2, 2>   square = kl::zeros( 2, 2 );
            _                             = tall.dot( square );
        }
    );
    c.expect_panic(
        "`operator+=` needs `S == broadcast(S, U)`, but `S` is 2, 2 and `U` is 3, 2",
        fn[]()
        {
            u64                    three = 3;
            kl::ndarray<f64, dyn, 2> tall  = kl::zeros( three, 2 );
            kl::ndarray<f64, 2, 2>   square = kl::zeros( 2, 2 );
            square += tall;
        }
    );
}

private void integer_operators( ref kl::test::context c )
{
    kl::ndarray<i32, 3> a = kl::of( [ 6, 5, 12 ] );
    c.check( ( a | 1 ) == kl::of( [ 7, 5, 13 ] ) );
    c.check( ( a ^ 1 ) == kl::of( [ 7, 4, 13 ] ) );
    c.check( ( a ^ a ) == kl::ndarray<i32, 3>::zeros() );
    c.check( ( a & kl::of( [ 2, 4, 8 ] ) ) == kl::of( [ 2, 4, 8 ] ) );
    c.check( ~a == kl::of( [ -7, -6, -13 ] ) );
    c.check( 7 % a == kl::of( [ 1, 2, 7 ] ) );

    kl::ndarray<i32, 3> s = a.copy();
    s %= 4;
    s |= 8;
    s &= 11;
    s ^= kl::of( [ 1, 1, 1 ] );
    c.check( s == kl::of( [ 11, 8, 9 ] ) );
}

private void elementwise_maths( ref kl::test::context c )
{
    kl::ndarray<f64, 3> a = kl::of( [ -1.5, 0.5, 2.5 ] );
    c.check( kl::floor( a ) == kl::of( [ -2.0, 0.0, 2.0 ] ) );
    c.check( kl::ceil( a ) == kl::of( [ -1.0, 1.0, 3.0 ] ) );
    c.check( kl::trunc( a ) == kl::of( [ -1.0, 0.0, 2.0 ] ) );
    c.check( kl::round( a ) == kl::of( [ -2.0, 1.0, 3.0 ] ) );

    kl::ndarray<f64, 2> z = kl::of( [ 0.0, 0.0 ] );
    c.check( kl::sin( z ) == z && kl::tan( z ) == z && kl::tanh( z ) == z && kl::asin( z ) == z );
    c.check( kl::cos( z ) == kl::of( [ 1.0, 1.0 ] ) && kl::cosh( z ) == kl::of( [ 1.0, 1.0 ] ) );
    c.check( kl::expm1( z ) == z && kl::log1p( z ) == z && kl::atan2( z, kl::of( [ 1.0, 1.0 ] ) ) == z );
    c.check( kl::log2( kl::of( [ 1.0, 8.0 ] ) ) == kl::of( [ 0.0, 3.0 ] ) );
    c.check( kl::log10( kl::of( [ 1.0, 100.0 ] ) ).approx_equal( kl::of( [ 0.0, 2.0 ] ) ) );

    c.check( kl::of( [ 1, 2 ] ).map( fn[]( i32 x ) { return cast<f64>( x ) / 2.0; } ) == kl::of( [ 0.5, 1.0 ] ) );
    c.check( a.zipped( a, fn[]( f64 x, f64 y ) { return x * y + 1.0; } ) == kl::of( [ 3.25, 1.25, 7.25 ] ) );
    c.check( kl::of( [ 1, 2 ] ).less_equal( kl::of( [ 1, 1 ] ) ).count() == 1 );
    c.check( kl::of( [ 1, 2, 3 ] ).greater_equal( 2 ).count() == 2 );

    kl::ndarray<i32, 2, 3> m = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    c.check( m.cumprod() == kl::of( [ 1, 2, 6, 24, 120, 720 ] ) );
    c.check( m.cumprod( 0 ) == kl::of( [ [ 1, 2, 3 ], [ 4, 10, 18 ] ] ) );
    c.check_eq( kl::of( [ [ 1.0, 2.0 ], [ 3.0, 4.0 ] ] ).std(), kl::sqrt( 1.25 ) );
}

private void norms( ref kl::test::context c )
{
    c.check( kl::of( [ 3.0, 4.0 ] ).normalised() == kl::of( [ 0.6, 0.8 ] ) );

    // Scaled, so no square overflows or underflows.
    c.check( kl::abs( kl::of( [ 3e200, 4e200 ] ).norm() / 5e200 - 1.0 ) < 1e-15 );
    c.check( kl::abs( kl::of( [ 3e-200, 4e-200 ] ).norm() / 5e-200 - 1.0 ) < 1e-15 );
    c.check( kl::abs( kl::ndarray<f32, 2>::of( [ 3e30, 4e30 ] ).norm() / 5e30 - 1.0 ) < 1e-6 );
    c.check_eq( kl::of( [ 0.0, 0.0 ] ).norm(), 0.0 );
    c.check_eq( kl::of( [ kl::inf(), 1.0, kl::inf() ] ).norm(), kl::inf() );
    c.check( kl::is_nan( kl::of( [ kl::inf(), kl::nan() ] ).norm() ) );
}

private void linear_algebra_more( ref kl::test::context c )
{
    // A pivot is needed: the first column's top is 0.
    kl::ndarray<f64, 3, 3> p = kl::of( [ [ 0.0, 1.0, 2.0 ], [ 1.0, 0.0, 3.0 ], [ 4.0, -3.0, 8.0 ] ] );
    c.check_eq( kl::determinant( p ), -2.0 );
    kl::ndarray<f64, 3, 3> eye = kl::eye( 3, 3 );
    c.check( kl::matmul( p, kl::unwrap( kl::inverse( p ) ) ).approx_equal( eye ) );

    kl::ndarray<f64, 2, 2> a  = kl::of( [ [ 2.0, 1.0 ], [ 1.0, 3.0 ] ] );
    kl::ndarray<f64, 2, 2> bs = kl::of( [ [ 3.0, 1.0 ], [ 4.0, 3.0 ] ] );
    c.check( kl::matmul( a, kl::unwrap( kl::solve( a, bs ) ) ).approx_equal( bs ) );

    kl::ndarray<f64, 2, 2> singular = kl::of( [ [ 1.0, 2.0 ], [ 2.0, 4.0 ] ] );
    c.check_eq( kl::determinant( singular ), 0.0 );
    c.check( kl::is_none( kl::solve( singular, kl::ndarray<f64, 2>::ones() ) ) );

    // numpy's factors, solutions and leverages for a line through four points.
    kl::ndarray<f64, 4, 2>                                 l = kl::of( [ [ 1.0, 1.0 ], [ 1.0, 2.0 ], [ 1.0, 3.0 ], [ 1.0, 4.0 ] ] );
    kl::pair<kl::ndarray<f64, 4, 2>, kl::ndarray<f64, 2, 2>> f = kl::qr( l );
    c.check( f.first.approx_equal( kl::of( [ [ -0.5, 0.6708203932499369 ], [ -0.5, 0.22360679774997896 ], [ -0.5, -0.22360679774997896 ], [ -0.5, -0.6708203932499369 ] ] ) ) );
    c.check( f.second.approx_equal( kl::of( [ [ -2.0, -5.0 ], [ 0.0, -2.23606797749979 ] ] ) ) );
    c.check( kl::unwrap( kl::lstsq( l, kl::of( [ 6.0, 5.0, 7.0, 10.0 ] ) ) ).approx_equal( kl::of( [ 3.5, 1.4 ] ) ) );
    kl::ndarray<f64, 4, 2> b = kl::of( [ [ 6.0, 1.0 ], [ 5.0, 0.0 ], [ 7.0, 2.0 ], [ 10.0, 1.0 ] ] );
    c.check( kl::unwrap( kl::lstsq( l, b ) ).approx_equal( kl::of( [ [ 3.5, 0.5 ], [ 1.4, 0.2 ] ] ) ) );
    c.check( kl::hat_diagonal( l ).approx_equal( kl::of( [ 0.7, 0.3, 0.3, 0.7 ] ) ) );
    kl::ndarray<f32, 2, 2> g = kl::ndarray<f32, 2, 2>::of( [ 2.0, 1.0, 1.0, 3.0 ] );
    c.check( kl::unwrap( kl::lstsq( g, kl::ndarray<f32, 2>::of( [ 3.0, 4.0 ] ) ) ).approx_equal( kl::ndarray<f32, 2>::ones() ) );
    kl::ndarray<f64, 3, 2> zero_column = kl::of( [ [ 1.0, 0.0 ], [ 2.0, 0.0 ], [ 3.0, 0.0 ] ] );
    c.check( kl::is_none( kl::lstsq( zero_column, kl::ndarray<f64, 3>::ones() ) ) );
}

private void sorting_more( ref kl::test::context c )
{
    kl::ndarray<f64, 5> u = kl::of( [ 2.0, kl::nan(), 1.0, 2.0, kl::nan() ] );
    kl::ndarray<f64, dyn> v = u.unique();
    c.check_eq( v.size(), 3 );
    c.check( v[0] == 1.0 && v[1] == 2.0 && kl::is_nan( v[2] ) );
    c.check_eq( kl::of( [ 0.0, kl::nan(), -0.0 ] ).nonzero().size(), 1 );
    u64 none = 0;
    c.check_eq( kl::zeros<i32, dyn>( none ).sorted().size(), 0 );
    c.check_eq( kl::zeros<i32, dyn>( none ).unique().size(), 0 );

    // Larger than a few elements, so the heap is several levels deep.
    kl::ndarray<i32, dyn> big = kl::arange( 0, 100 ).map( fn[]( i32 x ) { return ( x * 37 ) % 100; } );
    c.check( big.sorted() == kl::arange( 0, 100 ) );
    c.check( big.argsort().map( fn[]( u64 i ) { return ( i * 37 ) % 100; } ) == kl::arange<u64>( 0, 100 ) );
}

// Bits 0 and n - 1 of an n-bit mask, and every whole-mask reader.
private void mask_edges( ref kl::test::context c, u64 n )
{
    kl::mask<dyn> m = kl::cleared( n );
    c.check_eq( m.size(), n );
    c.check_eq( m.count(), 0 );
    c.check( !m.any() && !m.all() );

    m.assign( 0, true );
    m.assign( n - 1, true );
    c.check( m.test( 0 ) && m.at( n - 1 ) );
    c.check_eq( m.count(), n == 1 ? 1 : 2 );

    kl::mask<dyn> f = ~kl::cleared( n );
    c.check_eq( f.count(), n );
    c.check( f.all() && ( f & m ) == m && ( f | m ) == f );
    c.check_eq( ( f ^ m ).count() + m.count(), n );
    c.check( ~~m == m );
}

// Counting, combining and comparing agree across one word, a full word and one past it, and the
// spare bits never show.
private void masks( ref kl::test::context c )
{
    mask_edges( ref c, 1 );
    mask_edges( ref c, 64 );
    mask_edges( ref c, 65 );

    kl::mask<65> v = kl::cleared( 65 );
    v.assign( 64, true );
    c.check( v.at( 64 ) && v.any() && !v.all() );
    c.check_eq( ( ~v ).count(), 64 );
    c.check( ( v | ~v ).all() && !( v & ~v ).any() );

    kl::mask<2, 3> m = kl::cleared( 2, 3 );
    m.assign( 5, true );
    c.check( m.at( 1, 2 ) && !m.at( 1, 1 ) );

    c.expect_panic( "index out of range", fn[]() { _ = kl::mask<2, 3>().at( 2, 0 ); } );
    c.expect_panic(
        "index out of range",
        fn[]()
        {
            u64                 six = 6;
            kl::mask<dyn> s   = kl::cleared( six );
            s.assign( 6, true );
        }
    );
    c.expect_panic(
        "`operator&` needs `S == U`",
        fn[]()
        {
            u64 two   = 2;
            u64 three = 3;
            _         = kl::cleared( two ) & kl::cleared( three );
        }
    );
}

// Each NaN reduction against numpy's, in the three forms, with an all-NaN column.
private void nan_reductions( ref kl::test::context c )
{
    kl::ndarray<f64, 2, 3> a = kl::of( [ [ 1.0, kl::nan(), 3.0 ], [ kl::nan(), kl::nan(), 6.0 ] ] );
    c.check_eq( a.nansum(), 10.0 );
    c.check( a.nansum<0>() == kl::of( [ 1.0, 0.0, 9.0 ] ) );
    c.check( a.nansum( 1 ) == kl::of( [ 4.0, 6.0 ] ).as_dyn() );

    c.check_eq( a.nanmean(), 10.0 / 3.0 );
    kl::ndarray<f64, 3> m = a.nanmean<0>();
    c.check( m[0] == 1.0 && kl::is_nan( m[1] ) && m[2] == 4.5 );
    c.check( a.nanmean<1>() == kl::of( [ 2.0, 6.0 ] ) );

    c.check_eq( a.nanvar(), 4.222222222222222 );
    c.check( a.nanvar<1>() == kl::of( [ 1.0, 0.0 ] ) );
    c.check( a.nanstd( 1 ) == kl::of( [ 1.0, 0.0 ] ).as_dyn() );

    c.check_eq( a.nanmin(), 1.0 );
    kl::ndarray<f64, 3> lo = a.nanmin<0>();
    c.check( lo[0] == 1.0 && kl::is_nan( lo[1] ) && lo[2] == 3.0 );
    c.check( a.nanmax<1>() == kl::of( [ 3.0, 6.0 ] ) );

    // A NaN first in the fold is passed over, not kept.
    c.check_eq( kl::of( [ kl::nan(), 2.0, 1.0 ] ).nanmin(), 1.0 );
    c.check_eq( kl::of( [ kl::nan(), 2.0, 1.0 ] ).nanmax(), 2.0 );
    c.check_eq( kl::of( [ kl::nan(), kl::nan() ] ).nansum(), 0.0 );
    c.check( kl::is_nan( kl::of( [ kl::nan(), kl::nan() ] ).nanvar() ) );
}

// Gathering by flat index into the index array's shape, and putting back, a later index winning.
private void gather_scatter( ref kl::test::context c )
{
    kl::ndarray<i32, 2, 3> a = kl::of( [ [ 10, 11, 12 ], [ 13, 14, 15 ] ] );
    c.check( a.taken( kl::ndarray<u64, 3>::of( [ 5, 0, 5 ] ) ) == kl::of( [ 15, 10, 15 ] ) );
    kl::ndarray<i32, 2, 2> g = a.taken( kl::ndarray<u64, 2, 2>::of( [ 1, 2, 3, 4 ] ) );
    c.check( g == kl::of( [ [ 11, 12 ], [ 13, 14 ] ] ) );

    u64                   n  = 2;
    kl::ndarray<u64, dyn> at = kl::zeros<u64, dyn>( n );
    at[1]                    = 4;
    c.check( a.taken( at ) == kl::of( [ 10, 14 ] ).as_dyn() );

    a.put( kl::ndarray<u64, 3>::of( [ 0, 4, 0 ] ), kl::of( [ 1, 2, 3 ] ) );
    c.check( a == kl::of( [ [ 3, 11, 12 ], [ 13, 2, 15 ] ] ) );

    c.expect_panic( "out of bounds", fn[ a ]() { _ = a.taken( kl::ndarray<u64, 1>::of( [ 6 ] ) ); } );
    c.expect_panic(
        "`put` needs one `I[0]`",
        fn[]()
        {
            u64                    three = 3;
            kl::ndarray<i32, 2, 3> b     = kl::zeros( 2, 3 );
            b.put( kl::zeros<u64, dyn>( three ), kl::of( [ 1, 2 ] ).as_dyn() );
        }
    );
}

// numpy's interp: the ends held, a point hit exactly, a NaN kept, and repeated points.
private void interpolating( ref kl::test::context c )
{
    kl::ndarray<f64, 3> xp = kl::of( [ 1.0, 2.0, 4.0 ] );
    kl::ndarray<f64, 3> fp = kl::of( [ 10.0, 20.0, 0.0 ] );
    kl::ndarray<f64, 7> y  = kl::interp( kl::of( [ 0.0, 1.0, 1.5, 2.0, 3.0, 5.0, kl::nan() ] ), xp, fp );
    kl::ndarray<f64, 6> want = kl::of( [ 10.0, 10.0, 15.0, 20.0, 10.0, 0.0 ] );
    for( u64 i : 0..6 )
    {
        c.check_eq( y[i], want[i] );
    }
    c.check( kl::is_nan( y[6] ) );
    c.check( kl::interp( kl::of( [ 1.0, 2.0 ] ), kl::of( [ 1.0, 1.0, 3.0 ] ), kl::of( [ 0.0, 5.0, 7.0 ] ) ) == kl::of( [ 5.0, 6.0 ] ) );
    c.check( kl::interp( kl::of( [ -1.0, 9.0 ] ), kl::of( [ 2.0 ] ), kl::of( [ 7.0 ] ) ) == kl::of( [ 7.0, 7.0 ] ) );

    u64 none = 0;
    c.expect_panic( "interp needs at least one point", fn[ none ]() { _ = kl::interp( kl::of( [ 1.0 ] ), kl::zeros<f64, dyn>( none ), kl::zeros<f64, dyn>( none ) ); } );
}
