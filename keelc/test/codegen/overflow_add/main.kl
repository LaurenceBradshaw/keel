// --overflow-checks without --debug: an `i32` sum past its range prints the file, the line and the
// operation as written, and aborts.
import t::console;

i32 add( i32 a, i32 b )
{
    return a + b;
}

i32 main()
{
    t::println( "before" );
    t::println( add( 2147483647, 1 ) );
    return 0;
}
