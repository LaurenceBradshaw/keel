{
    "name": "keel",
    "displayName": "Keel",
    "description": "Keel language support: highlighting, editing rules, keelc's errors, name colours and hovers on save, and a header view.",
    "version": "0.0.1",
    "publisher": "keel",
    "license": "Apache-2.0 WITH LLVM-exception",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:keel",
        "onCommand:keel.showHeader",
        "onCommand:keel.switchHeaderSource"
    ],
    "extensionKind": [
        "workspace"
    ],
    "contributes": {
        "commands": [
            {
                "command": "keel.switchHeaderSource",
                "title": "Switch Header/Source",
                "category": "Keel"
            },
            {
                "command": "keel.showHeader",
                "title": "Show Header",
                "category": "Keel",
                "icon": "$(list-flat)"
            }
        ],
        "keybindings": [
            {
                "command": "keel.switchHeaderSource",
                "key": "alt+o",
                "when": "editorTextFocus && editorLangId == keel"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "keel.showHeader",
                    "when": "editorLangId == keel && resourceScheme == file",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "keel.switchHeaderSource",
                    "when": "editorLangId == keel"
                },
                {
                    "command": "keel.showHeader",
                    "when": "editorLangId == keel && resourceScheme == file"
                }
            ]
        },
        "breakpoints": [
            {
                "language": "keel"
            }
        ],
        "languages": [
            {
                "id": "keel",
                "aliases": [
                    "Keel",
                    "keel"
                ],
                "extensions": [
                    ".kl"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/keel_kl.svg",
                    "dark": "./icons/keel_kl.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "keel",
                "scopeName": "source.keel",
                "path": "./syntaxes/keel.tmLanguage.json"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "global",
                "description": "A variable declared at the top level of a module."
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "keel",
                "scopes": {
                    "namespace": [
                        "entity.name.namespace.keel"
                    ],
                    "struct": [
                        "entity.name.type.keel"
                    ],
                    "class": [
                        "entity.name.type.keel"
                    ],
                    "interface": [
                        "entity.name.type.keel"
                    ],
                    "enum": [
                        "entity.name.type.keel"
                    ],
                    "typeParameter": [
                        "entity.name.type.parameter.keel"
                    ],
                    "enumMember": [
                        "variable.other.enummember.keel"
                    ],
                    "property": [
                        "variable.other.member.keel"
                    ],
                    "function": [
                        "entity.name.function.keel"
                    ],
                    "method": [
                        "entity.name.function.keel"
                    ],
                    "parameter": [
                        "variable.parameter.keel"
                    ],
                    "variable": [
                        "variable.other.keel"
                    ],
                    "variable.global": [
                        "variable.other.global.keel"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "storage.modifier.mode.keel",
                        "settings": {
                            "fontStyle": "italic"
                        }
                    },
                    {
                        "scope": "markup.heading.banner.keel",
                        "settings": {
                            "fontStyle": "bold"
                        }
                    }
                ]
            },
            "[keel]": {
                "editor.semanticHighlighting.enabled": true
            }
        },
        "configuration": {
            "title": "Keel",
            "properties": {
                "keel.compilerPath": {
                    "type": "string",
                    "default": "build/debug/bin/keelc",
                    "description": "The keelc to check files with, relative to the workspace folder."
                },
                "keel.packages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Packages to pass to keelc, each as name=<dir>, with dir relative to the workspace folder."
                }
            }
        }
    }
}