// A `@real_arithmetic` function whose body is no linear map warns at what stops it, once however
// many instances it has, and is optimised as usual.

@real_arithmetic
f64 energy( const ref f64[2] x )
{
    return x[0] * x[0] + x[1] * x[1];
}

@real_arithmetic
f64 scaled<u64 N>( f64 x )
{
    return x * cast<f64>( N ) + 1.0;
}

i32 main()
{
    const f64[2] x = [ 3.0, 4.0 ];
    return energy( x ) + scaled<2>( 1.0 ) + scaled<3>( 1.0 ) == 32.0 ? 0 : 1;
}
