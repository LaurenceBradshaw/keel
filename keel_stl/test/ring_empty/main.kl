// Popping an empty `kl::ring` aborts, naming the check in the library; `try_pop_front` answers none.
import kl::ring;

i32 main()
{
    kl::ring<i32> values = kl::ring<i32>::with_capacity( 2 );
    values.push_back( 10 );

    if( values.pop_back() != 10 )
    {
        return 1;
    }

    return values.pop_front();
}
