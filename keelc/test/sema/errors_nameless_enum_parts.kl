// An enum or a variant with no name is not one, so the parser leaves it out; a payload field with
// no name is still one, and only a duplicate's report reads that name. Each is reported once, by
// the parser, and nothing after it is disturbed - the switch below covers Shape as one variant.

enum : u8
{
    Red,
};

enum Shape
{
    Circle( f64 radius ),
    ( f64 side ),
};

enum Pair
{
    Both( f64, f64 ),
};

i32 area( Shape s )
{
    switch( s )
    {
        case Shape::Circle( r ):
            return 1;
    }

    return 0;
}

i32 main()
{
    return 0;
}
