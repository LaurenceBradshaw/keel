// A limit belongs to a number type or a parameter bounded `numeric`, is a value rather than a
// function, and has the type it names.
T plain<T>() { return T::max; }
i32 main()
{
    i32 a = i32::max();
    i32 b = i32::biggest;
    bool c = bool::max;
    i8 d = i32::max;
    i32 e = i32::max + 1;
    return 0;
}
