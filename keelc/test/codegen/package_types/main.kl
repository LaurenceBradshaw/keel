// Every kind of declaration in the package `kinds`, named from outside it. Every check returns a
// distinct code.
import kinds::shapes;

// kinds::Point's name, in this program's own package.
struct Point
{
    i32 x;
};

// Deduced at both Points, which must be two functions in C.
T same<T>( T v ) where T : Copyable
{
    return v;
}

i32 measure( kinds::Shape s )
{
    switch( s )
    {
        case kinds::Shape::Circle( r ):
            return 3 * r * r;
        case kinds::Shape::Square( a ):
            return a * a;
    }
}

i32 main()
{
    kinds::Point p = kinds::origin();
    if( p.x != 7 || p.y != 8 ) { return 1; }

    kinds::Point q = kinds::Point { 1, 2 };
    Point own = Point { 5 };
    if( q.x + own.x != 6 ) { return 2; }

    if( same( p ).y != 8 || same( own ).x != 5 ) { return 3; }

    kinds::Box<i32> b = kinds::Box<i32>::of( 9 );
    kinds::Box<kinds::Point> boxed = kinds::Box { q };
    if( b.v != 9 || boxed.v.y != 2 ) { return 4; }

    kinds::Colour c = kinds::Colour::Green;
    if( c == kinds::Colour::Red ) { return 5; }

    if( measure( kinds::Shape::Circle( 2 ) ) != 12 || measure( kinds::Shape::Square( 3 ) ) != 9 ) { return 6; }

    kinds::Counter k = kinds::Counter( 4 );
    if( k.get() != 4 || kinds::Counter::zero().get() != 0 ) { return 7; }

    kinds::made = kinds::made + 10;
    if( kinds::made != 11 ) { return 8; }

    return 0;
}
