// PLAN §12. Two callables may share a name when a call site can tell them apart, and what tells
// them apart is each parameter's declared type together with the marker the call has to write.
// Selection is by exact type: §6.4's widening is what gets an argument to a parameter after one has
// been chosen, and letting it choose would mean ranking two parameters that both accept.
//
// Only the exit code can see most of this. Every overload below returns a different number, so
// picking the wrong one is a wrong answer rather than a wrong-looking symbol - and the ones that
// differ only in a marker or in a `move` are exactly the pairs that used to mangle alike.

i32 by_type( i32 a )
{
    return 1 + a * 0;
}

i32 by_type( f64 a )
{
    if( a > 0.0 )
    {
        return 2;
    }

    return 2;
}

i32 by_type( bool a )
{
    if( a )
    {
        return 3;
    }

    return 3;
}

// Arity alone, which is settled before any argument is typed.
i32 by_arity( i32 a )
{
    return 10 + a * 0;
}

i32 by_arity( i32 a, i32 b )
{
    return 20 + a * 0 + b * 0;
}

// A borrow and a pointer are two parameters, distinguished at the call by `ref` and at the
// declaration by what they say. They encoded alike until overloading made the pair reachable.
i32 by_marker( i32 a )
{
    return 30 + a * 0;
}

i32 by_marker( ref i32 a )
{
    a = a + 1;
    return 40;
}

i32 by_marker( i32* a )
{
    return 50 + *a * 0;
}

i32 destroyed = 0;

class Owned
{
    public i32 tag;

    Owned( i32 t )
    {
        tag = t;
    }

    ~Owned()
    {
        destroyed = destroyed + tag * 0;
    }
};

// A transfer and a copy. `move` is part of what the call site writes, so the two are distinct -
// and by the same argument they need distinct symbols.
i32 by_transfer( const ref Owned a )
{
    return 60 + a.tag * 0;
}

i32 by_transfer( move Owned a )
{
    return 70 + a.tag * 0;
}

class Two
{
    public i32 x;

    Two( i32 v )
    {
        x = v;
    }

    Two( f64 v )
    {
        if( v > 0.0 )
        {
            x = 100;
        }
        else
        {
            x = 100;
        }
    }

    i32 at( i32 n )
    {
        return x + n;
    }

    i32 at( bool n )
    {
        if( n )
        {
            return x * 2;
        }

        return x;
    }

    // A sibling reached by bare name goes through the same choice: the member scope holds the whole
    // set, not the first of it.
    i32 both( i32 n )
    {
        return at( n ) + at( true );
    }
};

// Two overloads of one generic at the same type arguments. Named by their type arguments alone they
// were one C symbol, which is why the parameters are part of the name too.
class Holder<T> where T : Copyable & Integral
{
    T held;

    Holder( T v )
    {
        held = v;
    }

    i32 count( T a, i32 b )
    {
        if( held == a )
        {
            return b;
        }

        return 0;
    }

    i32 count( bool a )
    {
        if( a )
        {
            return 200 + wrap<i32>( held ) * 0;
        }

        return 0;
    }
};

// Two whose *return* types differ, and differ in a direction §6.4 widens neither way. The call's
// type has to come from the callable that was chosen rather than from the name, and a set whose
// members all returned alike would never say so.
bool answers( i32 a )
{
    return a > 0;
}

i32 answers( bool a )
{
    if( a )
    {
        return 500;
    }

    return 0;
}

// A generic beside a non-generic of one name. Today the call site says which by writing the type
// arguments or not; the rule that prefers the non-generic arrives with inference.
i32 either( i32 a )
{
    return 300 + a * 0;
}

i32 either<T>( T a ) where T : Copyable & Integral
{
    return 400 + wrap<i32>( a ) * 0;
}

i32 main()
{
    i32 whole = 7;
    f64 fraction = 1.5;
    i32* address = &whole;

    // 1..3: the argument's own type chooses.
    if( by_type( whole ) != 1 ) { return 1; }
    if( by_type( fraction ) != 2 ) { return 2; }
    if( by_type( true ) != 3 ) { return 3; }

    // 4..5: a literal carries the family it is written in, and no more than that.
    if( by_type( 9 ) != 1 ) { return 4; }
    if( by_type( 9.0 ) != 2 ) { return 5; }

    // 6..7: the count, before anything is typed.
    if( by_arity( whole ) != 10 ) { return 6; }
    if( by_arity( whole, whole ) != 20 ) { return 7; }

    // 8..11: the marker is part of what the call says, and `ref` really is the caller's variable.
    if( by_marker( whole ) != 30 ) { return 8; }
    if( by_marker( ref whole ) != 40 ) { return 9; }
    if( whole != 8 ) { return 10; }
    if( by_marker( address ) != 50 ) { return 11; }

    // 12..13: a transfer and a borrow of one owning type.
    Owned borrowed = Owned( 1 );
    if( by_transfer( borrowed ) != 60 ) { return 12; }

    Owned given = Owned( 2 );
    if( by_transfer( move given ) != 70 ) { return 13; }

    // 14..17: two constructors, and two methods reached both ways.
    Two from_whole = Two( 5 );
    if( from_whole.x != 5 ) { return 14; }

    Two from_fraction = Two( 2.5 );
    if( from_fraction.x != 100 ) { return 15; }

    if( from_whole.at( 3 ) != 8 ) { return 16; }
    if( from_whole.at( true ) != 10 ) { return 17; }
    if( from_whole.both( 3 ) != 18 ) { return 18; }

    // 19..20: two overloads of one generic member, at one instantiation.
    Holder<i32> holder = Holder<i32>( 4 );
    if( holder.count( 4, 19 ) != 19 ) { return 19; }
    if( holder.count( true ) != 200 ) { return 20; }

    // 21..22: the generic and the plain one, told apart by the call site.
    if( either( whole ) != 300 ) { return 21; }
    if( either<i32>( whole ) != 400 ) { return 22; }

    // 23..24: the result comes from the chosen callable, not from the first of its name.
    bool positive = answers( whole );
    if( !positive ) { return 23; }
    if( answers( true ) != 500 ) { return 24; }

    return 42;
}
