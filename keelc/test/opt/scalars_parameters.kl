// M11's scalar replacement of a by-value parameter, in a release build: one with a field written
// is copied whole into a fresh local in a new entry block, which then splits, so a check on the
// written field folds and a dead write goes. One only read stays as it is. Each returns its own code.

struct Point
{
    i32 x;
    i32 y;
};

// The write to `x` is its own local's, so the check folds.
i32 written( Point p )
{
    p.x = 3;
    return p.x == 3 ? p.y : 100;
}

// Nothing reads `x` after the write, which goes.
i32 dead( Point p )
{
    p.x = 9;
    return p.y;
}

i32 read( Point p )
{
    return p.x + p.y;
}

// The loop writes `x` each turn; the copy runs once, before it.
i32 counted( Point p )
{
    while( p.x < 10 )
    {
        p.x = p.x + p.y;
    }
    return p.x;
}

i32 main()
{
    i32 code = written( Point { 1, 2 } ) == 2 ? 0 : 1;
    if( code == 0 )
    {
        code = dead( Point { 1, 2 } ) == 2 ? 0 : 2;
    }
    if( code == 0 )
    {
        code = read( Point { 1, 2 } ) == 3 ? 0 : 3;
    }
    if( code == 0 )
    {
        code = counted( Point { 1, 4 } ) == 13 ? 0 : 4;
    }

    return code;
}
