// Every kind of declaration in the package `kl`, named from outside it. Every check returns a
// distinct code.
import kl::shapes;

// kl::Point's name, in this program's own package.
struct Point
{
    i32 x;
};

// Deduced at both Points, which must be two functions in C.
T same<T>( T v ) where T : Copyable
{
    return v;
}

i32 measure( kl::Shape s )
{
    switch( s )
    {
        case kl::Shape::Circle( r ):
            return 3 * r * r;
        case kl::Shape::Square( a ):
            return a * a;
    }
}

i32 main()
{
    kl::Point p = kl::origin();
    if( p.x != 7 || p.y != 8 ) { return 1; }

    kl::Point q = kl::Point { 1, 2 };
    Point own = Point { 5 };
    if( q.x + own.x != 6 ) { return 2; }

    if( same( p ).y != 8 || same( own ).x != 5 ) { return 3; }

    kl::Box<i32> b = kl::Box<i32>::of( 9 );
    kl::Box<kl::Point> boxed = kl::Box { q };
    if( b.v != 9 || boxed.v.y != 2 ) { return 4; }

    kl::Colour c = kl::Colour::Green;
    if( c == kl::Colour::Red ) { return 5; }

    if( measure( kl::Shape::Circle( 2 ) ) != 12 || measure( kl::Shape::Square( 3 ) ) != 9 ) { return 6; }

    kl::Counter k = kl::Counter( 4 );
    if( k.get() != 4 || kl::Counter::zero().get() != 0 ) { return 7; }

    kl::made = kl::made + 10;
    if( kl::made != 11 ) { return 8; }

    return 0;
}
