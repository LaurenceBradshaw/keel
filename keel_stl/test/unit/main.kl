// The kl package's unit tests: every test in this program's modules, run by `kl::run_tests`.
import kl::test;
import hash_control_tests;
import map_tests;
import os_tests;
import ordered_map_tests;
import ordered_set_tests;
import pair_tests;
import reassignment_tests;
import ring_tests;
import set_tests;
import time_tests;

i32 main( const ref str[] args )
{
    return kl::run_tests( @functions_of( kl::test_case ), args );
}
