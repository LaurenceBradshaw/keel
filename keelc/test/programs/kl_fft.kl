// kl's transforms, solved at -O3 past what solve reads whole, each give what their definition run as a
// loop gives: dft and idft at 128, rdft and irdft at an even and an odd length, and dft in f32, to
// within f32's rounding.

import kl::complex;
import kl::fft;
import kl::math;

kl::complex<f64> turn( u64 e, u64 n, f64 sign )
{
    const f64 t = sign * 2.0 * kl::pi * cast<f64>( e % n ) / cast<f64>( n );
    return kl::complex<f64> { kl::cos( t ), kl::sin( t ) };
}

f64 gap( kl::complex<f64> a, kl::complex<f64> b )
{
    return kl::max( kl::abs( a.re - b.re ), kl::abs( a.im - b.im ) );
}

kl::complex<f64> input( u64 i )
{
    return kl::complex<f64> { cast<f64>( i % 7 ) * 0.5 + 1.0, 2.0 - cast<f64>( i % 5 ) * 0.25 };
}

bool complex_agrees<u64 N>()
{
    kl::complex<f64>[N] x = [ kl::complex<f64> {}, .. ];
    for( u64 i : 0..N )
    {
        x[i] = input( i );
    }
    const kl::complex<f64>[N] y = kl::dft( x );
    const kl::complex<f64>[N] z = kl::idft( x );
    for( u64 k : 0..N )
    {
        kl::complex<f64> f = kl::complex<f64> {};
        kl::complex<f64> b = kl::complex<f64> {};
        for( u64 j : 0..N )
        {
            f = f + x[j] * turn( j * k, N, -1.0 );
            b = b + x[j] * turn( j * k, N, 1.0 );
        }
        if( gap( y[k], f ) > 1e-9 || gap( z[k], b / cast<f64>( N ) ) > 1e-12 )
        {
            return false;
        }
    }
    return true;
}

bool real_agrees<u64 N>()
{
    f64[N] x = [ 0.0, .. ];
    for( u64 i : 0..N )
    {
        x[i] = cast<f64>( i % 11 ) - 3.5;
    }
    const kl::complex<f64>[N / 2 + 1] y = kl::rdft( x );
    for( u64 k : 0..N / 2 + 1 )
    {
        kl::complex<f64> f = kl::complex<f64> {};
        for( u64 j : 0..N )
        {
            f = f + turn( j * k, N, -1.0 ) * x[j];
        }
        if( gap( y[k], f ) > 1e-9 )
        {
            return false;
        }
    }
    const f64[N] back = kl::irdft<f64, N>( y );
    for( u64 j : 0..N )
    {
        if( kl::abs( back[j] - x[j] ) > 1e-12 )
        {
            return false;
        }
    }
    return true;
}

bool narrow_agrees<u64 N>()
{
    kl::complex<f32>[N] x = [ kl::complex<f32> {}, .. ];
    for( u64 i : 0..N )
    {
        const kl::complex<f64> w = input( i );
        x[i]                     = kl::complex<f32> { cast<f32>( w.re ), cast<f32>( w.im ) };
    }
    const kl::complex<f32>[N] y = kl::dft( x );
    for( u64 k : 0..N )
    {
        kl::complex<f32> f = kl::complex<f32> {};
        for( u64 j : 0..N )
        {
            const kl::complex<f64> w = turn( j * k, N, -1.0 );
            f                        = f + x[j] * kl::complex<f32> { cast<f32>( w.re ), cast<f32>( w.im ) };
        }
        if( kl::abs( y[k].re - f.re ) > 1e-3 || kl::abs( y[k].im - f.im ) > 1e-3 )
        {
            return false;
        }
    }
    return true;
}

i32 main()
{
    return complex_agrees<128>() && real_agrees<128>() && real_agrees<99>() && narrow_agrees<96>() ? 0 : 1;
}
