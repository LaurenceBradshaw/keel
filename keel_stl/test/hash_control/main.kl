// `kl::hash_control`'s word tricks against byte-at-a-time answers, over control words mixing empty,
// deleted and full bytes; then its slot sizes and its growth accounting. Each check returns its own
// code.
import kl::hash_control;

// Byte `i` of `word`.
u64 byte_of( u64 word, u64 i )
{
    return ( word >> ( i * 8 ) ) & 0xff;
}

// The top bit of byte `i`.
u64 flag( u64 i )
{
    return cast<u64>( 0x80 ) << ( i * 8 );
}

// A control byte from a random number: empty, deleted, or one of the tags.
u64 control_byte( u64 r )
{
    switch( r % 4 )
    {
        case 0:
            return 0xff;
        case 1:
            return 0x80;
        default:
            return ( r >> 8 ) % 4; // few tags, so matches are common
    }
}

u64 next_random( ref u64 state )
{
    state ^= state << 13;
    state ^= state >> 7;
    state ^= state << 17;
    return state;
}

i32 main()
{
    u64 state = 0x2545_f491_4f6c_dd1d;

    for( u64 round = 0; round < 10000; round++ )
    {
        u64 word = 0;

        for( u64 i = 0; i < 8; i++ )
        {
            word |= control_byte( next_random( ref state ) ) << ( i * 8 );
        }

        const u64 tag  = next_random( ref state ) % 4;
        const u64 tags = tag * 0x0101_0101_0101_0101;

        u64 empty  = 0;
        u64 vacant = 0;
        u64 found = 0;

        for( u64 i = 0; i < 8; i++ )
        {
            if( byte_of( word, i ) == 0xff )
            {
                empty |= flag( i );
            }

            if( byte_of( word, i ) >= 0x80 )
            {
                vacant |= flag( i );
            }

            if( byte_of( word, i ) == tag )
            {
                found |= flag( i );
            }
        }

        if( kl::hash_control::match_empty( word ) != empty || kl::hash_control::match_free( word ) != vacant )
        {
            return 1;
        }

        // Every true match is flagged; anything else flagged is a full byte, never a vacant one.
        const u64 matched = kl::hash_control::match_tags( word, tags );

        if( ( matched & found ) != found || ( matched & vacant ) != 0 )
        {
            return 2;
        }

        if( vacant != 0 )
        {
            u64 first = 0;

            while( ( vacant & flag( first ) ) == 0 )
            {
                first++;
            }

            if( kl::hash_control::lowest( vacant ) != first )
            {
                return 3;
            }
        }
    }

    if( kl::hash_control::slots_for( 0 ) != 0 || kl::hash_control::slots_for( 1 ) != 8 || kl::hash_control::slots_for( 7 ) != 8 ||
        kl::hash_control::slots_for( 8 ) != 16 || kl::hash_control::slots_for( 1000 ) != 2048 )
    {
        return 4;
    }

    // Slot 3 filled and emptied: its group still has empty slots, so the slot is empty again and
    // the room comes back.
    kl::hash_control control = kl::hash_control( 8, 1, 2 );

    control.occupy( 3, 5 );

    if( !control.is_full( 3 ) || control.is_full( 4 ) || control.size() != 1 || control.capacity() != 7 )
    {
        return 5;
    }

    control.vacate( 3 );

    if( control.is_full( 3 ) || control.size() != 0 || control.capacity() != 7 || control.free_slot( 3 ) != 0 )
    {
        return 6;
    }

    // A full group leaves a tombstone, which costs room until the table is rebuilt.
    for( u64 i = 0; i < 8; i++ )
    {
        control.occupy( i, i );
    }

    control.vacate( 3 );

    if( control.size() != 7 || control.capacity() != 6 || control.free_slot( 0 ) != 3 )
    {
        return 7;
    }

    control.occupy( 3, 3 );

    if( control.capacity() != 7 || control.needs_growth() )
    {
        return 8;
    }

    control.clear();

    if( control.size() != 0 || control.capacity() != 7 || control.is_full( 0 ) )
    {
        return 9;
    }

    return 0;
}
