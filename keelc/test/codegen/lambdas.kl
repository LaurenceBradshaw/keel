// A captureless lambda as an `fn` value: its own function, whose address is the value.
i32 apply( fn( i32 ) -> i32 f, i32 x ) { return f( x ); }

void bump( fn( ref i32 ) -> void f, ref i32 x ) { f( ref x ); }

struct Op { fn( i32, i32 ) -> i32 combine; };

fn( i32 ) -> i32 doubler() { return fn[]( x ) { return x * 2; }; }

i32 main()
{
    fn( i32 ) -> i32 inc = fn[]( i32 x ) -> i32 { return x + 1; };
    if( inc( 1 ) != 2 ) { return 1; }

    if( apply( fn[]( x ) -> i32 { return x * x; }, 5 ) != 25 ) { return 2; }

    i32 n = 1;
    bump( fn[]( y ) { y += 10; }, ref n );
    if( n != 11 ) { return 3; }

    Op add = Op { fn[]( a, b ) { return a + b; } };
    if( add.combine( 3, 4 ) != 7 ) { return 4; }

    fn( i32 ) -> i32 d = doubler();
    if( d( 21 ) != 42 ) { return 5; }

    auto square = fn[]( i32 x ) -> i32 { return x * x; };
    if( square( 6 ) != 36 ) { return 6; }

    fn() -> void nothing = fn[]() { };
    nothing();

    return 0;
}
