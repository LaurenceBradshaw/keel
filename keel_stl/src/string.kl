import list;
import optional;

/// Why `string::parse_i64` refused its text.
enum parse_error
{
    /// There are no digits: the text is empty, or only `-`.
    no_digits,
    /// The byte at `index` cannot continue the number.
    invalid_digit( u64 index ),
    /// The number lies outside the range of `i64`.
    overflow
};

/// A growable sequence of bytes that owns its storage.
///
/// The bytes are not checked to be UTF-8, and every index and size counts bytes.
class string implements textual, equatable, hashable, from<str>, from<u64>, from<i64>,
    from<joined_text>
{
    /// --- Construction ---

    /// An empty string.
    string()
    {
        data_ = nullptr;
        size_ = 0;
        cap_ = 0;
    }

    /// A string holding a copy of the bytes of `text`.
    string( const ref textual text )
    {
        const ref u8[] bytes = text.as_text();

        unsafe
        {
            data_ = alloc<u8>( bytes.size );
        }

        size_ = bytes.size;
        cap_ = bytes.size;
        for( u64 i = 0; i < bytes.size; i++ )
        {
            unsafe
            {
                data_[i] = bytes[ i ];
            }
        }
    }

    /// An empty string with room for `capacity` bytes before it reallocates.
    public static string with_capacity( u64 capacity )
    {
        string result = string();
        unsafe
        {
            result.data_ = alloc<u8>( capacity );
        }

        result.size_ = 0;
        result.cap_ = capacity;
        return result;
    }

    ~string()
    {
        unsafe
        {
            free( data_ );
        }
    }

    /// `text`'s bytes, taken over rather than copied.
    public static string from( move joined_text text )
    {
        string result = string();
        result.size_ = text.size();
        result.cap_ = result.size_;
        result.data_ = text.release();
        return result;
    }

    /// A copy of `text`'s bytes.
    public static string from( move str text )
    {
        return string( text );
    }

    /// `value` written in decimal, with no leading zeros.
    public static string from( move u64 value )
    {
        if( value == 0 )
        {
            return string( "0" );
        }

        string result = string();
        while( value > 0 )
        {
            result.push( cast<u8>( 48 + value % 10 ) );
            value /= 10;
        }

        for( u64 i = 0; i < result.size_ / 2; i++ )
        {
            unsafe
            {
                const u8 low = result.data_[i];
                result.data_[i] = result.data_[result.size_ - 1 - i];
                result.data_[result.size_ - 1 - i] = low;
            }
        }

        return result;
    }

    /// `value` written in decimal, with a leading `-` if it is negative and no leading zeros.
    public static string from( move i64 value )
    {
        if( value >= 0 )
        {
            return from( cast<u64>( value ) );
        }

        u64 magnitude = wrap<u64>( 0 - value );
        string result = string();
        result.push( 45 ); // '-'
        result += from( magnitude );

        return result;
    }

    /// --- Size ---

    /// The number of bytes.
    public u64 size() const
    {
        return size_;
    }

    /// Whether the string holds no bytes.
    public bool is_empty() const
    {
        return size_ == 0;
    }

    /// --- Reading ---

    /// The bytes, borrowed. The string cannot change while they are held.
    public const ref u8[] as_text() const
    {
        unsafe
        {
            return data_[0..size_];
        }
    }

    /// The byte at `index`.
    ///
    /// ### Panics
    ///
    /// If `index` is not less than `size()`.
    public const ref u8 operator[]( u64 index ) const
    {
        if( index >= size() )
        {
            panic( "index out of range" );
        }

        unsafe
        {
            return data_[index];
        }
    }

    /// A new string holding the `count` bytes from index `start` on.
    ///
    /// ### Panics
    ///
    /// If those bytes do not all lie within the string.
    public string substring( u64 start, u64 count ) const
    {
        if( start > size() || count > size() - start )
        {
            panic( "substring out of range" );
        }

        string result = string::with_capacity( count );
        for( u64 i = 0; i < count; i++ )
        {
            unsafe
            {
                result.push( data_[start + i] );
            }
        }

        return result;
    }

    /// --- Searching ---

    /// Whether the string begins with the bytes of `prefix`; every string begins with `""`.
    public bool starts_with( const ref textual prefix ) const
    {
        const ref u8[] text = prefix.as_text();
        return matches_at( 0, text );
    }

    /// Whether the string ends with the bytes of `suffix`; every string ends with `""`.
    public bool ends_with( const ref textual suffix ) const
    {
        const ref u8[] text = suffix.as_text();
        if( text.size > size() )
        {
            return false;
        }

        return matches_at( size() - text.size, text );
    }

    /// The index of the first place `needle` occurs, or `none`. `""` is found at 0.
    public optional<u64> find( const ref textual needle ) const
    {
        const ref u8[] text = needle.as_text();

        if( text.size > size() )
        {
            return optional::none;
        }

        for( u64 i = 0; i <= size() - text.size; i++ )
        {
            if( matches_at( i, text ) )
            {
                return optional::some( i );
            }
        }

        return optional::none;
    }

    /// The index of the last place `needle` occurs, or `none`. `""` is found at `size()`.
    public optional<u64> rfind( const ref textual needle ) const
    {
        const ref u8[] text = needle.as_text();

        if( text.size > size() )
        {
            return optional::none;
        }

        u64 i = size() - text.size;
        while( true )
        {
            if( matches_at( i, text ) )
            {
                return optional::some( i );
            }

            if( i == 0 )
            {
                break;
            }

            i--;
        }

        return optional::none;
    }

    /// The pieces between each occurrence of `separator`, in order, empty ones kept: `"a\nb\n"`
    /// split on `"\n"` gives `a`, `b` and an empty piece.
    ///
    /// ### Panics
    ///
    /// If `separator` is empty.
    public list<string> split( const ref textual separator ) const
    {
        const ref u8[] text = separator.as_text();
        
        if( text.size == 0 )
        {
            panic( "split on an empty separator" );
        }

        u64 start = 0;
        list<string> pieces = list<string>();
        for( u64 i = 0; i + text.size <= size(); i++ )
        {
            if( matches_at( i, text ) )
            {
                pieces.push( substring( start, i - start ) );
                start = i + text.size;
                i += text.size - 1;
            }
        }
        
        pieces.push( substring( start, size() - start ) );
        return pieces;
    }

    /// A new string with every occurrence of `pattern` replaced, matched left to right without
    /// overlap: `"a.b.c"` with `"."` replaced by `"-"` gives `"a-b-c"`.
    ///
    /// ### Panics
    ///
    /// If `pattern` is empty.
    public string replace( const ref textual pattern, const ref textual replacement ) const
    {
        const ref u8[] pattern_bytes = pattern.as_text();
        const ref u8[] replacement_bytes = replacement.as_text();

        if( pattern_bytes.size == 0 )
        {
            panic( "replace with an empty pattern" );
        }

        string result = string::with_capacity( size() );

        u64 i = 0;
        while( i < size() )
        {
            if( matches_at( i, pattern_bytes ) )
            {
                result.append( replacement_bytes );
                i += pattern_bytes.size;
            }
            else
            {
                unsafe
                {
                    result.push( data_[i] );
                }
                i++;
            }
        }

        return result;
    }

    /// --- Trimming ---

    /// A new string without the leading whitespace, as `trim` counts it.
    public string trim_start() const
    {
        u64 start = 0;
        while( start < size() && is_space( as_text()[start] ) )
        {
            start++;
        }

        return substring( start, size() - start );
    }

    /// A new string without the trailing whitespace, as `trim` counts it.
    public string trim_end() const
    {
        u64 end = size();
        while( end > 0 && is_space( as_text()[end - 1] ) )
        {
            end--;
        }

        return substring( 0, end );
    }

    /// A new string without leading or trailing whitespace: space, `\t`, `\n`, `\v`, `\f` and `\r`.
    public string trim() const
    {
        u64 start = 0;
        while( start < size() && is_space( as_text()[start] ) )
        {
            start++;
        }

        u64 end = size();
        while( end > start && is_space( as_text()[end - 1] ) )
        {
            end--;
        }

        return substring( start, end - start );
    }

    /// The rest of the string after `prefix`, or `none` if it does not begin with `prefix`.
    public optional<string> strip_prefix( const ref textual prefix ) const
    {
        if( starts_with( prefix ) )
        {
            const u64 prefix_size = prefix.as_text().size;
            return optional::some( substring( prefix_size, size() - prefix_size ) );
        }

        return optional::none;
    }

    /// The string before `suffix`, or `none` if it does not end with `suffix`.
    public optional<string> strip_suffix( const ref textual suffix ) const
    {
        if( ends_with( suffix ) )
        {
            const u64 suffix_size = suffix.as_text().size;
            return optional::some( substring( 0, size() - suffix_size ) );
        }

        return optional::none;
    }

    /// --- Changing ---

    /// Adds the byte `value` at the end.
    public void push( u8 value )
    {
        if( size_ == cap_ )
        {
            reallocate( cap_ > 0 ? cap_ * 2 : 1 );
        }

        unsafe
        {
            data_[size_] = value;
        }
        size_ += 1;
    }

    /// Removes the last byte and returns it.
    ///
    /// ### Panics
    ///
    /// If the string is empty.
    public u8 pop()
    {
        if( size_ == 0 )
        {
            panic( "the string is empty" );
        }
        size_ -= 1;
        unsafe
        {
            return data_[size_];
        }
    }

    /// Adds a copy of every byte of `bytes` at the end.
    public void append( const ref u8[] bytes )
    {
        for( u64 i = 0; i < bytes.size; i++ )
        {
            push( bytes[i] );
        }
    }

    /// Adds a copy of every byte of `other` at the end.
    public void operator+=( const ref textual other )
    {
        const ref u8[] text = other.as_text();
        append( text );
    }

    /// A new string holding these bytes and then `other`'s bytes.
    public string operator+( const ref textual other ) const
    {
        const ref u8[] text = other.as_text();
        string result = string::with_capacity( size() + text.size );

        for( u64 i = 0; i < size(); i++ )
        {
            result.push( as_text()[i] );
        }

        for( u64 i = 0; i < text.size; i++ )
        {
            result.push( text[i] );
        }

        return result;
    }

    /// Removes every byte and releases the storage.
    public void clear()
    {
        unsafe
        {
            free( data_ );
        }
        data_ = nullptr;
        size_ = 0;
        cap_ = 0;
    }

    /// --- Comparing and hashing ---

    /// Whether both strings hold the same bytes in the same order.
    public bool operator==( const ref string other ) const
    {
        if( size() != other.size() )
        {
            return false;
        }

        for( u64 i = 0; i < size(); i++ )
        {
            if( as_text()[i] != other[i] )
            {
                return false;
            }
        }

        return true;
    }

    /// Feeds the bytes and their count, as `write_bytes` does, so a string hashes as a literal of
    /// the same text would.
    public void hash( ref hasher h ) const
    {
        h.write_bytes( as_text() );
    }

    /// --- Parsing ---

    /// The `i64` the string writes in decimal.
    ///
    /// The text is an optional `-` and then one or more digits `0` to `9`, which may have leading
    /// zeros. Nothing else is read: not a `+`, whitespace or a separator.
    ///
    /// ### Errors
    ///
    /// `no_digits` if there are no digits, `invalid_digit` naming the first byte that cannot continue
    /// the number, and `overflow` as soon as the number leaves the range of `i64`.
    public result<i64, parse_error> parse_i64() const
    {
        const bool is_negative = !is_empty() && as_text()[0] == 45; // '-'
        const u64 start = is_negative ? 1 : 0;
        const u64 limit = is_negative ? 9223372036854775808 : 9223372036854775807;

        if( size() == start )
        {
            return result::err( parse_error::no_digits );
        }

        u64 magnitude = 0;
        for( u64 i = start; i < size(); i++ )
        {
            const u8 byte = as_text()[i];
            if( byte < 48 || byte > 57 ) // '0'..'9'
            {
                return result::err( parse_error::invalid_digit( i ) );
            }
            
            const u64 digit = byte - 48;

            if( magnitude > (limit - digit) / 10 )
            {
                return result::err( parse_error::overflow );
            }

            magnitude = magnitude * 10 + digit;
        }

        return result::ok( is_negative ? wrap<i64>( 0 - magnitude ) : cast<i64>( magnitude ) );
    }

    /// --- Internals ---

    /// Whether the bytes of `text` occur at index `at`.
    private bool matches_at( u64 at, const ref u8[] text ) const
    {
        if( at + text.size > size() )
        {
            return false;
        }

        for( u64 i = 0; i < text.size; i++ )
        {
            if( as_text()[at + i] != text[i] )
            {
                return false;
            }
        }

        return true;
    }

    /// Moves the bytes into a new block of `n` bytes and frees the old one.
    private void reallocate( u64 n )
    {
        u8[*] new_data;
        unsafe
        {
            new_data = alloc<u8>( n );
            for( u64 i = 0; i < size_; i++ )
            {
                new_data[i] = data_[i];
            }
            free( data_ );
        }

        data_ = new_data;
        cap_ = n;
    }

    // Bytes below `size_` are written, the rest of the `cap_` are raw.
    private u8[*] data_;
    private u64 size_;
    private u64 cap_;
};

/// Whether `a` and `b` hold the same bytes in the same order.
bool same_text( const ref textual a, const ref textual b )
{
    const ref u8[] a_bytes = a.as_text();
    const ref u8[] b_bytes = b.as_text();

    if( a_bytes.size != b_bytes.size )
    {
        return false;
    }

    for( u64 i : 0..a_bytes.size )
    {
        if( a_bytes[i] != b_bytes[i] )
        {
            return false;
        }
    }

    return true;
}

/// Whether `byte` is ASCII whitespace.
private bool is_space( u8 byte )
{
    return byte == 32 || (byte >= 9 && byte <= 13); // ' ', '\t', '\n', '\v', '\f', '\r'
}

/// The parts with `separator` between each pair: `join( [ "a", "b" ], ", " )` gives `"a, b"`.
string join<T>( const ref T[] parts, const ref textual separator )
    where T : textual
{
    const ref u8[] between = separator.as_text();
    u64 total = 0;

    for( u64 i : 0..parts.size )
    {
        total += parts[i].as_text().size;
    }

    if( parts.size > 1 )
    {
        total += between.size * (parts.size - 1);
    }

    string result = string::with_capacity( total );

    for( u64 i : 0..parts.size )
    {
        if( i > 0 )
        {
            result.append( between );
        }

        result.append( parts[i].as_text() );
    }

    return result;
}
