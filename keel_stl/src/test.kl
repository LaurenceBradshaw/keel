// Unit tests: named test functions, checks that report their caller's line, and a runner that
// gives each test a process of its own.

import console;
import list;
import optional;
import string;

// The runtime's calls.
private extern i32 kl_rt_fork( i64* pid );
private extern never kl_rt_exit( i32 code );
private extern i32 kl_rt_process_wait( i64 pid, i32* status );

/// --- Writing tests ---

/// A test and the name `run_tests` reports it by.
struct test_case
{
    /// Matched by the runner's filters and printed in its report.
    str name;
    /// The test itself.
    fn( ref test_context ) -> void body;
};

/// What a test checks through. A failed check is counted and reported, and the test goes on; a
/// failed `require` ends it.
class test_context
{
    /// A context with no failures.
    public test_context()
    {
        failures_ = 0;
    }

    /// Whether any check has failed.
    public bool failed() const
    {
        return failures_ != 0;
    }

    /// Counts a failure if `condition` is false, reporting the line that called it.
    @located
    public void check( bool condition )
    {
        if( !condition )
        {
            failures_ += 1;
            eprint_location();
            eprintln( "check failed" );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( i64 a, i64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            eprint( "check_eq failed: " );
            eprint( a );
            eprint( " != " );
            eprint( b );
            eprint( "\n" );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( u64 a, u64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            eprint( "check_eq failed: " );
            eprint( a );
            eprint( " != " );
            eprint( b );
            eprint( "\n" );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it. A NaN
    /// equals nothing, itself included.
    @located
    public void check_eq( f64 a, f64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            eprint( "check_eq failed: " );
            eprint( a );
            eprint( " != " );
            eprint( b );
            eprint( "\n" );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( bool a, bool b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            eprint( "check_eq failed: " );
            eprint( a );
            eprint( " != " );
            eprint( b );
            eprint( "\n" );
        }
    }

    /// Counts a failure if `a` and `b` hold different bytes, reporting both, quoted, and the line
    /// that called it.
    @located
    public void check_eq( const ref textual a, const ref textual b )
    {
        if( !same_text( a, b ) )
        {
            failures_ += 1;
            eprint_location();
            eprint( "check_eq failed: \"" );
            eprint( a );
            eprint( "\" != \"" );
            eprint( b );
            eprint( "\"\n" );
        }
    }

    /// Ends the test if `condition` is false, as a `panic` at the line that called it.
    @located
    public void require( bool condition )
    {
        if( !condition )
        {
            panic( "require failed", @caller() );
        }
    }

    // `file:line: ` of the check's caller, to stderr.
    @located
    private void eprint_location()
    {
        eprint( @caller().file );
        eprint( ":" );
        eprint( @caller().line );
        eprint( ": " );
    }

    private u64 failures_;
};

/// --- Running tests ---

// Whether `name` contains any filter; with none, every test is selected.
private bool selected( str name, const ref list<string> filters )
{
    if( filters.is_empty() )
    {
        return true;
    }

    string text = string::from( name );
    const ref string[] each = filters.as_run();

    for( u64 i : 0..each.size )
    {
        if( is_some( text.find( each[i] ) ) )
        {
            return true;
        }
    }

    return false;
}

// Runs `t` and answers how it ended: 0 passed, 1 a check failed, 134 a panic, or 128 and a signal.
private i32 run_one( const ref test_case t, bool fork )
{
    if( !fork )
    {
        test_context context = test_context();
        t.body( ref context );
        return context.failed() ? 1 : 0;
    }

    i64 pid = 0;
    unsafe
    {
        i32 result = kl_rt_fork( &pid );
        if( result != 0 )
        {
            panic( "cannot fork" );
        }
    }

    if( pid == 0 )
    {
        test_context context = test_context();
        t.body( ref context );
        unsafe
        {
            kl_rt_exit( context.failed() ? 1 : 0 );
        }
    }

    i32 code = 0;
    unsafe
    {
        i32 result = kl_rt_process_wait( pid, &code );
        if( result != 0 )
        {
            panic( "cannot wait for test" );
        }
    }

    return code;
}

/// Runs the tests that `args` selects, each in a process of its own, and answers `main`'s exit
/// code: 0 when every test passed, 1 when any failed, 2 for an unknown option.
///
/// Each argument is an option or a filter. A test runs when its name contains any filter, or when
/// there is none.
/// - `--list` prints the selected names and runs nothing.
/// - `--no-fork` runs every test in this process, so a `panic` ends the run; for a debugger.
///
/// Each test's result is a line on stdout, `pass <name>` or `FAIL <name>`, then the counts.
i32 run_tests( const ref test_case[] tests, const ref str[] args )
{
    bool listing = false;
    bool fork = true;
    list<string> filters = list<string>();

    for( u64 i = 0; i < args.size; i++ )
    {
        string arg = string::from( args[i] );
        if( arg == "--list" )
        {
            listing = true;
        }
        else if( arg == "--no-fork" )
        {
            fork = false;
        }
        else if( arg.starts_with( "--" ) )
        {
            eprintln( "unknown option: " + arg );
            return 2;
        }
        else
        {
            filters.push( move arg );
        }
    }

    if( listing )
    {
        for( u64 i : 0..tests.size )
        {
            if( selected( tests[i].name, filters ) )
            {
                println( tests[i].name );
            }
        }
        return 0;
    }

    u64 n_passed = 0;
    u64 n_failed = 0;
    for( u64 i : 0..tests.size )
    {
        if( !selected( tests[i].name, filters ) )
        {
            continue;
        }

        const ref test_case t = tests[i];
        string name = string::from( t.name );
        i32 code = run_one( t, fork );
        if( code == 0 )
        {
            println( "pass " + name );
            n_passed++;
            continue;
        }
        else if( code == 1 )
        {
            println( "FAIL " + name );
        }
        else if( code == 134 )
        {
            println( "FAIL " + name + " (panic)" );
        }
        else if( code >= 128 )
        {
            println( "FAIL " + name + " (signal " + string::from( code - 128 ) + ")" );
        }
        else
        {
            println( "FAIL " + name + " (exit " + string::from( code ) + ")" );
        }
        n_failed++;
    }

    println( string::from( n_passed ) + " passed, " + string::from( n_failed ) + " failed" );
    return n_failed == 0 ? 0 : 1;
}
