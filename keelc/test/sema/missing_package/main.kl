// A package the command line does not name is one error, at the import, and nothing at each use.
import kl::shapes;

i32 measure( kl::Shape s )
{
    switch( s )
    {
        case kl::Shape::Circle( r ):
            return 3 * r * r;
        case kl::Shape::Square( a ):
            return a * a;
    }
}

i32 main()
{
    kl::Point p = kl::origin();
    kl::Point q = kl::Point { 1, 2 };
    kl::Box<i32> b = kl::Box<i32>::of( 9 );
    kl::Colour c = kl::Colour::Green;
    kl::Counter k = kl::Counter::zero();
    kl::made = kl::made + 10;
    return measure( kl::Shape::Circle( 2 ) ) + p.x + q.y + b.v + k.get();
}
