// DCT-IIs past what solve takes whole are read from their loops as a real sum and planned; each gives
// what the same loop unmarked gives, at a power of two and at 80.

import kl::console;
import kl::math;
import kl::trig;

@real_arithmetic
void solved<u64 N>( const ref f64[N] x, ref f64[N] y )
{
    for( u64 k = 0; k < N; k += 1 )
    {
        f64 s = 0.0;
        for( u64 n = 0; n < N; n += 1 )
        {
            s += x[n] * kl::cos( kl::pi / cast<f64>( N ) * ( cast<f64>( n ) + 0.5 ) * cast<f64>( k ) );
        }
        y[k] = s;
    }
}

void naive<u64 N>( const ref f64[N] x, ref f64[N] y )
{
    for( u64 k = 0; k < N; k += 1 )
    {
        f64 s = 0.0;
        for( u64 n = 0; n < N; n += 1 )
        {
            s += x[n] * kl::cos( kl::pi / cast<f64>( N ) * ( cast<f64>( n ) + 0.5 ) * cast<f64>( k ) );
        }
        y[k] = s;
    }
}

f64 gap( f64 a, f64 b )
{
    return a > b ? a - b : b - a;
}

bool agrees<u64 N>()
{
    f64[N] x = [ 0.0, .. ];
    for( u64 i = 0; i < N; i += 1 )
    {
        x[i] = cast<f64>( i % 7 ) * 0.5 - 1.0;
    }
    f64[N] a = [ 0.0, .. ];
    f64[N] b = [ 0.0, .. ];
    solved<N>( x, ref a );
    naive<N>( x, ref b );
    for( u64 k = 0; k < N; k += 1 )
    {
        if( gap( a[k], b[k] ) > 1e-9 )
        {
            kl::print( k );
            return false;
        }
    }
    return true;
}

i32 main()
{
    return agrees<128>() && agrees<80>() ? 0 : 1;
}
