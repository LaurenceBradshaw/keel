// `kl::_core`'s array kernels, each over a `T[N]` and a `kl::list`'s run, with a destination that
// is also a source, and a shape mismatch's panic.
import kl::_core::compare as kernel;
import kl::_core::elementwise as kernel;
import kl::_core::linear as kernel;
import kl::_core::reduce as kernel;
import kl::list;
import kl::math;
import kl::test::context;

private kl::list<i32> list_of<u64 N>( i32[N] values )
{
    kl::list<i32> l = kl::list<i32>();
    for( u64 i : 0..N )
    {
        l.push( values[i] );
    }
    return l;
}

// A destination that is also a source, as `a += a` hands the kernel.
private struct pairs
{
    i32[3] e;

    void operator+=( const ref pairs o )
    {
        kernel::zip_into( ref e, o.e, fn[]( i32 x, i32 y ) { return x + y; } );
    }
};

private void zip_and_map( ref kl::test::context c )
{
    i32[3] a = [ 1, 2, 3 ];
    i32[3] b = [ 10, 20, 30 ];
    i32[3] d = [ 0, 0, 0 ];
    kernel::zip( ref d, a, b, fn[]( i32 x, i32 y ) { return x + y; } );
    c.check( d == [ 11, 22, 33 ] );

    kernel::zip_scalar( ref d, a, 10, fn[]( i32 x, i32 s ) { return s - x; } );
    c.check( d == [ 9, 8, 7 ] );

    kernel::zip_into( ref d, b, fn[]( i32 x, i32 y ) { return x * y; } );
    c.check( d == [ 90, 160, 210 ] );

    kernel::map_into( ref d, fn[]( i32 x ) { return x / 10; } );
    c.check( d == [ 9, 16, 21 ] );

    f64[3] f = [ 0.0, 0.0, 0.0 ];
    kernel::map( ref f, a, fn[]( i32 x ) { return cast<f64>( x ) / 2.0; } );
    c.check( f == [ 0.5, 1.0, 1.5 ] );

    kernel::fill( ref d, 4 );
    c.check( d == [ 4, 4, 4 ] );

    kl::list<i32> l = list_of( [ 1, 2, 3 ] );
    kl::list<i32> m = list_of( [ 5, 5, 5 ] );
    ref i32[] r = l.as_run();
    kernel::zip( ref r, l.as_run(), m.as_run(), fn[]( i32 x, i32 y ) { return x - y; } );
    kernel::zip_into( ref r, m.as_run(), fn[]( i32 x, i32 y ) { return x + y; } );
    c.check( l[0] == 1 && l[1] == 2 && l[2] == 3 );

    pairs p = pairs { [ 1, 2, 3 ] };
    p += p;
    c.check( p.e == [ 2, 4, 6 ] );
}

private void element_shapes( ref kl::test::context c )
{
    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            i32[2] a = [ 1, 2 ];
            i32[3] d = [ 0, 0, 0 ];
            kernel::zip( ref d, a, d, fn[]( i32 x, i32 y ) { return x + y; } );
        }
    );
    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            kl::list<i32> l = list_of( [ 1, 2 ] );
            i32[3] d = [ 0, 0, 0 ];
            kernel::zip_into( ref d, l.as_run(), fn[]( i32 x, i32 y ) { return x + y; } );
        }
    );
}

private void equality( ref kl::test::context c )
{
    i32[3] a = [ 1, 2, 3 ];
    kl::list<i32> l = list_of( [ 1, 2, 3 ] );
    c.check( kernel::equal( a, l.as_run() ) );
    l[2] = 4;
    c.check( !kernel::equal( a, l.as_run() ) );
    i32[2] short_ = [ 1, 2 ];
    c.check( !kernel::equal( a, short_ ) );

    f64 infinity = kl::inf();
    f64 nan = infinity - infinity;
    f64[3] x = [ 1.0, 1000.0, infinity ];
    f64[3] y = [ 1.0 + 1e-10, 1000.0 + 1e-6, infinity ];
    c.check( kernel::approx_equal( x, y, 1e-8, 1e-9 ) );
    c.check( !kernel::approx_equal( x, y, 0.0, 1e-9 ) );

    f64[1] one = [ 1.0 ];
    f64[1] inf = [ infinity ];
    f64[1] not_a_number = [ nan ];
    c.check( !kernel::approx_equal( one, inf, 1.0, 1.0 ) );
    c.check( !kernel::approx_equal( inf, one, 1.0, 1.0 ) );
    c.check( !kernel::approx_equal( not_a_number, not_a_number, 1.0, 1.0 ) );
}

private void reductions( ref kl::test::context c )
{
    i32[4] a = [ 1, 2, 3, 4 ];
    kl::list<i32> l = list_of( [ 5, 6, 7, 8 ] );
    c.check_eq( kernel::sum( a ), 10 );
    c.check_eq( kernel::sum( l.as_run() ), 26 );
    c.check_eq( kernel::dot( a, l.as_run() ), 5 + 12 + 21 + 32 );

    kl::list<f64> none = kl::list<f64>();
    c.check_eq( kernel::sum( none.as_run() ), 0.0 );

    // In order: (1e16 + 1) + 1 loses both ones; any other order keeps one or both.
    f64[3] f = [ 1e16, 1.0, 1.0 ];
    c.check_eq( kernel::sum( f ), 1e16 );

    // Pairwise, as numpy adds: in order, a thousand tenths are 99.9999999999986.
    kl::list<f64> tenths = kl::list<f64>::filled( 1000, 0.1 );
    kl::list<f64> ones = kl::list<f64>::filled( 1000, 1.0 );
    c.check_eq( kernel::sum( tenths.as_run() ), 100.00000000000001 );
    c.check_eq( kernel::dot( tenths.as_run(), ones.as_run() ), 100.00000000000001 );

    // Down a strided axis as along a run: column 0 is 0, 0.1, ..., 99.9, column 1 is all 1.
    kl::list<f64> columns = kl::list<f64>::filled( 2000, 1.0 );
    for( u64 i : 0..1000 )
    {
        columns[2 * i] = cast<f64>( i ) * 0.1;
    }
    f64[2] spread = [ -1.0, -1.0 ];
    kernel::variance_axis( ref spread, columns.as_run(), 1, 1000, 2 );
    c.check_eq( spread[0], 833.3325000000001 );
    c.check_eq( spread[1], 0.0 );

    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            i32[2] b = [ 1, 2 ];
            i32[3] d = [ 1, 2, 3 ];
            i32 x = kernel::dot( b, d );
        }
    );
}

private void products( ref kl::test::context c )
{
    // 2 by 3 times 3 by 2.
    i32[6] a = [ 1, 2, 3, 4, 5, 6 ];
    kl::list<i32> b = list_of( [ 7, 8, 9, 10, 11, 12 ] );
    i32[4] d = [ -1, -1, -1, -1 ];
    kernel::matmul( ref d, a, b.as_run(), 2, 3, 2 );
    c.check( d == [ 58, 64, 139, 154 ] );

    // A row times a matrix, and a matrix times a column.
    i32[2] row = [ 0, 0 ];
    i32[3] ones = [ 1, 1, 1 ];
    kernel::matmul( ref row, ones, b.as_run(), 1, 3, 2 );
    c.check( row == [ 27, 30 ] );
    kernel::matmul( ref row, a, ones, 2, 3, 1 );
    c.check( row == [ 6, 15 ] );

    i32[6] t = [ 0, 0, 0, 0, 0, 0 ];
    kernel::transpose( ref t, a, 2, 3 );
    c.check( t == [ 1, 4, 2, 5, 3, 6 ] );

    kl::list<f64> eye = kl::list<f64>();
    for( u64 i : 0..9 )
    {
        eye.push( 7.0 );
    }
    ref f64[] e = eye.as_run();
    kernel::identity( ref e, 3 );
    c.check( eye[0] == 1.0 && eye[1] == 0.0 && eye[4] == 1.0 && eye[7] == 0.0 && eye[8] == 1.0 );

    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            i32[6] a = [ 1, 2, 3, 4, 5, 6 ];
            i32[4] b = [ 1, 2, 3, 4 ];
            i32[4] d = [ 0, 0, 0, 0 ];
            kernel::matmul( ref d, a, b, 2, 3, 2 );
        }
    );
    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            i32[6] a = [ 1, 2, 3, 4, 5, 6 ];
            i32[4] d = [ 0, 0, 0, 0 ];
            kernel::transpose( ref d, a, 2, 3 );
        }
    );
}
