// `kl::math`: the bits of a float, both ways, for each width, the square root, the classes, the
// roundings, and `abs`, `sign`, `min` and `max`.
import kl::math;
import kl::test::context;

private void bits_of_known_values( ref kl::test::context c )
{
    c.check_eq( kl::bits_of( 1.0 ), 0x3FF0000000000000 );
    c.check_eq( kl::bits_of( -0.0 ), 0x8000000000000000 );
    c.check_eq( kl::bits_of( 0.0 ), 0 );
    c.check_eq( kl::from_bits( 0x4000000000000000 ), 2.0 );

    f32 one = 1.0;
    c.check_eq( cast<u64>( kl::bits_of( one ) ), 0x3F800000 );
    c.check_eq( cast<f64>( kl::from_bits( wrap<u32>( 0xC0000000 ) ) ), -2.0 );
}

// A NaN keeps its payload, and a subnormal its one bit.
private void bits_round_trip( ref kl::test::context c )
{
    u64[5] patterns = [ 0x7FF8000000000123, 0xFFF0000000000001, 1, 0x8000000000000000, 0x7FEFFFFFFFFFFFFF ];
    for( u64 i = 0; i < 5; i++ )
    {
        c.check_eq( kl::bits_of( kl::from_bits( patterns[i] ) ), patterns[i] );
    }

    f64 nan = kl::from_bits( 0x7FF8000000000123 );
    c.check( nan != nan );
    c.check( kl::from_bits( 1 ) > 0.0 && kl::from_bits( 1 ) * 2.0 == kl::from_bits( 2 ) );

    u32[3] narrow = [ 0x7FC00042, 1, 0x80000000 ];
    for( u64 i = 0; i < 3; i++ )
    {
        c.check_eq( cast<u64>( kl::bits_of( kl::from_bits( narrow[i] ) ) ), cast<u64>( narrow[i] ) );
    }
}

// The square root, against C's, bit for bit: every class of input, from random bits.
extern f64 sqrt( f64 x );
extern f32 sqrtf( f32 x );

private void sqrt_matches_libm( ref kl::test::context c )
{
    u64 seed = 7;
    u64 missed = 0;
    for( u64 i = 0; i < 200000; i++ )
    {
        u64 b = next_random( ref seed );
        f64 x = kl::from_bits( b );
        f32 y = kl::from_bits( wrap<u32>( b >> 32 ) );
        unsafe
        {
            f64 want = sqrt( x );
            f32 narrow = sqrtf( y );
            if( want == want ? kl::bits_of( kl::sqrt( x ) ) != kl::bits_of( want ) : kl::sqrt( x ) == kl::sqrt( x ) )
            {
                missed++;
            }
            if( narrow == narrow ? kl::bits_of( kl::sqrt( y ) ) != kl::bits_of( narrow ) : kl::sqrt( y ) == kl::sqrt( y ) )
            {
                missed++;
            }
        }
    }
    c.check_eq( missed, 0 );

    f64 infinity = kl::from_bits( 0x7ff0000000000000 );
    c.check_eq( kl::bits_of( kl::sqrt( -0.0 ) ), 0x8000000000000000 );
    c.check_eq( kl::sqrt( infinity ), infinity );
    c.check( kl::sqrt( -1.0 ) != kl::sqrt( -1.0 ) );
    c.check( kl::sqrt( -infinity ) != kl::sqrt( -infinity ) );
    c.check_eq( kl::sqrt( kl::from_bits( cast<u64>( 4 ) ) ), kl::from_bits( 0x1e70000000000000 ) );
    c.check_eq( kl::sqrt( 0.25 ), 0.5 );
}

private u64 next_random( ref u64 seed )
{
    seed = wrap<u64>( seed * 6364136223846793005 + 1442695040888963407 );
    return seed;
}

// Each rounding's direction, at halves and both signs.
private void roundings_by_direction( ref kl::test::context c )
{
    c.check_eq( kl::truncated<i32>( 2.7 ), 2 );
    c.check_eq( kl::truncated<i32>( -2.7 ), -2 );
    c.check_eq( kl::rounded<i32>( 2.49 ), 2 );
    c.check_eq( kl::rounded<i32>( 2.5 ), 3 );
    c.check_eq( kl::rounded<i32>( -2.5 ), -3 );
    c.check_eq( kl::floored<i32>( 2.5 ), 2 );
    c.check_eq( kl::floored<i32>( -2.5 ), -3 );
    c.check_eq( kl::ceiled<i32>( 2.1 ), 3 );
    c.check_eq( kl::ceiled<i32>( -2.1 ), -2 );
    c.check_eq( kl::floored<i64>( 0.5 ), 0 );
    c.check_eq( kl::ceiled<i64>( -0.5 ), 0 );
    c.check_eq( kl::rounded<i32>( -0.0 ), 0 );

    f32 narrow = -0.4;
    c.check_eq( kl::rounded<i8>( narrow ), 0 );
    narrow = 7.5;
    c.check_eq( cast<u64>( kl::floored<u8>( narrow ) ), 7 );
}

// Whole values past 2^52, and both ends of the 64-bit integers.
private void roundings_at_the_edges( ref kl::test::context c )
{
    c.check_eq( kl::truncated<i64>( 4503599627370497.0 ), 4503599627370497 );
    c.check_eq( kl::truncated<u64>( 18446744073709549568.0 ), 18446744073709549568 );
    c.check_eq( kl::truncated<i64>( -9223372036854775808.0 ), cast<i64>( -9223372036854775807 ) - 1 );
    c.check_eq( cast<u64>( kl::rounded<u8>( 254.5 ) ), 255 );
}

// A NaN and the two infinities, at each width, and the values beside them.
private void classes_of_floats( ref kl::test::context c )
{
    f64 infinity = kl::from_bits( 0x7ff0000000000000 );
    f64 nan = kl::from_bits( 0x7ff8000000000000 );
    c.check( kl::is_nan( nan ) && !kl::is_nan( infinity ) && !kl::is_nan( 0.0 ) );
    c.check( kl::is_inf( infinity ) && kl::is_inf( -infinity ) && !kl::is_inf( nan ) );
    c.check( !kl::is_inf( kl::from_bits( 0x7fefffffffffffff ) ) );

    f32 wide = kl::from_bits( wrap<u32>( 0x7f800000 ) );
    f32 odd = kl::from_bits( wrap<u32>( 0x7fc00000 ) );
    f32 one = 1.0;
    c.check( kl::is_inf( wide ) && kl::is_inf( -wide ) && !kl::is_inf( odd ) && !kl::is_inf( one ) );
    c.check( kl::is_nan( odd ) && !kl::is_nan( wide ) && !kl::is_nan( one ) );
}

// `-0.0` loses its sign under `abs`, and a NaN wins `min` and `max` from either side.
private void sign_and_order( ref kl::test::context c )
{
    i32 neg   = -3;
    u8  small = 3;
    f64 zero  = -0.0;
    f64 half  = -2.5;
    c.check_eq( kl::abs( neg ), 3 );
    c.check_eq( cast<u64>( kl::abs( small ) ), 3 );
    c.check_eq( kl::bits_of( kl::abs( zero ) ), 0 );
    c.check_eq( kl::abs( half ), 2.5 );

    u32 seven = 7;
    i32 none  = 0;
    c.check_eq( kl::sign( neg ), -1 );
    c.check_eq( cast<u64>( kl::sign( seven ) ), 1 );
    c.check_eq( kl::sign( none ), 0 );
    c.check_eq( kl::sign( half ), -1.0 );
    c.check_eq( kl::bits_of( kl::sign( zero ) ), 0x8000000000000000 );

    f64 nan = kl::from_bits( 0x7ff8000000000000 );
    f64 one = 1.0;
    c.check_eq( kl::min( neg, none ), -3 );
    c.check_eq( kl::max( neg, none ), 0 );
    c.check( kl::is_nan( kl::sign( nan ) ) );
    c.check( kl::is_nan( kl::abs( nan ) ) );
    c.check( kl::is_nan( kl::min( nan, one ) ) && kl::is_nan( kl::min( one, nan ) ) );
    c.check( kl::is_nan( kl::max( nan, one ) ) && kl::is_nan( kl::max( one, nan ) ) );
    i32 four = 4;
    c.check_eq( kl::min( none, neg, four ), -3 );
    c.check_eq( kl::max( neg, four, none ), 4 );
    c.check_eq( kl::max( neg ), -3 );
    c.check( kl::is_nan( kl::min( one, nan, half ) ) && kl::is_nan( kl::max( one, half, nan ) ) );
}
