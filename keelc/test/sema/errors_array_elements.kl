// PLAN D60: an element is written or read only once the whole array holds a value. These are flow
// errors, apart from errors_array_fill because a sema error stops the flow checks. A line ending
// `// error` reports exactly one error; every other line reports none.
struct S
{
    u64[2] arr;
    u64    n;
};

u64 field_first()
{
    S s;
    s.arr[0] = 1; // error
    s.n      = 2;
    return s.arr[1] + s.n;
}

void fill( out u64[2] a )
{
    a[0] = 1; // error
}

u64 on_some_paths( bool c )
{
    S s;
    if( c )
    {
        s.arr = [ 0, .. ];
    }
    s.arr[0] = 1; // error
    s.n      = 0;
    return s.arr[0] + s.n;
}

u64 read_first()
{
    S s;
    s.n = 1;
    return s.arr[1]; // error
}

void whole_first( out u64[2] a )
{
    a    = [ 0, .. ];
    a[1] = 3;
}

u64 whole_field()
{
    S s;
    s.arr    = [ 4, .. ];
    s.arr[1] = 5;
    s.n      = 6;
    return s.arr[1] + s.n;
}

i32 main()
{
    u64[2] a = [ 0, .. ];
    fill( out a );
    whole_first( out a );
    return 0;
}
