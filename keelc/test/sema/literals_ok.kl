// Every one of these needs no suffix: the annotation is what gives the literal its type.
i32 main()
{
    u8  a = 255; _ = a;
    u32 b = 42; _ = b;
    u64 c = 18446744073709551615; _ = c;
    i32 d = -2147483648; _ = d;      // fits only as a negation
    u64 e = 0b1111_1111; _ = e;
    u64 f = 0xdead_beef; _ = f;
    f64 g = 1_000.5; _ = g;
    bool h = true; _ = h;
    u8   i = 'A'; _ = i;             // D20: a code point is the byte it denotes
    u8   j = '\n'; _ = j;
    u8   k = '\xFF'; _ = k;
    u32  l = 'z'; _ = l;             // and fits any integer type wide enough
    return 0;
}
