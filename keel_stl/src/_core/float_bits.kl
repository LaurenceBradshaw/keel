// A float's bits and back, and the infinities and NaN, behind `kl::bits_of`, `kl::from_bits`,
// `kl::inf`, `kl::ninf` and `kl::nan`, for the modules `kl::math` imports and those that import neither.

/// The bits of `x`, sign first.
u64 bits_of( f64 x )
{
    unsafe
    {
        return *cast<u64*>( &x );
    }
}

/// The `f64` whose bits are `x`.
f64 from_bits( u64 x )
{
    unsafe
    {
        return *cast<f64*>( &x );
    }
}

/// The bits of `x`, sign first.
u32 bits_of( f32 x )
{
    unsafe
    {
        return *cast<u32*>( &x );
    }
}

/// The `f32` whose bits are `x`.
f32 from_bits( u32 x )
{
    unsafe
    {
        return *cast<f32*>( &x );
    }
}

/// Positive infinity.
f64 inf()
{
    return from_bits( 0x7ff0_0000_0000_0000 );
}

/// Negative infinity.
f64 ninf()
{
    return from_bits( 0xfff0_0000_0000_0000 );
}

/// A quiet NaN.
f64 nan()
{
    return from_bits( 0x7ff8_0000_0000_0000 );
}
