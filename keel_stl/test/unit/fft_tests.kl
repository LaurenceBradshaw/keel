// `kl::dft`, `idft`, `rdft` and `irdft` against numpy's `fft`, `ifft`, `rfft` and `irfft`, even and
// odd lengths, and `f32` beside `f64`.
import kl::complex;
import kl::fft;
import kl::math;
import kl::test::context;

private bool near( kl::complex<f64> a, f64 re, f64 im )
{
    return kl::abs( a.re - re ) <= 1e-12 && kl::abs( a.im - im ) <= 1e-12;
}

private void dft_and_idft( ref kl::test::context c )
{
    kl::complex<f64>[8] x = [ kl::complex<f64> {}, .. ];
    for( u64 i : 0..8 )
    {
        x[i] = kl::complex<f64> { cast<f64>( i ) + 1.0, cast<f64>( i % 3 ) };
    }
    const kl::complex<f64>[8] y = kl::dft( x );
    c.check( near( y[0], 36.0, 7.0 ) );
    c.check( near( y[1], -3.414213562373095, 8.65685424949238 ) );
    c.check( near( y[2], -2.0, 3.0 ) );
    c.check( near( y[3], -7.414213562373095, 0.6568542494923806 ) );
    c.check( near( y[4], -4.0, -1.0 ) );
    c.check( near( y[5], -0.5857864376269049, -2.6568542494923806 ) );
    c.check( near( y[6], -6.0, -5.0 ) );
    c.check( near( y[7], -4.585786437626905, -10.65685424949238 ) );
    const kl::complex<f64>[8] z = kl::idft( y );
    for( u64 i : 0..8 )
    {
        c.check( near( z[i], x[i].re, x[i].im ) );
    }

    const kl::complex<f64>[6] w = kl::idft( [
        kl::complex<f64> { 1.0, 2.0 },
        kl::complex<f64> { -1.0, 0.5 },
        kl::complex<f64> { 3.0, -1.0 },
        kl::complex<f64> { 0.25, 0.0 },
        kl::complex<f64> { 2.0, 2.0 },
        kl::complex<f64> { -2.0, -1.0 }
    ] );
    c.check( near( w[0], 0.5416666666666666, 0.41666666666666663 ) );
    c.check( near( w[1], -0.325160315720557, 0.4970084679281461 ) );
    c.check( near( w[2], -0.6078523861716623, 0.29166666666666663 ) );
    c.check( near( w[3], 1.4583333333333333, 0.5833333333333333 ) );
    c.check( near( w[4], 0.6911857195049956, 0.29166666666666663 ) );
    c.check( near( w[5], -0.7581730176127761, -0.0803418012614795 ) );
}

private void rdft_and_irdft( ref kl::test::context c )
{
    f64[8] r = [ 0.0, .. ];
    for( u64 i : 0..8 )
    {
        r[i] = cast<f64>( i * i ) - 3.0;
    }
    const kl::complex<f64>[5] h = kl::rdft( r );
    c.check( near( h[0], 116.0, 0.0 ) );
    c.check( near( h[1], -4.686291501015239, 77.25483399593904 ) );
    c.check( near( h[2], -24.0, 32.0 ) );
    c.check( near( h[3], -27.31370849898476, 13.254833995939045 ) );
    c.check( near( h[4], -28.0, 0.0 ) );
    const f64[8] back = kl::irdft<f64, 8>( h );
    for( u64 i : 0..8 )
    {
        c.check( kl::abs( back[i] - r[i] ) <= 1e-12 );
    }

    const kl::complex<f64>[3] odd = kl::rdft( [ 2.0, -1.0, 0.5, 3.0, -2.5 ] );
    c.check( near( odd[0], 2.0, 0.0 ) );
    c.check( near( odd[1], -1.9131189606246322, 0.04287835628845271 ) );
    c.check( near( odd[2], 5.913118960624633, -3.2593191691765933 ) );
    const f64[5] five = kl::irdft<f64, 5>( odd );
    c.check( kl::abs( five[3] - 3.0 ) <= 1e-12 );
}

// As numpy's irfft, y[0]'s imaginary part is not read, nor an even N's y[N / 2]'s.
private void irdft_drops_the_ends( ref kl::test::context c )
{
    const kl::complex<f64>[5] y = [
        kl::complex<f64> { 1.0, 5.0 },
        kl::complex<f64> { 2.0, -1.0 },
        kl::complex<f64> { 0.5, 0.25 },
        kl::complex<f64> { -1.0, 3.0 },
        kl::complex<f64> { 4.0, 7.0 }
    ];
    const f64[8] x    = kl::irdft<f64, 8>( y );
    const f64[8] want = [
        1.0, -0.2607233047033632, 1.5, -1.1963834764831844, 0.5, -0.6142766952966368, -0.5, 0.5713834764831844
    ];
    for( u64 i : 0..8 )
    {
        c.check( kl::abs( x[i] - want[i] ) <= 1e-12 );
    }

    const kl::complex<f64>[3] z = [ y[0], y[1], y[2] ];
    const f64[5] odd  = kl::irdft<f64, 5>( z );
    const f64[5] wide = [ 1.2000000000000002, 0.6070542779137826, -0.05519044407846385, -0.7156299491714732, -0.03623388466384565 ];
    for( u64 i : 0..5 )
    {
        c.check( kl::abs( odd[i] - wide[i] ) <= 1e-12 );
    }
}

// Computed in f64 and rounded once, so each part is the f64 transform's, rounded.
private void in_f32( ref kl::test::context c )
{
    kl::complex<f32>[8] x = [ kl::complex<f32> {}, .. ];
    for( u64 i : 0..8 )
    {
        x[i] = kl::complex<f32> { cast<f32>( i ) + 1.0, cast<f32>( i % 3 ) };
    }
    const kl::complex<f32>[8] y = kl::dft( x );
    c.check( y[1] == kl::complex<f32> { cast<f32>( -3.414213562373095 ), cast<f32>( 8.65685424949238 ) } );
    c.check( y[4] == kl::complex<f32> { -4.0, -1.0 } );
    const kl::complex<f32>[8] z = kl::idft( y );
    c.check( z[5] == x[5] );

    const kl::complex<f32>[5] h = kl::rdft( [ cast<f32>( -3.0 ), -2.0, 1.0, 6.0, 13.0, 22.0, 33.0, 46.0 ] );
    c.check( h[2] == kl::complex<f32> { -24.0, 32.0 } );
    const f32[8] back = kl::irdft<f32, 8>( h );
    c.check_eq( cast<f64>( back[7] ), 46.0 );
}
