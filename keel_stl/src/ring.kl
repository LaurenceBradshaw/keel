import iterable;
import optional;

/// A double-ended queue of at most `N` elements of `T`, held inline: it never allocates.
///
/// Elements are added and removed at either end in constant time, and indexed from 0 at the
/// front. Pushing onto a full ring panics, `try_push_back` hands the element back, and
/// `push_back_evict` makes room by removing the element at the other end. Dropping the ring drops
/// every element, back to front.
class ring<T, u64 N> implements iterable<T>, fixed_memory<T>
{
    ~ring()
    {
        clear();
    }

    /// --- Size and capacity ---

    /// The number of elements.
    public u64 size() const
    {
        return count_;
    }

    /// The most elements the ring can hold, `N`.
    public u64 capacity() const
    {
        return N;
    }

    /// Whether the ring holds no elements.
    public bool is_empty() const
    {
        return count_ == 0;
    }

    /// Whether the ring holds `N` elements, so a push would panic.
    public bool is_full() const
    {
        return count_ == N;
    }

    /// --- Reading ---

    /// The element `index` places from the front.
    ///
    /// ### Panics
    ///
    /// If `index` is not less than `size()`.
    public ref T operator[]( u64 index ) const
    {
        if( index >= count_ )
        {
            panic( "index out of range" );
        }

        unsafe
        {
            return slots_[slot( index )];
        }
    }

    /// The front element.
    ///
    /// ### Panics
    ///
    /// If the ring is empty.
    public ref T first() const
    {
        if( count_ == 0 )
        {
            panic( "the ring is empty" );
        }

        return this[0];
    }

    /// The back element.
    ///
    /// ### Panics
    ///
    /// If the ring is empty.
    public ref T last() const
    {
        if( count_ == 0 )
        {
            panic( "the ring is empty" );
        }

        return this[count_ - 1];
    }

    /// Each element from front to back, read-only: `for( const ref T x : xs )`. The body may not
    /// change the ring.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..count_ )
        {
            unsafe
            {
                yield( slots_[slot( i )] );
            }
        }
    }

    /// Each element from front to back, writable in place: `for( ref T x : xs )`. The body may not
    /// change the ring itself.
    public void operator:( ref T item )
    {
        for( u64 i : 0..count_ )
        {
            unsafe
            {
                yield( ref slots_[slot( i )] );
            }
        }
    }

    /// --- Adding ---

    /// Adds `value` at the back.
    ///
    /// ### Panics
    ///
    /// If the ring is full; `try_push_back` hands the element back instead.
    public void push_back( move T value )
    {
        if( count_ == N )
        {
            panic( "the ring is full" );
        }

        unsafe
        {
            slots_[slot( count_ )] = move value;
        }
        count_ += 1;
    }

    /// Adds `value` at the front, so it becomes the element at index 0.
    ///
    /// ### Panics
    ///
    /// If the ring is full; `try_push_front` hands the element back instead.
    public void push_front( move T value )
    {
        if( count_ == N )
        {
            panic( "the ring is full" );
        }

        head_ = head_ == 0 ? N - 1 : head_ - 1;
        unsafe
        {
            slots_[head_] = move value;
        }
        count_ += 1;
    }

    /// Adds `value` at the back, or hands it back in an `err` if the ring is full.
    public result<void, T> try_push_back( move T value )
    {
        if( is_full() )
        {
            return result::err( move value );
        }

        push_back( move value );
        return result::ok();
    }

    /// Adds `value` at the front, or hands it back in an `err` if the ring is full.
    public result<void, T> try_push_front( move T value )
    {
        if( is_full() )
        {
            return result::err( move value );
        }

        push_front( move value );
        return result::ok();
    }

    /// Adds `value` at the back, first removing and returning the front element if the ring is full.
    ///
    /// Returns `none` when there was room, so nothing was removed.
    public optional<T> push_back_evict( move T value )
    {
        if( !is_full() )
        {
            push_back( move value );
            return optional::none;
        }

        T old = pop_front();
        push_back( move value );
        return optional::some( move old );
    }

    /// Adds `value` at the front, first removing and returning the back element if the ring is full.
    ///
    /// Returns `none` when there was room, so nothing was removed.
    public optional<T> push_front_evict( move T value )
    {
        if( !is_full() )
        {
            push_front( move value );
            return optional::none;
        }

        T old = pop_back();
        push_front( move value );
        return optional::some( move old );
    }

    /// --- Removing ---

    /// Removes the front element and returns it.
    ///
    /// ### Panics
    ///
    /// If the ring is empty; `try_pop_front` answers `none` instead.
    public T pop_front()
    {
        if( count_ == 0 )
        {
            panic( "the ring is empty" );
        }

        u64 front = head_;
        head_     = slot( 1 );
        count_ -= 1;
        unsafe
        {
            return move slots_[front];
        }
    }

    /// Removes the back element and returns it.
    ///
    /// ### Panics
    ///
    /// If the ring is empty; `try_pop_back` answers `none` instead.
    public T pop_back()
    {
        if( count_ == 0 )
        {
            panic( "the ring is empty" );
        }

        count_ -= 1;
        unsafe
        {
            return move slots_[slot( count_ )];
        }
    }

    /// Removes the front element and returns it, or `none` if the ring is empty.
    public optional<T> try_pop_front()
    {
        if( count_ == 0 )
        {
            return optional::none;
        }

        return optional::some( pop_front() );
    }

    /// Removes the back element and returns it, or `none` if the ring is empty.
    public optional<T> try_pop_back()
    {
        if( count_ == 0 )
        {
            return optional::none;
        }

        return optional::some( pop_back() );
    }

    /// Drops every element, back to front.
    public void clear()
    {
        while( count_ > 0 )
        {
            count_ -= 1;
            unsafe
            {
                _ = move slots_[slot( count_ )];
            }
        }
        head_ = 0;
    }

    /// --- Rearranging ---

    /// Puts `value` `index` places from the front and returns the element that was there.
    ///
    /// ### Panics
    ///
    /// If `index` is not less than `size()`.
    public T replace( u64 index, move T value )
    {
        if( index >= count_ )
        {
            panic( "index out of range" );
        }

        u64 at = slot( index );
        unsafe
        {
            T result  = move slots_[at];
            slots_[at] = move value;
            return result;
        }
    }

    /// Exchanges the elements `a` and `b` places from the front.
    ///
    /// ### Panics
    ///
    /// If either is not less than `size()`.
    public void swap( u64 a, u64 b )
    {
        if( a >= count_ || b >= count_ )
        {
            panic( "index out of range" );
        }

        if( a == b )
        {
            return;
        }

        u64 x = slot( a );
        u64 y = slot( b );
        unsafe
        {
            T temp    = move slots_[x];
            slots_[x] = move slots_[y];
            slots_[y] = move temp;
        }
    }

    /// --- Internals ---

    // The slot holding the element `index` places from the front, for `index` up to `N`.
    private u64 slot( u64 index ) const
    {
        return head_ + index - ( head_ + index >= N ? N : cast<u64>( 0 ) );
    }

    // `count_` elements are live, from slot `head_` on, wrapping at `N`; the rest are raw.
    private T[?N] slots_;
    private u64   head_  = 0;
    private u64   count_ = 0;
};

/// Two rings are equal when they hold equal elements in the same order from the front.
implements<T, u64 N> equatable for ring<T, N> where T : equatable
{
    bool operator==( const ref ring<T, N> other ) const
    {
        if( this.size() != other.size() )
        {
            return false;
        }

        for( u64 i : 0..this.size() )
        {
            if( this[i] != other[i] )
            {
                return false;
            }
        }

        return true;
    }
};

/// A ring hashes each element from the front, then its size.
implements<T, u64 N> hashable for ring<T, N> where T : hashable
{
    void hash( ref hasher h ) const
    {
        for( u64 i : 0..this.size() )
        {
            this[i].hash( ref h );
        }

        h.write( this.size() );
    }
};
