// A package the command line does not name is one error, at the import, and nothing at each use.
import absent::shapes;

i32 measure( absent::Shape s )
{
    switch( s )
    {
        case absent::Shape::Circle( r ):
            return 3 * r * r;
        case absent::Shape::Square( a ):
            return a * a;
    }
}

i32 main()
{
    absent::Point p = absent::origin();
    absent::Point q = absent::Point { 1, 2 };
    absent::Box<i32> b = absent::Box<i32>::of( 9 );
    absent::Colour c = absent::Colour::Green;
    absent::Counter k = absent::Counter::zero();
    absent::made = absent::made + 10;
    return measure( absent::Shape::Circle( 2 ) ) + p.x + q.y + b.v + k.get();
}
