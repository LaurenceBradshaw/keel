// `operator[]` on a key `kl::map` does not hold aborts, naming the check in the library; `get`
// is the way to ask without one.
import kl::console;
import kl::map;

i32 main()
{
    kl::map<i32, i32> values = kl::map<i32, i32>();

    values.insert( 1, 2 );
    kl::println( "looking" );
    return values[ 3 ];
}
