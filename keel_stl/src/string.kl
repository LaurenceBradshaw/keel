import kl::_core::compare as kernel;
import kl::_core::float_format as float_text;
import kl::_core::float_parse as float_parse;
import kl::_core::float_exact as float_exact;
import kl::_core::float_bits as float_bits;
import list;
import optional;

/// Why `string::parse_i64`, `parse_u64` or `parse_f64` refused its text.
enum parse_error
{
    /// A part that needs digits has none: the text is empty, only `-`, or ends after an `e`.
    no_digits,
    /// The byte at `index` cannot continue the number.
    invalid_digit( u64 index ),
    /// The number lies outside the range of its integer type.
    overflow
};

/// A growable sequence of bytes that owns its storage.
///
/// The bytes are not checked to be UTF-8, and every index and size counts bytes.
class string implements textual, equatable, comparable, hashable, from<str>, from<u64>, from<i64>,
    from<f64>, from<joined_text>
{
    /// --- Construction ---

    /// An empty string.
    string()
    {
        data_ = nullptr;
        size_ = 0;
        cap_ = 0;
    }

    /// A string holding a copy of the bytes of `text`.
    string( const ref textual text )
    {
        const ref u8[] bytes = text.as_text();

        unsafe
        {
            data_ = alloc<u8>( bytes.size );
        }

        size_ = 0;
        cap_ = bytes.size;
        append( bytes );
    }

    /// An empty string with room for `capacity` bytes before it reallocates.
    public static string with_capacity( u64 capacity )
    {
        string result = string();
        unsafe
        {
            result.data_ = alloc<u8>( capacity );
        }

        result.size_ = 0;
        result.cap_ = capacity;
        return result;
    }

    ~string()
    {
        unsafe
        {
            free( data_ );
        }
    }

    /// `text`'s bytes, taken over rather than copied.
    public static string from( move joined_text text )
    {
        string result = string();
        result.size_ = text.size();
        result.cap_ = result.size_;
        result.data_ = text.release();
        return result;
    }

    /// A copy of `text`'s bytes.
    public static string from( move str text )
    {
        return string( text );
    }

    /// `value` written in decimal, with no leading zeros.
    public static string from( move u64 value )
    {
        string result = with_capacity( 20 );
        result.push_digits( value );
        return result;
    }

    /// `value` written in decimal, with a leading `-` if it is negative and no leading zeros.
    public static string from( move i64 value )
    {
        string result = with_capacity( 20 );
        if( value < 0 )
        {
            result.push( '-' );
        }
        result.push_digits( value < 0 ? wrap<u64>( 0 - value ) : cast<u64>( value ) );
        return result;
    }

    // Appends `value` in decimal, with no leading zeros.
    private void push_digits( u64 value )
    {
        u8[20] digits = [ 0, .. ];
        u64 i = 20;
        u64 rest = value;
        while( true )
        {
            i--;
            digits[i] = cast<u8>( '0' + rest % 10 );
            rest /= 10;
            if( rest == 0 )
            {
                break;
            }
        }
        append( digits[i..20] );
    }

    /// `value` as Python's `repr` writes it: the fewest digits that read back as `value`, fixed
    /// from 1e-4 up to 1e16, with `.0` on a whole number, and otherwise as `1e+16` or `2.5e-05`;
    /// `nan`, `inf` and `-inf`.
    public static string from( move f64 value )
    {
        string result = with_capacity( 25 );
        if( result.push_special( value ) )
        {
            return result;
        }
        if( value == 0.0 )
        {
            result += "0.0";
            return result;
        }

        float_text::decimal d = float_text::shortest( value );
        while( d.digits % 10 == 0 )
        {
            d.digits /= 10;
            d.exponent++;
        }
        u8[17] digits = [ 0, .. ];
        u64 n = 0;
        for( u64 rest = d.digits; rest > 0; rest /= 10 )
        {
            n++;
        }
        u64 rest = d.digits;
        for( u64 i = n; i > 0; i-- )
        {
            digits[i - 1] = cast<u8>( '0' + rest % 10 );
            rest /= 10;
        }
        const i64 e = cast<i64>( d.exponent ) + cast<i64>( n ) - 1; // as in d.ddd * 10^e

        if( e < -4 || e >= 16 )
        {
            result.push( digits[0] );
            if( n > 1 )
            {
                result.push( '.' );
                result.append( digits[1..n] );
            }
            result.push_exponent( e );
        }
        else if( e < 0 )
        {
            result.push( '0' );
            result.push( '.' );
            for( i64 i = 0; i < -e - 1; i++ )
            {
                result.push( '0' );
            }
            result.append( digits[0..n] );
        }
        else if( n <= cast<u64>( e ) + 1 )
        {
            result.append( digits[0..n] );
            for( u64 i = n; i < cast<u64>( e ) + 1; i++ )
            {
                result.push( '0' );
            }
            result.push( '.' );
            result.push( '0' );
        }
        else
        {
            const u64 point = cast<u64>( e ) + 1;
            result.append( digits[0..point] );
            result.push( '.' );
            result.append( digits[point..n] );
        }

        return result;
    }

    /// `value` with `places` digits after the point, as C's `%.*f` writes it: rounded from its
    /// exact binary value, ties to even, so `fixed( 2.675, 2 )` is `2.67`; no point when `places`
    /// is 0. `nan`, `inf` and `-inf` as `from` writes them.
    public static string fixed( f64 value, u64 places )
    {
        string result = with_capacity( 24 + places );
        if( result.push_special( value ) )
        {
            return result;
        }

        float_exact::expansion x = float_exact::exact( value );
        float_exact::round_to( ref x, x.point + cast<i64>( places ) );
        if( x.point <= 0 )
        {
            result.push( '0' );
        }
        for( i64 i = 0; i < x.point; i++ )
        {
            result.push( digit_at( x, i ) );
        }
        if( places > 0 )
        {
            result.push( '.' );
            for( i64 i = x.point; i < x.point + cast<i64>( places ); i++ )
            {
                result.push( digit_at( x, i ) );
            }
        }
        return result;
    }

    /// `value` as `d.ddde+XX` with `places` digits after the point, as C's `%.*e` writes it: rounded
    /// from its exact binary value, ties to even, and at least two exponent digits. `nan`, `inf`
    /// and `-inf` as `from` writes them.
    public static string scientific( f64 value, u64 places )
    {
        string result = with_capacity( 24 + places );
        if( result.push_special( value ) )
        {
            return result;
        }

        float_exact::expansion x = float_exact::exact( value );
        float_exact::round_to( ref x, cast<i64>( places ) + 1 );
        result.push( digit_at( x, 0 ) );
        if( places > 0 )
        {
            result.push( '.' );
            for( i64 i = 1; i <= cast<i64>( places ); i++ )
            {
                result.push( digit_at( x, i ) );
            }
        }
        result.push_exponent( x.size == 0 ? 0 : x.point - 1 );
        return result;
    }

    // Appends the sign of `value`, and `nan` or `inf` if it is one; returns whether it was.
    private bool push_special( f64 value )
    {
        if( value != value )
        {
            append( "nan".as_text() );
            return true;
        }
        if( ( float_bits::bits_of( value ) >> 63 ) != 0 )
        {
            push( '-' );
        }
        if( value > 1.7976931348623157e308 || value < -1.7976931348623157e308 )
        {
            append( "inf".as_text() );
            return true;
        }
        return false;
    }

    // Appends `e+XX` or `e-XX`, with a third digit past 99.
    private void push_exponent( i64 e )
    {
        push( 'e' );
        push( e < 0 ? '-' : '+' );
        const u64 magnitude = cast<u64>( e < 0 ? -e : e );
        if( magnitude >= 100 )
        {
            push( cast<u8>( '0' + magnitude / 100 ) );
        }
        push( cast<u8>( '0' + magnitude / 10 % 10 ) );
        push( cast<u8>( '0' + magnitude % 10 ) );
    }

    // Digit `i` of `x`, counting from its first; `0` outside its digits.
    private static u8 digit_at( const ref float_exact::expansion x, i64 i )
    {
        return i >= 0 && i < cast<i64>( x.size ) ? x.digits[cast<u64>( i )] : '0';
    }

    /// --- Size ---

    /// The number of bytes.
    public u64 size() const
    {
        return size_;
    }

    /// Whether the string holds no bytes.
    public bool is_empty() const
    {
        return size_ == 0;
    }

    /// --- Reading ---

    /// The bytes, borrowed. The string cannot change while they are held.
    public const ref u8[] as_text() const
    {
        unsafe
        {
            return data_[0..size_];
        }
    }

    /// The byte at `index`.
    ///
    /// ### Panics
    ///
    /// If `index` is not less than `size()`.
    public const ref u8 operator[]( u64 index ) const
    {
        if( index >= size() )
        {
            panic( "index out of range" );
        }

        unsafe
        {
            return data_[index];
        }
    }

    /// A new string holding the `count` bytes from index `start` on.
    ///
    /// ### Panics
    ///
    /// If those bytes do not all lie within the string.
    public string substring( u64 start, u64 count ) const
    {
        if( start > size() || count > size() - start )
        {
            panic( "substring out of range" );
        }

        string result = string::with_capacity( count );
        result.append( as_text()[start..start + count] );
        return result;
    }

    /// --- Searching ---

    /// Whether the string begins with the bytes of `prefix`; every string begins with `""`.
    public bool starts_with( const ref textual prefix ) const
    {
        const ref u8[] text = prefix.as_text();
        return matches_at( 0, text );
    }

    /// Whether the string ends with the bytes of `suffix`; every string ends with `""`.
    public bool ends_with( const ref textual suffix ) const
    {
        const ref u8[] text = suffix.as_text();
        if( text.size > size() )
        {
            return false;
        }

        return matches_at( size() - text.size, text );
    }

    /// The index of the first place `needle` occurs, or `none`. `""` is found at 0.
    public optional<u64> find( const ref textual needle ) const
    {
        const ref u8[] text = needle.as_text();

        if( text.size > size() )
        {
            return optional::none;
        }

        for( u64 i = 0; i <= size() - text.size; i++ )
        {
            if( matches_at( i, text ) )
            {
                return optional::some( i );
            }
        }

        return optional::none;
    }

    /// The index of the last place `needle` occurs, or `none`. `""` is found at `size()`.
    public optional<u64> rfind( const ref textual needle ) const
    {
        const ref u8[] text = needle.as_text();

        if( text.size > size() )
        {
            return optional::none;
        }

        u64 i = size() - text.size;
        while( true )
        {
            if( matches_at( i, text ) )
            {
                return optional::some( i );
            }

            if( i == 0 )
            {
                break;
            }

            i--;
        }

        return optional::none;
    }

    /// The pieces between each occurrence of `separator`, in order, empty ones kept: `"a\nb\n"`
    /// split on `"\n"` gives `a`, `b` and an empty piece.
    ///
    /// ### Panics
    ///
    /// If `separator` is empty.
    public list<string> split( const ref textual separator ) const
    {
        const ref u8[] text = separator.as_text();
        
        if( text.size == 0 )
        {
            panic( "split on an empty separator" );
        }

        u64 start = 0;
        list<string> pieces = list<string>();
        for( u64 i = 0; i + text.size <= size(); i++ )
        {
            if( matches_at( i, text ) )
            {
                pieces.push( substring( start, i - start ) );
                start = i + text.size;
                i += text.size - 1;
            }
        }
        
        pieces.push( substring( start, size() - start ) );
        return pieces;
    }

    /// A new string with every occurrence of `pattern` replaced, matched left to right without
    /// overlap: `"a.b.c"` with `"."` replaced by `"-"` gives `"a-b-c"`.
    ///
    /// ### Panics
    ///
    /// If `pattern` is empty.
    public string replace( const ref textual pattern, const ref textual replacement ) const
    {
        const ref u8[] pattern_bytes = pattern.as_text();
        const ref u8[] replacement_bytes = replacement.as_text();

        if( pattern_bytes.size == 0 )
        {
            panic( "replace with an empty pattern" );
        }

        string result = string::with_capacity( size() );

        u64 start = 0;
        u64 i = 0;
        while( i < size() )
        {
            if( matches_at( i, pattern_bytes ) )
            {
                result.append( as_text()[start..i] );
                result.append( replacement_bytes );
                i += pattern_bytes.size;
                start = i;
            }
            else
            {
                i++;
            }
        }

        result.append( as_text()[start..size()] );
        return result;
    }

    /// --- Trimming ---

    /// A new string without the leading whitespace, as `trim` counts it.
    public string trim_start() const
    {
        u64 start = 0;
        while( start < size() && is_space( as_text()[start] ) )
        {
            start++;
        }

        return substring( start, size() - start );
    }

    /// A new string without the trailing whitespace, as `trim` counts it.
    public string trim_end() const
    {
        u64 end = size();
        while( end > 0 && is_space( as_text()[end - 1] ) )
        {
            end--;
        }

        return substring( 0, end );
    }

    /// A new string without leading or trailing whitespace: space, `\t`, `\n`, `\v`, `\f` and `\r`.
    public string trim() const
    {
        u64 start = 0;
        while( start < size() && is_space( as_text()[start] ) )
        {
            start++;
        }

        u64 end = size();
        while( end > start && is_space( as_text()[end - 1] ) )
        {
            end--;
        }

        return substring( start, end - start );
    }

    /// The rest of the string after `prefix`, or `none` if it does not begin with `prefix`.
    public optional<string> strip_prefix( const ref textual prefix ) const
    {
        if( starts_with( prefix ) )
        {
            const u64 prefix_size = prefix.as_text().size;
            return optional::some( substring( prefix_size, size() - prefix_size ) );
        }

        return optional::none;
    }

    /// The string before `suffix`, or `none` if it does not end with `suffix`.
    public optional<string> strip_suffix( const ref textual suffix ) const
    {
        if( ends_with( suffix ) )
        {
            const u64 suffix_size = suffix.as_text().size;
            return optional::some( substring( 0, size() - suffix_size ) );
        }

        return optional::none;
    }

    /// --- Changing ---

    /// Adds the byte `value` at the end.
    public void push( u8 value )
    {
        if( size_ == cap_ )
        {
            reallocate( cap_ > 0 ? cap_ * 2 : 1 );
        }

        unsafe
        {
            data_[size_] = value;
        }
        size_ += 1;
    }

    /// Removes the last byte and returns it.
    ///
    /// ### Panics
    ///
    /// If the string is empty.
    public u8 pop()
    {
        if( size_ == 0 )
        {
            panic( "the string is empty" );
        }
        size_ -= 1;
        unsafe
        {
            return data_[size_];
        }
    }

    /// Adds a copy of every byte of `bytes` at the end.
    public void append( const ref u8[] bytes )
    {
        if( size_ + bytes.size > cap_ )
        {
            reallocate( size_ + bytes.size > cap_ * 2 ? size_ + bytes.size : cap_ * 2 );
        }

        for( u64 i = 0; i < bytes.size; i++ )
        {
            unsafe
            {
                data_[size_ + i] = bytes[i];
            }
        }
        size_ += bytes.size;
    }

    /// Adds a copy of every byte of `other` at the end.
    public void operator+=( const ref textual other )
    {
        const ref u8[] text = other.as_text();
        append( text );
    }

    /// A new string holding these bytes and then `other`'s bytes.
    public string operator+( const ref textual other ) const
    {
        const ref u8[] text = other.as_text();
        string result = string::with_capacity( size() + text.size );
        result.append( as_text() );
        result.append( text );
        return result;
    }

    /// Removes every byte and releases the storage.
    public void clear()
    {
        unsafe
        {
            free( data_ );
        }
        data_ = nullptr;
        size_ = 0;
        cap_ = 0;
    }

    /// --- Comparing and hashing ---

    /// Whether both strings hold the same bytes in the same order.
    public bool operator==( const ref string other ) const
    {
        return kernel::equal( as_text(), other.as_text() );
    }

    /// Orders by the first byte that differs, and a string before any it is a prefix of.
    public ordering operator<=>( const ref string other ) const
    {
        const u64 min_size = size() < other.size() ? size() : other.size();

        for( u64 i = 0; i < min_size; i++ )
        {
            if( as_text()[i] < other[i] )
            {
                return ordering::less;
            }
            else if( as_text()[i] > other[i] )
            {
                return ordering::greater;
            }
        }

        if( size() < other.size() )
        {
            return ordering::less;
        }
        else if( size() > other.size() )
        {
            return ordering::greater;
        }

        return ordering::equal;
    }

    /// Feeds the bytes and their count, as `write_bytes` does, so a string hashes as a literal of
    /// the same text would.
    public void hash( ref hasher h ) const
    {
        h.write_bytes( as_text() );
    }

    /// --- Parsing ---

    /// The `i64` the string writes in decimal.
    ///
    /// The text is an optional `-` and then one or more digits `0` to `9`, which may have leading
    /// zeros. Nothing else is read: not a `+`, whitespace or a separator.
    ///
    /// ### Errors
    ///
    /// `no_digits` if there are no digits, `invalid_digit` naming the first byte that cannot continue
    /// the number, and `overflow` as soon as the number leaves the range of `i64`.
    public result<i64, parse_error> parse_i64() const
    {
        const bool is_negative = !is_empty() && as_text()[0] == '-';
        const u64 limit = is_negative ? cast<u64>( i64::max ) + 1 : cast<u64>( i64::max );

        switch( parse_digits( is_negative ? 1 : 0, limit ) )
        {
        case result::ok( magnitude ):
            return result::ok( is_negative ? wrap<i64>( 0 - magnitude ) : cast<i64>( magnitude ) );
        case result::err( e ):
            return result::err( e );
        }
    }

    /// The `u64` the string writes in decimal: one or more digits `0` to `9`, which may have
    /// leading zeros, and nothing else.
    ///
    /// ### Errors
    ///
    /// As `parse_i64`'s, a `-` being a byte that cannot begin the number, and `overflow` past
    /// `u64::max`.
    public result<u64, parse_error> parse_u64() const
    {
        return parse_digits( 0, u64::max );
    }

    /// The `f64` nearest the number the string writes in decimal, ties to even, as Python's
    /// `float` reads it: an optional `-`, digits with an optional `.` among them (`5.`, `.5`), and
    /// an optional exponent, `e` or `E` with an optional sign and digits. `nan`, `inf` and
    /// `infinity`, in any case, are the special values. A number too large for `f64` is an
    /// infinity and one too small a zero, both signed. Nothing else is read: not a `+` before the
    /// number, whitespace or a separator.
    ///
    /// ### Errors
    ///
    /// `no_digits` if the number or its exponent has no digits, and `invalid_digit` naming the
    /// first byte that cannot continue the number; a word that is not one of the special values
    /// is refused at its first byte.
    public result<f64, parse_error> parse_f64() const
    {
        const ref u8[] text = as_text();
        const bool negative = !is_empty() && text[0] == '-';
        u64 p = negative ? 1 : 0;

        if( p < text.size && ( ( text[p] | 0x20 ) == 'n' || ( text[p] | 0x20 ) == 'i' ) )
        {
            return special_value( p, negative );
        }

        const u64 integer_start = p;
        u64 digits = 0;
        while( p < text.size && is_digit( text[p] ) )
        {
            digits = wrap<u64>( digits * 10 + ( text[p] - '0' ) );
            p++;
        }
        const u64 integer_end = p;

        u64 fraction_start = p;
        if( p < text.size && text[p] == '.' )
        {
            p++;
            fraction_start = p;
            while( p < text.size && is_digit( text[p] ) )
            {
                digits = wrap<u64>( digits * 10 + ( text[p] - '0' ) );
                p++;
            }
        }
        const u64 fraction_end = p;

        if( integer_end == integer_start && fraction_end == fraction_start )
        {
            return result::err( p == text.size ? parse_error::no_digits : parse_error::invalid_digit( p ) );
        }

        i64 exponent = 0;
        if( p < text.size && ( text[p] | 0x20 ) == 'e' )
        {
            p++;
            const bool negative_exponent = p < text.size && text[p] == '-';
            if( p < text.size && ( text[p] == '-' || text[p] == '+' ) )
            {
                p++;
            }
            if( p == text.size )
            {
                return result::err( parse_error::no_digits );
            }
            if( !is_digit( text[p] ) )
            {
                return result::err( parse_error::invalid_digit( p ) );
            }
            while( p < text.size && is_digit( text[p] ) )
            {
                if( exponent < 0x1000_0000 ) // past any f64; stays clear of overflow
                {
                    exponent = exponent * 10 + ( text[p] - '0' );
                }
                p++;
            }
            if( negative_exponent )
            {
                exponent = -exponent;
            }
        }

        if( p != text.size )
        {
            return result::err( parse_error::invalid_digit( p ) );
        }

        return result::ok( float_parse::from_decimal( negative, digits, text[integer_start..integer_end],
            text[fraction_start..fraction_end], exponent ) );
    }

    /// --- Internals ---

    /// The digits from `start` to the end as a `u64` no greater than `limit`.
    private result<u64, parse_error> parse_digits( u64 start, u64 limit ) const
    {
        if( size() == start )
        {
            return result::err( parse_error::no_digits );
        }

        u64 magnitude = 0;
        for( u64 i = start; i < size(); i++ )
        {
            const u8 byte = as_text()[i];
            if( !is_digit( byte ) )
            {
                return result::err( parse_error::invalid_digit( i ) );
            }

            const u64 digit = byte - '0';
            if( magnitude > ( limit - digit ) / 10 )
            {
                return result::err( parse_error::overflow );
            }

            magnitude = magnitude * 10 + digit;
        }

        return result::ok( magnitude );
    }

    /// `nan`, `inf` or `infinity` from `start` to the end, in any case.
    private result<f64, parse_error> special_value( u64 start, bool negative ) const
    {
        const ref u8[] word = as_text()[start..size()];
        const u64 sign = negative ? cast<u64>( 1 ) << 63 : 0;
        if( same_folded( word, "nan".as_text() ) )
        {
            return result::ok( float_bits::from_bits( sign | 0x7ff8_0000_0000_0000 ) );
        }
        if( same_folded( word, "inf".as_text() ) || same_folded( word, "infinity".as_text() ) )
        {
            return result::ok( float_bits::from_bits( sign | 0x7ff0_0000_0000_0000 ) );
        }
        return result::err( parse_error::invalid_digit( start ) );
    }

    /// Whether the bytes of `text` occur at index `at`.
    private bool matches_at( u64 at, const ref u8[] text ) const
    {
        if( at + text.size > size() )
        {
            return false;
        }

        return kernel::equal( as_text()[at..at + text.size], text );
    }

    /// Moves the bytes into a new block of `n` bytes and frees the old one.
    private void reallocate( u64 n )
    {
        u8[*] new_data;
        unsafe
        {
            new_data = alloc<u8>( n );
            for( u64 i = 0; i < size_; i++ )
            {
                new_data[i] = data_[i];
            }
            free( data_ );
        }

        data_ = new_data;
        cap_ = n;
    }

    // Bytes below `size_` are written, the rest of the `cap_` are raw.
    private u8[*] data_;
    private u64 size_;
    private u64 cap_;
};

/// Whether `a` and `b` hold the same bytes in the same order.
bool same_text( const ref textual a, const ref textual b )
{
    return kernel::equal( a.as_text(), b.as_text() );
}

/// Whether `byte` is `0` to `9`.
private bool is_digit( u8 byte )
{
    return byte >= '0' && byte <= '9';
}

/// Whether `text` is the lower-case ASCII `word` in any case.
private bool same_folded( const ref u8[] text, const ref u8[] word )
{
    if( text.size != word.size )
    {
        return false;
    }
    for( u64 i : 0..text.size )
    {
        if( ( text[i] | 0x20 ) != word[i] )
        {
            return false;
        }
    }
    return true;
}

/// Whether `byte` is ASCII whitespace.
private bool is_space( u8 byte )
{
    return byte == ' ' || ( byte >= '\t' && byte <= '\r' ); // and '\n', '\v', '\f' between
}

/// The parts with `separator` between each pair: `join( [ "a", "b" ], ", " )` gives `"a, b"`.
string join<T>( const ref T[] parts, const ref textual separator )
    where T : textual
{
    const ref u8[] between = separator.as_text();
    u64 total = 0;

    for( u64 i : 0..parts.size )
    {
        total += parts[i].as_text().size;
    }

    if( parts.size > 1 )
    {
        total += between.size * (parts.size - 1);
    }

    string result = string::with_capacity( total );

    for( u64 i : 0..parts.size )
    {
        if( i > 0 )
        {
            result.append( between );
        }

        result.append( parts[i].as_text() );
    }

    return result;
}
