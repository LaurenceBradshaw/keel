// `kl::dataframe`: building and shape, pandas' table, selecting rows and columns, sorting,
// series arithmetic, comparisons and reductions with missing values, describe, CSV both ways,
// time and duration columns, concat and merge, the index. The expected texts are pandas 3.1's,
// but for an integer or bool column with a gap, which stays one.
import kl::dataframe;
import kl::list;
import kl::mask;
import kl::math;
import kl::ndarray;
import kl::string;
import kl::optional;
import kl::test::context;
import kl::time;

private kl::dataframe fruit()
{
    f64 zero = 0.0;
    kl::dataframe df = kl::dataframe();
    df.insert( "n", kl::series( [ 3, 1, 2, 1, 5 ] ) );
    df.insert( "x", kl::series( [ 2.5, zero / zero, -1.0, 4.0, 0.5 ] ) );
    df.insert( "s", kl::series( [ "pear", "fig", "apple", "fig", "kiwi" ] ) );
    df.insert( "b", kl::series( [ true, false, true, true, false ] ) );
    return df;
}

private kl::dataframe parsed( str text, u8 sep )
{
    switch( kl::parse_csv( text, sep ) )
    {
        case result::ok( df ):
            return df.copy();
        case result::err( _ ):
            panic( "the CSV did not parse" );
    }
}

private void building_and_shape( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    c.check_eq( df.shape()[0], 5 );
    c.check_eq( df.shape()[1], 4 );
    c.check_eq( df.columns()[2], "s" );
    c.check_eq( kl::dtype_name( df.dtypes()[0] ), "int64" );
    c.check_eq( kl::dtype_name( df.dtypes()[1] ), "float64" );
    c.check_eq( kl::dtype_name( df.dtypes()[2] ), "str" );
    c.check_eq( kl::dtype_name( df.dtypes()[3] ), "bool" );
    c.check_eq( df["n"].i64s()[4], 5 );
    c.check( df.has( "b" ) && !df.has( "z" ) );

    df.rename( "x", "y" );
    df.drop( "s", "b" );
    c.check_eq( df.shape()[1], 2 );
    c.check_eq( df.columns()[1], "y" );

    c.expect_panic( "a column already has that name", fn[]() { kl::dataframe d = fruit(); d.insert( "n", kl::series( [ 1 ] ) ); } );
    c.expect_panic( "the column's size is not the frame's rows", fn[]() { kl::dataframe d = fruit(); d.insert( "m", kl::series( [ 1 ] ) ); } );
    c.expect_panic( "no column has that name", fn[]() { _ = fruit()["z"].size(); } );
    c.expect_panic( "the series holds another dtype", fn[]() { _ = fruit()["n"].f64s().size(); } );
}

private void printing_as_pandas( ref kl::test::context c )
{
    c.check_eq( fruit().to_string(), "   n    x      s      b\n0  3  2.5   pear   True\n1  1  NaN    fig  False\n2  2 -1.0  apple   True\n3  1  4.0    fig   True\n4  5  0.5   kiwi  False" );

    kl::dataframe f = kl::dataframe();
    f.insert( "a", kl::series( [ 1e7, 2.0 ] ) );
    f.insert( "b", kl::series( [ 1e12, 3.0 ] ) );
    f.insert( "c", kl::series( [ 3.14159265, 1.0 ] ) );
    f.insert( "d", kl::series( [ 1e-7, 1.0 ] ) );
    c.check_eq( f.to_string(), "            a             b         c             d\n0  10000000.0  1.000000e+12  3.141593  1.000000e-07\n1         2.0  3.000000e+00  1.000000  1.000000e+00" );

    kl::dataframe long = kl::dataframe();
    long.insert( "abcd", kl::series( kl::ndarray<i64>::arange( 0, 70 ) ) );
    c.check_eq( long.to_string(), "    abcd\n0      0\n1      1\n2      2\n3      3\n4      4\n..   ...\n65    65\n66    66\n67    67\n68    68\n69    69\n\n[70 rows x 1 columns]" );

    c.check_eq( kl::dataframe().to_string(), "Empty DataFrame\nColumns: []\nIndex: []" );
}

private void selecting_rows_and_columns( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    c.check_eq( df.head( 2 ).to_string(), "   n    x     s      b\n0  3  2.5  pear   True\n1  1  NaN   fig  False" );
    c.check_eq( df.tail( 2 )["s"].strings()[0], "fig" );
    c.check_eq( df.tail( 9 ).rows(), 5 );
    c.check_eq( df.iloc( 1..3 )["n"].i64s()[1], 2 );
    c.check_eq( df.iloc( 4..9 ).rows(), 1 );

    kl::dataframe big = df.filtered( df["n"].greater( 1.0 ) );
    c.check_eq( big.rows(), 3 );
    c.check_eq( big["s"].strings()[2], "kiwi" );
    c.check_eq( df.filtered( df["s"].equal_each( "fig" ) & df["b"].bools() )["x"].f64s()[0], 4.0 );

    kl::dataframe two = df.select( "s", "n" );
    c.check_eq( two.columns()[0], "s" );
    c.check_eq( two.shape()[1], 2 );
}

private void sorting_keeps_ties_and_puts_missing_last( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    kl::dataframe up = df.sort_values( "x" );
    c.check_eq( up["n"].i64s()[0], 2 );
    c.check( up["x"].is_missing( 4 ) );
    c.check( df.sort_values( "x", false )["x"].is_missing( 4 ) );
    c.check_eq( df.sort_values( "x", false )["x"].f64s()[0], 4.0 );

    // The two figs keep their order, either way.
    kl::dataframe by_name = df.sort_values( "s" );
    c.check_eq( by_name["s"].strings()[0], "apple" );
    c.check( by_name["x"].is_missing( 1 ) && by_name["x"].f64s()[2] == 4.0 );
    kl::dataframe by_n = df.sort_values( "n", false );
    c.check( by_n["x"].is_missing( 3 ) && by_n["x"].f64s()[4] == 4.0 );
    c.check( !df.sort_values( "b" )["b"].bools().test( 0 ) );
}

private void arithmetic_keeps_ints_and_missing( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    kl::series sum = df["n"] + df["x"];
    c.check( sum.kind() == kl::dtype::f64s );
    c.check_eq( sum.f64s()[0], 5.5 );
    c.check( sum.is_missing( 1 ) );
    c.check( ( df["n"] * 2 ).kind() == kl::dtype::i64s );
    c.check_eq( ( df["n"] * 2 ).i64s()[4], 10 );
    c.check_eq( ( df["n"] / 2 ).f64s()[0], 1.5 );
    c.check_eq( ( df["x"] - 1.5 ).f64s()[2], -2.5 );

    kl::series gappy = kl::series( [ 1, 2, 3 ] );
    gappy.set_missing( 1 );
    kl::series twice = gappy + gappy;
    c.check( twice.kind() == kl::dtype::i64s && twice.is_missing( 1 ) && !twice.is_missing( 2 ) );
    c.check( ( gappy + 0.5 ).is_missing( 1 ) );
    c.check( !gappy.greater( 0.0 ).test( 1 ) && gappy.differs( 0.0 ).test( 1 ) );
    c.check_eq( gappy.greater_equal( kl::series( [ 1, 1, 4 ] ) ).count(), 1 );

    c.expect_panic( "the series differ in size", fn[]() { _ = kl::series( [ 1 ] ) + kl::series( [ 1, 2 ] ); } );
    c.expect_panic( "the series does not hold numbers", fn[]() { _ = kl::series( [ "a" ] ) * 2; } );
}

private void reductions_skip_missing( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    c.check_eq( df["x"].sum(), 6.0 );
    c.check_eq( df["x"].mean(), 1.5 );
    c.check_eq( df["x"].std(), 2.1984843263788196 );
    c.check_eq( df["n"].std(), 1.6733200530681511 );
    c.check_eq( df["x"].min(), -1.0 );
    c.check_eq( df["n"].max(), 5.0 );
    c.check_eq( df["x"].quantile( 0.3 ), 0.34999999999999987 );
    c.check_eq( df["n"].quantile( 0.75 ), 3.0 );
    c.check_eq( df["x"].count(), 4 );

    kl::series none = kl::series( [ 1, 2 ] );
    none.set_missing( 0 );
    none.set_missing( 1 );
    c.check_eq( none.sum(), 0.0 );
    c.check( kl::is_nan( none.mean() ) && kl::is_nan( none.max() ) && kl::is_nan( kl::series( [ 2.0 ] ).std() ) );

    c.check_eq( df.describe().to_string(), "             n         x\ncount  5.00000  4.000000\nmean   2.40000  1.500000\nstd    1.67332  2.198484\nmin    1.00000 -1.000000\n25%    1.00000  0.125000\n50%    2.00000  1.500000\n75%    3.00000  2.875000\nmax    5.00000  4.000000" );
}

private void csv_both_ways( ref kl::test::context c )
{
    c.check_eq( fruit().to_csv(), "n,x,s,b\n3,2.5,pear,True\n1,,fig,False\n2,-1.0,apple,True\n1,4.0,fig,True\n5,0.5,kiwi,False\n" );

    kl::dataframe df = parsed( "id,v,t,flag,e\r\n1,1.5,\"a\nb\",TRUE,\r\n\r\n2,-2e3,\"x\"\"y\",false,\r\n3,inf,plain,True,\r\n4,,\"\",FALSE,NA\r\n5,0.1\r\n", ',' );
    c.check_eq( kl::dtype_name( df.dtypes()[0] ), "int64" );
    c.check_eq( kl::dtype_name( df.dtypes()[1] ), "float64" );
    c.check_eq( kl::dtype_name( df.dtypes()[2] ), "str" );
    c.check_eq( kl::dtype_name( df.dtypes()[3] ), "bool" );
    c.check_eq( kl::dtype_name( df.dtypes()[4] ), "float64" );
    c.check_eq( df.to_csv(), "id,v,t,flag,e\n1,1.5,\"a\nb\",True,\n2,-2000.0,\"x\"\"y\",False,\n3,inf,plain,True,\n4,,,False,\n5,0.1,,,\n" );

    // An integer column with a gap stays integer.
    kl::dataframe ints = parsed( "a;b\n1;\n;2\n", ';' );
    c.check( ints["a"].kind() == kl::dtype::i64s && ints["a"].is_missing( 1 ) && ints["b"].i64s()[1] == 2 );
    c.check_eq( ints.to_string(), "      a     b\n0     1  <NA>\n1  <NA>     2" );

    switch( kl::parse_csv( "a,b\n1,2\n1,2,3\n" ) )
    {
        case result::ok( _ ):
            c.check( false );
            break;
        case result::err( e ):
            switch( e )
            {
                case kl::csv_error::too_many_fields( line ):
                    c.check_eq( line, 3 );
                    break;
                default:
                    c.check( false );
                    break;
            }
            break;
    }
    switch( kl::parse_csv( "a\n\"open\n" ) )
    {
        case result::ok( _ ):
            c.check( false );
            break;
        case result::err( e ):
            switch( e )
            {
                case kl::csv_error::unclosed_quote:
                    break;
                default:
                    c.check( false );
                    break;
            }
            break;
    }
}

private void missing_values_found_filled_and_dropped( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    c.check_eq( df["x"].isna().count(), 1 );
    c.check( df.isna()["x"].bools().test( 1 ) );
    c.check_eq( df.dropna().rows(), 4 );
    c.check_eq( df.dropna( "n", "s" ).rows(), 5 );
    c.check_eq( df["x"].dropna().size(), 4 );
    c.check_eq( df.fillna( 0 ).to_string(), "   n    x      s      b\n0  3  2.5   pear   True\n1  1  0.0    fig  False\n2  2 -1.0  apple   True\n3  1  4.0    fig   True\n4  5  0.5   kiwi  False" );
    c.check_eq( df["x"].fillna( 9.5 ).f64s()[1], 9.5 );

    kl::series gappy = kl::series( [ "a", "b" ] );
    gappy.set_missing( 0 );
    c.check_eq( gappy.fillna( "z" ).strings()[0], "z" );
    c.check( !gappy.fillna( "z" ).is_missing( 0 ) );
    kl::series flags = kl::series( [ true, false ] );
    flags.set_missing( 1 );
    c.check( flags.fillna( true ).bools().test( 1 ) );

    df.set( "x", df["x"].fillna( 0 ) );
    c.check_eq( df["x"].count(), 5 );
    df.set( "y", df["n"] * 2 );
    c.check_eq( df.columns()[4], "y" );
    c.expect_panic( "the series holds another dtype", fn[]() { _ = kl::series( [ 1 ] ).fillna( 0.5 ); } );
}

private void groupby_reduces_each_group( ref kl::test::context c )
{
    kl::grouped g = fruit().groupby( "s" );
    c.check_eq( g.groups(), 4 );
    c.check_eq( g.sum().to_string(), "       s  n    x  b\n0  apple  2 -1.0  1\n1    fig  2  4.0  1\n2   kiwi  5  0.5  0\n3   pear  3  2.5  1" );
    c.check_eq( g.mean().to_string(), "       s    n    x    b\n0  apple  2.0 -1.0  1.0\n1    fig  1.0  4.0  0.5\n2   kiwi  5.0  0.5  0.0\n3   pear  3.0  2.5  1.0" );
    c.check_eq( g.count()["x"].i64s()[1], 1 );
    c.check_eq( g.max().to_string(), "       s  n    x      b\n0  apple  2 -1.0   True\n1    fig  1  4.0   True\n2   kiwi  5  0.5  False\n3   pear  3  2.5   True" );
    c.check_eq( g.std().to_string(), "       s    n   x         b\n0  apple  NaN NaN       NaN\n1    fig  0.0 NaN  0.707107\n2   kiwi  NaN NaN       NaN\n3   pear  NaN NaN       NaN" );
    c.check_eq( g.size()["size"].i64s()[1], 2 );
    c.check_eq( g.agg( fn[]( s ) { return s.max() - s.min(); } )["b"].f64s()[1], 1.0 );
    c.check_eq( fruit().groupby( "b", "n" ).sum().to_string(), "       b  n    x\n0  False  1  0.0\n1  False  5  0.5\n2   True  1  4.0\n3   True  2 -1.0\n4   True  3  2.5" );

    // A row missing its key is left out; a group with no value present has no least one.
    kl::dataframe ints = parsed( "a,b\n1,\n,2\n1,3\n", ',' );
    c.check_eq( ints.groupby( "a" ).sum().to_string(), "   a  b\n0  1  3" );
    c.check_eq( ints.groupby( "b" ).min().to_string(), "   b     a\n0  2  <NA>\n1  3     1" );
    c.expect_panic( "no column is named to group by", fn[]() { _ = fruit().groupby().groups(); } );
}

private void value_counts_and_unique_keep_first_appearance( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    c.check_eq( df.value_counts( "s" ).to_string(), "       s  count\n0    fig      2\n1   pear      1\n2  apple      1\n3   kiwi      1" );
    c.check_eq( df.value_counts( "n" ).to_string(), "   n  count\n0  1      2\n1  3      1\n2  2      1\n3  5      1" );
    c.check_eq( df.value_counts( "b", "n" ).rows(), 5 );

    kl::series u = df["x"].unique();
    c.check_eq( u.size(), 5 );
    c.check( u.is_missing( 1 ) );
    c.check_eq( df["s"].unique().strings()[2], "apple" );
    c.check_eq( df["n"].unique().size(), 4 );
}

private void map_and_apply_take_lambdas( ref kl::test::context c )
{
    kl::dataframe df = fruit();
    kl::series twice = df["x"].map( fn[]( f64 v ) { return v * 2.0; } );
    c.check_eq( twice.f64s()[2], -2.0 );
    c.check( twice.is_missing( 1 ) );
    c.check_eq( df["n"].map( fn[]( f64 v ) { return v + 0.5; } ).f64s()[0], 3.5 );
    c.check_eq( df["s"].map( fn[]( const ref kl::string t ) { return t + "!"; } ).strings()[1], "fig!" );
    c.check_eq( df.select( "n", "x" ).apply( fn[]( s ) { return s.sum(); } ).to_string(), "      n    x\n0  12.0  6.0" );
    c.check_eq( df["b"].sum(), 3.0 );
}

// Column `name` of `text`, read as CSV, as times.
private kl::series times_of( str text, str name )
{
    switch( parsed( text, ',' )[name].to_times() )
    {
        case result::ok( t ):
            return t.copy();
        case result::err( _ ):
            panic( "the times did not read" );
    }
}

// Start and end times with a gap in each, and what lies between.
private kl::dataframe trips()
{
    str text = "k,start,end\nb,2026-11-19 14:03:05,2026-11-20\na,2024-02-29,2024-03-01 12:00\nb,2026-01-01 23:59:59.25,2026-01-01\na,,2026-05-05\nc,1999-12-31 08:00,\n";
    kl::dataframe df = kl::dataframe();
    df.insert( "k", parsed( text, ',' )["k"].copy() );
    df.insert( "start", times_of( text, "start" ) );
    df.insert( "end", times_of( text, "end" ) );
    df.set( "took", df["end"] - df["start"] );
    return df;
}

private void times_are_read_printed_and_written( ref kl::test::context c )
{
    kl::dataframe dates = kl::dataframe();
    dates.insert( "w", times_of( "w,n\n2026-11-19,1\n2026-01-02,2\n,3\n", "w" ) );
    c.check_eq( kl::dtype_name( dates.dtypes()[0] ), "datetime64[ns]" );
    c.check_eq( dates.to_string(), "           w\n0 2026-11-19\n1 2026-01-02\n2        NaT" );
    c.check_eq( dates.to_csv(), "w\n2026-11-19\n2026-01-02\n\"\"\n" );
    switch( kl::parse_csv( dates.to_csv() ) )
    {
        case result::ok( back ):
            c.check_eq( back.rows(), 3 );
            break;
        case result::err( _ ):
            c.check( false );
            break;
    }

    kl::dataframe fine = kl::dataframe();
    fine.insert( "w", times_of( "w\n2026-11-19 14:00:00.5\n2026-01-02\n", "w" ) );
    c.check_eq( fine.to_string(), "                        w\n0 2026-11-19 14:00:00.500\n1 2026-01-02 00:00:00.000" );
    c.check_eq( times_of( "w\n2026-11-19 14:00:00.000001\n", "w" ).timestamp_at( 0 ).nanosecond(), 1000 );

    kl::dataframe spans = kl::dataframe();
    spans.insert( "d", kl::series( [ kl::duration::of_hours( 1 ), kl::duration::of_seconds( -1 ), kl::duration::of_days( 1 ) + kl::duration::of_seconds( 1 ) ] ) );
    c.check_eq( kl::dtype_name( spans.dtypes()[0] ), "timedelta64[ns]" );
    c.check_eq( spans.to_string(), "                  d\n0   0 days 01:00:00\n1 -1 days +23:59:59\n2   1 days 00:00:01" );
    c.check_eq( spans.to_csv(), "d\n0 days 01:00:00\n-1 days +23:59:59\n1 days 00:00:01\n" );
    kl::dataframe days = kl::dataframe();
    days.insert( "d", kl::series( [ kl::duration::of_days( 1 ), kl::duration::of_nanoseconds( 500000000 ) ] ) );
    c.check_eq( days.to_string(), "                       d\n0 1 days 00:00:00.000000\n1 0 days 00:00:00.500000" );
    days.set( "d", kl::series( [ kl::duration::of_days( 1 ), kl::duration::of_days( 2 ) ] ) );
    c.check_eq( days.to_string(), "       d\n0 1 days\n1 2 days" );

    switch( kl::series( [ "19/11/2026", "01/02/2003" ] ).to_times( "%d/%m/%Y" ) )
    {
        case result::ok( t ):
            c.check_eq( t.timestamp_at( 1 ).to_string(), "2003-02-01 00:00:00" );
            break;
        case result::err( _ ):
            c.check( false );
            break;
    }
    switch( kl::series( [ "2026-11-19", "nope" ] ).to_times() )
    {
        case result::ok( _ ):
            c.check( false );
            break;
        case result::err( row ):
            c.check_eq( row, 1 );
            break;
    }
}

private void times_take_arithmetic_and_give_fields( ref kl::test::context c )
{
    kl::dataframe df = trips();
    c.check_eq( df.select( "k", "took" ).to_string(), "   k                     took\n0  b   0 days 09:56:55.000000\n1  a   1 days 12:00:00.000000\n2  b -1 days +00:00:00.750000\n3  a                      NaT\n4  c                      NaT" );
    c.check_eq( ( df["start"] + kl::duration::of_hours( 36 ) ).timestamp_at( 1 ).to_string(), "2024-03-01 12:00:00" );
    c.check_eq( ( df["took"] - kl::duration::of_hours( 1 ) ).duration_at( 1 ).to_string(), "1 days 11:00:00" );
    c.check_eq( ( df["end"] - kl::date( 2026, 1, 1 ).at() ).duration_at( 0 ).to_string(), "323 days 00:00:00" );
    c.check_eq( df["took"].total_seconds().f64s()[2], -86399.25 );
    c.check( df["took"].total_seconds().is_missing( 4 ) );

    kl::series start = df["start"].copy();
    c.check_eq( start.year().i64s()[0], 2026 );
    c.check_eq( start.month().i64s()[1], 2 );
    c.check_eq( start.day().i64s()[1], 29 );
    c.check_eq( start.hour().i64s()[2], 23 );
    c.check_eq( start.minute().i64s()[2], 59 );
    c.check_eq( start.second().i64s()[0], 5 );
    c.check_eq( start.nanosecond().i64s()[2], 250000000 );
    c.check_eq( start.weekday().i64s()[4], 4 );
    c.check_eq( start.day_of_year().i64s()[1], 60 );
    c.check( start.year().is_missing( 3 ) );

    c.expect_panic( "the dtypes do not combine", fn[]() { _ = trips()["start"] + trips()["start"]; } );
    c.expect_panic( "the dtypes do not combine", fn[]() { _ = trips()["took"] - trips()["start"]; } );
    c.expect_panic( "the series hold dtypes that do not compare", fn[]() { _ = trips()["took"].less( trips()["start"] ); } );
    c.expect_panic( "the series does not hold numbers", fn[]() { _ = trips()["took"].sum(); } );
}

private void times_compare_sort_and_group( ref kl::test::context c )
{
    kl::dataframe df = trips();
    kl::timestamp cut = kl::date( 2025, 1, 1 ).at();
    kl::mask before = df["start"].less( cut );
    c.check( !before.test( 0 ) && before.test( 1 ) && !before.test( 3 ) && before.test( 4 ) );
    c.check_eq( df["start"].greater_equal( cut ).count(), 2 );
    c.check( df["start"].differs( cut ).test( 3 ) );
    c.check_eq( df.filtered( df["took"].greater( df["took"] - kl::duration::of_seconds( 1 ) ) ).rows(), 3 );

    switch( df["start"].min_time() )
    {
        case kl::optional::some( t ):
            c.check_eq( t.to_string(), "1999-12-31 08:00:00" );
            break;
        case kl::optional::none:
            c.check( false );
            break;
    }
    c.check_eq( df.sort_values( "took", false ).select( "k", "took" ).to_string(), "   k                     took\n0  a   1 days 12:00:00.000000\n1  b   0 days 09:56:55.000000\n2  b -1 days +00:00:00.750000\n3  a                      NaT\n4  c                      NaT" );
    c.check_eq( df.groupby( "k" ).min().to_string(), "   k                   start                 end                     took\n0  a 2024-02-29 00:00:00.000 2024-03-01 12:00:00   1 days 12:00:00.000000\n1  b 2026-01-01 23:59:59.250 2026-01-01 00:00:00 -1 days +00:00:00.750000\n2  c 1999-12-31 08:00:00.000                 NaT                      NaT" );
    c.check_eq( df.groupby( "k" ).sum().to_string(), "   k                     took\n0  a   1 days 12:00:00.000000\n1  b -1 days +09:56:55.750000\n2  c   0 days 00:00:00.000000" );
    c.check_eq( df["start"].unique().size(), 5 );
}

private void concat_stacks_rows( ref kl::test::context c )
{
    kl::dataframe both = kl::concat( parsed( "x,y\n1,p\n2,q\n", ',' ), parsed( "x,z\n1.5,True\n", ',' ) );
    c.check_eq( both.to_string(), "     x    y     z\n0  1.0    p  <NA>\n1  2.0    q  <NA>\n2  1.5  NaN  True" );
    kl::dataframe ints = kl::concat( parsed( "n\n1\n", ',' ), parsed( "m\n2\n", ',' ) );
    c.check_eq( ints.to_string(), "      n     m\n0     1  <NA>\n1  <NA>     2" );
    c.check_eq( kl::concat().rows(), 0 );
    c.expect_panic( "the frames hold a column in dtypes that do not concatenate", fn[]() { _ = kl::concat( parsed( "a\n1\n", ',' ), parsed( "a\nx\n", ',' ) ); } );
}

private void merge_pairs_rows( ref kl::test::context c )
{
    kl::dataframe l = parsed( "k,v\nb,1\na,2\nb,3\nc,4\n,5\n", ',' );
    kl::dataframe r = parsed( "k,w\na,10.0\nb,20.0\nd,30.0\nb,40.0\n,50.0\n", ',' );
    c.check_eq( l.merge( r, kl::how::inner, "k" ).to_string(), "     k  v     w\n0    b  1  20.0\n1    b  1  40.0\n2    a  2  10.0\n3    b  3  20.0\n4    b  3  40.0\n5  NaN  5  50.0" );
    c.check_eq( l.merge( r, kl::how::left, "k" ).to_string(), "     k  v     w\n0    b  1  20.0\n1    b  1  40.0\n2    a  2  10.0\n3    b  3  20.0\n4    b  3  40.0\n5    c  4   NaN\n6  NaN  5  50.0" );
    c.check_eq( l.merge( r, kl::how::right, "k" ).to_string(), "     k     v     w\n0    a     2  10.0\n1    b     1  20.0\n2    b     3  20.0\n3    d  <NA>  30.0\n4    b     1  40.0\n5    b     3  40.0\n6  NaN     5  50.0" );
    c.check_eq( l.merge( r, kl::how::outer ).to_string(), "     k     v     w\n0    a     2  10.0\n1    b     1  20.0\n2    b     1  40.0\n3    b     3  20.0\n4    b     3  40.0\n5    c     4   NaN\n6    d  <NA>  30.0\n7  NaN     5  50.0" );

    kl::dataframe d = parsed( "k,j,v\n1,x,1\n2,y,2\n1,y,3\n", ',' );
    kl::dataframe e = parsed( "k,j,v\n1,y,7\n1,x,8\n3,z,9\n", ',' );
    c.check_eq( d.merge( e, kl::how::outer, "k", "j" ).to_string(), "   k  j   v_x   v_y\n0  1  x     1     8\n1  1  y     3     7\n2  2  y     2  <NA>\n3  3  z  <NA>     9" );
    c.check_eq( d.merge( e, kl::how::inner, "k" ).columns()[1], "j_x" );
    c.check_eq( d.merge( parsed( "k,w\n", ',' ), kl::how::left, "k" )["w"].count(), 0 );
    c.expect_panic( "the key columns' dtypes differ", fn[]() { _ = parsed( "k\n1\n", ',' ).merge( parsed( "k\nx\n", ',' ), kl::how::inner ); } );
    c.expect_panic( "the frames share no column to merge on", fn[]() { _ = parsed( "a\n1\n", ',' ).merge( parsed( "b\n1\n", ',' ), kl::how::inner ); } );
}

private void index_labels_rows( ref kl::test::context c )
{
    kl::dataframe df = parsed( "k,v,w\nb,1,1.5\na,2,2.25\nc,3,\na,4,4.0\n", ',' );
    kl::dataframe a = df.set_index( "k" );
    c.check_eq( a.to_string(), "   v     w\nk         \nb  1  1.50\na  2  2.25\nc  3   NaN\na  4  4.00" );
    c.check_eq( a.loc( "a" ).to_string(), "   v     w\nk         \na  2  2.25\na  4  4.00" );
    c.check_eq( a.filtered( a["v"].greater( 1.0 ) ).head( 1 ).to_string(), "   v     w\nk         \na  2  2.25" );
    c.check_eq( a.reset_index().to_string(), df.to_string() );
    c.check_eq( df.reset_index().columns()[0], "index" );
    c.check_eq( df.set_index( "v" ).loc( 2, 3 ).to_string(), "   k     w\nv         \n2  a  2.25\n3  c   NaN" );
    c.check_eq( df.set_index( "w" ).to_string(), "      k  v\nw         \n1.50  b  1\n2.25  a  2\nNaN   c  3\n4.00  a  4" );
    c.check_eq( df.sort_values( "k" ).set_index( "k" ).loc( "aa", "bz" ).to_string(), "   v    w\nk        \nb  1  1.5" );
    c.check_eq( df.loc( 3 ).rows(), 1 );
    c.expect_panic( "no row has that label", fn[ a ]() { _ = a.loc( "z" ); } );
    c.expect_panic( "the index is not sorted", fn[ a ]() { _ = a.loc( "a", "b" ); } );
}
