// Slots below `count` are live, the rest are raw.
class list<T>
{
    list() 
    {
        data_ = nullptr;
        count_ = 0;
        cap_ = 0;
    }

    public static list<T> with_capacity( u64 capacity )
    {
        list<T> result = list<T>();
        result.cap_ = capacity;
        result.count_ = 0;

        unsafe
        {
            result.data_ = alloc<T>( capacity );
        }

        return result;
    }

    ~list()
    {
        if( data_ != nullptr )
        {
            unsafe
            {
                destroy( data_, count_ );
                free( data_ );
            }
        }
    }

    public void push( move T value )
    {
        if( count_ == cap_ )
        {
            grow( cap_ > 0 ? cap_ * 2 : 1 );
        }
        
        unsafe
        {
            data_[count_] = move value;
        }
        count_ += 1;
    }

    public T pop()
    {
        assert( count_ > 0 );
        count_ -= 1;
        unsafe
        {
            return move data_[count_];
        }
    }

    public T* operator[]( u64 index ) const
    {
        assert( index < count_ );

        unsafe
        {
            return &data_[index];
        }
    }

    public T remove( u64 index )
    {
        assert( index < count_ );

        unsafe
        {
            T result = move data_[index];

            for( u64 i = index; i < count_ - 1; i++ )
            {
                data_[i] = move data_[i + 1];
            }

            count_ -= 1;
            return result;
        }
    }

    public T swap_remove( u64 index )
    {
        assert( index < count_ );

        count_ -= 1;
        unsafe
        {
            T result = move data_[index];

            if( index != count_ )
            {
                data_[index] = move data_[count_];
            }

            return result;
        }
    }

    public T replace( u64 index, move T value )
    {
        assert( index < count_ );

        unsafe
        {
            T result = move data_[index];
            data_[index] = move value;
            return result;
        }
    }

    public void swap( u64 a, u64 b )
    {
        assert( a < count_ );
        assert( b < count_ );

        if( a == b )
        {
            return;
        }

        unsafe
        {
            T temp = move data_[a];
            data_[a] = move data_[b];
            data_[b] = move temp;
        }
    }

    public u64 size() const
    {
        return count_;
    }

    public u64 capacity() const
    {
        return cap_;
    }

    public bool is_empty() const
    {
        return count_ == 0;
    }

    public void reserve( u64 n )
    {
        if( n > cap_ )
        {
            grow( n );
        }
    }

    public void clear()
    {
        unsafe
        {
            destroy( data_, count_ );
        }
        count_ = 0;
    }

    private void grow( u64 n )
    {
        T[*] new_data;
        unsafe
        {
            new_data = alloc<T>( n );
        }

        if( data_ != nullptr )
        {
            for( u64 i = 0; i < count_; i++ )
            {
                unsafe
                {
                    new_data[i] = move data_[i];
                }
            }
            
            // Slots are raw after the above move, so we don't need to destroy them.
            unsafe
            {
                free( data_ );
            }
        }

        data_ = new_data;
        cap_ = n;
    }

    private T[*] data_;
    private u64 count_;
    private u64 cap_;
};