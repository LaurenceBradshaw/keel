// The exponentials, logarithms, powers, hyperbolic functions and error functions behind `kl::math`:
// the hyperbolic functions and erfc within 2 ulps of the true value, the rest within one.
import float_bits;
import trig;

/// e^x times 2^s, `s` 0 or -1; -1 keeps e^x / 2 finite up to 710.47, where e^x is not.
f64 exp_scaled( f64 x, i32 s )
{
    u32 hx = high_word( x );
    bool negative = ( hx >> 31 ) != 0;
    u64 xsb = negative ? 1 : 0;
    hx &= 0x7fffffff;

    if( hx >= 0x40862E42 )
    {
        if( hx >= 0x7ff00000 )
        {
            if( ( ( hx & 0xfffff ) | low_word( x ) ) != 0 )
            {
                return x + x;
            }
            return negative ? 0.0 : x;
        }
        if( s == 0 && x > O_THRESHOLD )
        {
            return inf();
        }
        if( x < U_THRESHOLD )
        {
            return 0.0;
        }
    }

    f64 hi = 0.0;
    f64 lo = 0.0;
    i32 k = 0;
    if( hx > 0x3fd62e42 )
    {
        if( hx < 0x3FF0A2B2 )
        {
            hi = x - LN2HI[xsb];
            lo = LN2LO[xsb];
            k = negative ? -1 : 1;
        }
        else
        {
            k = truncated( INVLN2 * x + HALF[xsb] );
            f64 t = cast<f64>( k );
            hi = x - t * LN2HI[0];
            lo = t * LN2LO[0];
        }
        x = hi - lo;
    }
    else if( hx < 0x3e300000 )
    {
        return times_power_of_two( 1.0 + x, s );
    }

    f64 t = x * x;
    f64 c = x - t * ( P1 + t * ( P2 + t * ( P3 + t * ( P4 + t * P5 ) ) ) );
    if( k == 0 )
    {
        return times_power_of_two( 1.0 - ( ( x * c ) / ( c - 2.0 ) - x ), s );
    }
    f64 y = 1.0 - ( ( lo - ( x * c ) / ( 2.0 - c ) ) - hi );
    return times_power_of_two( y, k + s );
}

/// e^x.
f64 exp( f64 x )
{
    u64 ix = bits_of( x );
    u32 abstop = wrap<u32>( ix >> 52 ) & 0x7ff;
    // |x| below 2^-54, at least 512, or not finite.
    if( wrap<u32>( abstop - 0x3c9 ) >= 0x408 - 0x3c9 )
    {
        if( wrap<u32>( abstop - 0x3c9 ) >= 0x80000000 )
        {
            return 1.0 + x;
        }
        if( abstop >= 0x409 )
        {
            if( ix == 0xfff0_0000_0000_0000 )
            {
                return 0.0;
            }
            if( abstop >= 0x7ff )
            {
                return 1.0 + x;
            }
            return ( ix >> 63 ) != 0 ? 0.0 : inf();
        }
        abstop = 0;
    }

    // x = k ln2 / N + r, r in [-ln2 / 2N, ln2 / 2N]; e^x = 2^(k / N) e^r.
    f64 z = EXP_INVLN2N * x;
    f64 kd = z + EXP_SHIFT;
    u64 ki = bits_of( kd );
    kd -= EXP_SHIFT;
    f64 r = x + kd * EXP_NEGLN2HIN + kd * EXP_NEGLN2LON;
    u64 idx = 2 * ( ki % 128 );
    f64 tail = from_bits( EXP_T[idx] );
    u64 sbits = wrap<u64>( EXP_T[idx + 1] + ( ki << 45 ) );
    f64 r2 = r * r;
    f64 tmp = tail + r + r2 * ( EXP_C[0] + r * EXP_C[1] ) + r2 * r2 * ( EXP_C[2] + r * EXP_C[3] );
    if( abstop == 0 )
    {
        return exp_near_limits( tmp, sbits, ki );
    }
    f64 scale = from_bits( sbits );
    return scale + scale * tmp;
}

/// e^x - 1, exact near 0.
f64 expm1( f64 x )
{
    u32 hx = high_word( x );
    bool negative = ( hx >> 31 ) != 0;
    hx &= 0x7fffffff;

    if( hx >= 0x4043687A )
    {
        if( hx >= 0x40862E42 )
        {
            if( hx >= 0x7ff00000 )
            {
                if( ( ( hx & 0xfffff ) | low_word( x ) ) != 0 )
                {
                    return x + x;
                }
                return negative ? -1.0 : x;
            }
            if( x > O_THRESHOLD )
            {
                return inf();
            }
        }
        if( negative )
        {
            return -1.0;
        }
    }

    f64 c = 0.0;
    i32 k = 0;
    if( hx > 0x3fd62e42 )
    {
        f64 hi = 0.0;
        f64 lo = 0.0;
        if( hx < 0x3FF0A2B2 )
        {
            hi = negative ? x + LN2HI[0] : x - LN2HI[0];
            lo = negative ? -LN2LO[0] : LN2LO[0];
            k = negative ? -1 : 1;
        }
        else
        {
            k = truncated( INVLN2 * x + ( negative ? -0.5 : 0.5 ) );
            f64 t = cast<f64>( k );
            hi = x - t * LN2HI[0];
            lo = t * LN2LO[0];
        }
        x = hi - lo;
        c = ( hi - x ) - lo;
    }
    else if( hx < 0x3c900000 )
    {
        return x;
    }

    f64 hfx = 0.5 * x;
    f64 hxs = x * hfx;
    f64 r1 = 1.0 + hxs * ( Q1 + hxs * ( Q2 + hxs * ( Q3 + hxs * ( Q4 + hxs * Q5 ) ) ) );
    f64 t = 3.0 - r1 * hfx;
    f64 e = hxs * ( ( r1 - t ) / ( 6.0 - x * t ) );
    if( k == 0 )
    {
        return x - ( x * e - hxs );
    }
    e = x * ( e - c ) - c;
    e -= hxs;
    if( k == -1 )
    {
        return 0.5 * ( x - e ) - 0.5;
    }
    if( k == 1 )
    {
        if( x < -0.25 )
        {
            return -2.0 * ( e - ( x + 0.5 ) );
        }
        return 1.0 + 2.0 * ( x - e );
    }
    if( k <= -2 || k > 56 )
    {
        return times_power_of_two( 1.0 - ( e - x ), k ) - 1.0;
    }
    u32 bit = 0x200000;
    if( k < 20 )
    {
        f64 one_less = from_words( 0x3ff00000 - ( bit >> wrap<u32>( k ) ), 0 ); // 1 - 2^-k
        return times_power_of_two( one_less - ( e - x ), k );
    }
    f64 y = x - ( e + from_words( wrap<u32>( 0x3ff - k ) << 20, 0 ) ); // 2^-k
    y += 1.0;
    return times_power_of_two( y, k );
}

/// The natural logarithm: -inf at 0, NaN below.
f64 log( f64 x )
{
    u64 ix = bits_of( x );
    if( wrap<u64>( ix - LOG_NEAR_LOW ) < LOG_NEAR_HIGH - LOG_NEAR_LOW )
    {
        return log_near_one( x );
    }
    u32 top = wrap<u32>( ix >> 48 );
    // Not above 2^-1022 and finite.
    if( wrap<u32>( top - 0x0010 ) >= 0x7ff0 - 0x0010 )
    {
        if( ( ix << 1 ) == 0 )
        {
            return -inf();
        }
        if( ix == 0x7ff0_0000_0000_0000 )
        {
            return x;
        }
        if( ( top & 0x8000 ) != 0 || ( top & 0x7ff0 ) == 0x7ff0 )
        {
            return x != x ? x + x : nan();
        }
        ix = wrap<u64>( bits_of( x * TWO52 ) - ( 52 << 52 ) );
    }

    // x = 2^k z, z in [OFF, 2 OFF) and exact, near c, the centre of the i-th of 128 subintervals:
    // log(x) = log1p(z / c - 1) + log(c) + k ln2.
    u64 tmp = wrap<u64>( ix - 0x3fe6_0000_0000_0000 );
    u64 i = ( tmp >> 45 ) % 128;
    i64 k = wrap<i64>( tmp ) >> 52;
    u64 iz = wrap<u64>( ix - ( tmp & 0xfff0_0000_0000_0000 ) );
    f64 invc = LOG_INVC[i];
    f64 logc = LOG_LOGC[i];
    f64 z = from_bits( iz );
    f64 r = ( z - LOG_CHI[i] - LOG_CLO[i] ) * invc;
    f64 kd = cast<f64>( k );
    f64 w = kd * LOG_LN2HI + logc;
    f64 hi = w + r;
    f64 lo = w - hi + r + kd * LOG_LN2LO;
    f64 r2 = r * r;
    return lo + r2 * LOG_A[0] + r * r2 * ( LOG_A[1] + r * LOG_A[2] + r2 * ( LOG_A[3] + r * LOG_A[4] ) ) + hi;
}

/// log(1 + x), exact near 0: -inf at -1, NaN below.
f64 log1p( f64 x )
{
    u32 hx = high_word( x );
    bool negative = ( hx >> 31 ) != 0;
    u32 ax = hx & 0x7fffffff;

    f64 f = 0.0;
    f64 c = 0.0;
    i32 k = 1;
    u32 hu = 0;
    if( negative || hx < 0x3FDA827A )
    {
        if( negative && ax >= 0x3ff00000 )
        {
            return x == -1.0 ? -inf() : nan();
        }
        if( ax < 0x3e200000 )
        {
            return ax < 0x3c900000 ? x : x - x * x * 0.5;
        }
        if( !negative || ax <= 0x3fd2bec4 )
        {
            k = 0;
            f = x;
            hu = 1;
        }
    }
    if( hx >= 0x7ff00000 && !negative )
    {
        return x + x;
    }
    if( k != 0 )
    {
        f64 u = x;
        if( hx < 0x43400000 || negative )
        {
            u = 1.0 + x;
            hu = high_word( u );
            k = wrap<i32>( hu >> 20 ) - 1023;
            c = k > 0 ? 1.0 - ( u - x ) : x - ( u - 1.0 );
            c /= u;
        }
        else
        {
            hu = high_word( u );
            k = wrap<i32>( hu >> 20 ) - 1023;
        }
        hu &= 0x000fffff;
        if( hu < 0x6a09e )
        {
            u = with_high_word( u, hu | 0x3ff00000 );
        }
        else
        {
            k += 1;
            u = with_high_word( u, hu | 0x3fe00000 );
            hu = ( 0x00100000 - hu ) >> 2;
        }
        f = u - 1.0;
    }

    f64 dk = cast<f64>( k );
    f64 hfsq = 0.5 * f * f;
    if( hu == 0 )
    {
        if( f == 0.0 )
        {
            if( k == 0 )
            {
                return 0.0;
            }
            c += dk * LN2LO[0];
            return dk * LN2HI[0] + c;
        }
        f64 r = hfsq * ( 1.0 - 0.66666666666666666 * f );
        return k == 0 ? f - r : dk * LN2HI[0] - ( ( r - ( dk * LN2LO[0] + c ) ) - f );
    }
    f64 s = f / ( 2.0 + f );
    f64 z = s * s;
    f64 r = z * ( LG1 + z * ( LG2 + z * ( LG3 + z * ( LG4 + z * ( LG5 + z * ( LG6 + z * LG7 ) ) ) ) ) );
    if( k == 0 )
    {
        return f - ( hfsq - s * ( hfsq + r ) );
    }
    return dk * LN2HI[0] - ( ( hfsq - ( s * ( hfsq + r ) + ( dk * LN2LO[0] + c ) ) ) - f );
}

/// The base 2 logarithm, exact at powers of 2.
f64 log2( f64 x )
{
    if( outside_log( x ) )
    {
        return log_outside( x );
    }
    if( x == 1.0 )
    {
        return 0.0;
    }

    parts p = split( x );
    f64 f = p.f;
    f64 y = cast<f64>( p.k );
    f64 hfsq = 0.5 * f * f;
    f64 r = log1p_kernel( f );
    f64 hi = low_word_cleared( f - hfsq );
    f64 lo = ( f - hi ) - hfsq + r;
    f64 val_hi = hi * IVLN2HI;
    f64 val_lo = ( lo + hi ) * IVLN2LO + lo * IVLN2HI;
    f64 w = y + val_hi;
    val_lo += ( y - w ) + val_hi;
    val_hi = w;
    return val_lo + val_hi;
}

/// The base 10 logarithm.
f64 log10( f64 x )
{
    if( outside_log( x ) )
    {
        return log_outside( x );
    }
    if( x == 1.0 )
    {
        return 0.0;
    }

    parts p = split( x );
    f64 f = p.f;
    f64 y = cast<f64>( p.k );
    f64 hfsq = 0.5 * f * f;
    f64 r = log1p_kernel( f );
    f64 hi = low_word_cleared( f - hfsq );
    f64 lo = ( f - hi ) - hfsq + r;
    f64 val_hi = hi * IVLN10HI;
    f64 y2 = y * LOG10_2HI;
    f64 val_lo = y * LOG10_2LO + ( lo + hi ) * IVLN10LO + lo * IVLN10HI;
    f64 w = y2 + val_hi;
    val_lo += ( y2 - w ) + val_hi;
    val_hi = w;
    return val_lo + val_hi;
}

/// x^y, with C's special values: 1 when `y` is 0 or `x` is 1, even for a NaN.
f64 pow( f64 x, f64 y )
{
    u32 hx = high_word( x );
    u32 lx = low_word( x );
    u32 hy = high_word( y );
    u32 ly = low_word( y );
    u32 ix = hx & 0x7fffffff;
    u32 iy = hy & 0x7fffffff;
    bool x_negative = ( hx >> 31 ) != 0;
    bool y_negative = ( hy >> 31 ) != 0;

    if( ( iy | ly ) == 0 || ( hx == 0x3ff00000 && lx == 0 ) )
    {
        return 1.0;
    }
    if( ix > 0x7ff00000 || ( ix == 0x7ff00000 && lx != 0 ) || iy > 0x7ff00000 || ( iy == 0x7ff00000 && ly != 0 ) )
    {
        return x + y;
    }

    // 0 when `y` is not a whole number, 1 when it is odd and 2 when even; only for a negative `x`.
    i32 yisint = 0;
    if( x_negative )
    {
        if( iy >= 0x43400000 )
        {
            yisint = 2;
        }
        else if( iy >= 0x3ff00000 )
        {
            u32 k = ( iy >> 20 ) - 0x3ff;
            if( k > 20 )
            {
                u32 j = ly >> ( 52 - k );
                if( ( j << ( 52 - k ) ) == ly )
                {
                    yisint = 2 - wrap<i32>( j & 1 );
                }
            }
            else if( ly == 0 )
            {
                u32 j = iy >> ( 20 - k );
                if( ( j << ( 20 - k ) ) == iy )
                {
                    yisint = 2 - wrap<i32>( j & 1 );
                }
            }
        }
    }

    if( ly == 0 )
    {
        if( iy == 0x7ff00000 )
        {
            if( ix == 0x3ff00000 && lx == 0 )
            {
                return 1.0;
            }
            if( ix >= 0x3ff00000 )
            {
                return y_negative ? 0.0 : y;
            }
            return y_negative ? -y : 0.0;
        }
        if( iy == 0x3ff00000 )
        {
            return y_negative ? 1.0 / x : x;
        }
        if( hy == 0x40000000 )
        {
            return x * x;
        }
        if( hy == 0x3fe00000 && !x_negative )
        {
            return sqrt_f64( x );
        }
    }

    f64 ax = magnitude( x );
    if( lx == 0 && ( ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000 ) )
    {
        f64 z = y_negative ? 1.0 / ax : ax;
        if( x_negative )
        {
            if( ix == 0x3ff00000 && yisint == 0 )
            {
                return nan();
            }
            if( yisint == 1 )
            {
                return -z;
            }
        }
        return z;
    }

    if( x_negative && yisint == 0 )
    {
        return nan();
    }
    f64 s = x_negative && yisint == 1 ? -1.0 : 1.0;

    // log2(|x|) as t1 + t2.
    f64 t1 = 0.0;
    f64 t2 = 0.0;
    if( iy > 0x41e00000 )
    {
        if( iy > 0x43f00000 )
        {
            if( ix <= 0x3fefffff )
            {
                return y_negative ? inf() : 0.0;
            }
            return y_negative ? 0.0 : inf();
        }
        if( ix < 0x3fefffff )
        {
            return y_negative ? s * inf() : s * 0.0;
        }
        if( ix > 0x3ff00000 )
        {
            return y_negative ? s * 0.0 : s * inf();
        }
        f64 t = ax - 1.0;
        f64 w = ( t * t ) * ( 0.5 - t * ( THIRD - t * 0.25 ) );
        f64 u = IVLN2_H * t;
        f64 v = t * IVLN2_L - w * IVLN2;
        t1 = low_word_cleared( u + v );
        t2 = v - ( t1 - u );
    }
    else
    {
        i32 n = 0;
        if( ix < 0x00100000 )
        {
            ax *= TWO53;
            n -= 53;
            ix = high_word( ax );
        }
        n += wrap<i32>( ix >> 20 ) - 0x3ff;
        u32 j = ix & 0x000fffff;
        ix = j | 0x3ff00000;
        u32 k = 0;
        if( j > 0x3988E )
        {
            if( j < 0xBB67A )
            {
                k = 1;
            }
            else
            {
                n += 1;
                ix -= 0x00100000;
            }
        }
        ax = with_high_word( ax, ix );

        f64 u = ax - BP[k];
        f64 v = 1.0 / ( ax + BP[k] );
        f64 ss = u * v;
        f64 s_h = low_word_cleared( ss );
        f64 t_h = from_words( ( ( ix >> 1 ) | 0x20000000 ) + 0x00080000 + ( k << 18 ), 0 );
        f64 t_l = ax - ( t_h - BP[k] );
        f64 s_l = v * ( ( u - s_h * t_h ) - s_h * t_l );
        f64 s2 = ss * ss;
        f64 r = s2 * s2 * ( L1 + s2 * ( L2 + s2 * ( L3 + s2 * ( L4 + s2 * ( L5 + s2 * L6 ) ) ) ) );
        r += s_l * ( s_h + ss );
        s2 = s_h * s_h;
        t_h = low_word_cleared( 3.0 + s2 + r );
        t_l = r - ( ( t_h - 3.0 ) - s2 );
        u = s_h * t_h;
        v = s_l * t_h + t_l * ss;
        f64 p_h = low_word_cleared( u + v );
        f64 p_l = v - ( p_h - u );
        f64 z_h = CP_H * p_h;
        f64 z_l = CP_L * p_h + p_l * CP + DP_L[k];
        f64 t = cast<f64>( n );
        t1 = low_word_cleared( ( ( z_h + z_l ) + DP_H[k] ) + t );
        t2 = z_l - ( ( ( t1 - t ) - DP_H[k] ) - z_h );
    }

    // y * log2(|x|) as p_h + p_l, then 2 to that.
    f64 y1 = low_word_cleared( y );
    f64 p_l = ( y - y1 ) * t1 + y * t2;
    f64 p_h = y1 * t1;
    f64 z = p_l + p_h;
    u32 j = high_word( z );
    u32 i = low_word( z );
    bool z_negative = ( j >> 31 ) != 0;
    if( !z_negative && j >= 0x40900000 )
    {
        if( ( ( j - 0x40900000 ) | i ) != 0 || p_l + OVT > z - p_h )
        {
            return s * inf();
        }
    }
    else if( ( j & 0x7fffffff ) >= 0x4090cc00 )
    {
        if( ( ( j - 0xc090cc00 ) | i ) != 0 || p_l <= z - p_h )
        {
            return s * 0.0;
        }
    }

    i = j & 0x7fffffff;
    i32 k = wrap<i32>( i >> 20 ) - 0x3ff;
    i32 n = 0;
    if( i > 0x3fe00000 )
    {
        u32 half_bit = 0x00100000;
        u32 m = j + ( half_bit >> wrap<u32>( k + 1 ) );
        k = wrap<i32>( ( m & 0x7fffffff ) >> 20 ) - 0x3ff;
        u32 fraction = 0x000fffff;
        f64 t = from_words( m & ~( fraction >> wrap<u32>( k ) ), 0 );
        n = wrap<i32>( ( ( m & 0x000fffff ) | 0x00100000 ) >> wrap<u32>( 20 - k ) );
        if( z_negative )
        {
            n = -n;
        }
        p_h -= t;
    }
    f64 t = low_word_cleared( p_l + p_h );
    f64 u = t * LN2_H;
    f64 v = ( p_l - ( t - p_h ) ) * LN2 + t * LN2_L;
    z = u + v;
    f64 w = v - ( z - u );
    t = z * z;
    t1 = z - t * ( P1 + t * ( P2 + t * ( P3 + t * ( P4 + t * P5 ) ) ) );
    f64 r = ( z * t1 ) / ( t1 - 2.0 ) - ( w + z * w );
    z = 1.0 - ( r - z );
    i32 e = wrap<i32>( high_word( z ) ) + n * 0x100000;
    if( e < 0x100000 )
    {
        return s * times_power_of_two( z, n );
    }
    return s * with_high_word( z, wrap<u32>( e ) );
}

/// The hyperbolic sine.
f64 sinh( f64 x )
{
    u32 jx = high_word( x );
    u32 ix = jx & 0x7fffffff;
    if( ix >= 0x7ff00000 )
    {
        return x + x;
    }

    f64 h = ( jx >> 31 ) != 0 ? -0.5 : 0.5;
    f64 a = magnitude( x );
    if( ix < 0x40360000 )
    {
        if( ix < 0x3e300000 )
        {
            return x;
        }
        f64 t = expm1( a );
        if( ix < 0x3ff00000 )
        {
            return h * ( 2.0 * t - t * t / ( t + 1.0 ) );
        }
        return h * ( t + t / ( t + 1.0 ) );
    }
    if( ix < 0x40862E42 )
    {
        return h * exp( a );
    }
    if( ix <= 0x408633CE )
    {
        return h * 2.0 * exp_scaled( a, -1 );
    }
    return x * SHUGE;
}

/// The hyperbolic cosine.
f64 cosh( f64 x )
{
    u32 ix = high_word( x ) & 0x7fffffff;
    if( ix >= 0x7ff00000 )
    {
        return x * x;
    }

    f64 a = magnitude( x );
    if( ix < 0x3fd62e43 )
    {
        f64 t = expm1( a );
        f64 w = 1.0 + t;
        if( ix < 0x3c800000 )
        {
            return w;
        }
        return 1.0 + ( t * t ) / ( w + w );
    }
    if( ix < 0x40360000 )
    {
        f64 t = exp( a );
        return 0.5 * t + 0.5 / t;
    }
    if( ix < 0x40862E42 )
    {
        return 0.5 * exp( a );
    }
    if( ix <= 0x408633CE )
    {
        return exp_scaled( a, -1 );
    }
    return inf();
}

/// The hyperbolic tangent.
f64 tanh( f64 x )
{
    u32 jx = high_word( x );
    u32 ix = jx & 0x7fffffff;
    bool negative = ( jx >> 31 ) != 0;
    if( ix >= 0x7ff00000 )
    {
        return negative ? 1.0 / x - 1.0 : 1.0 / x + 1.0;
    }

    f64 z = 1.0;
    if( ix < 0x40360000 )
    {
        if( ix < 0x3e300000 )
        {
            return x;
        }
        if( ix >= 0x3ff00000 )
        {
            f64 t = expm1( 2.0 * magnitude( x ) );
            z = 1.0 - 2.0 / ( t + 2.0 );
        }
        else
        {
            f64 t = expm1( -2.0 * magnitude( x ) );
            z = -t / ( t + 2.0 );
        }
    }
    return negative ? -z : z;
}

/// The error function, 2/sqrt(pi) times the integral of e^(-t^2) from 0 to `x`.
f64 erf( f64 x )
{
    u32 hx = high_word( x );
    u32 ix = hx & 0x7fffffff;
    bool negative = ( hx >> 31 ) != 0;
    if( ix >= 0x7ff00000 )
    {
        return ( negative ? -1.0 : 1.0 ) + 1.0 / x;
    }

    if( ix < 0x3feb0000 )
    {
        if( ix < 0x3e300000 )
        {
            if( ix < 0x00800000 )
            {
                return ( 8.0 * x + EFX8 * x ) / 8.0;
            }
            return x + EFX * x;
        }
        return x + x * erf_small( x * x );
    }
    if( ix < 0x3ff40000 )
    {
        f64 r = erf_near_one( magnitude( x ) - 1.0 );
        return negative ? -ERX - r : ERX + r;
    }
    if( ix >= 0x40180000 )
    {
        return negative ? -1.0 : 1.0;
    }
    f64 a = magnitude( x );
    f64 r = erfc_tail( a, ix < 0x4006DB6E );
    return negative ? r - 1.0 : 1.0 - r;
}

/// 1 - erf( x ), without the cancellation when erf( x ) is near 1.
f64 erfc( f64 x )
{
    u32 hx = high_word( x );
    u32 ix = hx & 0x7fffffff;
    bool negative = ( hx >> 31 ) != 0;
    if( ix >= 0x7ff00000 )
    {
        return ( negative ? 2.0 : 0.0 ) + 1.0 / x;
    }

    if( ix < 0x3feb0000 )
    {
        if( ix < 0x3c700000 )
        {
            return 1.0 - x;
        }
        f64 y = erf_small( x * x );
        if( negative || ix < 0x3fd00000 )
        {
            return 1.0 - ( x + x * y );
        }
        return 0.5 - ( x * y + ( x - 0.5 ) );
    }
    if( ix < 0x3ff40000 )
    {
        f64 r = erf_near_one( magnitude( x ) - 1.0 );
        return negative ? 1.0 + ( ERX + r ) : ( 1.0 - ERX ) - r;
    }
    if( ix < 0x403c0000 )
    {
        if( negative && ix >= 0x40180000 )
        {
            return 2.0;
        }
        f64 r = erfc_tail( magnitude( x ), ix < 0x4006DB6D );
        return negative ? 2.0 - r : r;
    }
    return negative ? 2.0 : 0.0;
}

/// The probability a standard normal value is at most `x`, for `x` at most -1.25 sqrt(2): erfc( -x /
/// sqrt(2) ) / 2 with x^2 / 2 taken from `x` itself, as rounding x / sqrt(2) first would cost up to
/// 2 x^2 ulps.
f64 normal_lower_tail( f64 x )
{
    f64 a = -x * SQRT_HALF;
    u32 ia = high_word( a ) & 0x7fffffff;
    if( ia >= 0x403c0000 )
    {
        return 0.0;
    }
    f64 h = from_words( high_word( x ), 0 );
    return 0.5 * erfc_tail_of( a, h * h * 0.5, ( x - h ) * ( x + h ) * 0.5, ia < 0x4006DB6D );
}

/// `y` rounded to `T`, or an infinity where it is beyond `T`'s range, as arithmetic in `T` gives;
/// `cast` panics there.
T narrowed<T>( f64 y ) where T : floating
{
    // Only f32 rounds 1 + 2^-30 to 1, and beyond 2^128 - 2^103 an f64 rounds to its infinity.
    if( cast<T>( 1.000000000931322574615478515625 ) == 1.0 && ( y >= 3.4028235677973366e38 || y <= -3.4028235677973366e38 ) )
    {
        return cast<T>( y * 1.0e300 );
    }
    return cast<T>( y );
}

/// --- Internals ---

// `x` as 2^k (1 + f), 1 + f in [sqrt(2)/2, sqrt(2)); `hx` the top of the fraction before.
private struct parts
{
    f64 f;
    i32 k;
    u32 hx;
};

// A positive finite `x`, normal or not.
private parts split( f64 x )
{
    i32 k = 0;
    u32 hx = high_word( x );
    if( hx < 0x00100000 )
    {
        k -= 54;
        x *= TWO54;
        hx = high_word( x );
    }
    k += wrap<i32>( hx >> 20 ) - 1023;
    hx &= 0x000fffff;
    u32 i = ( hx + 0x95f64 ) & 0x100000;
    x = with_high_word( x, hx | ( i ^ 0x3ff00000 ) );
    k += wrap<i32>( i >> 20 );
    return parts { x - 1.0, k, hx };
}

// Whether `x` is not a positive finite number.
private bool outside_log( f64 x )
{
    return !( x > 0.0 ) || high_word( x ) >= 0x7ff00000;
}

private f64 log_outside( f64 x )
{
    if( x == 0.0 )
    {
        return -inf();
    }
    return x < 0.0 ? nan() : x + x;
}

// log(x) for x in (1 - 2^-4, 1 + 0x1.09p-4), where the table's terms would cancel.
private f64 log_near_one( f64 x )
{
    if( x == 1.0 )
    {
        return 0.0;
    }
    f64 r = x - 1.0;
    f64 r2 = r * r;
    f64 r3 = r * r2;
    f64 y = r3 * ( LOG_B[1] + r * LOG_B[2] + r2 * LOG_B[3] +
                   r3 * ( LOG_B[4] + r * LOG_B[5] + r2 * LOG_B[6] +
                          r3 * ( LOG_B[7] + r * LOG_B[8] + r2 * LOG_B[9] + r3 * LOG_B[10] ) ) );
    // r^2 / 2 split so its product is exact: hi + lo = r - r^2 / 2.
    f64 w = r * TWO27;
    f64 rhi = r + w - w;
    f64 rlo = r - rhi;
    w = rhi * rhi * LOG_B[0];
    f64 hi = r + w;
    f64 lo = r - hi + w;
    lo += LOG_B[0] * rlo * ( rhi + r );
    y += lo;
    y += hi;
    return y;
}

// scale (1 + tmp) for |x| at least 512, `sbits` scale's bits with its exponent maybe past the
// sign bit; `ki`'s low word is k, positive when the result may overflow, negative underflow.
private f64 exp_near_limits( f64 tmp, u64 sbits, u64 ki )
{
    if( ( ki & 0x8000_0000 ) == 0 )
    {
        f64 scale = from_bits( wrap<u64>( sbits - ( 1009 << 52 ) ) );
        return TWO1009 * ( scale + scale * tmp );
    }
    f64 scale = from_bits( wrap<u64>( sbits + ( 1022 << 52 ) ) );
    f64 y = scale + scale * tmp;
    if( y < 1.0 )
    {
        // Rounded to its precision before the scale into the subnormals, so it rounds once.
        f64 lo = scale - y + scale * tmp;
        f64 hi = 1.0 + y;
        lo = 1.0 - hi + y + lo;
        y = ( hi + lo ) - 1.0;
    }
    return TWOM1022 * y;
}

// log(1 + f) - f + f^2 / 2, for 1 + f in [sqrt(2)/2, sqrt(2)).
private f64 log1p_kernel( f64 f )
{
    f64 s = f / ( 2.0 + f );
    f64 z = s * s;
    f64 w = z * z;
    f64 t1 = w * ( LG2 + w * ( LG4 + w * LG6 ) );
    f64 t2 = z * ( LG1 + w * ( LG3 + w * ( LG5 + w * LG7 ) ) );
    f64 hfsq = 0.5 * f * f;
    return s * ( hfsq + ( t2 + t1 ) );
}

// `y` times 2^n, n from -1074 to 1024, rounded once.
private f64 times_power_of_two( f64 y, i32 n )
{
    if( n > 1023 )
    {
        return y * from_bits( wrap<u64>( n ) << 52 ) * from_bits( 0x7fe0_0000_0000_0000 );
    }
    if( n >= -1021 )
    {
        return y * from_bits( wrap<u64>( n + 1023 ) << 52 );
    }
    return y * from_bits( wrap<u64>( n + 2023 ) << 52 ) * TWOM1000;
}

// `x` toward zero, |x| below 2^31.
private i32 truncated( f64 x )
{
    f64 a = magnitude( x );
    f64 t = ( a + TWO52 ) - TWO52;
    i32 n = wrap<i32>( bits_of( ( t > a ? t - 1.0 : t ) + TWO52 ) );
    return x < 0.0 ? -n : n;
}

// (erf( x ) - x) / x for |x| < 0.84375, from `z` = x^2.
private f64 erf_small( f64 z )
{
    f64 r = PP0 + z * ( PP1 + z * ( PP2 + z * ( PP3 + z * PP4 ) ) );
    f64 s = 1.0 + z * ( QQ1 + z * ( QQ2 + z * ( QQ3 + z * ( QQ4 + z * QQ5 ) ) ) );
    return r / s;
}

// erf( 1 + s ) - ERX for |1 + s| in [0.84375, 1.25).
private f64 erf_near_one( f64 s )
{
    f64 p = PA0 + s * ( PA1 + s * ( PA2 + s * ( PA3 + s * ( PA4 + s * ( PA5 + s * PA6 ) ) ) ) );
    f64 q = 1.0 + s * ( QA1 + s * ( QA2 + s * ( QA3 + s * ( QA4 + s * ( QA5 + s * QA6 ) ) ) ) );
    return p / q;
}

// erfc( x ) for x in [1.25, 28): the first fit below 1/0.35 when `near`, the second above.
private f64 erfc_tail( f64 x, bool near )
{
    // x^2 as z^2 + (x - z)(x + z), `z` holding x's top 21 bits, so z^2 is exact.
    f64 z = from_words( high_word( x ), 0 );
    return erfc_tail_of( x, z * z, ( x - z ) * ( x + z ), near );
}

// erfc_tail with x^2 given as `high` + `low`, `high` holding few enough bits that `high + 0.5625`
// is exact.
private f64 erfc_tail_of( f64 x, f64 high, f64 low, bool near )
{
    f64 s = 1.0 / ( x * x );
    f64 r = 0.0;
    f64 t = 0.0;
    if( near )
    {
        r = RA0 + s * ( RA1 + s * ( RA2 + s * ( RA3 + s * ( RA4 + s * ( RA5 + s * ( RA6 + s * RA7 ) ) ) ) ) );
        t = 1.0 + s * ( SA1 + s * ( SA2 + s * ( SA3 + s * ( SA4 + s * ( SA5 + s * ( SA6 + s * ( SA7 + s * SA8 ) ) ) ) ) ) );
    }
    else
    {
        r = RB0 + s * ( RB1 + s * ( RB2 + s * ( RB3 + s * ( RB4 + s * ( RB5 + s * RB6 ) ) ) ) );
        t = 1.0 + s * ( SB1 + s * ( SB2 + s * ( SB3 + s * ( SB4 + s * ( SB5 + s * ( SB6 + s * SB7 ) ) ) ) ) );
    }
    return exp( -high - 0.5625 ) * exp( -low + r / t ) / x;
}

private f64 from_words( u32 high, u32 low )
{
    return from_bits( ( cast<u64>( high ) << 32 ) | cast<u64>( low ) );
}

private f64 with_high_word( f64 x, u32 high )
{
    return from_words( high, low_word( x ) );
}

