// Slots below `count` are live, the rest are raw.
class list<T>
{
    list() 
    {
        data = nullptr;
        count = 0;
        cap = 0;
    }

    public static list<T> with_capacity( u64 capacity )
    {
        list<T> result = list<T>();
        result.cap = capacity;
        result.count = 0;

        unsafe
        {
            result.data = alloc<T>( capacity );
        }

        return result;
    }

    ~list()
    {
        if( data != nullptr )
        {
            unsafe
            {
                destroy( data, count );
                free( data );
            }
        }
    }

    public void push( move T value )
    {
        if( count == cap )
        {
            grow( cap > 0 ? cap * 2 : 1 );
        }
        
        unsafe
        {
            data[count] = move value;
        }
        count += 1;
    }

    public T pop()
    {
        assert( count > 0 );
        count -= 1;
        unsafe
        {
            return move data[count];
        }
    }

    public T* operator[]( u64 index ) const
    {
        assert( index < count );

        unsafe
        {
            return &data[index];
        }
    }

    public T remove( u64 index )
    {
        assert( index < count );

        unsafe
        {
            T result = move data[index];

            for( u64 i = index; i < count - 1; i++ )
            {
                data[i] = move data[i + 1];
            }

            count -= 1;
            return result;
        }
    }

    public T swap_remove( u64 index )
    {
        assert( index < count );

        count -= 1;
        unsafe
        {
            T result = move data[index];

            if( index != count )
            {
                data[index] = move data[count];
            }

            return result;
        }
    }

    public T replace( u64 index, move T value )
    {
        assert( index < count );

        unsafe
        {
            T result = move data[index];
            data[index] = move value;
            return result;
        }
    }

    public void swap( u64 a, u64 b )
    {
        assert( a < count );
        assert( b < count );

        if( a == b )
        {
            return;
        }

        unsafe
        {
            T temp = move data[a];
            data[a] = move data[b];
            data[b] = move temp;
        }
    }

    public u64 size() const
    {
        return count;
    }

    public u64 capacity() const
    {
        return cap;
    }

    public bool is_empty() const
    {
        return count == 0;
    }

    public void reserve( u64 n )
    {
        if( n > cap )
        {
            grow( n );
        }
    }

    public void clear()
    {
        unsafe
        {
            destroy( data, count );
        }
        count = 0;
    }

    private void grow( u64 n )
    {
        T[*] new_data;
        unsafe
        {
            new_data = alloc<T>( n );
        }

        if( data != nullptr )
        {
            for( u64 i = 0; i < count; i++ )
            {
                unsafe
                {
                    new_data[i] = move data[i];
                }
            }
            
            // Slots are raw after the above move, so we don't need to destroy them.
            unsafe
            {
                free( data );
            }
        }

        data = new_data;
        cap = n;
    }

    private T[*] data;
    private u64 count;
    private u64 cap;
};