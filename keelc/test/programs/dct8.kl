// A real DCT-II 8, solved at -O3, gives what the same loop unmarked gives.

import kl::math;

@real_arithmetic
void solved( const ref f64[8] x, ref f64[8] y )
{
    for( u64 k = 0; k < 8; k += 1 )
    {
        f64 s = 0.0;
        for( u64 n = 0; n < 8; n += 1 )
        {
            s += x[n] * kl::cos( kl::pi / 8.0 * ( cast<f64>( n ) + 0.5 ) * cast<f64>( k ) );
        }
        y[k] = s;
    }
}

void naive( const ref f64[8] x, ref f64[8] y )
{
    for( u64 k = 0; k < 8; k += 1 )
    {
        f64 s = 0.0;
        for( u64 n = 0; n < 8; n += 1 )
        {
            s += x[n] * kl::cos( kl::pi / 8.0 * ( cast<f64>( n ) + 0.5 ) * cast<f64>( k ) );
        }
        y[k] = s;
    }
}

f64 gap( f64 a, f64 b )
{
    return a > b ? a - b : b - a;
}

i32 main()
{
    const f64[8] x = [ 0.5, -1.25, 3.0, 2.0, -0.75, 4.5, 1.0, -2.0 ];
    f64[8]       a = [ 0.0, .. ];
    f64[8]       b = [ 0.0, .. ];
    solved( x, ref a );
    naive( x, ref b );
    for( u64 k = 0; k < 8; k += 1 )
    {
        if( gap( a[k], b[k] ) > 1e-12 )
        {
            return 1;
        }
    }
    return 0;
}
