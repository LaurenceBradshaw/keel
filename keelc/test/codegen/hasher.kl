// The prelude's `hasher` is SipHash-1-3 over 64-bit words, keyed by two `u64`s. Words fed with
// `write` hash as their little-endian bytes would under the reference algorithm, and `write_bytes`
// feeds the bytes zero-padded to a word and then their count, so text of any length is
// prefix-free. The expected values are the reference SipHash-1-3 of those bytes under the key
// 00..0f. Exits with the failing check.
u64 key_low()
{
    return 0x0706_0504_0302_0100;
}

u64 key_high()
{
    return 0x0f0e_0d0c_0b0a_0908;
}

u64 text( str a, str b )
{
    hasher h = hasher( key_low(), key_high() );

    h.write_bytes( a.as_text() );
    h.write_bytes( b.as_text() );

    return h.finish();
}

i32 main()
{
    hasher empty = hasher( key_low(), key_high() );

    if( empty.finish() != 12370263754033579228 )
    {
        return 1;
    }

    hasher word = hasher( key_low(), key_high() );

    word.write( 0x0706_0504_0302_0100 );

    if( word.finish() != 3931806377309739662 || word.finish() != word.finish() )
    {
        return 2;
    }

    hasher two = hasher( key_low(), key_high() );

    two.write( 1 );
    two.write( 2 );

    if( two.finish() != 7810086282998830284 )
    {
        return 3;
    }

    hasher letters = hasher( key_low(), key_high() );
    str    abc     = "abcdefghij";

    letters.write_bytes( abc.as_text() );

    if( letters.finish() != 11389776620634058455 )
    {
        return 4;
    }

    hasher nothing = hasher( key_low(), key_high() );
    str    blank   = "";

    nothing.write_bytes( blank.as_text() );

    if( nothing.finish() != 6681494030261746940 )
    {
        return 5;
    }

    if( text( "ab", "c" ) == text( "a", "bc" ) )
    {
        return 6;
    }

    hasher other = hasher( 1, 2 );

    other.write( 1 );
    other.write( 2 );

    if( other.finish() == 7810086282998830284 )
    {
        return 7;
    }

    return 0;
}
