// Fixed-shape vectors and matrices, over kl::_core's kernels. One module, as each type's `matmul`
// takes the other.

import kl::_core::compare as kernel;
import kl::_core::elementwise as kernel;
import kl::_core::linear as kernel;
import kl::_core::reduce as kernel;
import iterable;
import math;

/// `N` numbers held inline: a vector of rank 1, neither a row nor a column.
///
/// The operators work element by element, with a scalar on either side. `v.dot( w )` is the inner
/// product, and `v.matmul( m )` reads `v` as a row.
class vec<T, u64 N> implements iterable<T> where T : numeric
{
    T[N] e_;

    /// The elements in order: `vec<f64, 3>( [1.0, 2.0, 3.0] )`.
    public vec( T[N] elements )
    {
        e_ = elements;
    }

    /// Every element 0.
    public static vec<T, N> zeros()
    {
        return vec<T, N>( [0, ..] );
    }

    /// Every element `x`.
    public static vec<T, N> filled( T x )
    {
        return vec<T, N>( [x, ..] );
    }

    /// Every element 1.
    public static vec<T, N> ones()
    {
        return vec<T, N>( [1, ..] );
    }

    /// --- Shape and elements ---

    /// The number of elements, `N`.
    public u64 size() const
    {
        return N;
    }

    /// The element at `i`, which panics outside `size()`.
    public ref T operator[]( u64 i ) const
    {
        return e_[i];
    }

    /// The elements as a run, writable where the vector is.
    public ref T[] as_run() const
    {
        return e_;
    }

    /// Each element in order.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..N )
        {
            yield( e_[i] );
        }
    }

    /// Each element in order, writable in place.
    public void operator:( ref T item )
    {
        for( u64 i : 0..N )
        {
            yield( ref e_[i] );
        }
    }

    /// This vector's elements, then `b`'s.
    public vec<T, (N + M)> concatenated<u64 M>( const ref vec<T, M> b ) const
    {
        vec<T, (N + M)> r = vec<T, (N + M)>::zeros();
        for( u64 i : 0..N )
        {
            r.e_[i] = e_[i];
        }
        for( u64 i : 0..M )
        {
            r.e_[N + i] = b.e_[i];
        }
        return r;
    }

    /// --- Arithmetic ---

    /// The element-wise sum with `o`.
    public vec<T, N> operator+( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x + y; } );
        return r;
    }

    /// Each element + `s`.
    public vec<T, N> operator+( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x + s; } );
        return r;
    }

    /// `s` + each element.
    public static vec<T, N> operator+( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s + x; } );
        return r;
    }

    /// The element-wise difference with `o`.
    public vec<T, N> operator-( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x - y; } );
        return r;
    }

    /// Each element - `s`.
    public vec<T, N> operator-( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x - s; } );
        return r;
    }

    /// `s` - each element.
    public static vec<T, N> operator-( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s - x; } );
        return r;
    }

    /// The element-wise product with `o`.
    public vec<T, N> operator*( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x * y; } );
        return r;
    }

    /// Each element * `s`.
    public vec<T, N> operator*( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x * s; } );
        return r;
    }

    /// `s` * each element.
    public static vec<T, N> operator*( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s * x; } );
        return r;
    }

    /// The element-wise quotient with `o`.
    public vec<T, N> operator/( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x / y; } );
        return r;
    }

    /// Each element / `s`.
    public vec<T, N> operator/( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x / s; } );
        return r;
    }

    /// `s` / each element.
    public static vec<T, N> operator/( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s / x; } );
        return r;
    }

    /// Each element += the matching one of `o`.
    public void operator+=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element += `s`.
    public void operator+=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x + s; } );
    }

    /// Each element -= the matching one of `o`.
    public void operator-=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element -= `s`.
    public void operator-=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x - s; } );
    }

    /// Each element *= the matching one of `o`.
    public void operator*=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element *= `s`.
    public void operator*=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x * s; } );
    }

    /// Each element /= the matching one of `o`.
    public void operator/=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element /= `s`.
    public void operator/=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x / s; } );
    }

    /// Each element negated.
    public vec<T, N> operator-() const where T : floating
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return -x; } );
        return r;
    }

    /// --- Integer operators ---

    /// The element-wise remainder after dividing by `o`.
    public vec<T, N> operator%( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x % y; } );
        return r;
    }

    /// Each element % `s`.
    public vec<T, N> operator%( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x % s; } );
        return r;
    }

    /// `s` % each element.
    public static vec<T, N> operator%( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s % x; } );
        return r;
    }

    /// The element-wise bitwise and with `o`.
    public vec<T, N> operator&( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x & y; } );
        return r;
    }

    /// Each element & `s`.
    public vec<T, N> operator&( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x & s; } );
        return r;
    }

    /// `s` & each element.
    public static vec<T, N> operator&( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s & x; } );
        return r;
    }

    /// The element-wise bitwise or with `o`.
    public vec<T, N> operator|( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x | y; } );
        return r;
    }

    /// Each element | `s`.
    public vec<T, N> operator|( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x | s; } );
        return r;
    }

    /// `s` | each element.
    public static vec<T, N> operator|( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s | x; } );
        return r;
    }

    /// The element-wise bitwise exclusive or with `o`.
    public vec<T, N> operator^( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
        return r;
    }

    /// Each element ^ `s`.
    public vec<T, N> operator^( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x ^ s; } );
        return r;
    }

    /// `s` ^ each element.
    public static vec<T, N> operator^( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s ^ x; } );
        return r;
    }

    /// Each element %= the matching one of `o`.
    public void operator%=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element %= `s`.
    public void operator%=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x % s; } );
    }

    /// Each element &= the matching one of `o`.
    public void operator&=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element &= `s`.
    public void operator&=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x & s; } );
    }

    /// Each element |= the matching one of `o`.
    public void operator|=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element |= `s`.
    public void operator|=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x | s; } );
    }

    /// Each element ^= the matching one of `o`.
    public void operator^=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^= `s`.
    public void operator^=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x ^ s; } );
    }

    /// Each element with its bits flipped.
    public vec<T, N> operator~() const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return ~x; } );
        return r;
    }

    /// --- Element-wise functions ---

    /// Each element without its sign, as `kl::abs`.
    public vec<T, N> abs() const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::abs( x ); } );
        return r;
    }

    /// Each element's sign, as `kl::sign`: -1, 0 or 1.
    public vec<T, N> sign() const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::sign( x ); } );
        return r;
    }

    /// Each element held between `lo` and `hi`; `hi` wins when they cross.
    public vec<T, N> clip( T lo, T hi ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ lo, hi ]( T x ) { return kl::min( kl::max( x, lo ), hi ); } );
        return r;
    }

    /// `f` of each element, in the same shape, `U` being what `f` returns:
    /// `a.map( fn[]( f64 x ) { return x * x; } )`.
    public vec<U, N> map<U, F>( F f ) const where F : fn( T ) -> U, where U : numeric
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, f );
        return r;
    }

    /// --- Products ---

    /// The inner product with `o`.
    public T dot( const ref vec<T, N> o ) const
    {
        return kernel::dot( e_, o.e_ );
    }

    /// This vector, as a row, times `m`.
    public vec<T, K> matmul<u64 K>( const ref mat<T, N, K> m ) const
    {
        vec<T, K> r = vec<T, K>::zeros();
        kernel::matmul( ref r.e_, e_, m.as_run(), 1, N, K );
        return r;
    }

    /// --- Comparing ---

    /// Whether every element equals the matching one of `o`.
    public bool operator==( const ref vec<T, N> o ) const
    {
        return kernel::equal( e_, o.e_ );
    }

    /// Whether every `|a - b| <= atol + rtol * |b|`, `b` being `o`'s element. A NaN is close to
    /// nothing, and an infinity only to itself.
    public bool approx_equal( const ref vec<T, N> o, T rtol = 1e-5, T atol = 1e-8 ) const where T : floating
    {
        return kernel::approx_equal( e_, o.e_, rtol, atol );
    }

    /// --- Reducing ---

    /// The total of every element, added in index order.
    public T sum() const
    {
        return kernel::sum( e_ );
    }

    /// --- Converting ---

    /// Each element converted by `cast`, which panics on a value `U` cannot hold. A float to an
    /// integer needs a rounding: `truncated`, `rounded`, `floored` or `ceiled`.
    public vec<U, N> to<U>() const where T : converts_to<U>, where U : numeric
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return cast<U>( x ); } );
        return r;
    }

    /// Each element toward zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> truncated<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::truncated<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element to the nearest, a half away from zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> rounded<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::rounded<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element down, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> floored<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::floored<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element up, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> ceiled<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::ceiled<U>( cast<f64>( x ) ); } );
        return r;
    }

};

/// `R` rows of `C` numbers held inline, row after row: a matrix of rank 2.
///
/// The operators work element by element, with a scalar on either side; `m.matmul( b )` is the
/// matrix product, and `m.matmul( v )` reads `v` as a column. `m[r, c]` is row `r`, column `c`, and
/// `for( T x : m )` walks the elements row after row.
class mat<T, u64 R, u64 C> implements iterable<T> where T : numeric
{
    T[R * C] e_;

    /// The elements row after row: `mat<f64, 2, 2>( [1.0, 2.0, 3.0, 4.0] )`.
    public mat( T[R * C] elements )
    {
        e_ = elements;
    }

    /// The rows: `mat<f64, 2, 2>( [[1.0, 2.0], [3.0, 4.0]] )`.
    public mat( T[C][R] rows )
    {
        e_ = [0, ..];
        for( u64 r : 0..R )
        {
            for( u64 c : 0..C )
            {
                e_[r * C + c] = rows[r][c];
            }
        }
    }

    /// Every element 0.
    public static mat<T, R, C> zeros()
    {
        return mat<T, R, C>( [0, ..] );
    }

    /// Every element `x`.
    public static mat<T, R, C> filled( T x )
    {
        return mat<T, R, C>( [x, ..] );
    }

    /// Every element 1.
    public static mat<T, R, C> ones()
    {
        return mat<T, R, C>( [1, ..] );
    }

    /// 1 on the diagonal and 0 elsewhere: the identity when square.
    public static mat<T, R, C> eye()
    {
        mat<T, R, C> r = mat<T, R, C>::zeros();
        kernel::eye( ref r.e_, R, C );
        return r;
    }

    /// --- Shape and elements ---

    /// The number of rows, `R`.
    public u64 rows() const
    {
        return R;
    }

    /// The number of columns, `C`.
    public u64 cols() const
    {
        return C;
    }

    /// The number of elements, `R * C`.
    public u64 size() const
    {
        return R * C;
    }

    /// The element in row `r`, column `c`, which panics outside the shape.
    public ref T operator[]( u64 r, u64 c ) const
    {
        if( r >= R || c >= C )
        {
            panic( "index out of range" );
        }

        return e_[r * C + c];
    }

    /// The elements row after row, as a run writable where the matrix is.
    public ref T[] as_run() const
    {
        return e_;
    }

    /// Each element, row after row.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..R * C )
        {
            yield( e_[i] );
        }
    }

    /// Each element, row after row, writable in place.
    public void operator:( ref T item )
    {
        for( u64 i : 0..R * C )
        {
            yield( ref e_[i] );
        }
    }

    /// The elements row after row, as a vector.
    public vec<T, (R * C)> flattened() const
    {
        return vec<T, (R * C)>( e_ );
    }

    /// --- Arithmetic ---

    /// The element-wise sum with `o`.
    public mat<T, R, C> operator+( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x + y; } );
        return r;
    }

    /// Each element + `s`.
    public mat<T, R, C> operator+( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x + s; } );
        return r;
    }

    /// `s` + each element.
    public static mat<T, R, C> operator+( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s + x; } );
        return r;
    }

    /// The element-wise difference with `o`.
    public mat<T, R, C> operator-( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x - y; } );
        return r;
    }

    /// Each element - `s`.
    public mat<T, R, C> operator-( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x - s; } );
        return r;
    }

    /// `s` - each element.
    public static mat<T, R, C> operator-( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s - x; } );
        return r;
    }

    /// The element-wise product with `o`.
    public mat<T, R, C> operator*( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x * y; } );
        return r;
    }

    /// Each element * `s`.
    public mat<T, R, C> operator*( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x * s; } );
        return r;
    }

    /// `s` * each element.
    public static mat<T, R, C> operator*( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s * x; } );
        return r;
    }

    /// The element-wise quotient with `o`.
    public mat<T, R, C> operator/( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x / y; } );
        return r;
    }

    /// Each element / `s`.
    public mat<T, R, C> operator/( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x / s; } );
        return r;
    }

    /// `s` / each element.
    public static mat<T, R, C> operator/( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s / x; } );
        return r;
    }

    /// Each element += the matching one of `o`.
    public void operator+=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element += `s`.
    public void operator+=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x + s; } );
    }

    /// Each element -= the matching one of `o`.
    public void operator-=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element -= `s`.
    public void operator-=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x - s; } );
    }

    /// Each element *= the matching one of `o`.
    public void operator*=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element *= `s`.
    public void operator*=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x * s; } );
    }

    /// Each element /= the matching one of `o`.
    public void operator/=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element /= `s`.
    public void operator/=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x / s; } );
    }

    /// Each element negated.
    public mat<T, R, C> operator-() const where T : floating
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return -x; } );
        return r;
    }

    /// --- Integer operators ---

    /// The element-wise remainder after dividing by `o`.
    public mat<T, R, C> operator%( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x % y; } );
        return r;
    }

    /// Each element % `s`.
    public mat<T, R, C> operator%( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x % s; } );
        return r;
    }

    /// `s` % each element.
    public static mat<T, R, C> operator%( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s % x; } );
        return r;
    }

    /// The element-wise bitwise and with `o`.
    public mat<T, R, C> operator&( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x & y; } );
        return r;
    }

    /// Each element & `s`.
    public mat<T, R, C> operator&( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x & s; } );
        return r;
    }

    /// `s` & each element.
    public static mat<T, R, C> operator&( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s & x; } );
        return r;
    }

    /// The element-wise bitwise or with `o`.
    public mat<T, R, C> operator|( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x | y; } );
        return r;
    }

    /// Each element | `s`.
    public mat<T, R, C> operator|( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x | s; } );
        return r;
    }

    /// `s` | each element.
    public static mat<T, R, C> operator|( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s | x; } );
        return r;
    }

    /// The element-wise bitwise exclusive or with `o`.
    public mat<T, R, C> operator^( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
        return r;
    }

    /// Each element ^ `s`.
    public mat<T, R, C> operator^( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x ^ s; } );
        return r;
    }

    /// `s` ^ each element.
    public static mat<T, R, C> operator^( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s ^ x; } );
        return r;
    }

    /// Each element %= the matching one of `o`.
    public void operator%=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element %= `s`.
    public void operator%=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x % s; } );
    }

    /// Each element &= the matching one of `o`.
    public void operator&=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element &= `s`.
    public void operator&=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x & s; } );
    }

    /// Each element |= the matching one of `o`.
    public void operator|=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element |= `s`.
    public void operator|=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x | s; } );
    }

    /// Each element ^= the matching one of `o`.
    public void operator^=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^= `s`.
    public void operator^=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x ^ s; } );
    }

    /// Each element with its bits flipped.
    public mat<T, R, C> operator~() const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return ~x; } );
        return r;
    }

    /// --- Element-wise functions ---

    /// Each element without its sign, as `kl::abs`.
    public mat<T, R, C> abs() const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::abs( x ); } );
        return r;
    }

    /// Each element's sign, as `kl::sign`: -1, 0 or 1.
    public mat<T, R, C> sign() const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::sign( x ); } );
        return r;
    }

    /// Each element held between `lo` and `hi`; `hi` wins when they cross.
    public mat<T, R, C> clip( T lo, T hi ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ lo, hi ]( T x ) { return kl::min( kl::max( x, lo ), hi ); } );
        return r;
    }

    /// `f` of each element, in the same shape, `U` being what `f` returns:
    /// `a.map( fn[]( f64 x ) { return x * x; } )`.
    public mat<U, R, C> map<U, F>( F f ) const where F : fn( T ) -> U, where U : numeric
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, f );
        return r;
    }

    /// --- Products ---

    /// This matrix times `b`.
    public mat<T, R, K> matmul<u64 K>( const ref mat<T, C, K> b ) const
    {
        mat<T, R, K> r = mat<T, R, K>::zeros();
        kernel::matmul( ref r.e_, e_, b.e_, R, C, K );
        return r;
    }

    /// This matrix times `v`, read as a column.
    public vec<T, R> matmul( const ref vec<T, C> v ) const
    {
        vec<T, R> r = vec<T, R>::zeros();
        kernel::matmul( ref r.as_run(), e_, v.as_run(), R, C, 1 );
        return r;
    }

    /// The rows as columns.
    public mat<T, C, R> transposed() const
    {
        mat<T, C, R> r = mat<T, C, R>::zeros();
        kernel::transpose( ref r.e_, e_, R, C );
        return r;
    }

    /// --- Comparing ---

    /// Whether every element equals the matching one of `o`.
    public bool operator==( const ref mat<T, R, C> o ) const
    {
        return kernel::equal( e_, o.e_ );
    }

    /// Whether every `|a - b| <= atol + rtol * |b|`, `b` being `o`'s element. A NaN is close to
    /// nothing, and an infinity only to itself.
    public bool approx_equal( const ref mat<T, R, C> o, T rtol = 1e-5, T atol = 1e-8 ) const where T : floating
    {
        return kernel::approx_equal( e_, o.e_, rtol, atol );
    }

    /// --- Reducing ---

    /// The total of every element, added in index order.
    public T sum() const
    {
        return kernel::sum( e_ );
    }

    /// --- Converting ---

    /// Each element converted by `cast`, which panics on a value `U` cannot hold. A float to an
    /// integer needs a rounding: `truncated`, `rounded`, `floored` or `ceiled`.
    public mat<U, R, C> to<U>() const where T : converts_to<U>, where U : numeric
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return cast<U>( x ); } );
        return r;
    }

    /// Each element toward zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> truncated<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::truncated<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element to the nearest, a half away from zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> rounded<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::rounded<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element down, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> floored<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::floored<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element up, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> ceiled<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::ceiled<U>( cast<f64>( x ) ); } );
        return r;
    }

};

/// The `N` by `N` identity: `mat<f64, 3, 3> i = kl::identity();`.
mat<T, N, N> identity<T, u64 N>() where T : numeric
{
    mat<T, N, N> r = mat<T, N, N>::zeros();
    kernel::identity( ref r.as_run(), N );
    return r;
}

/// The square matrix with `v` on its diagonal: `kl::diag( v )`.
mat<T, N, N> diag<T, u64 N>( const ref vec<T, N> v ) where T : numeric
{
    mat<T, N, N> r = mat<T, N, N>::zeros();
    for( u64 i : 0..N )
    {
        r[i, i] = v[i];
    }
    return r;
}

/// The smallest of each set of matching elements, as `kl::min`: `kl::minimum( a, b, c )`.
vec<T, N> minimum<T, u64 N>( const ref vec<T, N> first, vec<T, N>... rest ) where T : numeric
{
    vec<T, N> r = first;
    for( const ref vec<T, N> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::min( x, y ); } );
    }
    return r;
}

/// The largest of each set of matching elements, as `kl::max`: `kl::maximum( a, b, c )`.
vec<T, N> maximum<T, u64 N>( const ref vec<T, N> first, vec<T, N>... rest ) where T : numeric
{
    vec<T, N> r = first;
    for( const ref vec<T, N> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::max( x, y ); } );
    }
    return r;
}

/// The smallest of each set of matching elements, as `kl::min`: `kl::minimum( a, b, c )`.
mat<T, R, C> minimum<T, u64 R, u64 C>( const ref mat<T, R, C> first, mat<T, R, C>... rest ) where T : numeric
{
    mat<T, R, C> r = first;
    for( const ref mat<T, R, C> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::min( x, y ); } );
    }
    return r;
}

/// The largest of each set of matching elements, as `kl::max`: `kl::maximum( a, b, c )`.
mat<T, R, C> maximum<T, u64 R, u64 C>( const ref mat<T, R, C> first, mat<T, R, C>... rest ) where T : numeric
{
    mat<T, R, C> r = first;
    for( const ref mat<T, R, C> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::max( x, y ); } );
    }
    return r;
}
