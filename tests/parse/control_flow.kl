i32 branches( i32 x )
{
    if( x < 0 )
    {
        return 0;
    }
    else if( x == 0 )
    {
        return 1;
    }
    else
    {
        return 2;
    }
}

i32 loops()
{
    i32 y = 0;

    while( y < 10 )
    {
        y++;
    }

    for( i32 i = 0; i < 3; i++ )
    {
        y = y + i;
    }

    for( ; ; )
    {
        y--;
    }

    return y;
}
