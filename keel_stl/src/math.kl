// Numbers beyond the operators.
import kl::_core::exponential as exponential;
import kl::_core::trig as trig;

/// --- Bits ---

/// The bits of `x`, sign first: `bits_of( 1.0 )` is `0x3FF0000000000000`.
u64 bits_of( f64 x )
{
    unsafe
    {
        return *cast<u64*>( &x );
    }
}

/// The `f64` whose bits are `x`.
f64 from_bits( u64 x )
{
    unsafe
    {
        return *cast<f64*>( &x );
    }
}

/// The bits of `x`, sign first: the `f32` 1.0 has `0x3F800000`.
u32 bits_of( f32 x )
{
    unsafe
    {
        return *cast<u32*>( &x );
    }
}

/// The `f32` whose bits are `x`.
f32 from_bits( u32 x )
{
    unsafe
    {
        return *cast<f32*>( &x );
    }
}

/// --- Roots ---

/// The square root of `x`, correctly rounded: NaN below zero, and `-0.0` for `-0.0`.
f64 sqrt( f64 x )
{
    return sqrt_f64( x );
}

/// The square root of `x`, correctly rounded: NaN below zero, and `-0.0` for `-0.0`.
f32 sqrt( f32 x )
{
    return sqrt_f32( x );
}

/// --- Classes ---

/// Whether `x` is a NaN, the one value not equal to itself.
bool is_nan( f64 x )
{
    return x != x;
}

/// Whether `x` is a NaN, the one value not equal to itself.
bool is_nan( f32 x )
{
    return x != x;
}

/// Whether `x` is positive or negative infinity.
bool is_inf( f64 x )
{
    return ( bits_of( x ) & 0x7fff_ffff_ffff_ffff ) == 0x7ff0_0000_0000_0000;
}

/// Whether `x` is positive or negative infinity.
bool is_inf( f32 x )
{
    return ( bits_of( x ) & 0x7fff_ffff ) == 0x7f80_0000;
}

/// --- Sign and order ---

/// `x` without its sign: `-0.0` gives `0.0`, and a NaN stays one. The most negative integer
/// overflows, as `0 - x` does.
T abs<T>( T x ) where T : numeric
{
    if( x <= 0 )
    {
        return 0 - x;
    }
    return x;
}

/// -1, 0 or 1 as `x` is below, at or above zero. A NaN stays one, and `-0.0` stays `-0.0`.
T sign<T>( T x ) where T : numeric
{
    if( x > 0 )
    {
        return 1;
    }
    if( x < 0 )
    {
        return 0 - 1;
    }
    return x;
}

/// The smallest of `first` and `rest`, or a NaN when any is one: `kl::min( a, b, c )`.
T min<T>( T first, T... rest ) where T : numeric
{
    T m = first;
    for( T x : rest )
    {
        if( m == m && ( x < m || x != x ) )
        {
            m = x;
        }
    }
    return m;
}

/// The largest of `first` and `rest`, or a NaN when any is one: `kl::max( a, b, c )`.
T max<T>( T first, T... rest ) where T : numeric
{
    T m = first;
    for( T x : rest )
    {
        if( m == m && ( x > m || x != x ) )
        {
            m = x;
        }
    }
    return m;
}

/// --- Rounding ---

/// `x` toward zero, as a `U`: `truncated<i32>( -2.7 )` is `-2`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U truncated<U>( f64 x ) where U : integral
{
    return integer_of<U>( chopped( x ) );
}

/// `x` toward zero, as a `U`: `truncated<i32>( -2.7 )` is `-2`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U truncated<U>( f32 x ) where U : integral
{
    return integer_of<U>( chopped( cast<f64>( x ) ) );
}

/// `x` to the nearest whole value, a half away from zero, as a `U`: `rounded<i32>( -2.5 )` is `-3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U rounded<U>( f64 x ) where U : integral
{
    return integer_of<U>( nearest( x ) );
}

/// `x` to the nearest whole value, a half away from zero, as a `U`: `rounded<i32>( -2.5 )` is `-3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U rounded<U>( f32 x ) where U : integral
{
    return integer_of<U>( nearest( cast<f64>( x ) ) );
}

/// `x` down to a whole value, as a `U`: `floored<i32>( -2.5 )` is `-3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U floored<U>( f64 x ) where U : integral
{
    return integer_of<U>( below( x ) );
}

/// `x` down to a whole value, as a `U`: `floored<i32>( -2.5 )` is `-3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U floored<U>( f32 x ) where U : integral
{
    return integer_of<U>( below( cast<f64>( x ) ) );
}

/// `x` up to a whole value, as a `U`: `ceiled<i32>( 2.1 )` is `3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U ceiled<U>( f64 x ) where U : integral
{
    return integer_of<U>( -below( -x ) );
}

/// `x` up to a whole value, as a `U`: `ceiled<i32>( 2.1 )` is `3`.
///
/// Panics on an infinity, a NaN, or a whole value `U` does not hold.
U ceiled<U>( f32 x ) where U : integral
{
    return integer_of<U>( -below( -cast<f64>( x ) ) );
}

/// `x` down to a whole value: `floor( -2.5 )` is `-3.0`. An infinity or a NaN stays one.
f64 floor( f64 x )
{
    return below( x );
}

/// `x` down to a whole value: `floor( -2.5 )` is `-3.0`. An infinity or a NaN stays one.
f32 floor( f32 x )
{
    return cast<f32>( below( cast<f64>( x ) ) );
}

/// `x` up to a whole value: `ceil( -0.5 )` is `-0.0`. An infinity or a NaN stays one.
f64 ceil( f64 x )
{
    return -below( -x );
}

/// `x` up to a whole value: `ceil( -0.5 )` is `-0.0`. An infinity or a NaN stays one.
f32 ceil( f32 x )
{
    return cast<f32>( -below( -cast<f64>( x ) ) );
}

/// `x` toward zero, to a whole value: `trunc( -2.7 )` is `-2.0`. An infinity or a NaN stays one.
f64 trunc( f64 x )
{
    return chopped( x );
}

/// `x` toward zero, to a whole value: `trunc( -2.7 )` is `-2.0`. An infinity or a NaN stays one.
f32 trunc( f32 x )
{
    return cast<f32>( chopped( cast<f64>( x ) ) );
}

/// `x` to the nearest whole value, a half away from zero: `round( 2.5 )` is `3.0`. An infinity or a NaN stays one.
f64 round( f64 x )
{
    return nearest( x );
}

/// `x` to the nearest whole value, a half away from zero: `round( 2.5 )` is `3.0`. An infinity or a NaN stays one.
f32 round( f32 x )
{
    return cast<f32>( nearest( cast<f64>( x ) ) );
}

/// --- Constants ---

/// The `f64` nearest to the ratio of a circle's circumference to its diameter.
const f64 pi = 3.14159265358979311600e+00;

/// --- Exponentials and logarithms ---

/// e to the power `x`: an infinity above 709.78, and 0 below -745.13. Within an ulp.
f64 exp( f64 x )
{
    return exponential::exp( x );
}

/// e to the power `x`: an infinity above 709.78, and 0 below -745.13. Within an ulp.
f32 exp( f32 x )
{
    return exponential::narrowed<f32>( exponential::exp( cast<f64>( x ) ) );
}

/// e^x - 1, exact near 0 where `exp( x ) - 1.0` loses digits: -1 below -38. Within an ulp.
f64 expm1( f64 x )
{
    return exponential::expm1( x );
}

/// e^x - 1, exact near 0 where `exp( x ) - 1.0` loses digits: -1 below -38. Within an ulp.
f32 expm1( f32 x )
{
    return exponential::narrowed<f32>( exponential::expm1( cast<f64>( x ) ) );
}

/// The natural logarithm: `-inf` at 0, and a NaN below. Within an ulp.
f64 log( f64 x )
{
    return exponential::log( x );
}

/// The natural logarithm: `-inf` at 0, and a NaN below. Within an ulp.
f32 log( f32 x )
{
    return exponential::narrowed<f32>( exponential::log( cast<f64>( x ) ) );
}

/// log(1 + x), exact near 0 where `log( 1.0 + x )` loses digits: `-inf` at -1, and a NaN below. Within an ulp.
f64 log1p( f64 x )
{
    return exponential::log1p( x );
}

/// log(1 + x), exact near 0 where `log( 1.0 + x )` loses digits: `-inf` at -1, and a NaN below. Within an ulp.
f32 log1p( f32 x )
{
    return exponential::narrowed<f32>( exponential::log1p( cast<f64>( x ) ) );
}

/// The base 2 logarithm, exact at powers of 2: `-inf` at 0, and a NaN below. Within an ulp.
f64 log2( f64 x )
{
    return exponential::log2( x );
}

/// The base 2 logarithm, exact at powers of 2: `-inf` at 0, and a NaN below. Within an ulp.
f32 log2( f32 x )
{
    return exponential::narrowed<f32>( exponential::log2( cast<f64>( x ) ) );
}

/// The base 10 logarithm: `-inf` at 0, and a NaN below. Within an ulp.
f64 log10( f64 x )
{
    return exponential::log10( x );
}

/// The base 10 logarithm: `-inf` at 0, and a NaN below. Within an ulp.
f32 log10( f32 x )
{
    return exponential::narrowed<f32>( exponential::log10( cast<f64>( x ) ) );
}

/// `x` to the power `y`. As C's `pow`: 1 when `y` is 0 or `x` is 1, even beside a NaN; a NaN for a
/// negative `x` and a `y` that is not whole; and an odd whole `y` keeps `x`'s sign. Within an ulp.
f64 pow( f64 x, f64 y )
{
    return exponential::pow( x, y );
}

/// `x` to the power `y`, as the `f64` form, rounded.
f32 pow( f32 x, f32 y )
{
    return exponential::narrowed<f32>( exponential::pow( cast<f64>( x ), cast<f64>( y ) ) );
}

/// --- Hyperbolic functions ---

/// The hyperbolic sine. Within 2 ulps.
f64 sinh( f64 x )
{
    return exponential::sinh( x );
}

/// The hyperbolic sine. Within 2 ulps.
f32 sinh( f32 x )
{
    return exponential::narrowed<f32>( exponential::sinh( cast<f64>( x ) ) );
}

/// The hyperbolic cosine. Within 2 ulps.
f64 cosh( f64 x )
{
    return exponential::cosh( x );
}

/// The hyperbolic cosine. Within 2 ulps.
f32 cosh( f32 x )
{
    return exponential::narrowed<f32>( exponential::cosh( cast<f64>( x ) ) );
}

/// The hyperbolic tangent, -1 to 1. Within 2 ulps.
f64 tanh( f64 x )
{
    return exponential::tanh( x );
}

/// The hyperbolic tangent, -1 to 1. Within 2 ulps.
f32 tanh( f32 x )
{
    return exponential::narrowed<f32>( exponential::tanh( cast<f64>( x ) ) );
}

/// --- Trigonometry ---

/// The sine of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN, and `-0.0` stays `-0.0`.
@trig_sin
f64 sin( f64 x )
{
    u32 ix = trig::high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e500000 )
        {
            return x;
        }
        return trig::sine_kernel( x, 0.0, false );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    trig::reduction r = trig::reduced( x );
    i32 quadrant = r.n & 3;
    if( quadrant == 0 )
    {
        return trig::sine_kernel( r.hi, r.lo, true );
    }
    if( quadrant == 1 )
    {
        return trig::cosine_kernel( r.hi, r.lo );
    }
    if( quadrant == 2 )
    {
        return -trig::sine_kernel( r.hi, r.lo, true );
    }
    return -trig::cosine_kernel( r.hi, r.lo );
}

/// The cosine of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN.
@trig_cos
f64 cos( f64 x )
{
    u32 ix = trig::high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e46a09e )
        {
            return 1.0;
        }
        return trig::cosine_kernel( x, 0.0 );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    trig::reduction r = trig::reduced( x );
    i32 quadrant = r.n & 3;
    if( quadrant == 0 )
    {
        return trig::cosine_kernel( r.hi, r.lo );
    }
    if( quadrant == 1 )
    {
        return -trig::sine_kernel( r.hi, r.lo, true );
    }
    if( quadrant == 2 )
    {
        return -trig::cosine_kernel( r.hi, r.lo );
    }
    return trig::sine_kernel( r.hi, r.lo, true );
}

/// The tangent of an angle in radians.
///
/// Within an ulp of the true value. An infinity or a NaN gives NaN, and `-0.0` stays `-0.0`.
@trig_tan
f64 tan( f64 x )
{
    u32 ix = trig::high_word( x ) & 0x7fffffff;
    if( ix <= 0x3fe921fb )
    {
        if( ix < 0x3e400000 )
        {
            return x;
        }
        return trig::tangent_kernel( x, 0.0, 1 );
    }
    if( ix >= 0x7ff00000 )
    {
        return x - x;
    }
    trig::reduction r = trig::reduced( x );
    return trig::tangent_kernel( r.hi, r.lo, 1 - ( ( r.n & 1 ) << 1 ) );
}

/// The angle in [-pi/2, pi/2] whose sine is given.
///
/// Within an ulp of the true value. Outside [-1, 1], or at NaN, it is NaN.
f64 asin( f64 x )
{
    u32 hx = trig::high_word( x );
    u32 ix = hx & 0x7fffffff;
    if( ix >= 0x3ff00000 )
    {
        if( ( ( ix - 0x3ff00000 ) | trig::low_word( x ) ) == 0 )
        {
            return x * PIO2_HI + x * PIO2_LO;
        }
        return ( x - x ) / ( x - x );
    }
    if( ix < 0x3fe00000 )
    {
        if( ix < 0x3e500000 )
        {
            return x;
        }
        return x + x * trig::arcsine_ratio( x * x );
    }
    f64 t = ( 1.0 - trig::magnitude( x ) ) * 0.5;
    f64 s = sqrt( t );
    f64 angle = 0.0;
    if( ix >= 0x3fef3333 )
    {
        angle = PIO2_HI - ( 2.0 * ( s + s * trig::arcsine_ratio( t ) ) - PIO2_LO );
    }
    else
    {
        f64 w = trig::low_word_cleared( s );
        f64 c = ( t - w * w ) / ( s + w );
        f64 p = 2.0 * s * trig::arcsine_ratio( t ) - ( PIO2_LO - 2.0 * c );
        f64 q = PIO4_HI - 2.0 * w;
        angle = PIO4_HI - ( p - q );
    }
    return ( hx >> 31 ) == 0 ? angle : -angle;
}

/// The angle in [0, pi] whose cosine is given.
///
/// Within an ulp of the true value. Outside [-1, 1], or at NaN, it is NaN.
f64 acos( f64 x )
{
    u32 hx = trig::high_word( x );
    u32 ix = hx & 0x7fffffff;
    if( ix >= 0x3ff00000 )
    {
        if( ( ( ix - 0x3ff00000 ) | trig::low_word( x ) ) == 0 )
        {
            return ( hx >> 31 ) == 0 ? 0.0 : pi + 2.0 * PIO2_LO;
        }
        return ( x - x ) / ( x - x );
    }
    if( ix < 0x3fe00000 )
    {
        if( ix <= 0x3c600000 )
        {
            return PIO2_HI + PIO2_LO;
        }
        return PIO2_HI - ( x - ( PIO2_LO - x * trig::arcsine_ratio( x * x ) ) );
    }
    if( ( hx >> 31 ) != 0 )
    {
        f64 z = ( 1.0 + x ) * 0.5;
        f64 s = sqrt( z );
        f64 w = trig::arcsine_ratio( z ) * s - PIO2_LO;
        return pi - 2.0 * ( s + w );
    }
    f64 z = ( 1.0 - x ) * 0.5;
    f64 s = sqrt( z );
    f64 df = trig::low_word_cleared( s );
    f64 c = ( z - df * df ) / ( s + df );
    f64 w = trig::arcsine_ratio( z ) * s + c;
    return 2.0 * ( df + w );
}

/// The angle in [-pi/2, pi/2] whose tangent is given.
///
/// Within an ulp of the true value. NaN gives NaN, and `-0.0` stays `-0.0`.
f64 atan( f64 x )
{
    u32 hx = trig::high_word( x );
    u32 ix = hx & 0x7fffffff;
    bool negative = ( hx >> 31 ) != 0;
    if( ix >= 0x44100000 )
    {
        if( ix > 0x7ff00000 || ( ix == 0x7ff00000 && trig::low_word( x ) != 0 ) )
        {
            return x + x;
        }
        return negative ? -ATANHI[3] - ATANLO[3] : ATANHI[3] + ATANLO[3];
    }
    i32 id = -1;
    if( ix < 0x3fdc0000 )
    {
        if( ix < 0x3e400000 )
        {
            return x;
        }
    }
    else
    {
        x = trig::magnitude( x );
        if( ix < 0x3ff30000 )
        {
            if( ix < 0x3fe60000 )
            {
                id = 0;
                x = ( 2.0 * x - 1.0 ) / ( 2.0 + x );
            }
            else
            {
                id = 1;
                x = ( x - 1.0 ) / ( x + 1.0 );
            }
        }
        else if( ix < 0x40038000 )
        {
            id = 2;
            x = ( x - 1.5 ) / ( 1.0 + 1.5 * x );
        }
        else
        {
            id = 3;
            x = -1.0 / x;
        }
    }
    f64 z = x * x;
    f64 w = z * z;
    f64 s1 = z * ( AT[0] + w * ( AT[2] + w * ( AT[4] + w * ( AT[6] + w * ( AT[8] + w * AT[10] ) ) ) ) );
    f64 s2 = w * ( AT[1] + w * ( AT[3] + w * ( AT[5] + w * ( AT[7] + w * AT[9] ) ) ) );
    if( id < 0 )
    {
        return x - x * ( s1 + s2 );
    }
    f64 angle = ATANHI[trig::at( id, 4 )] - ( ( x * ( s1 + s2 ) - ATANLO[trig::at( id, 4 )] ) - x );
    return negative ? -angle : angle;
}

/// The angle in [-pi, pi] of the point (`x`, `y`) from the positive x axis: `atan2( 1.0, -1.0 )` is
/// 3 pi / 4. Each zero's sign picks the side, as C's `atan2`. Within an ulp.
f64 atan2( f64 y, f64 x )
{
    u32 hx = trig::high_word( x );
    u32 lx = trig::low_word( x );
    u32 hy = trig::high_word( y );
    u32 ly = trig::low_word( y );
    u32 ix = hx & 0x7fffffff;
    u32 iy = hy & 0x7fffffff;
    if( ix > 0x7ff00000 || ( ix == 0x7ff00000 && lx != 0 ) || iy > 0x7ff00000 || ( iy == 0x7ff00000 && ly != 0 ) )
    {
        return x + y;
    }
    if( hx == 0x3ff00000 && lx == 0 )
    {
        return atan( y );
    }

    // 2 * sign(x) + sign(y).
    u32 m = ( hy >> 31 ) | ( ( hx >> 30 ) & 2 );
    if( ( iy | ly ) == 0 )
    {
        return m < 2 ? y : m == 2 ? PI : -PI;
    }
    if( ( ix | lx ) == 0 )
    {
        return ( hy >> 31 ) != 0 ? -PIO2_HI : PIO2_HI;
    }
    if( ix == 0x7ff00000 )
    {
        if( iy == 0x7ff00000 )
        {
            return m == 0 ? PIO4_HI : m == 1 ? -PIO4_HI : m == 2 ? 3.0 * PIO4_HI : -3.0 * PIO4_HI;
        }
        return m == 0 ? 0.0 : m == 1 ? -0.0 : m == 2 ? PI : -PI;
    }
    if( iy == 0x7ff00000 )
    {
        return ( hy >> 31 ) != 0 ? -PIO2_HI : PIO2_HI;
    }

    // The exponents' difference, to tell when y/x is beyond 2^60 either way.
    i32 d = wrap<i32>( iy ) - wrap<i32>( ix );
    f64 z = 0.0;
    if( d >= 61 * 0x100000 )
    {
        z = PIO2_HI + 0.5 * PI_LO;
        m &= 1;
    }
    else if( ( hx >> 31 ) == 0 || d >= -60 * 0x100000 )
    {
        z = atan( trig::magnitude( y / x ) );
    }
    if( m == 0 )
    {
        return z;
    }
    if( m == 1 )
    {
        return -z;
    }
    if( m == 2 )
    {
        return PI - ( z - PI_LO );
    }
    return ( z - PI_LO ) - PI;
}

/// The angle of (`x`, `y`), as the `f64` form, rounded.
f32 atan2( f32 y, f32 x )
{
    return cast<f32>( atan2( cast<f64>( y ), cast<f64>( x ) ) );
}

private i32 exponent_of( f64 x )
{
    return wrap<i32>( ( bits_of( x ) >> 52 ) & 0x7ff );
}

// `x` with its fraction cleared, toward zero; an infinity or a NaN unchanged.
private f64 chopped( f64 x )
{
    const i32 e = exponent_of( x ) - 1023;
    if( e >= 52 )
    {
        return x;
    }
    if( e < 0 )
    {
        return from_bits( bits_of( x ) & 0x8000_0000_0000_0000 );
    }
    return from_bits( bits_of( x ) & ~( 0x000f_ffff_ffff_ffff >> e ) );
}

private f64 below( f64 x )
{
    const f64 t = chopped( x );
    return x < t ? t - 1.0 : t;
}

private f64 nearest( f64 x )
{
    const f64 t = chopped( x );
    const f64 fraction = x - t; // exact: `t` keeps `x`'s leading bits
    if( fraction >= 0.5 )
    {
        return t + 1.0;
    }
    if( fraction <= -0.5 )
    {
        return t - 1.0;
    }
    return t;
}

// A whole `w` as a `U`, built from its bits, since `cast` takes no float to an integer.
private U integer_of<U>( f64 w ) where U : integral
{
    if( w == 0.0 )
    {
        return cast<U>( 0 );
    }

    const u64 bits = bits_of( w );
    const i32 e = exponent_of( w ) - 1075; // w = m * 2^e
    if( e > 11 )
    {
        panic( "the value is infinite, a NaN, or too large for any integer" );
    }

    const u64 m = ( bits & 0x000f_ffff_ffff_ffff ) | 0x0010_0000_0000_0000;
    const u64 magnitude = e >= 0 ? m << wrap<u64>( e ) : m >> wrap<u64>( -e );

    if( w > 0.0 )
    {
        return cast<U>( magnitude );
    }
    if( magnitude > 0x8000_0000_0000_0000 )
    {
        panic( "the value is too large for any integer" );
    }
    return cast<U>( wrap<i64>( 0 - magnitude ) );
}

private const f64 PIO2_HI = 1.57079632679489655800e+00;
private const f64 PIO2_LO = 6.12323399573676603587e-17;
private const f64 PIO4_HI = 7.85398163397448278999e-01;
private const f64 PI = 3.1415926535897931160e+00;
private const f64 PI_LO = 1.2246467991473531772e-16;

// atan at 0.5, 1, 1.5 and infinity, each as hi + lo.
private const f64[4] ATANHI = [
    4.63647609000806093515e-01,
    7.85398163397448278999e-01,
    9.82793723247329054082e-01,
    1.57079632679489655800e+00
];
