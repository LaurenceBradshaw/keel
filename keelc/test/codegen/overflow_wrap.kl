// Arithmetic inside `wrap<T>( … )` wraps on purpose and is never checked, under --debug too: each
// operation the overflow fixtures abort on gives its wrapped value here.
import t::console;

i32 id( i32 x )
{
    return x;
}

i64 wide( i64 x )
{
    return x;
}

i32 main()
{
    const i32 max = id( 2147483647 );
    const i32 min = id( -2147483647 - 1 );

    t::println( wrap<i32>( max + 1 ) );
    t::println( wrap<u32>( cast<u32>( id( 0 ) ) - 1 ) );
    t::println( wrap<i32>( -min ) );
    t::println( wrap<i32>( id( 65536 ) * 65536 ) );
    t::println( wrap<i64>( wide( -9223372036854775807 - 1 ) / wide( -1 ) ) );

    // Through every operator, however deep: `( max + 1 ) * 2` wraps at both steps.
    t::println( wrap<i32>( ( max + 1 ) * 2 - 1 ) );
    return 0;
}
