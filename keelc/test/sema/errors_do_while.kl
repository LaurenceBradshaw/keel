// A `do` condition is a `bool`, as a `while`'s is, and it cannot see what the body declared: the
// body is a block of its own, closed before the test.
i32 main()
{
    i32 n = 0;
    do
    {
        n++;
    } while( n ); // error

    do
    {
        i32 inner = 1;
        n += inner;
    } while( inner < 3 ); // error

    return 0;
}
