import optional;

// Sinks `root` until it is no less than its children, within the first `end` elements.
private void sift_down<C, T, F>( ref C items, u64 root, u64 end, F less ) where C : fixed_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    while( true )
    {
        u64 child = root * 2 + 1;
        
        if( child >= end )
        {
            return;
        }
        
        if( child + 1 < end && less( items[child], items[child + 1] ) )
        {
            child += 1;
        }
        
        if( !less( items[root], items[child] ) )
        {
            return;
        }

        items.swap( root, child );
        root = child;
    }
}

/// Orders `items` so no element is `less` than the one before it.
///
/// A heap sort: O(n log n) and in place, but equal elements may change order.
void sort<C, T, F>( ref C items, F less ) where C : fixed_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    u64 n = items.size();

    for( u64 i = n / 2; i > 0; i-- )
    {
        sift_down( ref items, i - 1, n, less );
    }

    for( u64 end = n; end > 1; end-- )
    {
        items.swap( 0, end - 1 );
        sift_down( ref items, 0, end - 1, less );
    }
}

/// Orders `items` from least to greatest, as `sort( ref items, less )` with `<`.
void sort<C, T>( ref C items ) where C : fixed_memory<T>, where T : comparable
{
    sort( ref items, fn[]( a, b ) { return a < b; } );
}

/// Orders `items` so no element is `less` than the one before it, keeping equal elements in order.
///
/// In place, with O(n log n) comparisons and O(n log^2 n) swaps: insertion sorts blocks of 20,
/// then merges them by Kim and Kutzner's symmetric merge.
void stable_sort<C, T, F>( ref C items, F less ) where C : fixed_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    u64 n = items.size();
    u64 block = 20;

    for( u64 a = 0; a < n; a += block )
    {
        insertion_sort( ref items, a, a + block < n ? a + block : n, less );
    }

    while( block < n )
    {
        for( u64 a = 0; a + block < n; a += block * 2 )
        {
            merge( ref items, a, a + block, a + block * 2 < n ? a + block * 2 : n, less );
        }
        block *= 2;
    }
}

/// Orders `items` from least to greatest, keeping equal elements in order, as `stable_sort( ref
/// items, less )` with `<`.
void stable_sort<C, T>( ref C items ) where C : fixed_memory<T>, where T : comparable
{
    stable_sort( ref items, fn[]( a, b ) { return a < b; } );
}

// Orders `[a, b)` by insertion.
private void insertion_sort<C, T, F>( ref C items, u64 a, u64 b, F less ) where C : fixed_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    for( u64 i = a + 1; i < b; i++ )
    {
        for( u64 j = i; j > a && less( items[j], items[j - 1] ); j-- )
        {
            items.swap( j, j - 1 );
        }
    }
}

// Merges the ordered `[a, m)` and `[m, b)` in place, the left first among equals.
private void merge<C, T, F>( ref C items, u64 a, u64 m, u64 b, F less ) where C : fixed_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    if( a == m || m == b || !less( items[m], items[m - 1] ) )
    {
        return;
    }

    // Split both sides where the halves of `[a, b)` meet, swap the middle pieces, merge each half.
    u64 mid = a + ( b - a ) / 2;
    u64 n = mid + m;
    u64 start = a;
    u64 end = m;
    if( m > mid )
    {
        start = n - b;
        end = mid;
    }
    while( start < end )
    {
        u64 c = start + ( end - start ) / 2;
        if( !less( items[n - 1 - c], items[c] ) )
        {
            start = c + 1;
        }
        else
        {
            end = c;
        }
    }
    end = n - start;

    rotate( ref items, start, m, end );
    merge( ref items, a, start, mid, less );
    merge( ref items, mid, end, b, less );
}

// Moves `[m, b)` before `[a, m)`.
private void rotate<C, T>( ref C items, u64 a, u64 m, u64 b ) where C : fixed_memory<T>
{
    reverse( ref items, a, m );
    reverse( ref items, m, b );
    reverse( ref items, a, b );
}

// Reverses `[a, b)`.
private void reverse<C, T>( ref C items, u64 a, u64 b ) where C : fixed_memory<T>
{
    while( a + 1 < b )
    {
        b -= 1;
        items.swap( a, b );
        a += 1;
    }
}

/// The index of the first element `matches` picks, or none.
optional<u64> index_if<C, T, F>( const ref C items, F matches ) where C : fixed_memory<T>, where F : fn( const ref T ) -> bool
{
    for( u64 i = 0; i < items.size(); i++ )
    {
        if( matches( items[i] ) )
        {
            return optional::some( i );
        }
    }

    return optional::none;
}

/// The index of the first element equal to `value`, or none.
optional<u64> index_of<C, T>( const ref C items, const ref T value ) where C : fixed_memory<T>, where T : equatable
{
    return index_if( items, fn[ value ]( x ) { return x == value; } );
}

/// Whether `matches` picks any element.
bool contains_if<C, T, F>( const ref C items, F matches ) where C : fixed_memory<T>, where F : fn( const ref T ) -> bool
{
    return is_some( index_if( items, matches ) );
}

/// Whether any element equals `value`.
bool contains<C, T>( const ref C items, const ref T value ) where C : fixed_memory<T>, where T : equatable
{
    return is_some( index_of( items, value ) );
}

/// The index of an element `compare` calls `equal`, or none.
///
/// `compare` says how each element orders against the one sought, and `items` must already be in
/// that order. Which of several equal elements it finds is unspecified.
optional<u64> binary_search_by<C, T, F>( const ref C items, F compare ) where C : fixed_memory<T>, where F : fn( const ref T ) -> ordering
{
    u64 low = 0;
    u64 high = items.size();

    while( low < high )
    {
        u64 mid = low + ( high - low ) / 2;
        ordering cmp = compare( items[mid] );

        if( cmp == ordering::equal )
        {
            return optional::some( mid );
        }
        else if( cmp == ordering::less )
        {
            low = mid + 1;
        }
        else
        {
            high = mid;
        }
    }

    return optional::none;
}

/// The index of an element equal to `value`, or none.
///
/// `items` must already be in order. Which of several equal elements it finds is unspecified.
optional<u64> binary_search<C, T>( const ref C items, const ref T value ) where C : fixed_memory<T>, where T : comparable
{
    return binary_search_by( items, fn[ value ]( x ) { return x <=> value; } );
}

/// Drops every element `drop` picks, keeping the rest in order.
void remove_if<C, T, F>( ref C items, F drop ) where C : dynamic_memory<T>, where F : fn( const ref T ) -> bool
{
    u64 kept = 0;
    
    for( u64 i : 0..items.size() )
    {
        if( !drop( items[i] ) )
        {
            items.swap( kept, i );
            kept += 1;
        }
    }

    items.truncate( kept );
}

/// Drops every element equal to `value`, keeping the rest in order.
void remove<C, T>( ref C items, const ref T value ) where C : dynamic_memory<T>, where T : equatable
{
    remove_if( ref items, fn[ value ]( x ) { return x == value; } );
}

/// Drops each element `same` calls equal to the one kept before it, so sorted `items` keep one
/// of each run.
void dedup<C, T, F>( ref C items, F same ) where C : dynamic_memory<T>, where F : fn( const ref T, const ref T ) -> bool
{
    if( items.size() < 2 )
    {
        return;
    }

    u64 kept = 1;

    for( u64 i : 1..items.size() )
    {
        if( !same( items[kept - 1], items[i] ) )
        {
            items.swap( kept, i );
            kept += 1;
        }
    }

    items.truncate( kept );
}

/// Drops each element equal to the one kept before it, so sorted `items` keep one of each value.
void dedup<C, T>( ref C items ) where C : dynamic_memory<T>, where T : equatable
{
    dedup( ref items, fn[]( a, b ) { return a == b; } );
}

// `next`, then counts it on.
private u64 advance( ref u64 next )
{
    u64 at = next;
    next += 1;
    return at;
}

/// An array whose element at each index is `make( index )`, made in index order.
///
/// `T` and `N` come from the type the result is given to: `buf[4] bufs = kl::array( fn[]( i ) { return buf( i ); } );`.
T[N] array<T, u64 N, F>( F make ) where F : fn( u64 ) -> T
{
    u64 next = 0;
    T[N] made = [ make( advance( ref next ) ), .. ];
    return made;
}