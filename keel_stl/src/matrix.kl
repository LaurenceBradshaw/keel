}

/// `kl::asin` of each element.
mat<T, R, C> asin<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::asin( cast<f64>( x ) ) ); } );
}

/// `kl::acos` of each element.
mat<T, R, C> acos<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::acos( cast<f64>( x ) ) ); } );
}

/// `kl::atan` of each element.
mat<T, R, C> atan<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::atan( cast<f64>( x ) ) ); } );
}

/// `kl::sinh` of each element.
mat<T, R, C> sinh<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::sinh( cast<f64>( x ) ) ); } );
}

/// `kl::cosh` of each element.
mat<T, R, C> cosh<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::cosh( cast<f64>( x ) ) ); } );
}

/// `kl::tanh` of each element.
mat<T, R, C> tanh<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::tanh( cast<f64>( x ) ) ); } );
}

/// `kl::floor` of each element.
mat<T, R, C> floor<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::floor( cast<f64>( x ) ) ); } );
}

/// `kl::ceil` of each element.
mat<T, R, C> ceil<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::ceil( cast<f64>( x ) ) ); } );
}

/// `kl::trunc` of each element.
mat<T, R, C> trunc<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::trunc( cast<f64>( x ) ) ); } );
}

/// `kl::round` of each element.
mat<T, R, C> round<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::round( cast<f64>( x ) ) ); } );
}

/// `kl::pow` of each element of `a` and the matching one of `b`.
mat<T, R, C> pow<T, u64 R, u64 C>( const ref mat<T, R, C> a, const ref mat<T, R, C> b ) where T : floating
{
    mat<T, R, C> r = a;
    kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( y ) ) ); } );
    return r;
}

/// `kl::pow` of each element and `s`: `kl::pow( a, 2.0 )`.
mat<T, R, C> pow<T, u64 R, u64 C>( const ref mat<T, R, C> a, T s ) where T : floating
{
    return a.map( fn[ s ]( T x ) { return kernel::narrowed<T>( kl::pow( cast<f64>( x ), cast<f64>( s ) ) ); } );
}

/// `kl::atan2` of each element of `y` and the matching one of `x`.
mat<T, R, C> atan2<T, u64 R, u64 C>( const ref mat<T, R, C> y, const ref mat<T, R, C> x ) where T : floating
{
    mat<T, R, C> r = y;
    kernel::zip_into( ref r.as_run(), x.as_run(), fn[]( T b, T a ) { return kernel::narrowed<T>( kl::atan2( cast<f64>( b ), cast<f64>( a ) ) ); } );
    return r;
}
