// An extern is a Function_decl whose body child is absent - the dump shows `<none>` where a Block
// would be, which is the only place the declaration differs from an ordinary function.
extern i32 abs( i32 v );

extern u8* reserve( u64 n );

extern i32 rand();

i32 magnitude( i32 v )
{
    i32 n = 0;

    unsafe
    {
        n = abs( v );
    }

    return n;
}
