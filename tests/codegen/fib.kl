// M1's acceptance program. Recursion works because every prototype precedes every body, which is
// how D18's "no forward declarations" survives translation into a language that requires them.
i32 fib( i32 n )
{
    if( n < 2 )
    {
        return n;
    }

    return fib( n - 1 ) + fib( n - 2 );
}

i32 main()
{
    return fib( 20 ) % 256; // 6765 % 256 == 109
}
