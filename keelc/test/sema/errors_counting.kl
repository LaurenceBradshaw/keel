// D59: a counter is read-only, counts in an integer type, holds its own value, and its bounds
// check against its type as an initialiser does.
void take( ref u64 x )
{
    x += 1;
}

i32 main()
{
    u64 n = 3;
    for( u64 i : 0..n )
    {
        i += 1;
        i++;
        i = 0;
        ref u64 r = i;
        const ref u64 c = i; // reading is fine
        take( ref i );
    }

    for( i32 i : 0..n )
    {
    }

    for( f64 x : 0.0..1.0 )
    {
    }

    for( u64 i : 5..2 )
    {
    }

    for( u64 i : 3..3 ) // empty, not an error
    {
    }

    for( ref u64 i : 0..n )
    {
    }

    return 0;
}
