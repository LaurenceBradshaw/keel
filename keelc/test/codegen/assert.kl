// `assert` that holds: in a function with an owning local, which is still dropped on the way out,
// around a call, inside a loop, and written across two lines.
class Owner
{
    public Owner()
    {
        unsafe
        {
            p = alloc<i32>();
        }
    }

    ~Owner()
    {
        unsafe
        {
            free( p );
        }
    }

    i32* p;
};

i32 positive( i32 x )
{
    Owner o = Owner();
    assert( x > 0 );
    return x;
}

i32 main()
{
    assert( positive( 3 ) == 3 );

    for( i32 i = 0; i < 4; i++ )
    {
        assert( i < 4 );
    }

    i32 n = 7;
    assert( n % 2 == 1
            && n > 5 );

    return 0;
}
