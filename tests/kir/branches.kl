// The first real control flow. Three blocks for an if, allocated before any is filled - which is
// why add_block() does not switch to what it makes: a branch needs the ids of blocks that do not
// exist yet.
i32 both_arms( bool c )
{
    i32 x = 0;

    if ( c )
    {
        x = 1;
    }
    else
    {
        x = 2;
    }

    return x;
}

// An absent else is still a block: it is where the branch's false edge goes, and being empty is
// what forces the join to exist.
i32 no_else( bool c )
{
    i32 x = 0;

    if ( c )
    {
        x = 1;
    }

    return x;
}

// Nothing falls out of this one, so there is no join. A block allocated anyway would be
// unreachable, which the verifier rejects - and blocks are indices, so one built by mistake cannot
// be taken back.
i32 both_return( bool c )
{
    if ( c )
    {
        return 1;
    }
    else
    {
        return 2;
    }
}

// Only the else arm falls out. Terminating the other one a second time would trip the builder's
// assert, which is what the guard on each arm prevents.
i32 one_returns( bool c )
{
    i32 x = 0;

    if ( c )
    {
        return 1;
    }
    else
    {
        x = 2;
    }

    return x;
}

// `else if` is another If_stmt in the else arm, so it nests rather than needing a rule of its own.
i32 chained( i32 n )
{
    if ( n == 0 )
    {
        return 1;
    }
    else if ( n == 1 )
    {
        return 2;
    }
    else
    {
        return 3;
    }
}

i32 main()
{
    return 0;
}
