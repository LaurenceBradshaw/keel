#!/usr/bin/env bash
#
# Pre-commit checks. Install once with:
#
#     git config core.hooksPath .githooks
#
# Runs standalone too: ./.githooks/pre-commit
# Bypass a single commit with: git commit --no-verify
#
# NOTE: this checks the working tree, not the staged snapshot. With unstaged changes present it
# tests those as well. That is the safe trade for a solo repo - stashing mid-commit is a good way
# to lose work when something goes wrong.

set -uo pipefail

cd "$( dirname "$0" )/.." || exit 1

if [ -t 1 ]; then
    red=$'\033[31m'; green=$'\033[32m'; dim=$'\033[2m'; reset=$'\033[0m'
else
    red=''; green=''; dim=''; reset=''
fi

log="$( mktemp )"
trap 'rm -f "$log"' EXIT

# $1 label, rest: command. Prints pass/fail, dumps output only on failure.
step()
{
    local label="$1"; shift
    local start; start=$SECONDS

    if "$@" > "$log" 2>&1; then
        printf '  %spass%s  %-28s %s(%ss)%s\n' "$green" "$reset" "$label" "$dim" "$(( SECONDS - start ))" "$reset"
        return 0
    fi

    printf '  %sFAIL%s  %s\n' "$red" "$reset" "$label"
    # Without the golden runner's pass lines, which would push its failures out of the tail.
    grep -v '^  pass     ' < "$log" | sed 's/^/        /' | tail -40
    return 1
}

# Configure any preset whose build directory is missing, so a fresh clone's first commit works.
for preset in debug release; do
    if [ ! -d "build/${preset}" ]; then
        printf '  %sconfiguring %s...%s\n' "$dim" "$preset" "$reset"
        cmake --preset "$preset" > /dev/null 2>&1 || {
            printf '  %sFAIL%s  cmake --preset %s\n' "$red" "$reset" "$preset"
            exit 1
        }
    fi
done

# Every project's sources, not one hard-coded directory. The previous version scanned `src/`, and
# when that moved under keelc/ the find matched nothing - so the check *passed in zero seconds*
# having read no files. A silent pass is worse than a loud failure, which is why the count below is
# checked rather than trusted.
#
# Spread across every core. Each diff is printed whole, so two failures cannot interleave.
check_format()
{
    local files
    mapfile -d '' -t files < <( find keelc keel_rt keel_stl keeldoc \( -name '*.cpp' -o -name '*.h' -o -name '*.c' \) -print0 2>/dev/null )

    if [ "${#files[@]}" -eq 0 ]; then
        echo "no sources found to format-check - has the layout moved?"
        return 1
    fi

    printf '%s\0' "${files[@]}" | xargs -0 -n 8 -P "$( nproc )" sh -c '
        bad=0
        for f; do
            d="$( clang-format-18 -style=file:.clang-format "$f" | diff -u "$f" - )" || { printf "%s\n" "$d"; bad=1; }
        done
        exit "$bad"
    ' sh
}

# Every source file opens with the copyright and licence lines. Test data, examples, CMake and shell
# scripts are exempt. A file changed since HEAD, or not yet tracked, must carry this year; one left
# alone keeps the year it was last touched. Same silent-pass guard as check_format.
check_headers()
{
    local year; year="$( date +%Y )"
    local spdx='// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception'
    local bad=0
    local seen=0
    local all_changed=0
    local -A changed=()

    if git rev-parse --verify -q HEAD > /dev/null; then
        while IFS= read -r f; do
            changed["$f"]=1
        done < <( git diff --name-only HEAD; git ls-files --others --exclude-standard )
    else
        all_changed=1 # no commit yet, so every file is new
    fi

    while IFS= read -r f; do
        seen=$(( seen + 1 ))

        local first='' second=''
        { IFS= read -r first; IFS= read -r second; } < "$f"

        if [[ ! "$first" =~ ^//\ Copyright\ ([0-9]{4})\ Laurence\ Bradshaw$ ]] || [ "$second" != "$spdx" ]; then
            echo "$f: missing the header - its first two lines must be"
            echo "    // Copyright $year Laurence Bradshaw"
            echo "    $spdx"
            bad=1
            continue
        fi

        if [ "${BASH_REMATCH[1]}" != "$year" ] && { [ "$all_changed" -eq 1 ] || [ -n "${changed[$f]:-}" ]; }; then
            echo "$f: changed this year, so its copyright year should be $year, not ${BASH_REMATCH[1]}"
            bad=1
        fi
    done < <( find keelc keel_rt keel_stl keeldoc -path '*/test/*' -prune -o -type f \
                  \( -name '*.cpp' -o -name '*.h' -o -name '*.c' -o -name '*.kl' \) -print 2>/dev/null )

    if [ "$seen" -eq 0 ]; then
        echo "no sources found to header-check - has the layout moved?"
        return 1
    fi

    return "$bad"
}

# Each Keel project's golden suite. keel_rt's tests are a C binary instead, run as its own step.
check_goldens()
{
    local any=0

    for runner in keelc/test/run_tests.sh keel_stl/test/run_tests.sh; do
        [ -x "$runner" ] || continue

        any=1
        "$runner" ./build/debug/bin/keelc || return 1
    done

    if [ "$any" -eq 0 ]; then
        echo "no golden runners found - has the layout moved?"
        return 1
    fi

    return 0
}

# keeldoc's own pages for its test package, then the stl's pages: regenerated into a scratch
# directory, so a doc comment changed without regenerating fails here rather than going stale.
check_docs()
{
    keeldoc/test/run_tests.sh ./build/debug/bin/keeldoc ./build/debug/bin/keelc || return 1

    local out; out="$( mktemp -d )"
    ./build/debug/bin/keeldoc --keelc ./build/debug/bin/keelc -o "$out" kl=keel_stl/src || { rm -rf "$out"; return 1; }

    if ! diff -ru keel_stl/docs "$out"; then
        echo "keel_stl/docs is stale - regenerate it with:"
        echo "    build/debug/bin/keeldoc -o keel_stl/docs kl=keel_stl/src"
        rm -rf "$out"
        return 1
    fi

    rm -rf "$out"
}

echo "pre-commit:"

# Cheapest first, and build before the things that need a binary.
step "copyright headers"   check_headers                             || exit 1
step "clang-format"        check_format                              || exit 1
step "build (debug)"       cmake --build --preset debug              || exit 1
step "unit tests"          ./build/debug/bin/keel_tests              || exit 1
step "keeldoc unit tests"  ./build/debug/bin/keeldoc_tests           || exit 1
step "runtime tests"       ./build/debug/bin/keel_rt_tests           || exit 1
step "golden tests"        check_goldens                             || exit 1
step "docs up to date"     check_docs                                || exit 1
step "build (release -Werror)" cmake --build --preset release        || exit 1

echo "  ${green}all checks passed${reset}"
