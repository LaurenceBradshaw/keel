// D40: `hashable` as a bound. A number, `bool`, an enum without payloads and a pointer feed the
// hasher their value, tag or address widened to `u64`, computed in the instance; a float feeds its
// bits, with `-0.0` taken as `0.0`. A type with a `hash` of its own has it called, and an enum whose
// own `equatable` replaces the compiler's writes its own `hash` too. `hashable` brings `==`. Exits
// with the failing check.
struct Point implements hashable, equatable
{
    i32 x;
    i32 y;

    bool operator==( const ref Point other ) const
    {
        return x == other.x && y == other.y;
    }

    void hash( ref hasher h ) const
    {
        h.write( wrap<u64>( x ) );
        h.write( wrap<u64>( y ) );
    }
};

enum Suit
{
    Hearts,
    Spades,
    Clubs,
};

// Red and Crimson are one colour.
enum Colour
{
    Red,
    Crimson,
    Blue,
};

implements equatable for Colour
{
    bool operator==( const ref Colour other ) const
    {
        return cast<u8>( this ) == cast<u8>( other ) || cast<u8>( this ) + cast<u8>( other ) == 1;
    }
};

implements hashable for Colour
{
    void hash( ref hasher h ) const
    {
        if( cast<u8>( this ) == 2 )
        {
            h.write( 7 );
            return;
        }

        h.write( 3 );
    }
};

u64 digest<T>( const ref T v ) where T : hashable
{
    hasher h = hasher( 1, 2 );

    v.hash( ref h );

    return h.finish();
}

// What a value that feeds one word hashes to, and one that feeds two.
u64 word( u64 value )
{
    hasher h = hasher( 1, 2 );

    h.write( value );

    return h.finish();
}

u64 words( u64 first, u64 second )
{
    hasher h = hasher( 1, 2 );

    h.write( first );
    h.write( second );

    return h.finish();
}

bool agree<T>( const ref T a, const ref T b ) where T : hashable
{
    return a == b && digest( a ) == digest( b );
}

i32 main()
{
    i32 minus = 0 - 1;
    u8  byte  = 200;

    if( digest( minus ) != word( 18446744073709551615 ) || digest( byte ) != word( 200 ) )
    {
        return 1;
    }

    bool yes  = true;
    Suit clubs = Suit::Clubs;

    if( digest( yes ) != word( 1 ) || digest( clubs ) != word( 2 ) )
    {
        return 2;
    }

    // Equal values at two addresses: the address is what hashes.
    i32  twin = 0 - 1;
    i32* p    = &minus;
    i32* q    = &minus;
    i32* o    = &twin;
    u8*  r    = &byte;

    if( digest( p ) != digest( q ) || digest( p ) == word( 0 ) || digest( p ) == digest( o ) || digest( p ) == digest( r ) )
    {
        return 3;
    }

    f64 one      = 1.0;
    f64 zero     = 0.0;
    f64 negative = zero * ( 0.0 - 1.0 );
    f32 single   = 1.0;

    if( digest( one ) != word( 4607182418800017408 ) || digest( single ) != word( 1065353216 ) )
    {
        return 4;
    }

    if( digest( zero ) != word( 0 ) || digest( negative ) != word( 0 ) || !agree( zero, negative ) )
    {
        return 5;
    }

    Point a = Point { 1, 2 };

    if( digest( a ) != words( 1, 2 ) || !agree( a, Point { 1, 2 } ) )
    {
        return 6;
    }

    Colour red     = Colour::Red;
    Colour crimson = Colour::Crimson;
    Colour blue    = Colour::Blue;

    if( digest( blue ) != word( 7 ) || digest( red ) != word( 3 ) || !agree( red, crimson ) || agree( red, blue ) )
    {
        return 7;
    }

    if( !agree( minus, minus ) || agree( byte, cast<u8>( 3 ) ) )
    {
        return 8;
    }

    return 0;
}
