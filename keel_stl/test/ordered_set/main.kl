// `kl::ordered_set` with owning keys: a duplicate is refused and dropped, `key_at` counts in order
// and `rank` places keys, and removal down to empty drops each key once, which valgrind checks.
import kl::ordered_set;
import kl::string;

class tag implements comparable, equatable
{
    public tag( u64 n )
    {
        n_ = n;
        text_ = kl::string::from( n );
    }

    public u64 n() const
    {
        return n_;
    }

    public bool operator==( const ref tag other ) const
    {
        return n_ == other.n_;
    }

    public ordering operator<=>( const ref tag other ) const
    {
        return n_ <=> other.n_;
    }

    private u64 n_;
    private kl::string text_;
};

i32 main()
{
    kl::ordered_set<tag> s = kl::ordered_set<tag>();

    for( u64 i : 0..200 )
    {
        if( !s.insert( tag( i * 37 % 200 ) ) )
        {
            return 1;
        }
    }

    if( s.insert( tag( 5 ) ) || s.size() != 200 || !s.contains( tag( 199 ) ) || s.contains( tag( 200 ) ) )
    {
        return 2;
    }

    for( u64 i : 0..200 )
    {
        if( s.key_at( i ).n() != i || s.rank( tag( i ) ) != i )
        {
            return 3;
        }
    }

    for( u64 i : 0..200 )
    {
        if( !s.remove( tag( i * 37 % 200 ) ) )
        {
            return 4;
        }
    }

    return s.is_empty() && !s.remove( tag( 1 ) ) ? 0 : 5;
}
