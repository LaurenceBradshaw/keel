// A complex-input sum whose output is only its real part is read from its loops as a real map of a
// complex x and solved at -O3, giving what the same loop unmarked gives, at 256 and at 97.

import kl::complex;
import kl::math;

kl::complex<f64> root( u64 e, u64 n )
{
    const f64 t = -2.0 * kl::pi * cast<f64>( e % n ) / cast<f64>( n );
    return kl::complex<f64> { kl::cos( t ), kl::sin( t ) };
}

@real_arithmetic
void solved<u64 N>( const ref kl::complex<f64>[N] y, ref f64[N] x )
{
    for( u64 n : 0..N )
    {
        kl::complex<f64> s = kl::complex<f64> {};
        for( u64 k : 0..N )
        {
            s = s + y[k] * root( k * n, N );
        }
        x[n] = s.re;
    }
}

void naive<u64 N>( const ref kl::complex<f64>[N] y, ref f64[N] x )
{
    for( u64 n : 0..N )
    {
        kl::complex<f64> s = kl::complex<f64> {};
        for( u64 k : 0..N )
        {
            s = s + y[k] * root( k * n, N );
        }
        x[n] = s.re;
    }
}

bool agrees<u64 N>()
{
    kl::complex<f64>[N] y = [ kl::complex<f64> {}, .. ];
    for( u64 i : 0..N )
    {
        y[i] = kl::complex<f64> { cast<f64>( i % 7 ) - 2.0, cast<f64>( i % 3 ) * 0.5 };
    }
    f64[N] a = [ 0.0, .. ];
    f64[N] b = [ 0.0, .. ];
    solved<N>( y, ref a );
    naive<N>( y, ref b );
    for( u64 i : 0..N )
    {
        if( kl::abs( a[i] - b[i] ) > 1e-9 )
        {
            return false;
        }
    }
    return true;
}

i32 main()
{
    return agrees<256>() && agrees<97>() ? 0 : 1;
}
