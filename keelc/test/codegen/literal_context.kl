// A literal has a value, not a type. Every line here depends on something supplying one: the
// operand beside it, the declared type, a parameter, or - where both operands are literals - the
// context alone. Four of these were compile errors until a program was written that used them.
i32 takes_u8( u8 v ) { return 0; }

i32 main()
{
    f32 a = -1.5;
    f64 b = -1.5;
    f64 c = 1;
    f32 d = 2;

    f32 e = 1.0;
    f32 f = e + 1.5;
    f32 g = e * 2;

    u8  h = 'a';
    u8  i = 'a' + 1;

    u64 j = 1;
    u64 k = j << 40;

    bool l = !true;
    i32  m = -( -5 );

    u8  n = 200;
    u8  o = n - 1;

    i32 p = takes_u8( 3 );
    u16 q = 1;
    q += 1;

    if( q != 2 ) { return 90; }
    if( -1 >= 0 ) { return 91; }

    // Checked rather than merely emitted. Three of the values above were *wrong* in this file's
    // golden for as long as it existed - `f64 c = 1;` emitted 1.5 - because an integer literal in
    // float context kept its value in the integer pool and the emitter read the float pool at that
    // index. Comparing the emitted text could never see it; the golden had recorded the bug as
    // correct. An exit code can, which is why this fixture now has one.
    if( c != 1.0 ) { return 10; }
    if( d != 2.0 ) { return 11; }
    if( g != 2.0 ) { return 12; }
    if( f != 2.5 ) { return 13; }
    if( a != -1.5 ) { return 14; }

    return wrap<i32>( h ) + wrap<i32>( i ) + wrap<i32>( o ) + m;
}
