// A DFT8 written out with its size, solved at -O3, gives what the same loop unmarked gives.

import kl::math;

@real_arithmetic
void solved( const ref f64[8] re, const ref f64[8] im, ref f64[8] yr, ref f64[8] yi )
{
    for( u64 k = 0; k < 8; k += 1 )
    {
        f64 sr = 0.0;
        f64 si = 0.0;
        for( u64 j = 0; j < 8; j += 1 )
        {
            const f64 t = -2.0 * kl::pi * cast<f64>( j * k ) / 8.0;
            sr += re[j] * kl::cos( t ) - im[j] * kl::sin( t );
            si += re[j] * kl::sin( t ) + im[j] * kl::cos( t );
        }
        yr[k] = sr;
        yi[k] = si;
    }
}

void naive( const ref f64[8] re, const ref f64[8] im, ref f64[8] yr, ref f64[8] yi )
{
    for( u64 k = 0; k < 8; k += 1 )
    {
        f64 sr = 0.0;
        f64 si = 0.0;
        for( u64 j = 0; j < 8; j += 1 )
        {
            const f64 t = -2.0 * kl::pi * cast<f64>( j * k ) / 8.0;
            sr += re[j] * kl::cos( t ) - im[j] * kl::sin( t );
            si += re[j] * kl::sin( t ) + im[j] * kl::cos( t );
        }
        yr[k] = sr;
        yi[k] = si;
    }
}

f64 gap( f64 a, f64 b )
{
    return a > b ? a - b : b - a;
}

i32 main()
{
    const f64[8] re = [ 1.0, -2.5, 3.25, 0.0, 7.0, -1.0, 0.5, 2.0 ];
    const f64[8] im = [ 0.0, 1.5, -4.0, 2.0, 0.25, 3.0, -6.0, 1.0 ];
    f64[8]       ar = [ 0.0, .. ];
    f64[8]       ai = [ 0.0, .. ];
    f64[8]       br = [ 0.0, .. ];
    f64[8]       bi = [ 0.0, .. ];
    solved( re, im, ref ar, ref ai );
    naive( re, im, ref br, ref bi );
    for( u64 k = 0; k < 8; k += 1 )
    {
        if( gap( ar[k], br[k] ) > 1e-12 || gap( ai[k], bi[k] ) > 1e-12 )
        {
            return 1;
        }
    }
    return 0;
}
