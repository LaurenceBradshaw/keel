// `kl::array`: building at constant and `dyn` sizes, indexing, the operators and broadcasting,
// products and linear algebra, comparing and masks, the three forms of each reduction, changing
// the shape, slices and windows, sorting, converting, the scalar maths, walking, and mixing
// constant and `dyn` sizes.
import kl::array;
import kl::math;
import kl::optional;
import kl::pair;
import kl::test::context;

private void building( ref kl::test::context c )
{
    kl::array<i32, 2, 3> a = kl::zeros( 2, 3 );
    c.check_eq( a.size(), 6 );
    c.check_eq( a.rank(), 2 );
    c.check_eq( a.rows(), 2 );
    c.check_eq( a.cols(), 3 );
    c.check_eq( a.sum(), 0 );

    // A value the program reads is `dyn`; the rest stay constants.
    u64                    rows = 4;
    kl::array<f64, dyn, 3> d    = kl::filled( 0.5, rows, 3 );
    c.check_eq( d.size(), 12 );
    c.check_eq( d.extent( 0 ), 4 );
    c.check_eq( d.sum(), 6.0 );

    kl::array<i32, 2, 2> m = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    c.check( m == kl::array<i32, 2, 2>::of( [ 1, 2, 3, 4 ] ) );
    c.check( kl::of( [ 1, 2, 3 ] ) == kl::shaped( [ 1, 2, 3 ], 3 ) );
    c.check( kl::array<i32, 2>::ones() == kl::of( [ 1, 1 ] ) );

    kl::array<i32, 3, 3> eye = kl::eye( 3, 3 );
    c.check_eq( eye.trace(), 3 );
    c.check( kl::arange( 0, 5 ).as_shape<5>() == kl::of( [ 0, 1, 2, 3, 4 ] ) );
    kl::array<f64, 3> l = kl::linspace( 0.0, 1.0, 3 );
    c.check( l == kl::of( [ 0.0, 0.5, 1.0 ] ) );

    // Past the inline limit, or `dyn`, the elements are on the heap; nothing else changes.
    kl::array<f64, 600> big = kl::zeros( 600 );
    big[599]                = 2.0;
    kl::array<f64, 600> moved = move big;
    c.check_eq( moved.sum(), 2.0 );

    c.expect_panic( "the shape does not fit the elements", fn[]() { _ = kl::shaped( [ 1, 2, 3 ], 2, 2 ); } );
}

private void indexing( ref kl::test::context c )
{
    kl::array<i32, 2, 3> a = kl::zeros( 2, 3 );
    a[1, 2]               = 5;
    a[0, 1] += 2;
    a.as_run()[0] = 1;
    c.check( a == kl::of( [ [ 1, 2, 0 ], [ 0, 0, 5 ] ] ) );
    c.check_eq( a.block( 1 ).size, 3 );
    c.check_eq( a.block( 1 )[2], 5 );

    c.expect_panic(
        "index out of range",
        fn[]()
        {
            kl::array<i32, 2, 2> m = kl::zeros( 2, 2 );
            m[0, 2]                = 1;
        }
    );
    c.expect_panic(
        "the index count differs from the rank",
        fn[]()
        {
            kl::array<i32, 2, 2> m = kl::zeros( 2, 2 );
            m[0]                   = 1;
        }
    );
}

private void arithmetic( ref kl::test::context c )
{
    kl::array<i32, 3> a = kl::of( [ 1, 2, 3 ] );
    kl::array<i32, 3> b = kl::of( [ 10, 20, 30 ] );
    c.check( a + b == kl::of( [ 11, 22, 33 ] ) );
    c.check( b - a == kl::of( [ 9, 18, 27 ] ) );
    c.check( a * b == kl::of( [ 10, 40, 90 ] ) );
    c.check( b / a == kl::of( [ 10, 10, 10 ] ) );
    c.check( a * 2 == kl::of( [ 2, 4, 6 ] ) );
    c.check( 2 * a == a * 2 );
    c.check( 10 - a == kl::of( [ 9, 8, 7 ] ) );
    c.check( b % 7 == kl::of( [ 3, 6, 2 ] ) );
    c.check( ( a & 1 ) == kl::of( [ 1, 0, 1 ] ) );

    kl::array<i32, 3> s = a.copy();
    s += b;
    s -= a;
    s *= 2;
    s /= b;
    c.check( s == kl::of( [ 2, 2, 2 ] ) );

    kl::array<f64, 2, 2> m = kl::of( [ [ 1.0, -2.0 ], [ 3.0, -4.0 ] ] );
    c.check( -m == m * -1.0 );

    // A row broadcast down a matrix, and a column across one.
    kl::array<i32, 2, 3> g   = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::array<i32, 2, 3> row = g + a;
    c.check( row == kl::of( [ [ 2, 4, 6 ], [ 5, 7, 9 ] ] ) );
    kl::array<i32, 2, 1> col = kl::of( [ [ 10 ], [ 20 ] ] );
    c.check( g + col == kl::of( [ [ 11, 12, 13 ], [ 24, 25, 26 ] ] ) );
    g += a;
    c.check( g == row );

    // At run-time sizes the same rule is checked when it runs.
    u64                    n = 3;
    kl::array<i32, dyn>    v = kl::filled( 1, n );
    kl::array<i32, 2, dyn> w = kl::filled( 2, 2, n );
    kl::array<i32, 2, dyn> x = w + v;
    c.check_eq( x.sum(), 18 );
    c.expect_panic(
        "the shapes do not broadcast",
        fn[]()
        {
            u64                 k = 2;
            kl::array<i32, dyn> p = kl::zeros( k );
            kl::array<i32, 3>   q = kl::zeros( 3 );
            _                     = p + q;
        }
    );
}

private void products( ref kl::test::context c )
{
    kl::array<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::array<i32, 3, 2> b = kl::of( [ [ 7, 8 ], [ 9, 10 ], [ 11, 12 ] ] );
    c.check( kl::matmul( a, b ) == kl::of( [ [ 58, 64 ], [ 139, 154 ] ] ) );
    c.check( a.transposed() == kl::of( [ [ 1, 4 ], [ 2, 5 ], [ 3, 6 ] ] ) );

    kl::array<i32, 3> ones = kl::of( [ 1, 1, 1 ] );
    c.check( kl::matmul( a, ones ) == kl::of( [ 6, 15 ] ) );
    c.check( kl::matmul( ones, b ) == kl::of( [ 27, 30 ] ) );
    c.check_eq( ones.dot( ones ), 3 );
    c.check( kl::outer( ones, kl::of( [ 1, 2 ] ) ) == kl::of( [ [ 1, 2 ], [ 1, 2 ], [ 1, 2 ] ] ) );
    c.check( kl::cross( kl::of( [ 1, 0, 0 ] ), kl::of( [ 0, 1, 0 ] ) ) == kl::of( [ 0, 0, 1 ] ) );

    // A `dyn` number of rows meets fixed columns; the inner sizes are compared when it runs.
    u64                    rows = 2;
    kl::array<i32, dyn, 3> d    = kl::filled( 1, rows, 3 );
    kl::array<i32, dyn, 2> e    = kl::matmul( d, b );
    c.check_eq( e.extent( 0 ), 2 );
    c.check_eq( e[1, 1], 30 );

    // A rank 3 transpose reverses every axis.
    kl::array<i32, 2, 3, 4> t = kl::zeros( 2, 3, 4 );
    t[1, 2, 3]                = 7;
    kl::array<i32, 4, 3, 2> r = t.transposed();
    c.check_eq( r[3, 2, 1], 7 );
}

private void linear_algebra( ref kl::test::context c )
{
    kl::array<f64, 2, 2> m = kl::of( [ [ 4.0, 7.0 ], [ 2.0, 6.0 ] ] );
    c.check( kl::abs( kl::determinant( m ) - 10.0 ) < 1e-12 );

    kl::optional<kl::array<f64, 2, 2>> inv = kl::inverse( m );
    kl::array<f64, 2, 2>           eye = kl::eye( 2, 2 );
    c.check( kl::matmul( m, kl::unwrap( move inv ) ).approx_equal( eye ) );

    kl::array<f64, 2> b = kl::of( [ 1.0, 2.0 ] );
    kl::array<f64, 2> x = kl::unwrap( kl::solve( m, b ) );
    c.check( kl::matmul( m, x ).approx_equal( b ) );

    kl::array<f64, 3, 2> a = kl::of( [ [ 1.0, 1.0 ], [ 1.0, 2.0 ], [ 1.0, 3.0 ] ] );
    kl::array<f64, 3>    y = kl::of( [ 1.0, 2.0, 2.0 ] );
    kl::array<f64, 2>    f = kl::unwrap( kl::lstsq( a, y ) );
    c.check( f.approx_equal( kl::of( [ 2.0 / 3.0, 0.5 ] ) ) );

    kl::pair<kl::array<f64, 3, 2>, kl::array<f64, 2, 2>> qr = kl::qr( a );
    c.check( kl::matmul( qr.first, qr.second ).approx_equal( a ) );
    c.check( kl::abs( kl::hat_diagonal( a ).sum() - 2.0 ) < 1e-12 );

    kl::array<f64, 2, 2> singular = kl::of( [ [ 1.0, 2.0 ], [ 2.0, 4.0 ] ] );
    c.check( kl::is_none( kl::inverse( singular ) ) );
    c.check( kl::diagonal( kl::diag( b ) ) == b );
}

private void comparing( ref kl::test::context c )
{
    kl::array<f64, 2> x = kl::of( [ 1.0, 1000.0 ] );
    kl::array<f64, 2> y = kl::of( [ 1.0 + 1e-10, 1000.0 + 1e-6 ] );
    c.check( !( x == y ) );
    c.check( x.approx_equal( y ) );
    c.check( !x.approx_equal( y, 0.0, 1e-9 ) );

    kl::array<i32, 4>      a = kl::of( [ 1, 5, 3, 8 ] );
    kl::array_mask<4>      m = a.greater( 2 );
    c.check_eq( m.count(), 3 );
    c.check( m.any() && !m.all() );
    c.check( !m.test( 0 ) && m.at( 1 ) );
    c.check_eq( ( m & a.less( 6 ) ).count(), 2 );
    c.check_eq( ( ~m ).count(), 1 );
    c.check( a.selected( m ).as_shape<3>() == kl::of( [ 5, 3, 8 ] ) );
    c.check( kl::select( m, a, kl::array<i32, 4>::zeros() ) == kl::of( [ 0, 5, 3, 8 ] ) );
    c.check_eq( a.equal_each( a ).count(), 4 );
    c.check_eq( a.differs( 5 ).count(), 3 );

    kl::array<f64, 3> n = kl::of( [ 1.0, kl::nan(), kl::inf() ] );
    c.check_eq( kl::is_nan( n ).count(), 1 );
    c.check_eq( kl::is_inf( n ).count(), 1 );
}

private void reducing( ref kl::test::context c )
{
    kl::array<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    c.check_eq( a.sum(), 21 );
    c.check_eq( a.prod(), 720 );
    c.check_eq( a.min(), 1 );
    c.check_eq( a.max(), 6 );
    c.check_eq( a.argmax(), 5 );

    // A constant axis keeps the other size in the type; a run-time one makes it `dyn`.
    kl::array<i32, 3> columns = a.sum<0>();
    kl::array<i32, 2> rows    = a.sum<1>();
    c.check( columns == kl::of( [ 5, 7, 9 ] ) );
    c.check( rows == kl::of( [ 6, 15 ] ) );
    u64                 axis = 1;
    kl::array<i32, dyn> by   = a.sum( axis );
    c.check( by.as_shape<2>() == kl::of( [ 6, 15 ] ) );
    c.check( a.max<0>() == kl::of( [ 4, 5, 6 ] ) );
    c.check( a.argmin<1>() == kl::array<u64, 2>::of( [ 0, 0 ] ) );
    c.check( a.prod( 0 ).as_shape<3>() == kl::of( [ 4, 10, 18 ] ) );
    c.check( a.cumsum() == kl::of( [ 1, 3, 6, 10, 15, 21 ] ) );
    c.check( a.cumsum( 0 ) == kl::of( [ [ 1, 2, 3 ], [ 5, 7, 9 ] ] ) );

    kl::array<f64, 2, 2> f = kl::of( [ [ 1.0, 2.0 ], [ 3.0, 4.0 ] ] );
    c.check_eq( f.mean(), 2.5 );
    c.check_eq( f.var(), 1.25 );
    c.check( f.mean<0>() == kl::of( [ 2.0, 3.0 ] ) );
    c.check( f.std<1>() == kl::of( [ 0.5, 0.5 ] ) );

    // At a `dyn` row count, the constant axis keeps the fixed size.
    u64                    n = 3;
    kl::array<f64, dyn, 2> d = kl::filled( 1.0, n, 2 );
    kl::array<f64, 2>      s = d.sum<0>();
    c.check( s == kl::of( [ 3.0, 3.0 ] ) );
    kl::array<f64, dyn> t = d.sum<1>();
    c.check_eq( t.size(), 3 );

    c.expect_panic( "axis out of range", fn[]() { _ = kl::array<i32, 2>::zeros().sum( 1 ); } );
}

private void changing_the_shape( ref kl::test::context c )
{
    kl::array<i32, 2, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ] ] );
    kl::array<i32, 6>    f = a.flattened();
    c.check( f == kl::of( [ 1, 2, 3, 4, 5, 6 ] ) );
    kl::array<i32, 3, 2> r = a.reshaped( 3, 2 );
    c.check_eq( r[2, 1], 6 );
    kl::array<i32, 1, 2, 3> e = a.expanded<0>();
    c.check_eq( e[0, 1, 2], 6 );

    // To `dyn` and back, checked.
    kl::array<i32, dyn, dyn> d = a.as_dyn();
    c.check_eq( d.extent( 1 ), 3 );
    kl::array<i32, 2, 3> back = d.as_shape<2, 3>();
    c.check( back == a );
    c.expect_panic(
        "the shapes differ",
        fn[]()
        {
            u64                 k = 4;
            kl::array<i32, dyn> v = kl::zeros( k );
            _                     = v.as_shape<3>();
        }
    );

    kl::array<i32, 2, 2> s = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    c.check( kl::concatenated( s, s ).sum() == 20 );
    kl::array<i32, 2, 2, 2> st = kl::stacked( s, s );
    c.check_eq( st[1, 1, 0], 3 );
}

private void slices( ref kl::test::context c )
{
    kl::array<i32, 3, 3> a = kl::of( [ [ 1, 2, 3 ], [ 4, 5, 6 ], [ 7, 8, 9 ] ] );
    kl::array<i32, dyn, dyn> s = a.sliced( 1..3, 0..2 );
    c.check( s.as_shape<2, 2>() == kl::of( [ [ 4, 5 ], [ 7, 8 ] ] ) );

    kl::array<i32, 2, 2> w = a.window<2, 2>( 0, 1 );
    c.check( w == kl::of( [ [ 2, 3 ], [ 5, 6 ] ] ) );
    a.set_window( kl::array<i32, 2, 2>::zeros(), 1, 1 );
    c.check_eq( a.sum(), 1 + 2 + 3 + 4 + 7 );
    a.fill( 9, 0..1, 0..3 );
    c.check_eq( a[0, 2], 9 );
    a.assign( kl::of( [ [ 1 ], [ 1 ] ] ), 1..3, 0..1 );
    c.check_eq( a[2, 0], 1 );

    c.expect_panic( "the window passes the end", fn[]() { _ = kl::array<i32, 2, 2>::zeros().window<2, 2>( 1, 0 ); } );
    c.expect_panic( "the range is past its size", fn[]() { _ = kl::array<i32, 2>::zeros().sliced( 0..3 ); } );
}

private void sorting( ref kl::test::context c )
{
    kl::array<f64, 4> a = kl::of( [ 3.0, kl::nan(), 1.0, 3.0 ] );
    kl::array<f64, 4> s = a.sorted();
    c.check_eq( s[0], 1.0 );
    c.check( s[3] != s[3] );
    c.check( a.argsort() == kl::array<u64, 4>::of( [ 2, 0, 3, 1 ] ) );
    c.check_eq( a.unique().size(), 3 );
    c.check( kl::of( [ 0, 4, 0, 2 ] ).nonzero().as_shape<2>() == kl::array<u64, 2>::of( [ 1, 3 ] ) );
}

private void converting( ref kl::test::context c )
{
    kl::array<f64, 3> a = kl::of( [ -1.5, 0.5, 2.5 ] );
    c.check( a.rounded<i32>() == kl::of( [ -2, 1, 3 ] ) );
    c.check( a.truncated<i32>() == kl::of( [ -1, 0, 2 ] ) );
    c.check( a.floored<i64>() == kl::array<i64, 3>::of( [ -2, 0, 2 ] ) );
    c.check( kl::of( [ 1, 2 ] ).to<f64>() == kl::of( [ 1.0, 2.0 ] ) );
    c.check( a.abs() == kl::of( [ 1.5, 0.5, 2.5 ] ) );
    c.check( a.clip( 0.0, 1.0 ) == kl::of( [ 0.0, 0.5, 1.0 ] ) );
    c.check( a.sign() == kl::of( [ -1.0, 1.0, 1.0 ] ) );
    c.check( kl::of( [ 3.0, 4.0 ] ).norm() == 5.0 );
}

private void maths( ref kl::test::context c )
{
    kl::array<f64, 2> a = kl::of( [ 1.0, 4.0 ] );
    c.check( kl::sqrt( a ) == kl::of( [ 1.0, 2.0 ] ) );
    c.check( kl::pow( a, 2.0 ) == kl::of( [ 1.0, 16.0 ] ) );
    c.check( kl::pow( a, a ) == kl::of( [ 1.0, 256.0 ] ) );
    c.check( kl::exp( kl::log( a ) ).approx_equal( a ) );
    c.check( kl::minimum( a, kl::of( [ 2.0, 2.0 ] ) ) == kl::of( [ 1.0, 2.0 ] ) );
    c.check( kl::maximum( a, kl::of( [ 2.0, 2.0 ] ) ) == kl::of( [ 2.0, 4.0 ] ) );
}

private void walking( ref kl::test::context c )
{
    kl::array<i32, 2, 2> a     = kl::of( [ [ 1, 2 ], [ 3, 4 ] ] );
    i32                  total = 0;
    for( i32 x : a )
    {
        total = total * 10 + x;
    }
    c.check_eq( total, 1234 );
    for( ref i32 x : a )
    {
        x *= 2;
    }
    c.check_eq( a.sum(), 20 );
}

private void mixing( ref kl::test::context c )
{
    u64                    rows = 2;
    kl::array<f64, dyn, 2> d    = kl::filled( 1.0, rows, 2 );
    kl::array<f64, 2, 2>   k    = kl::filled( 2.0, 2, 2 );
    c.check_eq( d.dot( k ), 8.0 );
    c.check( d.less( k ).all() );
    c.check( kl::stacked( d, k ).sum() == 12.0 );
    c.check( kl::select( d.less( k ), k, d ).sum() == 8.0 );
    c.check( kl::maximum( d, kl::of( [ 3.0, 0.0 ] ) ).equal_each( kl::of( [ [ 3.0, 1.0 ], [ 3.0, 1.0 ] ] ) ).all() );
    k += d;
    c.check_eq( k.sum(), 12.0 );
    d += kl::of( [ 1.0, 2.0 ] );
    c.check_eq( d.sum(), 10.0 );

    c.expect_panic(
        "`dot` needs `S == U`, but `S` is 3, 2 and `U` is 2, 2",
        fn[]()
        {
            u64                    three = 3;
            kl::array<f64, dyn, 2> tall  = kl::zeros( three, 2 );
            kl::array<f64, 2, 2>   square = kl::zeros( 2, 2 );
            _                             = tall.dot( square );
        }
    );
    c.expect_panic(
        "`operator+=` needs `S == broadcast(S, U)`, but `S` is 2, 2 and `U` is 3, 2",
        fn[]()
        {
            u64                    three = 3;
            kl::array<f64, dyn, 2> tall  = kl::zeros( three, 2 );
            kl::array<f64, 2, 2>   square = kl::zeros( 2, 2 );
            square += tall;
        }
    );
}
