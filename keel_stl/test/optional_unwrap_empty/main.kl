// `unwrap` on an empty `kl::optional` panics: what was printed shows, then the panic names the line
// in `main` that called `unwrap`, and the program aborts.
import kl::console;
import kl::optional;

i32 main()
{
    kl::optional<i32> missing = kl::optional::none;
    kl::println( "looking" );
    return kl::unwrap( missing );
}
