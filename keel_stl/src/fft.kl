import complex;
import math;

// e^(-2 pi i e / n), the angle reduced first so a large `e` keeps its precision.
private complex<T> root<T>( u64 e, u64 n ) where T : floating
{
    const f64 t = -2.0 * kl::pi * cast<f64>( e % n ) / cast<f64>( n );
    return complex<T> { cast<T>( kl::cos( t ) ), cast<T>( kl::sin( t ) ) };
}

@real_arithmetic
private void dft_into<T, u64 N>( const ref complex<T>[N] x, ref complex<T>[N] y ) where T : floating
{
    for( u64 k : 0..N )
    {
        complex<T> s = complex<T> {};
        for( u64 j : 0..N )
        {
            s = s + x[j] * root<T>( j * k, N );
        }
        y[k] = s;
    }
}

@real_arithmetic
private void rdft_into<T, u64 N>( const ref T[N] x, ref complex<T>[N / 2 + 1] y ) where T : floating
{
    for( u64 k : 0..N / 2 + 1 )
    {
        complex<T> s = complex<T> {};
        for( u64 j : 0..N )
        {
            s = s + root<T>( j * k, N ) * x[j];
        }
        y[k] = s;
    }
}

// The real part of the inverse's sum over the first N / 2 + 1 inputs.
@real_arithmetic
private void half_into<T, u64 N>( const ref complex<T>[N / 2 + 1] y, ref T[N] x ) where T : floating
{
    for( u64 n : 0..N )
    {
        complex<T> s = complex<T> {};
        for( u64 k : 0..N / 2 + 1 )
        {
            s = s + y[k] * root<T>( k * n, N ).conj();
        }
        x[n] = s.re;
    }
}

/// The DFT of `x`: `y[k]` is the sum over `j` of `x[j] e^(-2 pi i j k / N)`.
///
/// The transforms here follow scipy.fft: the forward one unnormalised, the inverse scaled by 1 / N.
/// Each is written as its definition, a sum over every input for every output. At -O3 that sum is
/// solved into a fast circuit for its `N`; below -O3 it runs as written, in O(N^2).
complex<T>[N] dft<T, u64 N>( const ref complex<T>[N] x ) where T : floating
{
    complex<T>[N] y = [ complex<T> {}, .. ];
    dft_into<T, N>( x, ref y );
    return y;
}

/// The inverse DFT, `conj( dft( conj( y ) ) ) / N`, so `idft( dft( x ) )` is `x` to rounding.
complex<T>[N] idft<T, u64 N>( const ref complex<T>[N] y ) where T : floating
{
    complex<T>[N] c = [ complex<T> {}, .. ];
    for( u64 k : 0..N )
    {
        c[k] = y[k].conj();
    }
    complex<T>[N] x = [ complex<T> {}, .. ];
    dft_into<T, N>( c, ref x );
    const T scale = 1 / cast<T>( N );
    for( u64 j : 0..N )
    {
        x[j] = x[j].conj() * scale;
    }
    return x;
}

/// The DFT of the real `x`, its first `N / 2 + 1` outputs; the rest are their conjugates,
/// `y[N - k]` being `conj( y[k] )`.
complex<T>[N / 2 + 1] rdft<T, u64 N>( const ref T[N] x ) where T : floating
{
    complex<T>[N / 2 + 1] y = [ complex<T> {}, .. ];
    rdft_into<T, N>( x, ref y );
    return y;
}

/// The real `N` points whose `rdft` is `y`, `N` given: `kl::irdft<f64, 8>( y )`. As numpy's
/// `irfft`, the imaginary parts of `y[0]` and, for an even `N`, `y[N / 2]` are not read.
T[N] irdft<T, u64 N>( const ref complex<T>[N / 2 + 1] y ) where T : floating
{
    // Twice the half's sum, each term standing for its conjugate's too, less y[0] and an even N's
    // y[N / 2], which have none.
    T[N] x = [ 0, .. ];
    half_into<T, N>( y, ref x );
    const T scale = 1 / cast<T>( N );
    const T last  = N % 2 == 0 ? y[N / 2].re : 0;
    for( u64 n : 0..N )
    {
        x[n] = ( 2 * x[n] - y[0].re - ( n % 2 == 0 ? last : -last ) ) * scale;
    }
    return x;
}
