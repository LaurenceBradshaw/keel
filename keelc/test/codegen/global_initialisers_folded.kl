// Global initialisers the folder once answered nothing for, so each was emitted as zero.
import t::console;

i64 shifted         = -16 >> 2;
i64 shifted_negated = -( -8 >> 1 );
i64 shifted_cast    = cast<i64>( -5 ) >> 1;
i64 shifted_all     = -1 >> 63;
i64 shifted_exact   = -16 >> 4;

bool not_false   = !false;
bool not_compare = !( 1 > 2 );

bool less_floats  = 1.0 < 2.0;
bool equal_floats = 2.5 == 2.5;
bool below_zero   = -1.0 >= 0.0;

f64 cast_shift    = cast<f64>( 1 << 3 );
f64 cast_negative = cast<f64>( -5 >> 1 );
f64 remainder     = 5.0 % 2.0;

struct Holder
{
    i32 unused;
    static const i64 quarter = -16 >> 2;
};

const bool flag = !false;

i32 main()
{
    t::println( shifted );
    t::println( shifted_negated );
    t::println( shifted_cast );
    t::println( shifted_all );
    t::println( shifted_exact );
    t::println( not_false );
    t::println( not_compare );
    t::println( less_floats );
    t::println( equal_floats );
    t::println( below_zero );
    t::println( cast_shift );
    t::println( cast_negative );
    t::println( remainder );
    t::println( Holder::quarter );
    t::println( flag );
    return 0;
}
