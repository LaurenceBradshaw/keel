// `main` gets the program's arguments without its name, each as a `str` of its bytes.
import t::console;

i32 main( const ref str[] args )
{
    t::println( args.size );

    for( u64 i : 0..args.size )
    {
        t::println( args[ i ] );
        t::println( args[ i ].size );
    }

    return 0;
}
