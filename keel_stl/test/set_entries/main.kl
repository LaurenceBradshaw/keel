// `kl::set`'s keys are dense: counted over by `key_at` in insertion order, with the last key moved
// into a removed one's place. Owning keys, so valgrind checks the moves.
import kl::set;
import kl::string;

i32 main()
{
    kl::set<u64> s = kl::set<u64>();

    for( u64 i : 0..5 )
    {
        s.insert( i * 10 );
    }

    for( u64 i : 0..s.size() )
    {
        if( *s.key_at( i ) != i * 10 )
        {
            return 1;
        }
    }

    // Removing 10, key 1, moves 40, the last, into its place.
    if( !s.remove( 10 ) || s.size() != 4 || *s.key_at( 1 ) != 40 || !s.contains( 40 ) )
    {
        return 2;
    }

    // Growth keeps insertion order.
    kl::set<u64> big = kl::set<u64>();

    for( u64 i : 0..1000 )
    {
        big.insert( i * 3 );
    }

    for( u64 i : 0..1000 )
    {
        if( *big.key_at( i ) != i * 3 || !big.contains( i * 3 ) )
        {
            return 3;
        }
    }

    kl::set<kl::string> names = kl::set<kl::string>();

    for( u64 i : 0..40 )
    {
        names.insert( kl::string::from( i ) );
    }

    for( u64 i : 0..20 )
    {
        if( !names.remove( kl::string::from( i * 2 ) ) )
        {
            return 4;
        }
    }

    for( u64 i : 0..names.size() )
    {
        if( !names.contains( *names.key_at( i ) ) )
        {
            return 5;
        }
    }

    if( names.size() != 20 || names.contains( "38" ) || !names.contains( "39" ) )
    {
        return 6;
    }

    return 0;
}
