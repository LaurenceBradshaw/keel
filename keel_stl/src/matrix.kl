// Fixed-shape vectors and matrices, over kl::_core's kernels. One module, as each type's `matmul`
// takes the other.

import kl::_core::bits as kernel;
import kl::_core::compare as kernel;
import kl::_core::elementwise as kernel;
import kl::_core::exponential as kernel;
import kl::_core::linear as kernel;
import kl::_core::reduce as kernel;
import algorithm;
import iterable;
import mask;
import math;
import optional;
import pair;

/// `N` numbers held inline: a vector of rank 1, neither a row nor a column.
///
/// The operators work element by element, with a scalar on either side. `v.dot( w )` is the inner
/// product, and `v.matmul( m )` reads `v` as a row.
class vec<T, u64 N> implements iterable<T> where T : numeric
{
    T[N] e_;

    /// The elements in order: `vec<f64, 3>( [1.0, 2.0, 3.0] )`.
    public vec( T[N] elements )
    {
        e_ = elements;
    }

    /// Every element 0.
    public static vec<T, N> zeros()
    {
        return vec<T, N>( [0, ..] );
    }

    /// Every element `x`.
    public static vec<T, N> filled( T x )
    {
        return vec<T, N>( [x, ..] );
    }

    /// Every element 1.
    public static vec<T, N> ones()
    {
        return vec<T, N>( [1, ..] );
    }

    /// --- Shape and elements ---

    /// The number of elements, `N`.
    public u64 size() const
    {
        return N;
    }

    /// The element at `i`, which panics outside `size()`.
    public ref T operator[]( u64 i ) const
    {
        return e_[i];
    }

    /// The elements as a run, writable where the vector is.
    public ref T[] as_run() const
    {
        return e_;
    }

    /// Each element in order.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..N )
        {
            yield( e_[i] );
        }
    }

    /// Each element in order, writable in place.
    public void operator:( ref T item )
    {
        for( u64 i : 0..N )
        {
            yield( ref e_[i] );
        }
    }

    /// This vector's elements, then `b`'s.
    public vec<T, (N + M)> concatenated<u64 M>( const ref vec<T, M> b ) const
    {
        vec<T, (N + M)> r = vec<T, (N + M)>::zeros();
        for( u64 i : 0..N )
        {
            r.e_[i] = e_[i];
        }
        for( u64 i : 0..M )
        {
            r.e_[N + i] = b.e_[i];
        }
        return r;
    }

    /// A copy of the `M` elements from `i`: `v.segment<2>( 1 )`. Panics when they pass the end.
    public vec<T, M> segment<u64 M>( u64 i ) const
    {
        fits( i, M );
        vec<T, M> r = vec<T, M>::zeros();
        for( u64 k : 0..M )
        {
            r.e_[k] = e_[i + k];
        }
        return r;
    }

    /// Writes `s` over the `M` elements from `i`. Panics when they pass the end.
    public void set_segment<u64 M>( u64 i, const ref vec<T, M> s )
    {
        fits( i, M );
        for( u64 k : 0..M )
        {
            e_[i + k] = s.e_[k];
        }
    }

    /// --- Arithmetic ---

    /// The element-wise sum with `o`.
    public vec<T, N> operator+( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x + y; } );
        return r;
    }

    /// Each element + `s`.
    public vec<T, N> operator+( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x + s; } );
        return r;
    }

    /// `s` + each element.
    public static vec<T, N> operator+( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s + x; } );
        return r;
    }

    /// The element-wise difference with `o`.
    public vec<T, N> operator-( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x - y; } );
        return r;
    }

    /// Each element - `s`.
    public vec<T, N> operator-( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x - s; } );
        return r;
    }

    /// `s` - each element.
    public static vec<T, N> operator-( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s - x; } );
        return r;
    }

    /// The element-wise product with `o`.
    public vec<T, N> operator*( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x * y; } );
        return r;
    }

    /// Each element * `s`.
    public vec<T, N> operator*( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x * s; } );
        return r;
    }

    /// `s` * each element.
    public static vec<T, N> operator*( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s * x; } );
        return r;
    }

    /// The element-wise quotient with `o`.
    public vec<T, N> operator/( const ref vec<T, N> o ) const
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x / y; } );
        return r;
    }

    /// Each element / `s`.
    public vec<T, N> operator/( T s ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x / s; } );
        return r;
    }

    /// `s` / each element.
    public static vec<T, N> operator/( T s, const ref vec<T, N> a )
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s / x; } );
        return r;
    }

    /// Each element += the matching one of `o`.
    public void operator+=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element += `s`.
    public void operator+=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x + s; } );
    }

    /// Each element -= the matching one of `o`.
    public void operator-=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element -= `s`.
    public void operator-=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x - s; } );
    }

    /// Each element *= the matching one of `o`.
    public void operator*=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element *= `s`.
    public void operator*=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x * s; } );
    }

    /// Each element /= the matching one of `o`.
    public void operator/=( const ref vec<T, N> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element /= `s`.
    public void operator/=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x / s; } );
    }

    /// Each element negated.
    public vec<T, N> operator-() const where T : floating
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return -x; } );
        return r;
    }

    /// --- Integer operators ---

    /// The element-wise remainder after dividing by `o`.
    public vec<T, N> operator%( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x % y; } );
        return r;
    }

    /// Each element % `s`.
    public vec<T, N> operator%( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x % s; } );
        return r;
    }

    /// `s` % each element.
    public static vec<T, N> operator%( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s % x; } );
        return r;
    }

    /// The element-wise bitwise and with `o`.
    public vec<T, N> operator&( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x & y; } );
        return r;
    }

    /// Each element & `s`.
    public vec<T, N> operator&( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x & s; } );
        return r;
    }

    /// `s` & each element.
    public static vec<T, N> operator&( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s & x; } );
        return r;
    }

    /// The element-wise bitwise or with `o`.
    public vec<T, N> operator|( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x | y; } );
        return r;
    }

    /// Each element | `s`.
    public vec<T, N> operator|( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x | s; } );
        return r;
    }

    /// `s` | each element.
    public static vec<T, N> operator|( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s | x; } );
        return r;
    }

    /// The element-wise bitwise exclusive or with `o`.
    public vec<T, N> operator^( const ref vec<T, N> o ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
        return r;
    }

    /// Each element ^ `s`.
    public vec<T, N> operator^( T s ) const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x ^ s; } );
        return r;
    }

    /// `s` ^ each element.
    public static vec<T, N> operator^( T s, const ref vec<T, N> a ) where T : integral
    {
        vec<T, N> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s ^ x; } );
        return r;
    }

    /// Each element %= the matching one of `o`.
    public void operator%=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element %= `s`.
    public void operator%=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x % s; } );
    }

    /// Each element &= the matching one of `o`.
    public void operator&=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element &= `s`.
    public void operator&=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x & s; } );
    }

    /// Each element |= the matching one of `o`.
    public void operator|=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element |= `s`.
    public void operator|=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x | s; } );
    }

    /// Each element ^= the matching one of `o`.
    public void operator^=( const ref vec<T, N> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^= `s`.
    public void operator^=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x ^ s; } );
    }

    /// Each element with its bits flipped.
    public vec<T, N> operator~() const where T : integral
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return ~x; } );
        return r;
    }

    /// --- Element-wise functions ---

    /// Each element without its sign, as `kl::abs`.
    public vec<T, N> abs() const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::abs( x ); } );
        return r;
    }

    /// Each element's sign, as `kl::sign`: -1, 0 or 1.
    public vec<T, N> sign() const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::sign( x ); } );
        return r;
    }

    /// Each element held between `lo` and `hi`; `hi` wins when they cross.
    public vec<T, N> clip( T lo, T hi ) const
    {
        vec<T, N> r = this;
        kernel::map_into( ref r.e_, fn[ lo, hi ]( T x ) { return kl::min( kl::max( x, lo ), hi ); } );
        return r;
    }

    /// `f` of each element, in the same shape, `U` being what `f` returns:
    /// `a.map( fn[]( f64 x ) { return x * x; } )`.
    public vec<U, N> map<U, F>( F f ) const where F : fn( T ) -> U, where U : numeric
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, f );
        return r;
    }

    /// --- Products ---

    /// The inner product with `o`.
    public T dot( const ref vec<T, N> o ) const
    {
        return kernel::dot( e_, o.e_ );
    }

    /// This vector, as a row, times `m`.
    public vec<T, K> matmul<u64 K>( const ref mat<T, N, K> m ) const
    {
        vec<T, K> r = vec<T, K>::zeros();
        kernel::matmul( ref r.e_, e_, m.as_run(), 1, N, K );
        return r;
    }

    /// Each element of this vector times each of `b`: row `i` is `b` times element `i`.
    public mat<T, N, M> outer<u64 M>( const ref vec<T, M> b ) const
    {
        mat<T, N, M> r = mat<T, N, M>::zeros();
        kernel::outer( ref r.as_run(), e_, b.e_ );
        return r;
    }

    /// The length, the square root of the sum of squares, which overflows only when the length does.
    public T norm() const where T : floating
    {
        return cast<T>( kernel::norm( e_ ) );
    }

    /// This vector over its `norm()`; every element NaN when that is 0.
    public vec<T, N> normalised() const where T : floating
    {
        return this / norm();
    }

    /// --- Comparing ---

    /// Whether every element equals the matching one of `o`.
    public bool operator==( const ref vec<T, N> o ) const
    {
        return kernel::equal( e_, o.e_ );
    }

    /// Whether every `|a - b| <= atol + rtol * |b|`, `b` being `o`'s element. A NaN is close to
    /// nothing, and an infinity only to itself.
    public bool approx_equal( const ref vec<T, N> o, T rtol = 1e-5, T atol = 1e-8 ) const where T : floating
    {
        return kernel::approx_equal( e_, o.e_, rtol, atol );
    }

    /// Where each element is less than the matching one of `o`.
    public vec_mask<N> less( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x < y; } );
        return r;
    }

    /// Where each element is less than `s`.
    public vec_mask<N> less( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x < s; } );
        return r;
    }

    /// Where each element is greater than the matching one of `o`.
    public vec_mask<N> greater( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x > y; } );
        return r;
    }

    /// Where each element is greater than `s`.
    public vec_mask<N> greater( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x > s; } );
        return r;
    }

    /// Where each element is at most the matching one of `o`.
    public vec_mask<N> less_equal( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x <= y; } );
        return r;
    }

    /// Where each element is at most `s`.
    public vec_mask<N> less_equal( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x <= s; } );
        return r;
    }

    /// Where each element is at least the matching one of `o`.
    public vec_mask<N> greater_equal( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x >= y; } );
        return r;
    }

    /// Where each element is at least `s`.
    public vec_mask<N> greater_equal( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x >= s; } );
        return r;
    }

    /// Where each element is equal to the matching one of `o`.
    public vec_mask<N> equal_each( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x == y; } );
        return r;
    }

    /// Where each element is equal to `s`.
    public vec_mask<N> equal_each( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x == s; } );
        return r;
    }

    /// Where each element is not equal to the matching one of `o`.
    public vec_mask<N> differs( const ref vec<T, N> o ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x != y; } );
        return r;
    }

    /// Where each element is not equal to `s`.
    public vec_mask<N> differs( T s ) const
    {
        vec_mask<N> r = vec_mask<N> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x != s; } );
        return r;
    }

    /// --- Sorting ---

    /// The elements from least to greatest, NaNs last.
    public vec<T, N> sorted() const
    {
        vec<T, N> r = this;
        kl::sort( ref r.e_, fn[]( x, y ) { return kernel::before( x, y ); } );
        return r;
    }

    /// The indices that would sort the elements, NaNs last and equal ones in index order.
    public vec<u64, N> argsort() const
    {
        vec<u64, N> r = vec<u64, N>::zeros();
        for( u64 i : 0..N )
        {
            r[i] = i;
        }
        kl::sort( ref r.e_, fn[ this ]( i, j ) { return kernel::before( e_[i], e_[j] ) || ( !kernel::before( e_[j], e_[i] ) && i < j ); } );
        return r;
    }

    /// --- Reducing ---

    /// The total of every element, added in index order.
    public T sum() const
    {
        return kernel::sum( e_ );
    }

    /// The product of every element, in index order.
    public T prod() const
    {
        return kernel::prod( e_ );
    }

    /// The smallest element, as `kl::min`.
    public T min() const
    {
        return kernel::fold( e_, fn[]( T x, T y ) { return kl::min( x, y ); } );
    }

    /// The largest element, as `kl::max`.
    public T max() const
    {
        return kernel::fold( e_, fn[]( T x, T y ) { return kl::max( x, y ); } );
    }

    /// The index of the first smallest element, or of the first NaN.
    public u64 argmin() const
    {
        return kernel::arg_best( e_, fn[]( T x, T m ) { return m == m && ( x < m || x != x ); } );
    }

    /// The index of the first largest element, or of the first NaN.
    public u64 argmax() const
    {
        return kernel::arg_best( e_, fn[]( T x, T m ) { return m == m && ( x > m || x != x ); } );
    }

    /// The running totals of the elements.
    public vec<T, N> cumsum() const
    {
        vec<T, N> r = this;
        kernel::scan_axis( ref r.e_, 1, N, 1, fn[]( T x, T y ) { return x + y; } );
        return r;
    }

    /// The running products of the elements.
    public vec<T, N> cumprod() const
    {
        vec<T, N> r = this;
        kernel::scan_axis( ref r.e_, 1, N, 1, fn[]( T x, T y ) { return x * y; } );
        return r;
    }

    /// The mean of the elements.
    public T mean() const where T : floating
    {
        return sum() / cast<T>( N );
    }

    /// The mean square distance of the elements from their mean.
    public T var() const where T : floating
    {
        return kernel::variance( e_ );
    }

    /// The standard deviation, the square root of `var()`.
    public T std() const where T : floating
    {
        return cast<T>( kl::sqrt( cast<f64>( var() ) ) );
    }

    /// --- Converting ---

    /// Each element converted by `cast`, which panics on a value `U` cannot hold. A float to an
    /// integer needs a rounding: `truncated`, `rounded`, `floored` or `ceiled`.
    public vec<U, N> to<U>() const where T : converts_to<U>, where U : numeric
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return cast<U>( x ); } );
        return r;
    }

    /// Each element toward zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> truncated<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::truncated<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element to the nearest, a half away from zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> rounded<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::rounded<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element down, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> floored<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::floored<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element up, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public vec<U, N> ceiled<U>() const where T : floating, where U : integral
    {
        vec<U, N> r = vec<U, N>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::ceiled<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// --- Internals ---

    // Panics unless the `m` elements from `i` are inside.
    private void fits( u64 i, u64 m ) const
    {
        if( m > N || i > N - m )
        {
            panic( "the segment passes the end" );
        }
    }
};

/// `R` rows of `C` numbers held inline, row after row: a matrix of rank 2.
///
/// The operators work element by element, with a scalar on either side; `m.matmul( b )` is the
/// matrix product, and `m.matmul( v )` reads `v` as a column. `m[r, c]` is row `r`, column `c`, and
/// `for( T x : m )` walks the elements row after row.
class mat<T, u64 R, u64 C> implements iterable<T> where T : numeric
{
    T[R * C] e_;

    /// The elements row after row: `mat<f64, 2, 2>( [1.0, 2.0, 3.0, 4.0] )`.
    public mat( T[R * C] elements )
    {
        e_ = elements;
    }

    /// The rows: `mat<f64, 2, 2>( [[1.0, 2.0], [3.0, 4.0]] )`.
    public mat( T[C][R] rows )
    {
        e_ = [0, ..];
        for( u64 r : 0..R )
        {
            for( u64 c : 0..C )
            {
                e_[r * C + c] = rows[r][c];
            }
        }
    }

    /// Every element 0.
    public static mat<T, R, C> zeros()
    {
        return mat<T, R, C>( [0, ..] );
    }

    /// Every element `x`.
    public static mat<T, R, C> filled( T x )
    {
        return mat<T, R, C>( [x, ..] );
    }

    /// Every element 1.
    public static mat<T, R, C> ones()
    {
        return mat<T, R, C>( [1, ..] );
    }

    /// 1 on the diagonal and 0 elsewhere: the identity when square.
    public static mat<T, R, C> eye()
    {
        mat<T, R, C> r = mat<T, R, C>::zeros();
        kernel::eye( ref r.e_, R, C );
        return r;
    }

    /// --- Shape and elements ---

    /// The number of rows, `R`.
    public u64 rows() const
    {
        return R;
    }

    /// The number of columns, `C`.
    public u64 cols() const
    {
        return C;
    }

    /// The number of elements, `R * C`.
    public u64 size() const
    {
        return R * C;
    }

    /// The element in row `r`, column `c`, which panics outside the shape.
    public ref T operator[]( u64 r, u64 c ) const
    {
        if( r >= R || c >= C )
        {
            panic( "index out of range" );
        }

        return e_[r * C + c];
    }

    /// The elements row after row, as a run writable where the matrix is.
    public ref T[] as_run() const
    {
        return e_;
    }

    /// Each element, row after row.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..R * C )
        {
            yield( e_[i] );
        }
    }

    /// Each element, row after row, writable in place.
    public void operator:( ref T item )
    {
        for( u64 i : 0..R * C )
        {
            yield( ref e_[i] );
        }
    }

    /// The elements row after row, as a vector.
    public vec<T, (R * C)> flattened() const
    {
        return vec<T, (R * C)>( e_ );
    }

    /// A copy of the `P` by `Q` block whose top left is row `i`, column `j`:
    /// `m.block<2, 2>( 1, 0 )`. Panics when it passes an edge.
    public mat<T, P, Q> block<u64 P, u64 Q>( u64 i, u64 j ) const
    {
        fits( i, j, P, Q );
        mat<T, P, Q> r = mat<T, P, Q>::zeros();
        for( u64 p : 0..P )
        {
            for( u64 q : 0..Q )
            {
                r.e_[p * Q + q] = e_[( i + p ) * C + j + q];
            }
        }
        return r;
    }

    /// Writes `b` over the block whose top left is row `i`, column `j`. Panics when it passes an
    /// edge.
    public void set_block<u64 P, u64 Q>( u64 i, u64 j, const ref mat<T, P, Q> b )
    {
        fits( i, j, P, Q );
        for( u64 p : 0..P )
        {
            for( u64 q : 0..Q )
            {
                e_[( i + p ) * C + j + q] = b.e_[p * Q + q];
            }
        }
    }

    /// --- Arithmetic ---

    /// The element-wise sum with `o`.
    public mat<T, R, C> operator+( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x + y; } );
        return r;
    }

    /// Each element + `s`.
    public mat<T, R, C> operator+( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x + s; } );
        return r;
    }

    /// `s` + each element.
    public static mat<T, R, C> operator+( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s + x; } );
        return r;
    }

    /// The element-wise difference with `o`.
    public mat<T, R, C> operator-( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x - y; } );
        return r;
    }

    /// Each element - `s`.
    public mat<T, R, C> operator-( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x - s; } );
        return r;
    }

    /// `s` - each element.
    public static mat<T, R, C> operator-( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s - x; } );
        return r;
    }

    /// The element-wise product with `o`.
    public mat<T, R, C> operator*( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x * y; } );
        return r;
    }

    /// Each element * `s`.
    public mat<T, R, C> operator*( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x * s; } );
        return r;
    }

    /// `s` * each element.
    public static mat<T, R, C> operator*( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s * x; } );
        return r;
    }

    /// The element-wise quotient with `o`.
    public mat<T, R, C> operator/( const ref mat<T, R, C> o ) const
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x / y; } );
        return r;
    }

    /// Each element / `s`.
    public mat<T, R, C> operator/( T s ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x / s; } );
        return r;
    }

    /// `s` / each element.
    public static mat<T, R, C> operator/( T s, const ref mat<T, R, C> a )
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s / x; } );
        return r;
    }

    /// Each element += the matching one of `o`.
    public void operator+=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element += `s`.
    public void operator+=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x + s; } );
    }

    /// Each element -= the matching one of `o`.
    public void operator-=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element -= `s`.
    public void operator-=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x - s; } );
    }

    /// Each element *= the matching one of `o`.
    public void operator*=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element *= `s`.
    public void operator*=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x * s; } );
    }

    /// Each element /= the matching one of `o`.
    public void operator/=( const ref mat<T, R, C> o )
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element /= `s`.
    public void operator/=( T s )
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x / s; } );
    }

    /// Each element negated.
    public mat<T, R, C> operator-() const where T : floating
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return -x; } );
        return r;
    }

    /// --- Integer operators ---

    /// The element-wise remainder after dividing by `o`.
    public mat<T, R, C> operator%( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x % y; } );
        return r;
    }

    /// Each element % `s`.
    public mat<T, R, C> operator%( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x % s; } );
        return r;
    }

    /// `s` % each element.
    public static mat<T, R, C> operator%( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s % x; } );
        return r;
    }

    /// The element-wise bitwise and with `o`.
    public mat<T, R, C> operator&( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x & y; } );
        return r;
    }

    /// Each element & `s`.
    public mat<T, R, C> operator&( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x & s; } );
        return r;
    }

    /// `s` & each element.
    public static mat<T, R, C> operator&( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s & x; } );
        return r;
    }

    /// The element-wise bitwise or with `o`.
    public mat<T, R, C> operator|( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x | y; } );
        return r;
    }

    /// Each element | `s`.
    public mat<T, R, C> operator|( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x | s; } );
        return r;
    }

    /// `s` | each element.
    public static mat<T, R, C> operator|( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s | x; } );
        return r;
    }

    /// The element-wise bitwise exclusive or with `o`.
    public mat<T, R, C> operator^( const ref mat<T, R, C> o ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::zip_into( ref r.e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
        return r;
    }

    /// Each element ^ `s`.
    public mat<T, R, C> operator^( T s ) const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return x ^ s; } );
        return r;
    }

    /// `s` ^ each element.
    public static mat<T, R, C> operator^( T s, const ref mat<T, R, C> a ) where T : integral
    {
        mat<T, R, C> r = a;
        kernel::map_into( ref r.e_, fn[ s ]( T x ) { return s ^ x; } );
        return r;
    }

    /// Each element %= the matching one of `o`.
    public void operator%=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element %= `s`.
    public void operator%=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x % s; } );
    }

    /// Each element &= the matching one of `o`.
    public void operator&=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element &= `s`.
    public void operator&=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x & s; } );
    }

    /// Each element |= the matching one of `o`.
    public void operator|=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element |= `s`.
    public void operator|=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x | s; } );
    }

    /// Each element ^= the matching one of `o`.
    public void operator^=( const ref mat<T, R, C> o ) where T : integral
    {
        kernel::zip_into( ref e_, o.e_, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^= `s`.
    public void operator^=( T s ) where T : integral
    {
        kernel::map_into( ref e_, fn[ s ]( T x ) { return x ^ s; } );
    }

    /// Each element with its bits flipped.
    public mat<T, R, C> operator~() const where T : integral
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return ~x; } );
        return r;
    }

    /// --- Element-wise functions ---

    /// Each element without its sign, as `kl::abs`.
    public mat<T, R, C> abs() const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::abs( x ); } );
        return r;
    }

    /// Each element's sign, as `kl::sign`: -1, 0 or 1.
    public mat<T, R, C> sign() const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[]( T x ) { return kl::sign( x ); } );
        return r;
    }

    /// Each element held between `lo` and `hi`; `hi` wins when they cross.
    public mat<T, R, C> clip( T lo, T hi ) const
    {
        mat<T, R, C> r = this;
        kernel::map_into( ref r.e_, fn[ lo, hi ]( T x ) { return kl::min( kl::max( x, lo ), hi ); } );
        return r;
    }

    /// `f` of each element, in the same shape, `U` being what `f` returns:
    /// `a.map( fn[]( f64 x ) { return x * x; } )`.
    public mat<U, R, C> map<U, F>( F f ) const where F : fn( T ) -> U, where U : numeric
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, f );
        return r;
    }

    /// --- Products ---

    /// This matrix times `b`.
    public mat<T, R, K> matmul<u64 K>( const ref mat<T, C, K> b ) const
    {
        mat<T, R, K> r = mat<T, R, K>::zeros();
        kernel::matmul( ref r.e_, e_, b.e_, R, C, K );
        return r;
    }

    /// This matrix times `v`, read as a column.
    public vec<T, R> matmul( const ref vec<T, C> v ) const
    {
        vec<T, R> r = vec<T, R>::zeros();
        kernel::matmul( ref r.as_run(), e_, v.as_run(), R, C, 1 );
        return r;
    }

    /// The rows as columns.
    public mat<T, C, R> transposed() const
    {
        mat<T, C, R> r = mat<T, C, R>::zeros();
        kernel::transpose( ref r.e_, e_, R, C );
        return r;
    }

    /// The sum of the diagonal, `[0, 0]` to the last row or column.
    public T trace() const
    {
        T r = 0;
        for( u64 i : 0..( R < C ? R : C ) )
        {
            r += e_[i * C + i];
        }
        return r;
    }

    /// The Frobenius norm, the square root of the sum of squares, which overflows only when the norm
    /// does.
    public T norm() const where T : floating
    {
        return cast<T>( kernel::norm( e_ ) );
    }

    /// This matrix over its `norm()`; every element NaN when that is 0.
    public mat<T, R, C> normalised() const where T : floating
    {
        return this / norm();
    }

    /// --- Comparing ---

    /// Whether every element equals the matching one of `o`.
    public bool operator==( const ref mat<T, R, C> o ) const
    {
        return kernel::equal( e_, o.e_ );
    }

    /// Whether every `|a - b| <= atol + rtol * |b|`, `b` being `o`'s element. A NaN is close to
    /// nothing, and an infinity only to itself.
    public bool approx_equal( const ref mat<T, R, C> o, T rtol = 1e-5, T atol = 1e-8 ) const where T : floating
    {
        return kernel::approx_equal( e_, o.e_, rtol, atol );
    }

    /// Where each element is less than the matching one of `o`.
    public mat_mask<R, C> less( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x < y; } );
        return r;
    }

    /// Where each element is less than `s`.
    public mat_mask<R, C> less( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x < s; } );
        return r;
    }

    /// Where each element is greater than the matching one of `o`.
    public mat_mask<R, C> greater( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x > y; } );
        return r;
    }

    /// Where each element is greater than `s`.
    public mat_mask<R, C> greater( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x > s; } );
        return r;
    }

    /// Where each element is at most the matching one of `o`.
    public mat_mask<R, C> less_equal( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x <= y; } );
        return r;
    }

    /// Where each element is at most `s`.
    public mat_mask<R, C> less_equal( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x <= s; } );
        return r;
    }

    /// Where each element is at least the matching one of `o`.
    public mat_mask<R, C> greater_equal( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x >= y; } );
        return r;
    }

    /// Where each element is at least `s`.
    public mat_mask<R, C> greater_equal( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x >= s; } );
        return r;
    }

    /// Where each element is equal to the matching one of `o`.
    public mat_mask<R, C> equal_each( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x == y; } );
        return r;
    }

    /// Where each element is equal to `s`.
    public mat_mask<R, C> equal_each( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x == s; } );
        return r;
    }

    /// Where each element is not equal to the matching one of `o`.
    public mat_mask<R, C> differs( const ref mat<T, R, C> o ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark_pairs( ref r.bits.words, e_, o.e_, fn[]( T x, T y ) { return x != y; } );
        return r;
    }

    /// Where each element is not equal to `s`.
    public mat_mask<R, C> differs( T s ) const
    {
        mat_mask<R, C> r = mat_mask<R, C> {};
        kernel::mark( ref r.bits.words, e_, fn[ s ]( T x ) { return x != s; } );
        return r;
    }

    /// --- Reducing ---

    /// The total of every element, added in index order.
    public T sum() const
    {
        return kernel::sum( e_ );
    }

    /// The product of every element, in index order.
    public T prod() const
    {
        return kernel::prod( e_ );
    }

    /// The smallest element, as `kl::min`.
    public T min() const
    {
        return kernel::fold( e_, fn[]( T x, T y ) { return kl::min( x, y ); } );
    }

    /// The largest element, as `kl::max`.
    public T max() const
    {
        return kernel::fold( e_, fn[]( T x, T y ) { return kl::max( x, y ); } );
    }

    /// The row-major index of the first smallest element, or of the first NaN.
    public u64 argmin() const
    {
        return kernel::arg_best( e_, fn[]( T x, T m ) { return m == m && ( x < m || x != x ); } );
    }

    /// The row-major index of the first largest element, or of the first NaN.
    public u64 argmax() const
    {
        return kernel::arg_best( e_, fn[]( T x, T m ) { return m == m && ( x > m || x != x ); } );
    }

    /// The running totals of the elements, row after row, as a vector.
    public vec<T, (R * C)> cumsum() const
    {
        return flattened().cumsum();
    }

    /// The running totals down each column (`axis` 0) or along each row (1).
    public mat<T, R, C> cumsum( u64 axis ) const
    {
        return scanned( axis, fn[]( T x, T y ) { return x + y; } );
    }

    /// The running products of the elements, row after row, as a vector.
    public vec<T, (R * C)> cumprod() const
    {
        return flattened().cumprod();
    }

    /// The running products down each column (`axis` 0) or along each row (1).
    public mat<T, R, C> cumprod( u64 axis ) const
    {
        return scanned( axis, fn[]( T x, T y ) { return x * y; } );
    }

    /// The mean of the elements.
    public T mean() const where T : floating
    {
        return sum() / cast<T>( R * C );
    }

    /// The mean square distance of the elements from their mean.
    public T var() const where T : floating
    {
        return kernel::variance( e_ );
    }

    /// The standard deviation, the square root of `var()`.
    public T std() const where T : floating
    {
        return cast<T>( kl::sqrt( cast<f64>( var() ) ) );
    }

    /// --- Converting ---

    /// Each element converted by `cast`, which panics on a value `U` cannot hold. A float to an
    /// integer needs a rounding: `truncated`, `rounded`, `floored` or `ceiled`.
    public mat<U, R, C> to<U>() const where T : converts_to<U>, where U : numeric
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return cast<U>( x ); } );
        return r;
    }

    /// Each element toward zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> truncated<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::truncated<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element to the nearest, a half away from zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> rounded<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::rounded<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element down, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> floored<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::floored<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// Each element up, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public mat<U, R, C> ceiled<U>() const where T : floating, where U : integral
    {
        mat<U, R, C> r = mat<U, R, C>::zeros();
        kernel::map( ref r.e_, e_, fn[]( T x ) { return kl::ceiled<U>( cast<f64>( x ) ); } );
        return r;
    }

    /// --- Internals ---

    // Panics unless `axis` is 0 or 1.
    private mat<T, R, C> scanned<F>( u64 axis, F op ) const where F : fn( T, T ) -> T
    {
        mat<T, R, C> r = this;
        if( axis == 0 )
        {
            kernel::scan_axis( ref r.e_, 1, R, C, op );
        }
        else if( axis == 1 )
        {
            kernel::scan_axis( ref r.e_, R, C, 1, op );
        }
        else
        {
            panic( "axis out of range" );
        }
        return r;
    }

    // Panics unless the `p` by `q` block from row `i`, column `j` is inside.
    private void fits( u64 i, u64 j, u64 p, u64 q ) const
    {
        if( p > R || i > R - p || q > C || j > C - q )
        {
            panic( "the block passes an edge" );
        }
    }
};

/// The `N` by `N` identity: `mat<f64, 3, 3> i = kl::identity();`.
mat<T, N, N> identity<T, u64 N>() where T : numeric
{
    mat<T, N, N> r = mat<T, N, N>::zeros();
    kernel::identity( ref r.as_run(), N );
    return r;
}

/// The square matrix with `v` on its diagonal: `kl::diag( v )`.
mat<T, N, N> diag<T, u64 N>( const ref vec<T, N> v ) where T : numeric
{
    mat<T, N, N> r = mat<T, N, N>::zeros();
    for( u64 i : 0..N )
    {
        r[i, i] = v[i];
    }
    return r;
}

/// The diagonal of a square matrix: `kl::diagonal( m )`.
vec<T, N> diagonal<T, u64 N>( const ref mat<T, N, N> m ) where T : numeric
{
    vec<T, N> r = vec<T, N>::zeros();
    for( u64 i : 0..N )
    {
        r[i] = m[i, i];
    }
    return r;
}

/// The cross product `a` x `b`: `kl::cross( a, b )`.
vec<T, 3> cross<T>( const ref vec<T, 3> a, const ref vec<T, 3> b ) where T : numeric
{
    vec<T, 3> r = vec<T, 3>::zeros();
    kernel::cross( ref r.as_run(), a.as_run(), b.as_run() );
    return r;
}

/// The determinant of a square matrix, through LU with partial pivoting: `kl::determinant( m )`.
/// 0 when a pivot is exactly zero.
T determinant<T, u64 N>( const ref mat<T, N, N> m ) where T : floating
{
    mat<T, N, N> f    = m;
    u64[N]       perm = [0, ..];
    T            sign = kernel::lu( ref f.as_run(), ref perm, N );
    return kernel::lu_determinant( f.as_run(), N, sign );
}

/// The inverse of a square matrix, `none` when a pivot is exactly zero: `kl::inverse( m )`. A
/// nearly singular matrix gives large elements.
optional<mat<T, N, N>> inverse<T, u64 N>( const ref mat<T, N, N> m ) where T : floating
{
    mat<T, N, N> f    = m;
    u64[N]       perm = [0, ..];
    if( kernel::lu( ref f.as_run(), ref perm, N ) == 0 )
    {
        return optional::none;
    }

    mat<T, N, N> r = mat<T, N, N>::zeros();
    kernel::lu_solve( ref r.as_run(), f.as_run(), perm, mat<T, N, N>::eye().as_run(), N, N );
    return optional::some( r );
}

/// The `x` with `a.matmul( x ) == b`, `none` when a pivot of `a` is exactly zero:
/// `kl::solve( a, b )`.
optional<vec<T, N>> solve<T, u64 N>( const ref mat<T, N, N> a, const ref vec<T, N> b ) where T : floating
{
    mat<T, N, N> f    = a;
    u64[N]       perm = [0, ..];
    if( kernel::lu( ref f.as_run(), ref perm, N ) == 0 )
    {
        return optional::none;
    }

    vec<T, N> r = vec<T, N>::zeros();
    kernel::lu_solve( ref r.as_run(), f.as_run(), perm, b.as_run(), N, 1 );
    return optional::some( r );
}

/// The thin QR factors of `a`, `first` with orthonormal columns and `second` upper triangular,
/// their product `a`, by Householder reflections as numpy's `qr`: `kl::qr( a )`.
pair<mat<T, R, C>, mat<T, C, C>> qr<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating, where R >= C
{
    mat<T, R, C> f   = a;
    T[C]         tau = [0, ..];
    _                = kernel::householder_qr( ref f.as_run(), ref tau, R, C );
    mat<T, R, C> q   = mat<T, R, C>::zeros();
    mat<T, C, C> r   = mat<T, C, C>::zeros();
    kernel::qr_q( ref q.as_run(), f.as_run(), tau, R, C );
    kernel::qr_r( ref r.as_run(), f.as_run(), R, C );
    return pair<mat<T, R, C>, mat<T, C, C>>( q, r );
}

/// The `x` making `a.matmul( x ) - b` shortest, through QR, `none` when a diagonal of R is
/// exactly zero: `kl::lstsq( a, b )`. numpy's `lstsq` answers the shortest such `x` there instead.
optional<vec<T, C>> lstsq<T, u64 R, u64 C>( const ref mat<T, R, C> a, const ref vec<T, R> b ) where T : floating, where R >= C
{
    mat<T, R, C> f   = a;
    T[C]         tau = [0, ..];
    if( !kernel::householder_qr( ref f.as_run(), ref tau, R, C ) )
    {
        return optional::none;
    }

    vec<T, R> w = b;
    vec<T, C> x = vec<T, C>::zeros();
    kernel::qr_solve( ref x.as_run(), ref w.as_run(), f.as_run(), tau, R, C, 1 );
    return optional::some( x );
}

/// The diagonal of the projection onto `a`'s columns, `a (a^T a)^-1 a^T`, through QR: each row's
/// leverage when `a` has full column rank. `kl::hat_diagonal( a )`.
vec<T, R> hat_diagonal<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating, where R >= C
{
    mat<T, R, C> q = kl::qr( a ).first;
    vec<T, R>    h = vec<T, R>::zeros();
    kernel::row_squares( ref h.as_run(), q.as_run(), R, C );
    return h;
}

/// The smallest of each set of matching elements, as `kl::min`: `kl::minimum( a, b, c )`.
vec<T, N> minimum<T, u64 N>( const ref vec<T, N> first, vec<T, N>... rest ) where T : numeric
{
    vec<T, N> r = first;
    for( const ref vec<T, N> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::min( x, y ); } );
    }
    return r;
}

/// The largest of each set of matching elements, as `kl::max`: `kl::maximum( a, b, c )`.
vec<T, N> maximum<T, u64 N>( const ref vec<T, N> first, vec<T, N>... rest ) where T : numeric
{
    vec<T, N> r = first;
    for( const ref vec<T, N> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::max( x, y ); } );
    }
    return r;
}

/// The smallest of each set of matching elements, as `kl::min`: `kl::minimum( a, b, c )`.
mat<T, R, C> minimum<T, u64 R, u64 C>( const ref mat<T, R, C> first, mat<T, R, C>... rest ) where T : numeric
{
    mat<T, R, C> r = first;
    for( const ref mat<T, R, C> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::min( x, y ); } );
    }
    return r;
}

/// The largest of each set of matching elements, as `kl::max`: `kl::maximum( a, b, c )`.
mat<T, R, C> maximum<T, u64 R, u64 C>( const ref mat<T, R, C> first, mat<T, R, C>... rest ) where T : numeric
{
    mat<T, R, C> r = first;
    for( const ref mat<T, R, C> b : rest )
    {
        kernel::zip_into( ref r.as_run(), b.as_run(), fn[]( T x, T y ) { return kl::max( x, y ); } );
    }
    return r;
}

/// `a`'s element where `m` is set, and `b`'s where it is clear.
vec<T, N> select<T, u64 N>( const ref vec_mask<N> m, const ref vec<T, N> a, const ref vec<T, N> b ) where T : numeric
{
    vec<T, N> r = b;
    kernel::select( ref r.as_run(), m.bits.words, a.as_run(), b.as_run() );
    return r;
}

/// Where each element is a NaN, as `kl::is_nan`.
vec_mask<N> is_nan<T, u64 N>( const ref vec<T, N> a ) where T : floating
{
    vec_mask<N> r = vec_mask<N> {};
    kernel::mark( ref r.bits.words, a.as_run(), fn[]( T x ) { return kl::is_nan( cast<f64>( x ) ); } );
    return r;
}

/// Where each element is an infinity, as `kl::is_inf`.
vec_mask<N> is_inf<T, u64 N>( const ref vec<T, N> a ) where T : floating
{
    vec_mask<N> r = vec_mask<N> {};
    kernel::mark( ref r.bits.words, a.as_run(), fn[]( T x ) { return kl::is_inf( cast<f64>( x ) ); } );
    return r;
}

/// `a`'s element where `m` is set, and `b`'s where it is clear.
mat<T, R, C> select<T, u64 R, u64 C>( const ref mat_mask<R, C> m, const ref mat<T, R, C> a, const ref mat<T, R, C> b ) where T : numeric
{
    mat<T, R, C> r = b;
    kernel::select( ref r.as_run(), m.bits.words, a.as_run(), b.as_run() );
    return r;
}

/// Where each element is a NaN, as `kl::is_nan`.
mat_mask<R, C> is_nan<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    mat_mask<R, C> r = mat_mask<R, C> {};
    kernel::mark( ref r.bits.words, a.as_run(), fn[]( T x ) { return kl::is_nan( cast<f64>( x ) ); } );
    return r;
}

/// Where each element is an infinity, as `kl::is_inf`.
mat_mask<R, C> is_inf<T, u64 R, u64 C>( const ref mat<T, R, C> a ) where T : floating
{
    mat_mask<R, C> r = mat_mask<R, C> {};
    kernel::mark( ref r.bits.words, a.as_run(), fn[]( T x ) { return kl::is_inf( cast<f64>( x ) ); } );
    return r;
}

