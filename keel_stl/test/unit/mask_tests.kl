// `kl::mask`, `kl::vec_mask` and `kl::mat_mask` at the word edges: counting, combining and
// comparing agree across one word, a full word and one past it, and the spare bits never show.
import kl::mask;
import kl::test::context;

// Bits 0 and n - 1 of an n-bit `kl::mask`, and every whole-mask reader.
private void edges( ref kl::test::context c, u64 n )
{
    kl::mask m = kl::mask( n );
    c.check_eq( m.size(), n );
    c.check_eq( m.count(), 0 );
    c.check( !m.any() && !m.all() );

    m.assign( 0, true );
    m.assign( n - 1, true );
    c.check( m.test( 0 ) && m.at( n - 1 ) );
    c.check_eq( m.count(), n == 1 ? 1 : 2 );

    kl::mask f = ~kl::mask( n );
    c.check_eq( f.count(), n );
    c.check( f.all() && ( f & m ) == m && ( f | m ) == f );
    c.check_eq( ( f ^ m ).count() + m.count(), n );
    c.check( ~~m == m );
}

private void at_word_edges( ref kl::test::context c )
{
    edges( ref c, 1 );
    edges( ref c, 64 );
    edges( ref c, 65 );
}

private void shape( ref kl::test::context c )
{
    kl::mask m = kl::mask( 2, 3 );
    c.check_eq( m.rank(), 2 );
    c.check_eq( m.size(), 6 );
    m.assign( 5, true );
    c.check( m.at( 1, 2 ) && !m.at( 1, 1 ) );
    c.check( !( m == kl::mask( 3, 2 ) ) );

    kl::mask s = kl::mask();
    c.check_eq( s.rank(), 0 );
    c.check_eq( s.size(), 1 );

    c.expect_panic( "the shapes differ", fn[]() { _ = kl::mask( 2, 3 ) & kl::mask( 3, 2 ); } );
    c.expect_panic( "index out of range", fn[]() { _ = kl::mask( 2, 3 ).at( 2, 0 ); } );
    c.expect_panic( "index out of range", fn[]() { kl::mask s = kl::mask( 6 ); s.assign( 6, true ); } );
}

private void fixed_masks( ref kl::test::context c )
{
    kl::vec_mask<65> v = kl::vec_mask<65> {};
    v.bits.set( 64 );
    c.check( v.at( 64 ) && v.any() && !v.all() );
    c.check_eq( ( ~v ).count(), 64 );
    c.check( ( v | ~v ).all() && !( v & ~v ).any() );

    kl::mat_mask<2, 3> m = kl::mat_mask<2, 3> {};
    m.bits.set( 4 );
    c.check( m.at( 1, 1 ) && !m.at( 0, 1 ) );
    c.check_eq( m.rows() * m.cols(), m.size() );
    c.check( ( m ^ m ) == kl::mat_mask<2, 3> {} );
    c.expect_panic( "index out of range", fn[ m ]() { _ = m.at( 0, 3 ); } );
}
