// What a test checks through, and how each failed check is reported.

import kl::console;
import kl::optional;
import kl::os;
import kl::string;

// The runtime's calls.
private extern i32 kl_rt_process_capture( const ref u8[] packed, u64 count, i64* pid, i32* output );
private extern never kl_rt_exit( i32 code );
private extern i32 kl_rt_process_wait( i64 pid, i32* status );
private extern i32 kl_rt_file_read( i32 fd, ref u8[] buffer, u64* count );
private extern i32 kl_rt_file_close( i32 fd );

/// What a test checks through. A failed check is counted and reported, and the test goes on; a
/// failed `require` ends it.
class context
{
    /// A context with no failures. `expect_panic` needs one `run` made.
    public context()
    {
        failures_ = 0;
        test_ = 0;
        only_ = 0;
        panics_ = 0;
    }

    /// The context `run` gives the test at `index` in its list. A `call` above 0 makes the
    /// process one `expect_panic` started, which runs only that call's body, counting from 1, and
    /// skips the calls before it. For `run`; a test never needs it.
    public context( u64 index, u64 call )
    {
        failures_ = 0;
        test_ = index + 1;
        only_ = call;
        panics_ = 0;
    }

    /// Whether any check has failed.
    public bool failed() const
    {
        return failures_ != 0;
    }

    /// Counts a failure if `condition` is false, reporting the line that called it.
    @located
    public void check( bool condition )
    {
        if( !condition )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check failed" );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( i64 a, i64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check_eq failed: ", "" );
            kl::eprint( a, "" );
            kl::eprint( " != ", "" );
            kl::eprint( b );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( u64 a, u64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check_eq failed: ", "" );
            kl::eprint( a, "" );
            kl::eprint( " != ", "" );
            kl::eprint( b );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it. A NaN
    /// equals nothing, itself included.
    @located
    public void check_eq( f64 a, f64 b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check_eq failed: ", "" );
            kl::eprint( a, "" );
            kl::eprint( " != ", "" );
            kl::eprint( b );
        }
    }

    /// Counts a failure if `a` and `b` differ, reporting both and the line that called it.
    @located
    public void check_eq( bool a, bool b )
    {
        if( a != b )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check_eq failed: ", "" );
            kl::eprint( a, "" );
            kl::eprint( " != ", "" );
            kl::eprint( b );
        }
    }

    /// Counts a failure if `a` and `b` hold different bytes, reporting both, quoted, and the line
    /// that called it.
    @located
    public void check_eq( const ref textual a, const ref textual b )
    {
        if( !kl::same_text( a, b ) )
        {
            failures_ += 1;
            eprint_location();
            kl::eprint( "check_eq failed: \"", "" );
            kl::eprint( a, "" );
            kl::eprint( "\" != \"", "" );
            kl::eprint( b, "" );
            kl::eprint( "\"\n", "" );
        }
    }

    /// Ends the test if `condition` is false, as a `panic` at the line that called it.
    @located
    public void require( bool condition )
    {
        if( !condition )
        {
            panic( "require failed", @caller() );
        }
    }

    /// Counts a failure unless `body` panics with a message containing `message`, reporting the
    /// line that called it.
    ///
    /// `body` runs in a process of its own: this program started again, running the test from
    /// its start but skipping the bodies of the calls before this one. Nothing `body` changes,
    /// checks on this context included, reaches the test, and a test whose path to this call can
    /// differ from one run to the next, by a clock or a random key, may not reach it there. Only
    /// a `panic` is expected: an `assert` is off in release builds.
    @located
    public void expect_panic<F>( const ref textual message, F body ) where F : fn() -> void
    {
        panics_ += 1;
        if( only_ != 0 )
        {
            // The process is for one call, and an earlier one's own process checks it.
            if( panics_ == only_ )
            {
                body();
                unsafe
                {
                    kl_rt_exit( 0 );
                }
            }
            return;
        }

        if( test_ == 0 )
        {
            panic( "expect_panic needs a context kl::test::run made" );
        }

        kl::string errors = kl::string();
        const i32 code = run_capturing( test_ - 1, panics_, ref errors );

        if( code == 134 && kl::is_some( errors.find( message ) ) )
        {
            return;
        }

        failures_ += 1;
        eprint_location();

        if( code != 134 )
        {
            kl::eprint( "expect_panic failed: no panic (exit ", "" );
            kl::eprint( code, "" );
            kl::eprint( "), wanted \"", "" );
            kl::eprint( message, "" );
            kl::eprint( "\"\n", "" );
        }
        else
        {
            kl::eprint( "expect_panic failed: wanted \"", "" );
            kl::eprint( message, "" );
            kl::eprint( "\", the panic said: ", "" );
            kl::eprint( errors, "" );
        }
    }

    // `file:line: ` of the check's caller, to stderr.
    @located
    private void eprint_location()
    {
        kl::eprint( @caller().file, "" );
        kl::eprint( ":", "" );
        kl::eprint( @caller().line, "" );
        kl::eprint( ": ", "" );
    }

    private u64 failures_;
    private u64 test_; // the test's place in `run`'s list, plus 1; 0 when `run` did not make this
    private u64 only_; // the call this process runs the body of, or 0
    private u64 panics_; // the `expect_panic` calls so far
};

// What `run` reads as a child's first argument.
private const str CHILD = "--kl-test-child";

// Starts this program again for `test`'s `call`th `expect_panic`, its stdout and stderr captured
// onto `errors`; answers its exit code, 134 for a panic.
private i32 run_capturing( u64 test, u64 call, ref kl::string errors )
{
    kl::string packed = kl::string();
    switch( kl::program_path() )
    {
        case result::ok( program ):
            packed.append( program.as_text() );
            break;
        case result::err( e ):
            panic( "cannot find this program to run expect_panic" );
    }
    packed.push( '\0' );
    packed.append( CHILD.as_text() );
    packed.push( '\0' );
    packed.append( kl::string::from( test ).as_text() );
    packed.push( '\0' );
    packed.append( kl::string::from( call ).as_text() );
    packed.push( '\0' );

    i64 pid = 0;
    i32 read_end = -1;
    unsafe
    {
        if( kl_rt_process_capture( packed.as_text(), 4, &pid, &read_end ) != 0 )
        {
            panic( "cannot start this program again for expect_panic" );
        }
    }

    // Read before waiting, or a child that fills the pipe blocks forever.
    unsafe
    {
        u8[*] buffer = alloc<u8>( 4096 );
        while( true )
        {
            u64 count = 0;
            if( kl_rt_file_read( read_end, ref buffer[0..4096], &count ) != 0 || count == 0 )
            {
                break;
            }
            errors.append( buffer[0..count] );
        }
        free( buffer );
        kl_rt_file_close( read_end );
    }

    i32 code = 0;
    unsafe
    {
        if( kl_rt_process_wait( pid, &code ) != 0 )
        {
            panic( "cannot wait for the child" );
        }
    }

    return code;
}
