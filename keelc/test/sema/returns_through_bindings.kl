// §8: a binding is never reseated (D32), so a returned `ref` local, walk binding or payload binding
// lasts as long as what it was bound to. Rooted in a reference parameter it is accepted; rooted in a
// local, or in what a walk makes for itself, it dies with the function. One error per marked line.
import kl::list;
import kl::string;
import kl::optional;

struct P
{
    i32 x;
};

// Accepted.

const ref i32 through_a_ref_local( const ref P a )
{
    const ref i32 p = a.x;
    return p;
}

ref i32 through_a_writable_ref_local( ref P p )
{
    ref i32 x = p.x;
    return x;
}

const ref i32 through_a_list_walk( const ref kl::list<i32> v )
{
    for( const ref i32 x : v )
    {
        return x;
    }
    return v[0];
}

const ref i32 through_an_array_walk( const ref i32[3] a )
{
    for( const ref i32 x : a )
    {
        return x;
    }
    return a[0];
}

const ref kl::string through_a_payload( const ref kl::optional<kl::string> o, const ref kl::string fallback )
{
    switch( o )
    {
        case kl::optional::some( s ):
            return s;
        case kl::optional::none:
            return fallback;
    }
}

// A `ref` local bound to another, and to a call returning a reference.
const ref i32 through_two_ref_locals( const ref P a )
{
    const ref i32 p = a.x;
    const ref i32 q = p;
    return q;
}

const ref i32 through_a_call( const ref kl::list<i32> v )
{
    const ref i32 p = v[0];
    return p;
}

// Refused: the same shapes rooted in a local.

const ref i32 a_ref_local_of_a_local()
{
    P a = P { 1 };
    const ref i32 p = a.x;
    return p; // error: dies
}

const ref i32 a_walk_of_a_local( const ref i32 fallback )
{
    kl::list<i32> v = kl::list<i32>();
    v.push( 1 );
    for( const ref i32 x : v )
    {
        return x; // error: dies
    }
    return fallback;
}

const ref kl::string a_payload_of_a_local( const ref kl::string fallback )
{
    kl::optional<kl::string> o = kl::optional::some( kl::string::from( "a" ) );
    switch( o )
    {
        case kl::optional::some( s ):
            return s; // error: dies
        case kl::optional::none:
            return fallback;
    }
}

// A by-value parameter dies too, and a copied payload is a local of its own.
const ref i32 a_ref_local_of_a_copy( P a )
{
    const ref i32 p = a.x;
    return p; // error: dies
}

const ref i32 a_copied_payload( const ref kl::optional<i32> o, const ref i32 fallback )
{
    switch( o )
    {
        case kl::optional::some( n ):
            return n; // error: a copy
        case kl::optional::none:
            return fallback;
    }
}

// A walk that yields what it makes, not what its receiver holds.
class Counts
{
    i32 a_;

    public Counts( i32 a )
    {
        a_ = a;
    }

    void operator:( const ref i32 item ) const
    {
        yield( a_ );
        yield( a_ + 1 );
    }
};

const ref i32 a_walk_of_a_temporary( const ref Counts c, const ref i32 fallback )
{
    for( const ref i32 x : c )
    {
        return x; // error: the walk's own
    }
    return fallback;
}

// A walk that yields only what its receiver holds is accepted.
class Held
{
    i32 a_;

    public Held( i32 a )
    {
        a_ = a;
    }

    void operator:( const ref i32 item ) const
    {
        yield( a_ );
    }
};

const ref i32 a_walk_of_its_receiver( const ref Held h, const ref i32 fallback )
{
    for( const ref i32 x : h )
    {
        return x;
    }
    return fallback;
}

i32 main()
{
    return 0;
}
