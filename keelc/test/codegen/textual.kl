// `print` takes any `textual`: a literal is borrowed as one through `str`'s vtable, written in the
// prelude's C, and a program's own type through a vtable in the program's.
import t::console;

struct Name implements textual
{
    const u8[*] data;
    u64 size;

    const ref u8[] as_text() const
    {
        unsafe
        {
            return data[ 0..size ];
        }
    }
};

void show( str _ )
{
    t::print( "exact " );
}

void show( const ref textual _ )
{
    t::print( "borrowed " );
}

// One candidate, so the conditional is checked against `textual`: its arms stay `str`s.
void one( const ref textual t )
{
    t::println( t );
}

i32 main()
{
    str  hello = "hello";
    Name name  = Name { hello.data, 3 };
    bool yes   = true;

    t::println( "text" );
    t::println( name );
    t::println( yes );
    t::print( yes ? "a" : "b" );
    t::println( 42 );
    t::eprintln( name );
    show( hello );
    show( name );
    t::println( "" );
    one( yes ? "c" : "d" );
    return 0;
}
