// PLAN D34. A range is two comparisons, and there is no conjunction in KIR to hold them - `&&`
// short-circuits and the lowerer builds that out of blocks. So a range is one more link in the
// chain a stacked label list already builds: `>=` failing leaves the arm exactly as a failed
// equality does, and succeeding falls into a block testing `<`. Nothing downstream learns that
// ranges exist.
i32 bucket( i32 n )
{
    switch( n )
    {
        case 1..5:
            return 1;
        case 20:
            return 2;
        default:
            return 3;
    }
}

// Half-open, so the upper bound is `<` and never `<=` - the one character an off-by-one would be.
i32 grade( f64 x )
{
    switch( x )
    {
        case 0..1:
            return 1;
        default:
            return 2;
    }
}

i32 main()
{
    return 0;
}
