// The runner, which gives each test a process of its own.

import context;
import kl::console;
import kl::list;
import kl::optional;
import kl::string;

// The runtime's calls.
private extern i32 kl_rt_fork( i64* pid );
private extern never kl_rt_exit( i32 code );
private extern i32 kl_rt_process_wait( i64 pid, i32* status );

/// A test and the name `run` reports it by.
struct entry
{
    /// Matched by the runner's filters and printed in its report.
    str name;
    /// The test itself.
    fn( ref context ) -> void body;
};

// Whether `name` contains any filter; with none, every test is selected.
private bool selected( str name, const ref kl::list<kl::string> filters )
{
    if( filters.is_empty() )
    {
        return true;
    }

    kl::string text = kl::string::from( name );
    const ref kl::string[] each = filters.as_run();

    for( u64 i : 0..each.size )
    {
        if( kl::is_some( text.find( each[i] ) ) )
        {
            return true;
        }
    }

    return false;
}

// Runs `t` and answers how it ended: 0 passed, 1 a check failed, 134 a panic, or 128 and a signal.
private i32 run_one( const ref entry t, bool fork )
{
    if( !fork )
    {
        context checks = context();
        t.body( ref checks );
        return checks.failed() ? 1 : 0;
    }

    i64 pid = 0;
    unsafe
    {
        i32 result = kl_rt_fork( &pid );
        if( result != 0 )
        {
            panic( "cannot fork" );
        }
    }

    if( pid == 0 )
    {
        context checks = context();
        t.body( ref checks );
        unsafe
        {
            kl_rt_exit( checks.failed() ? 1 : 0 );
        }
    }

    i32 code = 0;
    unsafe
    {
        i32 result = kl_rt_process_wait( pid, &code );
        if( result != 0 )
        {
            panic( "cannot wait for test" );
        }
    }

    return code;
}

/// Runs the tests that `args` selects, each in a process of its own, and answers `main`'s exit
/// code: 0 when every test passed, 1 when any failed, 2 for an unknown option.
///
/// Each argument is an option or a filter. A test runs when its name contains any filter, or when
/// there is none.
/// - `--list` prints the selected names and runs nothing.
/// - `--no-fork` runs every test in this process, so a `panic` ends the run; for a debugger.
///
/// Each test's result is a line on stdout, `pass <name>` or `FAIL <name>`, then the counts.
i32 run( const ref entry[] tests, const ref str[] args )
{
    bool listing = false;
    bool fork = true;
    kl::list<kl::string> filters = kl::list<kl::string>();

    for( u64 i = 0; i < args.size; i++ )
    {
        kl::string arg = kl::string::from( args[i] );
        if( arg == "--list" )
        {
            listing = true;
        }
        else if( arg == "--no-fork" )
        {
            fork = false;
        }
        else if( arg.starts_with( "--" ) )
        {
            kl::eprintln( "unknown option: " + arg );
            return 2;
        }
        else
        {
            filters.push( move arg );
        }
    }

    if( listing )
    {
        for( u64 i : 0..tests.size )
        {
            if( selected( tests[i].name, filters ) )
            {
                kl::println( tests[i].name );
            }
        }
        return 0;
    }

    u64 n_passed = 0;
    u64 n_failed = 0;
    for( u64 i : 0..tests.size )
    {
        if( !selected( tests[i].name, filters ) )
        {
            continue;
        }

        const ref entry t = tests[i];
        kl::string name = kl::string::from( t.name );
        i32 code = run_one( t, fork );
        if( code == 0 )
        {
            kl::println( "pass " + name );
            n_passed++;
            continue;
        }
        else if( code == 1 )
        {
            kl::println( "FAIL " + name );
        }
        else if( code == 134 )
        {
            kl::println( "FAIL " + name + " (panic)" );
        }
        else if( code >= 128 )
        {
            kl::println( "FAIL " + name + " (signal " + kl::string::from( code - 128 ) + ")" );
        }
        else
        {
            kl::println( "FAIL " + name + " (exit " + kl::string::from( code ) + ")" );
        }
        n_failed++;
    }

    kl::println( kl::string::from( n_passed ) + " passed, " + kl::string::from( n_failed ) + " failed" );
    return n_failed == 0 ? 0 : 1;
}
