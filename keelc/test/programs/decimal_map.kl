// A smoothing filter with decimal taps, read as their fractions and solved at -O3, gives what the same loop
// unmarked gives.

@real_arithmetic
void solved( const ref f64[20] x, ref f64[16] y )
{
    const f64[5] h = [ 0.1, 0.2, 0.4, 0.2, 0.1 ];
    for( u64 k = 0; k < 16; k += 1 )
    {
        f64 s = 0.0;
        for( u64 j = 0; j < 5; j += 1 )
        {
            s += h[j] * x[k + j];
        }
        y[k] = s;
    }
}

void naive( const ref f64[20] x, ref f64[16] y )
{
    const f64[5] h = [ 0.1, 0.2, 0.4, 0.2, 0.1 ];
    for( u64 k = 0; k < 16; k += 1 )
    {
        f64 s = 0.0;
        for( u64 j = 0; j < 5; j += 1 )
        {
            s += h[j] * x[k + j];
        }
        y[k] = s;
    }
}

f64 gap( f64 a, f64 b )
{
    return a > b ? a - b : b - a;
}

i32 main()
{
    f64[20] x = [ 0.0, .. ];
    for( u64 i = 0; i < 20; i += 1 )
    {
        x[i] = cast<f64>( i % 7 ) * 0.5 - 1.0;
    }
    f64[16] a = [ 0.0, .. ];
    f64[16] b = [ 0.0, .. ];
    solved( x, ref a );
    naive( x, ref b );
    for( u64 k = 0; k < 16; k += 1 )
    {
        if( gap( a[k], b[k] ) > 1e-12 )
        {
            return 1;
        }
    }
    return 0;
}
