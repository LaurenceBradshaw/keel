// Every parameter mode reached through a function pointer. `ref`, `const ref` and `out` travel as
// an address and neither a value nor a `move` does, so the five spell four different C parameter
// lists - and `ref` and `out` share a spelling while differing in what the call site writes.

struct P { i32 x; i32 y; };

i32 bump( ref i32 a )
{
    a = a + 1;
    return a;
}

i32 fill( out i32 a )
{
    a = 7;
    return a;
}

i32 total( const ref P p )
{
    return p.x + p.y;
}

i32 twice( i32 a )
{
    return a + a;
}

i32 taken( move i32 a )
{
    return a;
}

i32 main()
{
    fn( ref i32 ) -> i32     b = &bump;
    fn( out i32 ) -> i32     f = &fill;
    fn( const ref P ) -> i32 t = &total;
    fn( i32 ) -> i32         d = &twice;
    fn( move i32 ) -> i32    v = &taken;

    i32 n = 1;

    if( b( ref n ) != 2 )
    {
        return 1;
    }

    if( n != 2 )
    {
        return 2;
    }

    i32 m;

    if( f( out m ) != 7 )
    {
        return 3;
    }

    P p = P { 2, 3 };

    if( t( p ) != 5 )
    {
        return 4;
    }

    if( d( 4 ) != 8 )
    {
        return 5;
    }

    // The fifth: ownership transfers, so it travels by value exactly as a bare scalar does - and
    // still has a typedef of its own, because the call site writes a marker the others do not.
    i32 taken_from = 6;

    if( v( move taken_from ) != 6 )
    {
        return 6;
    }

    return 0;
}
