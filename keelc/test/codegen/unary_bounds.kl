// A bounded `T`'s unary operators at each instance: `-` under `floating`, `~` under `integral`.
// Each check returns its own code.
T negated<T>( T a ) where T : floating
{
    return -a;
}

T flipped<T>( T a ) where T : integral
{
    return ~a;
}

i32 main()
{
    if( negated<f64>( 1.5 ) != -1.5 || negated<f32>( -2.0 ) != cast<f32>( 2.0 ) )
    {
        return 1;
    }
    return flipped<u8>( 0x0f ) == 0xf0 && flipped<i32>( 0 ) == -1 ? 0 : 2;
}
