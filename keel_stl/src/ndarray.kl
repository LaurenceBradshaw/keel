import kl::_core::compare as kernel;
import kl::_core::elementwise as kernel;
import kl::_core::exponential as kernel;
import kl::_core::linear as kernel;
import kl::_core::reduce as kernel;
import algorithm;
import iterable;
import list;
import mask;
import math;
import optional;

/// Numbers of any rank with a shape set at run time, held row-major: the last index moves fastest.
///
/// The operators work element by element, with a scalar on either side. Two arrays broadcast:
/// their shapes line up from the right, and a dimension of 1 or a missing one stretches to the
/// other's, so a `(3, 4)` array plus a `(4)` adds the row to each row. Other shapes panic, as does
/// a compound assignment whose result would not keep the left side's shape. `a[i, j, k]` takes one
/// index per dimension. An array owns its elements,
/// so `copy()` is the way to a second one. `for( T x : a )` walks the elements in that order.
class ndarray<T> implements iterable<T> where T : numeric
{
    list<T>   e_;
    list<u64> shape_;

    /// Stands for one dimension `reshaped` works out from the others.
    public static const u64 inferred = 18446744073709551615;

    /// `elements` row after row, in `shape`, or as one dimension when no shape is given:
    /// `ndarray<f64>( [1.0, 2.0, 3.0, 4.0], 2, 2 )`. Panics when the shape does not hold
    /// exactly as many elements.
    public ndarray( const ref T[] elements, u64... shape )
    {
        e_ = list<T>::of( elements );

        shape_ = list<u64>::with_capacity( shape.size );
        if( shape.size == 0 )
        {
            shape_.push( elements.size );
        }
        for( u64 d : shape )
        {
            shape_.push( d );
        }

        if( count( shape_.as_run() ) != elements.size )
        {
            panic( "the shape does not fit the elements" );
        }
    }

    /// Every element 0, in `shape`: `ndarray<f64>::zeros( 3, 4 )`. No shape is rank 0, one element.
    public static ndarray<T> zeros( u64... shape )
    {
        return ndarray<T>::filled( 0, shape );
    }

    /// Every element `x`, in `shape`.
    public static ndarray<T> filled( T x, u64... shape )
    {
        return ndarray<T>( list<T>::filled( count( shape ), x ), shape );
    }

    /// The rows of a nested literal: `ndarray<f64>::of( [[1.0, 2.0], [3.0, 4.0]] )` is 2 by 2.
    public static ndarray<T> of<u64 R, u64 C>( T[C][R] rows )
    {
        list<T> e = list<T>::with_capacity( R * C );
        for( u64 r : 0..R )
        {
            for( u64 c : 0..C )
            {
                e.push( rows[r][c] );
            }
        }
        return ndarray<T>( move e, [R, C] );
    }

    /// The planes of a nested literal, `P` by `R` by `C`.
    public static ndarray<T> of<u64 P, u64 R, u64 C>( T[C][R][P] planes )
    {
        list<T> e = list<T>::with_capacity( P * R * C );
        for( u64 p : 0..P )
        {
            for( u64 r : 0..R )
            {
                for( u64 c : 0..C )
                {
                    e.push( planes[p][r][c] );
                }
            }
        }
        return ndarray<T>( move e, [P, R, C] );
    }

    /// Every element 1, in `shape`.
    public static ndarray<T> ones( u64... shape )
    {
        return ndarray<T>::filled( 1, shape );
    }

    /// Every element 0, in `a`'s shape.
    public static ndarray<T> zeros_like( const ref ndarray<T> a )
    {
        return ndarray<T>::filled( 0, a.shape_.as_run() );
    }

    /// Every element `x`, in `a`'s shape.
    public static ndarray<T> filled_like( T x, const ref ndarray<T> a )
    {
        return ndarray<T>::filled( x, a.shape_.as_run() );
    }

    /// `from`, `from + step`, ... while short of `to`, as rank 1: `arange( 0, 5 )` is `[0, 1, 2, 3,
    /// 4]`. A negative `step` counts down. Each element is `from + i * step`, so floats do not drift.
    /// Panics when `step` is 0.
    public static ndarray<T> arange( T from, T to, T step = 1 )
    {
        if( step == 0 )
        {
            panic( "the step is 0" );
        }

        list<T> e = list<T>();
        T       x = from;
        while( step > 0 ? x < to : x > to )
        {
            e.push( x );
            x = from + cast<T>( e.size() ) * step;
        }
        u64 n = e.size();
        return ndarray<T>( move e, [n] );
    }

    /// `n` evenly spaced from `a` to `b`, both included, as rank 1. One element is `a`.
    public static ndarray<T> linspace( T a, T b, u64 n ) where T : floating
    {
        list<T> e = list<T>::with_capacity( n );
        for( u64 i : 0..n )
        {
            e.push( i == 0 ? a : i + 1 == n ? b : a + ( b - a ) * cast<T>( i ) / cast<T>( n - 1 ) );
        }
        return ndarray<T>( move e, [n] );
    }

    /// The `n` by `n` identity.
    public static ndarray<T> identity( u64 n )
    {
        return ndarray<T>::eye( n, n );
    }

    /// `rows` by `cols`, 1 on the diagonal and 0 elsewhere.
    public static ndarray<T> eye( u64 rows, u64 cols )
    {
        ndarray<T> r = ndarray<T>::zeros( rows, cols );
        kernel::eye( ref r.e_.as_run(), rows, cols );
        return r;
    }

    /// A second array with the same shape and elements.
    public ndarray<T> copy() const
    {
        return ndarray<T>( list<T>::of( e_.as_run() ), shape_.as_run() );
    }

    /// The same elements in `shape`, which must hold as many. One dimension may be
    /// `ndarray<T>::inferred`, worked out from the others.
    public ndarray<T> reshaped( u64... shape ) const
    {
        list<u64> s     = list<u64>::with_capacity( shape.size );
        u64       known = 1;
        u64       at    = inferred;
        for( u64 k : 0..shape.size )
        {
            s.push( shape[k] );
            if( shape[k] != inferred )
            {
                known *= shape[k];
            }
            else if( at != inferred )
            {
                panic( "only one dimension can be inferred" );
            }
            else
            {
                at = k;
            }
        }
        if( at != inferred )
        {
            if( known == 0 || size() % known != 0 )
            {
                panic( "the shape does not fit the elements" );
            }
            s[at] = size() / known;
        }
        return ndarray<T>( list<T>::of( e_.as_run() ), s.as_run() );
    }

    /// The elements as rank 1.
    public ndarray<T> flattened() const
    {
        return ndarray<T>( list<T>::of( e_.as_run() ), [size()] );
    }

    /// Without its dimensions of length 1.
    public ndarray<T> squeezed() const
    {
        list<u64> s = list<u64>();
        for( u64 d : shape_.as_run() )
        {
            if( d != 1 )
            {
                s.push( d );
            }
        }
        return ndarray<T>( list<T>::of( e_.as_run() ), s.as_run() );
    }

    /// With a dimension of length 1 before `axis`; `rank()` puts it last. Panics on a later axis.
    public ndarray<T> expanded( u64 axis ) const
    {
        if( axis > rank() )
        {
            panic( "axis out of range" );
        }

        list<u64> s = list<u64>::with_capacity( rank() + 1 );
        for( u64 k : 0..rank() )
        {
            if( k == axis )
            {
                s.push( 1 );
            }
            s.push( shape_[k] );
        }
        if( axis == rank() )
        {
            s.push( 1 );
        }
        return ndarray<T>( list<T>::of( e_.as_run() ), s.as_run() );
    }

    /// The elements walked with the axes in the order `axes`: dimension `k` of the result is
    /// dimension `axes[k]` of this one. Panics unless `axes` names each axis once.
    public ndarray<T> permuted( u64... axes ) const
    {
        if( axes.size != rank() )
        {
            panic( "the axis count differs from the rank" );
        }

        list<u64> stride = strides();
        list<u64> s    = list<u64>::with_capacity( rank() );
        list<u64> from = list<u64>::with_capacity( rank() );
        for( u64 k : 0..rank() )
        {
            if( axes[k] >= rank() )
            {
                panic( "axis out of range" );
            }
            for( u64 j : 0..k )
            {
                if( axes[j] == axes[k] )
                {
                    panic( "an axis is named twice" );
                }
            }
            s.push( shape_[axes[k]] );
            from.push( stride[axes[k]] );
        }

        ndarray<T> r = ndarray<T>::zeros( s.as_run() );
        kernel::gather( ref r.e_.as_run(), e_.as_run(), s.as_run(), from.as_run() );
        return r;
    }

    /// With axes `a` and `b` exchanged.
    public ndarray<T> swapped_axes( u64 a, u64 b ) const
    {
        if( a >= rank() || b >= rank() )
        {
            panic( "axis out of range" );
        }

        list<u64> axes = list<u64>::with_capacity( rank() );
        for( u64 k : 0..rank() )
        {
            axes.push( k == a ? b : k == b ? a : k );
        }
        return permuted( axes.as_run() );
    }

    /// This array and `b` joined along `axis`, every other dimension matching.
    public ndarray<T> concatenated( const ref ndarray<T> b, u64 axis ) const
    {
        if( axis >= rank() || b.rank() != rank() )
        {
            panic( axis >= rank() ? "axis out of range" : "the shapes differ" );
        }

        list<u64> s     = list<u64>::with_capacity( rank() );
        u64       lead  = 1;
        u64       inner = 1;
        for( u64 k : 0..rank() )
        {
            if( k != axis && shape_[k] != b.shape_[k] )
            {
                panic( "the shapes differ" );
            }
            s.push( k == axis ? shape_[k] + b.shape_[k] : shape_[k] );
            if( k < axis )
            {
                lead *= shape_[k];
            }
            if( k > axis )
            {
                inner *= shape_[k];
            }
        }

        // Each leading index takes a block from this array, then one from `b`.
        u64     ra = shape_[axis] * inner;
        u64     rb = b.shape_[axis] * inner;
        list<T> e  = list<T>::with_capacity( size() + b.size() );
        for( u64 o : 0..lead )
        {
            for( u64 i : 0..ra )
            {
                e.push( e_[o * ra + i] );
            }
            for( u64 i : 0..rb )
            {
                e.push( b.e_[o * rb + i] );
            }
        }
        return ndarray<T>( move e, s.as_run() );
    }

    /// This array and `b`, of one shape, as the two entries of a new axis before `axis`.
    public ndarray<T> stacked( const ref ndarray<T> b, u64 axis ) const
    {
        same_shape( b );
        return expanded( axis ).concatenated( b.expanded( axis ), axis );
    }

    /// --- Shape and elements ---

    /// The length of each dimension, outermost first.
    public const ref u64[] shape() const
    {
        return shape_.as_run();
    }

    /// The number of dimensions.
    public u64 rank() const
    {
        return shape_.size();
    }

    /// The number of elements, the product of the shape.
    public u64 size() const
    {
        return e_.size();
    }

    /// The element at `at`, one index per dimension. Panics on another count or an index outside
    /// its dimension.
    public ref T operator[]( u64... at ) const
    {
        if( at.size != shape_.size() )
        {
            panic( "the index count differs from the rank" );
        }

        u64 flat = 0;
        for( u64 k : 0..at.size )
        {
            if( at[k] >= shape_[k] )
            {
                panic( "index out of range" );
            }
            flat = flat * shape_[k] + at[k];
        }
        return e_[flat];
    }

    /// The elements row after row, as a run writable where the array is.
    public ref T[] as_run() const
    {
        return e_.as_run();
    }

    /// Each element in row-major order.
    public void operator:( const ref T item ) const
    {
        for( u64 i : 0..e_.size() )
        {
            yield( e_[i] );
        }
    }

    /// Each element in row-major order, writable in place.
    public void operator:( ref T item )
    {
        for( u64 i : 0..e_.size() )
        {
            yield( ref e_[i] );
        }
    }

    /// --- Slices ---

    /// A copy of `region`, one range per dimension: `a.sliced( 1..3, 0..a.shape()[1] )`. Panics on
    /// another count, a backwards range, or one past its dimension.
    public ndarray<T> sliced( range... region ) const
    {
        list<u64>  s = lengths( region );
        ndarray<T> r = ndarray<T>::zeros( s.as_run() );
        if( r.size() != 0 )
        {
            kernel::gather( ref r.e_.as_run(), e_.as_run()[start( region )..size()], s.as_run(), strides().as_run() );
        }
        return r;
    }

    /// Writes `src` into `region`, whose lengths must be `src`'s shape. Panics as `sliced` does,
    /// or when the shapes differ.
    public void assign( const ref ndarray<T> src, range... region )
    {
        list<u64> s = lengths( region );
        if( !kernel::equal( s.as_run(), src.shape_.as_run() ) )
        {
            panic( "the shapes differ" );
        }
        if( src.size() != 0 )
        {
            kernel::scatter( ref e_.as_run()[start( region )..size()], src.e_.as_run(), s.as_run(), strides().as_run() );
        }
    }

    /// Sets every element of `region` to `x`. Panics as `sliced` does.
    public void fill( T x, range... region )
    {
        list<u64> s = lengths( region );
        if( count( s.as_run() ) != 0 )
        {
            kernel::fill_strided( ref e_.as_run()[start( region )..size()], x, s.as_run(), strides().as_run() );
        }
    }

    /// Row `i` of a matrix, as a run writable where the array is. Panics unless the rank is 2, or
    /// when `i` is outside the first dimension.
    public ref T[] row( u64 i ) const
    {
        if( rank() != 2 )
        {
            panic( "the rank is not 2" );
        }
        return block( i );
    }

    /// The elements under the leading indices `at`, as a run writable where the array is:
    /// `a.block( i, j )` of a rank 3 array is its `[i, j, ..]` row. Panics on more indices than
    /// dimensions, or an index outside its dimension.
    public ref T[] block( u64... at ) const
    {
        if( at.size > shape_.size() )
        {
            panic( "the index count exceeds the rank" );
        }

        u64 flat = 0;
        for( u64 k : 0..at.size )
        {
            if( at[k] >= shape_[k] )
            {
                panic( "index out of range" );
            }
            flat = flat * shape_[k] + at[k];
        }
        u64 n = span( at.size, rank() );
        return e_.as_run()[flat * n..flat * n + n];
    }

    /// --- Arithmetic ---

    /// The element-wise sum with `o`.
    public ndarray<T> operator+( const ref ndarray<T> o ) const
    {
        return map( o, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element + `s`.
    public ndarray<T> operator+( T s ) const
    {
        return map( fn[ s ]( T x ) { return x + s; } );
    }

    /// `s` + each element.
    public static ndarray<T> operator+( T s, const ref ndarray<T> a )
    {
        return a.map( fn[ s ]( T x ) { return s + x; } );
    }

    /// The element-wise difference with `o`.
    public ndarray<T> operator-( const ref ndarray<T> o ) const
    {
        return map( o, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element - `s`.
    public ndarray<T> operator-( T s ) const
    {
        return map( fn[ s ]( T x ) { return x - s; } );
    }

    /// `s` - each element.
    public static ndarray<T> operator-( T s, const ref ndarray<T> a )
    {
        return a.map( fn[ s ]( T x ) { return s - x; } );
    }

    /// The element-wise product with `o`.
    public ndarray<T> operator*( const ref ndarray<T> o ) const
    {
        return map( o, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element * `s`.
    public ndarray<T> operator*( T s ) const
    {
        return map( fn[ s ]( T x ) { return x * s; } );
    }

    /// `s` * each element.
    public static ndarray<T> operator*( T s, const ref ndarray<T> a )
    {
        return a.map( fn[ s ]( T x ) { return s * x; } );
    }

    /// The element-wise quotient with `o`.
    public ndarray<T> operator/( const ref ndarray<T> o ) const
    {
        return map( o, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element / `s`.
    public ndarray<T> operator/( T s ) const
    {
        return map( fn[ s ]( T x ) { return x / s; } );
    }

    /// `s` / each element.
    public static ndarray<T> operator/( T s, const ref ndarray<T> a )
    {
        return a.map( fn[ s ]( T x ) { return s / x; } );
    }

    /// Each element += the matching one of `o`.
    public void operator+=( const ref ndarray<T> o )
    {
        combine( o, fn[]( T x, T y ) { return x + y; } );
    }

    /// Each element += `s`.
    public void operator+=( T s )
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x + s; } );
    }

    /// Each element -= the matching one of `o`.
    public void operator-=( const ref ndarray<T> o )
    {
        combine( o, fn[]( T x, T y ) { return x - y; } );
    }

    /// Each element -= `s`.
    public void operator-=( T s )
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x - s; } );
    }

    /// Each element *= the matching one of `o`.
    public void operator*=( const ref ndarray<T> o )
    {
        combine( o, fn[]( T x, T y ) { return x * y; } );
    }

    /// Each element *= `s`.
    public void operator*=( T s )
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x * s; } );
    }

    /// Each element /= the matching one of `o`.
    public void operator/=( const ref ndarray<T> o )
    {
        combine( o, fn[]( T x, T y ) { return x / y; } );
    }

    /// Each element /= `s`.
    public void operator/=( T s )
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x / s; } );
    }

    /// Each element negated.
    public ndarray<T> operator-() const where T : floating
    {
        return map( fn[]( T x ) { return -x; } );
    }

    /// --- Integer operators ---

    /// The element-wise remainder after dividing by `o`.
    public ndarray<T> operator%( const ref ndarray<T> o ) const where T : integral
    {
        return map( o, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element % `s`.
    public ndarray<T> operator%( T s ) const where T : integral
    {
        return map( fn[ s ]( T x ) { return x % s; } );
    }

    /// `s` % each element.
    public static ndarray<T> operator%( T s, const ref ndarray<T> a ) where T : integral
    {
        return a.map( fn[ s ]( T x ) { return s % x; } );
    }

    /// The element-wise bitwise and with `o`.
    public ndarray<T> operator&( const ref ndarray<T> o ) const where T : integral
    {
        return map( o, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element & `s`.
    public ndarray<T> operator&( T s ) const where T : integral
    {
        return map( fn[ s ]( T x ) { return x & s; } );
    }

    /// `s` & each element.
    public static ndarray<T> operator&( T s, const ref ndarray<T> a ) where T : integral
    {
        return a.map( fn[ s ]( T x ) { return s & x; } );
    }

    /// The element-wise bitwise or with `o`.
    public ndarray<T> operator|( const ref ndarray<T> o ) const where T : integral
    {
        return map( o, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element | `s`.
    public ndarray<T> operator|( T s ) const where T : integral
    {
        return map( fn[ s ]( T x ) { return x | s; } );
    }

    /// `s` | each element.
    public static ndarray<T> operator|( T s, const ref ndarray<T> a ) where T : integral
    {
        return a.map( fn[ s ]( T x ) { return s | x; } );
    }

    /// The element-wise bitwise exclusive or with `o`.
    public ndarray<T> operator^( const ref ndarray<T> o ) const where T : integral
    {
        return map( o, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^ `s`.
    public ndarray<T> operator^( T s ) const where T : integral
    {
        return map( fn[ s ]( T x ) { return x ^ s; } );
    }

    /// `s` ^ each element.
    public static ndarray<T> operator^( T s, const ref ndarray<T> a ) where T : integral
    {
        return a.map( fn[ s ]( T x ) { return s ^ x; } );
    }

    /// Each element %= the matching one of `o`.
    public void operator%=( const ref ndarray<T> o ) where T : integral
    {
        combine( o, fn[]( T x, T y ) { return x % y; } );
    }

    /// Each element %= `s`.
    public void operator%=( T s ) where T : integral
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x % s; } );
    }

    /// Each element &= the matching one of `o`.
    public void operator&=( const ref ndarray<T> o ) where T : integral
    {
        combine( o, fn[]( T x, T y ) { return x & y; } );
    }

    /// Each element &= `s`.
    public void operator&=( T s ) where T : integral
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x & s; } );
    }

    /// Each element |= the matching one of `o`.
    public void operator|=( const ref ndarray<T> o ) where T : integral
    {
        combine( o, fn[]( T x, T y ) { return x | y; } );
    }

    /// Each element |= `s`.
    public void operator|=( T s ) where T : integral
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x | s; } );
    }

    /// Each element ^= the matching one of `o`.
    public void operator^=( const ref ndarray<T> o ) where T : integral
    {
        combine( o, fn[]( T x, T y ) { return x ^ y; } );
    }

    /// Each element ^= `s`.
    public void operator^=( T s ) where T : integral
    {
        kernel::map_into( ref e_.as_run(), fn[ s ]( T x ) { return x ^ s; } );
    }

    /// Each element with its bits flipped.
    public ndarray<T> operator~() const where T : integral
    {
        return map( fn[]( T x ) { return ~x; } );
    }

    /// --- Element-wise functions ---

    /// Each element without its sign, as `kl::abs`.
    public ndarray<T> abs() const
    {
        return map( fn[]( T x ) { return kl::abs( x ); } );
    }

    /// Each element's sign, as `kl::sign`: -1, 0 or 1.
    public ndarray<T> sign() const
    {
        return map( fn[]( T x ) { return kl::sign( x ); } );
    }

    /// Each element held between `lo` and `hi`; `hi` wins when they cross.
    public ndarray<T> clip( T lo, T hi ) const
    {
        return map( fn[ lo, hi ]( T x ) { return kl::min( kl::max( x, lo ), hi ); } );
    }

    /// `f` of each element, in the same shape, `U` being what `f` returns:
    /// `a.map( fn[]( f64 x ) { return x * x; } )`.
    public ndarray<U> map<U, F>( F f ) const where F : fn( T ) -> U, where U : numeric
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), f ), shape_.as_run() );
    }

    /// `f` of each element and the matching one of `o`, the two broadcast as the operators do:
    /// `a.map( b, fn[]( f64 x, f64 y ) { return kl::max( x, y ); } )`.
    public ndarray<T> map<F>( const ref ndarray<T> o, F f ) const where F : fn( T, T ) -> T
    {
        if( kernel::equal( shape_.as_run(), o.shape_.as_run() ) )
        {
            return ndarray<T>( list<T>::zipped( e_.as_run(), o.e_.as_run(), f ), shape_.as_run() );
        }

        // Lined up from the right, a dimension of 1 or a missing one stretches.
        u64       n = rank() > o.rank() ? rank() : o.rank();
        list<u64> s = list<u64>::with_capacity( n );
        for( u64 k : 0..n )
        {
            u64 a = k + rank() < n ? 1 : shape_[k + rank() - n];
            u64 b = k + o.rank() < n ? 1 : o.shape_[k + o.rank() - n];
            if( a != b && a != 1 && b != 1 )
            {
                panic( "the shapes do not broadcast" );
            }
            s.push( a == 1 ? b : a );
        }

        ndarray<T> r = ndarray<T>::zeros( s.as_run() );
        kernel::zip_strided( ref r.e_.as_run(), e_.as_run(), strides_to( s.as_run() ).as_run(), o.e_.as_run(), o.strides_to( s.as_run() ).as_run(), s.as_run(), f );
        return r;
    }

    /// --- Products ---

    /// The inner product with `o`, both of rank 1 and one length.
    public T dot( const ref ndarray<T> o ) const
    {
        if( rank() != 1 )
        {
            panic( "dot takes arrays of rank 1" );
        }

        same_shape( o );
        return kernel::dot( e_.as_run(), o.e_.as_run() );
    }

    /// The matrix product with `b`, each of rank 1 or 2. A rank 1 array is a row on the left and a
    /// column on the right, and that dimension is dropped from the result, so two of them give rank
    /// 0. Ranks above 2 panic.
    public ndarray<T> matmul( const ref ndarray<T> b ) const
    {
        if( rank() == 0 || rank() > 2 || b.rank() == 0 || b.rank() > 2 )
        {
            panic( "matmul takes arrays of rank 1 or 2" );
        }

        u64 rows  = rank() == 2 ? shape_[0] : 1;
        u64 inner = shape_[rank() - 1];
        u64 cols  = b.rank() == 2 ? b.shape_[1] : 1;
        if( b.shape_[0] != inner )
        {
            panic( "the shapes differ" );
        }

        ndarray<T> r = ndarray<T>::zeros( rows * cols );
        r.shape_.clear();
        if( rank() == 2 )
        {
            r.shape_.push( rows );
        }
        if( b.rank() == 2 )
        {
            r.shape_.push( cols );
        }
        kernel::matmul( ref r.e_.as_run(), e_.as_run(), b.e_.as_run(), rows, inner, cols );
        return r;
    }

    /// The axes reversed: a matrix's rows as columns. Rank 0 and 1 come back unchanged.
    public ndarray<T> transposed() const
    {
        if( rank() != 2 )
        {
            list<u64> axes = list<u64>::with_capacity( rank() );
            for( u64 k : 0..rank() )
            {
                axes.push( rank() - 1 - k );
            }
            return permuted( axes.as_run() );
        }

        ndarray<T> r = ndarray<T>::zeros( shape_[1], shape_[0] );
        kernel::transpose( ref r.e_.as_run(), e_.as_run(), shape_[0], shape_[1] );
        return r;
    }

    /// The diagonal of a rank 2 array, as rank 1.
    public ndarray<T> diagonal() const
    {
        if( rank() != 2 )
        {
            panic( "diagonal takes an array of rank 2" );
        }

        u64     n = shape_[0] < shape_[1] ? shape_[0] : shape_[1];
        list<T> e = list<T>::with_capacity( n );
        for( u64 i : 0..n )
        {
            e.push( e_[i * shape_[1] + i] );
        }
        return ndarray<T>( move e, [n] );
    }

    /// The sum of the diagonal of a rank 2 array.
    public T trace() const
    {
        return diagonal().sum();
    }

    /// Each element times each of `b`, both read flat: an `a.size()` by `b.size()` array.
    public ndarray<T> outer( const ref ndarray<T> b ) const
    {
        ndarray<T> r = ndarray<T>::zeros( size(), b.size() );
        kernel::outer( ref r.e_.as_run(), e_.as_run(), b.e_.as_run() );
        return r;
    }

    /// The square root of the sum of squares: the length at rank 1, the Frobenius norm at rank 2.
    /// It overflows only when the norm does.
    public T norm() const where T : floating
    {
        return cast<T>( kernel::norm( e_.as_run() ) );
    }

    /// This array over its `norm()`; every element NaN when that is 0.
    public ndarray<T> normalised() const where T : floating
    {
        T n = norm();
        return map( fn[ n ]( T x ) { return x / n; } );
    }

    /// --- Comparing ---

    /// Whether `o` has this shape and every element equals the matching one.
    public bool operator==( const ref ndarray<T> o ) const
    {
        return kernel::equal( shape_.as_run(), o.shape_.as_run() ) && kernel::equal( e_.as_run(), o.e_.as_run() );
    }

    /// Whether `o` has this shape and every `|a - b| <= atol + rtol * |b|`, `b` being `o`'s
    /// element. A NaN is close to nothing, and an infinity only to itself.
    public bool approx_equal( const ref ndarray<T> o, T rtol = 1e-5, T atol = 1e-8 ) const where T : floating
    {
        return kernel::equal( shape_.as_run(), o.shape_.as_run() ) && kernel::approx_equal( e_.as_run(), o.e_.as_run(), rtol, atol );
    }

    /// Where each element is less than the matching one of `o`. Panics when the shapes differ.
    public mask less( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x < y; } );
    }

    /// Where each element is less than `s`.
    public mask less( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x < s; } );
    }

    /// Where each element is greater than the matching one of `o`. Panics when the shapes differ.
    public mask greater( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x > y; } );
    }

    /// Where each element is greater than `s`.
    public mask greater( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x > s; } );
    }

    /// Where each element is at most the matching one of `o`. Panics when the shapes differ.
    public mask less_equal( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x <= y; } );
    }

    /// Where each element is at most `s`.
    public mask less_equal( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x <= s; } );
    }

    /// Where each element is at least the matching one of `o`. Panics when the shapes differ.
    public mask greater_equal( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x >= y; } );
    }

    /// Where each element is at least `s`.
    public mask greater_equal( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x >= s; } );
    }

    /// Where each element is equal to the matching one of `o`. Panics when the shapes differ.
    public mask equal_each( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x == y; } );
    }

    /// Where each element is equal to `s`.
    public mask equal_each( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x == s; } );
    }

    /// Where each element is not equal to the matching one of `o`. Panics when the shapes differ.
    public mask differs( const ref ndarray<T> o ) const
    {
        return compared( o, fn[]( T x, T y ) { return x != y; } );
    }

    /// Where each element is not equal to `s`.
    public mask differs( T s ) const
    {
        return marked( fn[ s ]( T x ) { return x != s; } );
    }

    /// The elements `m` sets, row-major, as rank 1. Panics when the shapes differ.
    public ndarray<T> selected( const ref mask m ) const
    {
        if( !kernel::equal( shape_.as_run(), m.shape() ) )
        {
            panic( "the shapes differ" );
        }

        list<T> e = list<T>::with_capacity( m.count() );
        for( u64 i : 0..e_.size() )
        {
            if( m.test( i ) )
            {
                e.push( e_[i] );
            }
        }
        u64 n = e.size();
        return ndarray<T>( move e, [ n ] );
    }

    /// --- Sorting and searching ---
    ///
    /// These take rank 1 and panic on any other. A NaN orders after every number.

    /// The elements from least to greatest.
    public ndarray<T> sorted() const
    {
        needs_rank_one( "sorted takes an array of rank 1" );
        ndarray<T> r = copy();
        kl::sort( ref r.e_, fn[]( x, y ) { return kernel::before( x, y ); } );
        return r;
    }

    /// The indices that would sort the elements, equal ones in index order.
    public ndarray<u64> argsort() const
    {
        needs_rank_one( "argsort takes an array of rank 1" );
        list<u64> r = list<u64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            r.push( i );
        }
        kl::sort( ref r, fn[ this ]( i, j ) { return kernel::before( e_[i], e_[j] ) || ( !kernel::before( e_[j], e_[i] ) && i < j ); } );
        u64 n = r.size();
        return ndarray<u64>( move r, [ n ] );
    }

    /// One of each distinct element, from least to greatest; the NaNs count as one.
    public ndarray<T> unique() const
    {
        needs_rank_one( "unique takes an array of rank 1" );
        list<T> e = list<T>::of( e_.as_run() );
        kl::sort( ref e, fn[]( x, y ) { return kernel::before( x, y ); } );

        list<T> r = list<T>::with_capacity( e.size() );
        for( T x : e.as_run() )
        {
            T last = r.size() == 0 ? x : r[r.size() - 1];
            if( r.size() == 0 || !( x == last || ( x != x && last != last ) ) )
            {
                r.push( x );
            }
        }
        u64 n = r.size();
        return ndarray<T>( move r, [ n ] );
    }

    /// The indices of the elements that are not 0, in order; a NaN is not 0.
    public ndarray<u64> nonzero() const
    {
        needs_rank_one( "nonzero takes an array of rank 1" );
        list<u64> r = list<u64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            if( e_[i] != 0 )
            {
                r.push( i );
            }
        }
        u64 n = r.size();
        return ndarray<u64>( move r, [ n ] );
    }

    /// --- Reducing ---

    /// The total of every element, added in index order; 0 when there are none.
    public T sum() const
    {
        return kernel::sum( e_.as_run() );
    }

    /// The totals along `axis`, dropped from the shape: a 2 by 3 array's `sum( 0 )` has 3 elements.
    public ndarray<T> sum( u64 axis ) const
    {
        if( length( axis ) == 0 )
        {
            return ndarray<T>::zeros( without( axis ).as_run() );
        }
        return folded( axis, fn[]( T x, T y ) { return x + y; } );
    }

    /// The product of every element, in index order; 1 when there are none.
    public T prod() const
    {
        return kernel::prod( e_.as_run() );
    }

    /// The products along `axis`, dropped from the shape.
    public ndarray<T> prod( u64 axis ) const
    {
        if( length( axis ) == 0 )
        {
            return ndarray<T>::ones( without( axis ).as_run() );
        }
        return folded( axis, fn[]( T x, T y ) { return x * y; } );
    }

    /// The smallest element, as `kl::min`. Panics when there are none.
    public T min() const
    {
        return kernel::fold( e_.as_run(), fn[]( T x, T y ) { return kl::min( x, y ); } );
    }

    /// The smallest along `axis`, dropped from the shape. Panics when the axis is empty.
    public ndarray<T> min( u64 axis ) const
    {
        return folded( axis, fn[]( T x, T y ) { return kl::min( x, y ); } );
    }

    /// The largest element, as `kl::max`. Panics when there are none.
    public T max() const
    {
        return kernel::fold( e_.as_run(), fn[]( T x, T y ) { return kl::max( x, y ); } );
    }

    /// The largest along `axis`, dropped from the shape. Panics when the axis is empty.
    public ndarray<T> max( u64 axis ) const
    {
        return folded( axis, fn[]( T x, T y ) { return kl::max( x, y ); } );
    }

    /// The row-major index of the first smallest element, or of the first NaN. Panics when there
    /// are none.
    public u64 argmin() const
    {
        return kernel::arg_best( e_.as_run(), fn[]( T x, T m ) { return m == m && ( x < m || x != x ); } );
    }

    /// The index along `axis` of each first smallest, or first NaN, `axis` dropped from the shape.
    /// Panics when the axis is empty.
    public ndarray<u64> argmin( u64 axis ) const
    {
        return arg_best( axis, fn[]( T x, T m ) { return m == m && ( x < m || x != x ); } );
    }

    /// The row-major index of the first largest element, or of the first NaN. Panics when there
    /// are none.
    public u64 argmax() const
    {
        return kernel::arg_best( e_.as_run(), fn[]( T x, T m ) { return m == m && ( x > m || x != x ); } );
    }

    /// The index along `axis` of each first largest, or first NaN, `axis` dropped from the shape.
    /// Panics when the axis is empty.
    public ndarray<u64> argmax( u64 axis ) const
    {
        return arg_best( axis, fn[]( T x, T m ) { return m == m && ( x > m || x != x ); } );
    }

    /// The running totals of the elements, as rank 1.
    public ndarray<T> cumsum() const
    {
        return flattened().cumsum( 0 );
    }

    /// The running totals along `axis`, in the same shape.
    public ndarray<T> cumsum( u64 axis ) const
    {
        return scanned( axis, fn[]( T x, T y ) { return x + y; } );
    }

    /// The running products of the elements, as rank 1.
    public ndarray<T> cumprod() const
    {
        return flattened().cumprod( 0 );
    }

    /// The running products along `axis`, in the same shape.
    public ndarray<T> cumprod( u64 axis ) const
    {
        return scanned( axis, fn[]( T x, T y ) { return x * y; } );
    }

    /// The mean of the elements; a NaN when there are none.
    public T mean() const where T : floating
    {
        return sum() / cast<T>( size() );
    }

    /// The means along `axis`, dropped from the shape.
    public ndarray<T> mean( u64 axis ) const where T : floating
    {
        ndarray<T> r = sum( axis );
        r /= cast<T>( shape_[axis] );
        return r;
    }

    /// The mean square distance of the elements from their mean; a NaN when there are none.
    public T var() const where T : floating
    {
        return kernel::variance( e_.as_run() );
    }

    /// The variances along `axis`, dropped from the shape.
    public ndarray<T> var( u64 axis ) const where T : floating
    {
        ndarray<T> r = ndarray<T>::zeros( without( axis ).as_run() );
        kernel::variance_axis( ref r.e_.as_run(), e_.as_run(), span( 0, axis ), shape_[axis], span( axis + 1, rank() ) );
        return r;
    }

    /// The standard deviation, the square root of `var()`.
    public T std() const where T : floating
    {
        return cast<T>( kl::sqrt( cast<f64>( var() ) ) );
    }

    /// The standard deviations along `axis`, dropped from the shape.
    public ndarray<T> std( u64 axis ) const where T : floating
    {
        ndarray<T> r = var( axis );
        kernel::map_into( ref r.e_.as_run(), fn[]( T x ) { return cast<T>( kl::sqrt( cast<f64>( x ) ) ); } );
        return r;
    }

    /// --- Converting ---

    /// Each element converted by `cast`, which panics on a value `U` cannot hold. A float to an
    /// integer needs a rounding: `truncated`, `rounded`, `floored` or `ceiled`.
    public ndarray<U> to<U>() const where T : converts_to<U>, where U : numeric
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), fn[]( T x ) { return cast<U>( x ); } ), shape_.as_run() );
    }

    /// Each element toward zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public ndarray<U> truncated<U>() const where T : floating, where U : integral
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), fn[]( T x ) { return kl::truncated<U>( cast<f64>( x ) ); } ), shape_.as_run() );
    }

    /// Each element to the nearest, a half away from zero, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public ndarray<U> rounded<U>() const where T : floating, where U : integral
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), fn[]( T x ) { return kl::rounded<U>( cast<f64>( x ) ); } ), shape_.as_run() );
    }

    /// Each element down, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public ndarray<U> floored<U>() const where T : floating, where U : integral
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), fn[]( T x ) { return kl::floored<U>( cast<f64>( x ) ); } ), shape_.as_run() );
    }

    /// Each element up, as a `U`. Panics on an infinity, a NaN, or a value `U` cannot hold.
    public ndarray<U> ceiled<U>() const where T : floating, where U : integral
    {
        return ndarray<U>( list<U>::mapped( e_.as_run(), fn[]( T x ) { return kl::ceiled<U>( cast<f64>( x ) ); } ), shape_.as_run() );
    }

    /// --- Internals ---

    // Panics when `shape` does not hold as many elements as `elements`.
    private ndarray( move list<T> elements, const ref u64[] shape )
    {
        e_     = move elements;
        shape_ = list<u64>::with_capacity( shape.size );
        for( u64 d : shape )
        {
            shape_.push( d );
        }

        if( count( shape ) != e_.size() )
        {
            panic( "the shape does not fit the elements" );
        }
    }

    private void needs_rank_one( str message ) const
    {
        if( rank() != 1 )
        {
            panic( message );
        }
    }

    // The length of `axis`. Panics when there is no such axis.
    private u64 length( u64 axis ) const
    {
        if( axis >= rank() )
        {
            panic( "axis out of range" );
        }
        return shape_[axis];
    }

    // The shape without `axis`.
    private list<u64> without( u64 axis ) const
    {
        _ = length( axis );
        list<u64> s = list<u64>::with_capacity( rank() - 1 );
        for( u64 k : 0..rank() )
        {
            if( k != axis )
            {
                s.push( shape_[k] );
            }
        }
        return s;
    }

    // The number of elements in dimensions `from` up to `to`.
    private u64 span( u64 from, u64 to ) const
    {
        return count( shape_.as_run()[from..to] );
    }

    private ndarray<T> folded<F>( u64 axis, F op ) const where F : fn( T, T ) -> T
    {
        ndarray<T> r = ndarray<T>::zeros( without( axis ).as_run() );
        kernel::fold_axis( ref r.e_.as_run(), e_.as_run(), span( 0, axis ), shape_[axis], span( axis + 1, rank() ), op );
        return r;
    }

    private ndarray<u64> arg_best<F>( u64 axis, F better ) const where F : fn( T, T ) -> bool
    {
        ndarray<u64> r = ndarray<u64>::zeros( without( axis ).as_run() );
        kernel::arg_best_axis( ref r.as_run(), e_.as_run(), span( 0, axis ), shape_[axis], span( axis + 1, rank() ), better );
        return r;
    }

    private ndarray<T> scanned<F>( u64 axis, F op ) const where F : fn( T, T ) -> T
    {
        u64        n = length( axis );
        ndarray<T> r = copy();
        kernel::scan_axis( ref r.e_.as_run(), span( 0, axis ), n, span( axis + 1, rank() ), op );
        return r;
    }

    // The step between neighbours along each dimension.
    private list<u64> strides() const
    {
        list<u64> r    = list<u64>::with_capacity( rank() );
        u64       step = 1;
        for( u64 k : 0..rank() )
        {
            r.push( 0 );
        }
        for( u64 k : 0..rank() )
        {
            r[rank() - 1 - k] = step;
            step *= shape_[rank() - 1 - k];
        }
        return r;
    }

    // The lengths of `region`. Panics on another count, a backwards range, or one past its dimension.
    private list<u64> lengths( const ref range[] region ) const
    {
        if( region.size != shape_.size() )
        {
            panic( "the range count differs from the rank" );
        }

        list<u64> s = list<u64>::with_capacity( region.size );
        for( u64 k : 0..region.size )
        {
            if( region[k].from > region[k].to )
            {
                panic( "the range is backwards" );
            }
            if( region[k].to > shape_[k] )
            {
                panic( "the range is past its dimension" );
            }
            s.push( region[k].to - region[k].from );
        }
        return s;
    }

    // Where `region`'s first element is, counted row-major.
    private u64 start( const ref range[] region ) const
    {
        u64 flat = 0;
        for( u64 k : 0..region.size )
        {
            flat = flat * shape_[k] + region[k].from;
        }
        return flat;
    }

    private mask compared<F>( const ref ndarray<T> o, F p ) const where F : fn( T, T ) -> bool
    {
        same_shape( o );
        mask r = mask( shape_.as_run() );
        for( u64 i : 0..e_.size() )
        {
            r.assign( i, p( e_[i], o.e_[i] ) );
        }
        return r;
    }

    private mask marked<F>( F p ) const where F : fn( T ) -> bool
    {
        mask r = mask( shape_.as_run() );
        for( u64 i : 0..e_.size() )
        {
            r.assign( i, p( e_[i] ) );
        }
        return r;
    }

    // `op` over each element and `o`'s, `o` stretched to this shape. Panics unless it stretches.
    private void combine<F>( const ref ndarray<T> o, F op ) where F : fn( T, T ) -> T
    {
        if( kernel::equal( shape_.as_run(), o.shape_.as_run() ) )
        {
            kernel::zip_into( ref e_.as_run(), o.e_.as_run(), op );
            return;
        }
        kernel::zip_strided_into( ref e_.as_run(), o.e_.as_run(), shape_.as_run(), o.strides_to( shape_.as_run() ).as_run(), op );
    }

    // This array's strides when read in `shape`, 0 along each stretched dimension. Panics unless
    // this shape stretches to `shape`.
    private list<u64> strides_to( const ref u64[] shape ) const
    {
        if( rank() > shape.size )
        {
            panic( "the shapes do not broadcast" );
        }

        list<u64> own = strides();
        list<u64> r   = list<u64>::with_capacity( shape.size );
        u64       pad = shape.size - rank();
        for( u64 k : 0..shape.size )
        {
            if( k < pad || shape_[k - pad] == 1 )
            {
                r.push( 0 );
            }
            else if( shape_[k - pad] == shape[k] )
            {
                r.push( own[k - pad] );
            }
            else
            {
                panic( "the shapes do not broadcast" );
            }
        }
        return r;
    }

    private void same_shape( const ref ndarray<T> o ) const
    {
        if( !kernel::equal( shape_.as_run(), o.shape_.as_run() ) )
        {
            panic( "the shapes differ" );
        }
    }
};

/// The cross product `a` x `b`, each of rank 1 and size 3: `kl::cross( a, b )`.
ndarray<T> cross<T>( const ref ndarray<T> a, const ref ndarray<T> b ) where T : numeric
{
    if( a.rank() != 1 || b.rank() != 1 )
    {
        panic( "cross takes vectors of size 3" );
    }

    ndarray<T> r = ndarray<T>::zeros( 3 );
    kernel::cross( ref r.as_run(), a.as_run(), b.as_run() );
    return r;
}

/// The determinant of a square rank 2 array, through LU with partial pivoting:
/// `kl::determinant( a )`. 0 when a pivot is exactly zero.
T determinant<T>( const ref ndarray<T> a ) where T : floating
{
    u64          n    = square( a );
    ndarray<T>   f    = a.copy();
    ndarray<u64> perm = ndarray<u64>::zeros( n );
    T            sign = kernel::lu( ref f.as_run(), ref perm.as_run(), n );
    return kernel::lu_determinant( f.as_run(), n, sign );
}

/// The inverse of a square rank 2 array, `none` when a pivot is exactly zero:
/// `kl::inverse( a )`. A nearly singular array gives large elements.
optional<ndarray<T>> inverse<T>( const ref ndarray<T> a ) where T : floating
{
    return solve( a, ndarray<T>::identity( square( a ) ) );
}

/// The `x` with `a.matmul( x ) == b`, for a square rank 2 `a` and a `b` of rank 1 or 2 whose first
/// dimension is `a`'s, `none` when a pivot of `a` is exactly zero: `kl::solve( a, b )`.
optional<ndarray<T>> solve<T>( const ref ndarray<T> a, const ref ndarray<T> b ) where T : floating
{
    u64 n = square( a );
    if( b.rank() < 1 || b.rank() > 2 || b.shape()[0] != n )
    {
        panic( "the shapes differ" );
    }

    ndarray<T>   f    = a.copy();
    ndarray<u64> perm = ndarray<u64>::zeros( n );
    if( kernel::lu( ref f.as_run(), ref perm.as_run(), n ) == 0 )
    {
        return optional::none;
    }

    u64        k = b.size() / n;
    ndarray<T> r = ndarray<T>::zeros( b.shape() );
    kernel::lu_solve( ref r.as_run(), f.as_run(), perm.as_run(), b.as_run(), n, k );
    return optional::some( move r );
}

// The size of square rank 2 `a`. Panics on any other.
private u64 square<T>( const ref ndarray<T> a ) where T : numeric
{
    if( a.rank() != 2 || a.shape()[0] != a.shape()[1] )
    {
        panic( "the matrix is not square" );
    }
    return a.shape()[0];
}

/// The square matrix with `v`, of rank 1, on its diagonal: `kl::diag( v )`.
ndarray<T> diag<T>( const ref ndarray<T> v ) where T : numeric
{
    if( v.rank() != 1 )
    {
        panic( "diag takes an array of rank 1" );
    }

    u64        n = v.size();
    ndarray<T> r = ndarray<T>::zeros( n, n );
    for( u64 i : 0..n )
    {
        r[i, i] = v[i];
    }
    return r;
}

/// The smaller of each pair of matching elements, as `kl::min`: `kl::minimum( a, b )`.
ndarray<T> minimum<T>( const ref ndarray<T> a, const ref ndarray<T> b ) where T : numeric
{
    if( !kernel::equal( a.shape(), b.shape() ) )
    {
        panic( "the shapes differ" );
    }

    return a.map( b, fn[]( T x, T y ) { return kl::min( x, y ); } );
}

/// The larger of each pair of matching elements, as `kl::max`: `kl::maximum( a, b )`.
ndarray<T> maximum<T>( const ref ndarray<T> a, const ref ndarray<T> b ) where T : numeric
{
    if( !kernel::equal( a.shape(), b.shape() ) )
    {
        panic( "the shapes differ" );
    }

    return a.map( b, fn[]( T x, T y ) { return kl::max( x, y ); } );
}

/// `a`'s element where `m` is set, and `b`'s where it is clear. Panics when the shapes differ.
ndarray<T> select<T>( const ref mask m, const ref ndarray<T> a, const ref ndarray<T> b ) where T : numeric
{
    if( !kernel::equal( m.shape(), a.shape() ) || !kernel::equal( m.shape(), b.shape() ) )
    {
        panic( "the shapes differ" );
    }

    ndarray<T> r = b.copy();
    for( u64 i : 0..r.size() )
    {
        if( m.test( i ) )
        {
            r.as_run()[i] = a.as_run()[i];
        }
    }
    return r;
}

/// Where each element is a NaN, as `kl::is_nan`.
mask is_nan<T>( const ref ndarray<T> a ) where T : floating
{
    mask r = mask( a.shape() );
    for( u64 i : 0..a.size() )
    {
        r.assign( i, kl::is_nan( cast<f64>( a.as_run()[i] ) ) );
    }
    return r;
}

/// Where each element is an infinity, as `kl::is_inf`.
mask is_inf<T>( const ref ndarray<T> a ) where T : floating
{
    mask r = mask( a.shape() );
    for( u64 i : 0..a.size() )
    {
        r.assign( i, kl::is_inf( cast<f64>( a.as_run()[i] ) ) );
    }
    return r;
}

// The scalar maths of `kl::math` over each element, for float elements: `kl::exp( a )`.

/// `kl::sqrt` of each element.
ndarray<T> sqrt<T>( const ref ndarray<T> a ) where T : floating
{
    return a.map( fn[]( T x ) { return kernel::narrowed<T>( kl::sqrt( cast<f64>( x ) ) ); } );
}

