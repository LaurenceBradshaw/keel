// `kl::console`'s writers, for the compiler's goldens: they print without depending on the library,
// whose C would otherwise be in every expectation.

private extern void kl_rt_write( i32 stream, const u8[*] data, u64 size );
private extern void kl_rt_write_i64( i32 stream, i64 value );
private extern void kl_rt_write_u64( i32 stream, u64 value );
private extern void kl_rt_write_f64( i32 stream, f64 value );

private void write_text( i32 stream, const ref textual text )
{
    const ref u8[] r = text.as_text();
    unsafe
    {
        kl_rt_write( stream, r.data, r.size );
    }
}

/// Writes text to standard output, then `end`.
///
/// `end` is a newline unless given: `print( "> ", "" )` writes a prompt.
void print( const ref textual text, const ref textual end = "\n" )
{
    write_text( 1, text );
    write_text( 1, end );
}

/// Writes an integer in decimal, then `end`.
void print( i64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_i64( 1, value );
    }
    write_text( 1, end );
}

/// Writes an integer in decimal, then `end`.
void print( u64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_u64( 1, value );
    }
    write_text( 1, end );
}

/// Writes a float in the fewest digits that read back as the same value, then `end`.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void print( f64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_f64( 1, value );
    }
    write_text( 1, end );
}

/// Writes `true` or `false`, then `end`.
void print( bool value, const ref textual end = "\n" )
{
    print( value ? "true" : "false", end );
}

/// Writes text to standard error, then `end`.
///
/// Standard output is flushed first, so what both show stays in order.
void eprint( const ref textual text, const ref textual end = "\n" )
{
    write_text( 2, text );
    write_text( 2, end );
}

/// Writes an integer in decimal, then `end`.
void eprint( i64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_i64( 2, value );
    }
    write_text( 2, end );
}

/// Writes an integer in decimal, then `end`.
void eprint( u64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_u64( 2, value );
    }
    write_text( 2, end );
}

/// Writes a float in the fewest digits that read back as the same value, then `end`.
///
/// A whole number gains `.0`, and a NaN is written `nan`.
void eprint( f64 value, const ref textual end = "\n" )
{
    unsafe
    {
        kl_rt_write_f64( 2, value );
    }
    write_text( 2, end );
}

/// Writes `true` or `false`, then `end`.
void eprint( bool value, const ref textual end = "\n" )
{
    eprint( value ? "true" : "false", end );
}
