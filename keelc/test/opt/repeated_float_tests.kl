// The same float test twice: on a known argument both tests fold, so `main` returns 0.

i32 classify( f64 x )
{
    i32 n = 0;
    if( x < 3.0 )
    {
        n += 1;
    }
    if( x < 3.0 )
    {
        n += 2;
    }
    return n;
}

i32 main()
{
    if( classify( 1.0 ) != 3 || classify( 4.0 ) != 0 )
    {
        return 1;
    }
    return 0;
}
