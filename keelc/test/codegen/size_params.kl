// A size parameter: `N` is an array's extent and a `u64` value in the body, and each size given is
// its own instance.
import t::console;

const u64 Four = 4;

u64 total<u64 N>( const ref i32[N] a )
{
    u64 sum = 0;
    for( u64 i = 0; i < N; i = i + 1 )
    {
        sum = sum + cast<u64>( a[i] );
    }
    return sum;
}

u64 forwarded<u64 N>( const ref i32[N] a )
{
    return total<N>( a );
}

u64 filled<u64 N>( i32 x )
{
    i32[N] b = [ x, .. ];
    return total<N>( b );
}

struct Grid<T, u64 W, u64 H> where T : copyable
{
    T[W * H] cells;
};

u64 area<u64 W, u64 H>( const ref Grid<i32, W, H> g )
{
    return g.cells.size();
}

i32 main()
{
    i32[3] three = [ 1, 2, 3 ];
    i32[4] four  = [ 5, 6, 7, 8 ];

    t::print( total<3>( three ) );
    t::print( total<Four>( four ) );
    t::print( forwarded<3>( three ) );
    t::print( filled<5>( 2 ) );

    Grid<i32, 2, 3> g = Grid<i32, 2, 3> { [ 7, .. ] };
    t::print( area<2, 3>( g ) );
    t::print( cast<u64>( g.cells[5] ) );
    return 0;
}
