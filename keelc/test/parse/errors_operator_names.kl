// `operator==` and `operator[]` are the operators a type may declare so far: `!=` comes from `==`,
// `&&` and `||` never can be, ordering waits for `<=>`, `[` needs its `]`, and an operator outside a
// type has no left operand.
struct a
{
    i32 x;

    bool operator!=( const ref a other ) const
    {
        return false;
    }

    bool operator&&( const ref a other ) const
    {
        return false;
    }

    bool operator<( const ref a other ) const
    {
        return false;
    }

    a operator+( const ref a other ) const
    {
        return other;
    }

    bool operator( const ref a other ) const
    {
        return false;
    }

    i32* operator[( u64 index ) const
    {
        return nullptr;
    }
};

bool operator==( const ref a l, const ref a r )
{
    return true;
}

i32* operator[]( u64 index )
{
    return nullptr;
}
