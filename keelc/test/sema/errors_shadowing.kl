i32 shadows_a_local()
{
    i32 x = 1;
    {
        i32 x = 2;
        return x;
    }
}

i32 shadows_a_parameter( i32 p )
{
    i32 p = 1;
    return p;
}

i32 shadows_from_three_levels_out()
{
    i32 deep = 1;
    {
        {
            i32 deep = 2;
            return deep;
        }
    }
}

// A local may not take a method's name either: a bare `size()` after it would call the local.
struct Sized
{
    i32 size() const
    {
        return 1;
    }

    i32 doubled() const
    {
        i32 size = 2;
        return size;
    }

    i32 n;
};
