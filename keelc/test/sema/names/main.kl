// What each name refers to: the names a grammar cannot classify by position alone.

import shapes;
import metric::units;

i32 counter = 0;

class meter
{
    public i32 count;

    public meter( i32 start )
    {
        count = start;
    }

    static meter zero()
    {
        return meter( 0 );
    }

    public i32 value() const
    {
        return count;
    }
};

T larger<T>( T a, T b ) where T : Copyable
{
    return a;
}

f64 radius_of( Shape s )
{
    switch( s )
    {
        case Shape::Circle( r ):
            return r;
        default:
            return 0.0;
    }
}

i32 main()
{
    meter m       = meter( 1 );
    meter z       = meter::zero();
    metric::Unit unit = metric::Unit::Foot;
    f64 r         = radius_of( Shape::Dot );
    meter* p      = &m;
    i32 n         = p.count + m.value();
    return larger( counter, metric::scale );
}
