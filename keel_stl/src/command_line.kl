import list;
import string;
import optional;

/// A flag that `command_line::add_flag` declared: present or absent, with no value.
///
/// Ask only the `parsed_arguments` that the same `command_line` made.
struct flag
{
    /// Which declaration, in the order they were added.
    u64 index;
};

/// An option that `command_line::add_option` declared: absent, or given with a value.
///
/// Ask only the `parsed_arguments` that the same `command_line` made.
struct option
{
    /// Which declaration, in the order they were added.
    u64 index;
};

// One declared flag or option. A flag has an empty placeholder; `short_name` is 0 when there is
// none, and `name` is empty when there is only a short name.
private struct entry
{
    u8 short_name;
    str name;
    str placeholder;
    str help;
};

/// The options a program accepts, which parse its arguments and describe them in a usage text.
///
/// `--name` sets a flag. `--name value` and `--name=value` set an option. A declaration may also
/// have a short name: `-d` sets a flag, `-c value` and `-cvalue` set an option, and `-dc value`
/// sets both, the first option taking the rest. `--` ends the options, and every other argument is
/// a positional.
class command_line
{
    /// No options yet. `synopsis` follows `usage: `, as `keelb <build|test> [options]`.
    public command_line( str synopsis )
    {
        synopsis_ = synopsis;
        entries_ = list<entry>();
    }

    /// Declares `--name`, which `help` describes. `name` is written without the dashes.
    ///
    /// Panics when `name` is empty, starts with `-`, or is already declared.
    @located
    public flag add_flag( str name, str help )
    {
        switch( refusal( true, 0, name ) )
        {
            case optional::some( message ):
                panic( message, @caller() );
            case optional::none:
                break;
        }

        entries_.push( entry{ 0, name, "", help } );
        return flag{ entries_.size() - 1 };
    }

    /// Declares `-s` and, unless `name` is empty, `--name`, which `help` describes.
    ///
    /// Panics when `short_name` is not a letter or digit, `name` starts with `-`, or either is
    /// already declared.
    @located
    public flag add_flag( u8 short_name, str name, str help )
    {
        switch( refusal( true, short_name, name ) )
        {
            case optional::some( message ):
                panic( message, @caller() );
            case optional::none:
                break;
        }

        entries_.push( entry{ short_name, name, "", help } );
        return flag{ entries_.size() - 1 };
    }

    /// Declares `--name <placeholder>`, which `help` describes. `name` is written without the dashes.
    ///
    /// Panics when `name` is empty, starts with `-`, or is already declared.
    @located
    public option add_option( str name, str placeholder, str help )
    {
        switch( refusal( false, 0, name ) )
        {
            case optional::some( message ):
                panic( message, @caller() );
            case optional::none:
                break;
        }

        entries_.push( entry{ 0, name, placeholder, help } );
        return option{ entries_.size() - 1 };
    }

    /// Declares `-s <placeholder>` and, unless `name` is empty, `--name <placeholder>`, which `help`
    /// describes. With no `name`, a placeholder that ends in `>` is shown as written, as `-march=<cpu>`
    /// from `arch=<cpu>`.
    ///
    /// Panics when `short_name` is not a letter or digit, `name` starts with `-`, or either is
    /// already declared.
    @located
    public option add_option( u8 short_name, str name, str placeholder, str help )
    {
        switch( refusal( false, short_name, name ) )
        {
            case optional::some( message ):
                panic( message, @caller() );
            case optional::none:
                break;
        }

        entries_.push( entry{ short_name, name, placeholder, help } );
        return option{ entries_.size() - 1 };
    }

    /// The usage line, then each declaration with its help, in the order they were added.
    public string usage() const
    {
        string s = "usage: " + synopsis_ + "\n";
        if( entries_.size() > 0 )
        {
            s += "\noptions:\n";

            bool shorts = false;
            for( u64 i : 0..entries_.size() )
            {
                shorts = shorts || entries_[ i ].short_name != 0;
            }

            // Each help text starts two spaces past the widest left side.
            list<string> lefts = list<string>::with_capacity( entries_.size() );
            u64 width = 0;
            for( u64 i : 0..entries_.size() )
            {
                string left = left_side( entries_[ i ], shorts );
                width = left.size() > width ? left.size() : width;
                lefts.push( move left );
            }

            for( u64 i : 0..entries_.size() )
            {
                s += "  " + lefts[ i ];
                for( u64 pad : lefts[ i ].size()..width + 2 )
                {
                    s.push( ' ' );
                }
                s += entries_[ i ].help + "\n";
            }
        }

        return s;
    }

    /// Reads `main`'s arguments, or answers why they cannot be read, as a sentence to print after
    /// the program's name.
    ///
    /// Refuses an unknown option, an option without its value, a flag with one, and anything given
    /// twice. An option's value is the next argument even when it starts with `-`.
    public result<parsed_arguments, string> parse( const ref str[] args ) const
    {
        list<bool> given = list<bool>::with_capacity( entries_.size() );
        list<string> values = list<string>::with_capacity( entries_.size() );
        for( u64 i : 0..entries_.size() )
        {
            given.push( false );
            values.push( "" );
        }
        list<string> positionals = list<string>();

        bool options_ended = false;
        for( u64 i = 0; i < args.size; i++ )
        {
            string arg = string::from( args[i] );
            if( options_ended || arg == "-" || !arg.starts_with( "-" ) )
            {
                positionals.push( move arg );
                continue;
            }

            if( arg == "--" )
            {
                options_ended = true;
                continue;
            }

            if( !arg.starts_with( "--" ) )
            {
                // Short flags until an option, which takes the rest or the next argument.
                for( u64 at = 1; at < arg.size(); at++ )
                {
                    string spelled = "-";
                    spelled.push( arg[at] );
                    u64 index = 0;
                    switch( find_short( arg[at] ) )
                    {
                        case optional::some( found ):
                            index = found;
                            break;
                        case optional::none:
                            return result::err( "unknown option `" + spelled + "`" );
                    }

                    if( given[index] )
                    {
                        return result::err( "`" + spelled + "` is given twice" );
                    }
                    given[index] = true;

                    if( entries_[index].placeholder.size > 0 )
                    {
                        if( at + 1 < arg.size() )
                        {
                            values[index] = arg.substring( at + 1, arg.size() - at - 1 );
                        }
                        else if( i + 1 == args.size )
                        {
                            return result::err( "`" + spelled + "` needs a value" );
                        }
                        else
                        {
                            i++;
                            values[index] = string::from( args[i] );
                        }
                        break;
                    }
                }
                continue;
            }

            // `--name=value` splits at the first `=`.
            string name = arg.substring( 2, arg.size() - 2 );
            string value = "";
            bool has_value = false;
            switch( arg.find( "=" ) )
            {
                case optional::some( at ):
                    name = arg.substring( 2, at - 2 );
                    value = arg.substring( at + 1, arg.size() - at - 1 );
                    has_value = true;
                    break;
                case optional::none:
                    break;
            }

            u64 index = 0;
            switch( find( name ) )
            {
                case optional::some( found ):
                    index = found;
                    break;
                case optional::none:
                    return result::err( "unknown option `" + arg + "`" );
            }

            if( given[index] )
            {
                return result::err( "`--" + name + "` is given twice" );
            }

            if( entries_[index].placeholder.size == 0 )
            {
                if( has_value )
                {
                    return result::err( "`--" + name + "` takes no value" );
                }
            }
            else if( !has_value )
            {
                if( i + 1 == args.size )
                {
                    return result::err( "`--" + name + "` needs a value" );
                }
                i++;
                value = string::from( args[i] );
            }

            given[index] = true;
            values[index] = move value;
        }

        return result::ok( parsed_arguments( move given, move values, move positionals ) );
    }

    // Why a flag, or an option when not `is_flag`, cannot have `short_name` (0 for none) and `name`.
    private optional<str> refusal( bool is_flag, u8 short_name, str name ) const
    {
        if( short_name == 0 && name.size == 0 )
        {
            return optional::some( is_flag ? "flag name cannot be empty" : "option name cannot be empty" );
        }

        if( name.size > 0 && name.as_text()[0] == '-' )
        {
            return optional::some( is_flag ? "flag name cannot start with a dash" : "option name cannot start with a dash" );
        }

        if( name.size > 0 && is_some( find( name ) ) )
        {
            return optional::some( is_flag ? "flag is already declared" : "option is already declared" );
        }

        if( short_name == 0 )
        {
            return optional::none;
        }

        bool letter = ( short_name >= 'a' && short_name <= 'z' ) || ( short_name >= 'A' && short_name <= 'Z' );
        if( !letter && !( short_name >= '0' && short_name <= '9' ) )
        {
            return optional::some( is_flag ? "flag short name must be a letter or digit" : "option short name must be a letter or digit" );
        }

        if( is_some( find_short( short_name ) ) )
        {
            return optional::some( is_flag ? "flag short name is already declared" : "option short name is already declared" );
        }

        return optional::none;
    }

    // `-s, --name <placeholder>`, with `    ` for a missing `-s, ` when `shorts`, and `-s<placeholder>`
    // when there is only a short name, or `-splaceholder` when it ends in `>`.
    private static string left_side( const ref entry e, bool shorts )
    {
        string s = "";
        if( e.short_name != 0 )
        {
            s += "-";
            s.push( e.short_name );
            if( e.name.size == 0 )
            {
                string placeholder = "";
                placeholder += e.placeholder;
                if( placeholder.ends_with( ">" ) )
                {
                    s += placeholder;
                }
                else if( placeholder.size() > 0 )
                {
                    s += "<" + placeholder + ">";
                }
                return s;
            }
            s += ", ";
        }
        else if( shorts )
        {
            s += "    ";
        }

        s += "--" + e.name;
        if( e.placeholder.size > 0 )
        {
            s += " <" + e.placeholder + ">";
        }
        return s;
    }

    // The declaration named `name`, without its dashes.
    private optional<u64> find( const ref textual name ) const
    {
        for( u64 i : 0..entries_.size() )
        {
            const ref entry e = entries_[ i ];
            if( e.name.size > 0 && same_text( name, e.name ) )
            {
                return optional::some( i );
            }
        }

        return optional::none;
    }

    // The declaration whose short name is `short_name`.
    private optional<u64> find_short( u8 short_name ) const
    {
        for( u64 i : 0..entries_.size() )
        {
            if( entries_[ i ].short_name == short_name )
            {
                return optional::some( i );
            }
        }

        return optional::none;
    }

    private list<entry> entries_;
    private str synopsis_;
};

/// What `command_line::parse` read: which flags and options were given, their values, and the
/// positionals.
class parsed_arguments
{
    /// Only `command_line::parse` makes one; each list but `positionals` holds one per declaration.
    public parsed_arguments( move list<bool> given, move list<string> values, move list<string> positionals )
    {
        given_ = move given;
        values_ = move values;
        positionals_ = move positionals;
    }

    /// Whether the flag was given.
    public bool has( flag f ) const
    {
        return given_[ f.index ];
    }

    /// Whether the option was given.
    public bool has( option o ) const
    {
        return given_[ o.index ];
    }

    /// The option's value. Panics when it was not given, so ask `has` first.
    public const ref string value( option o ) const
    {
        if( !has( o ) )
        {
            panic( "option was not given" );
        }

        return values_.as_run()[ o.index ];
    }

    /// Every argument that is not an option or its value, in order.
    public const ref list<string> positionals() const
    {
        return positionals_;
    }

    private list<bool> given_;
    private list<string> values_;
    private list<string> positionals_;
};