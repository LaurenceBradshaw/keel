// `kl::list` checks its index: reading one past the end aborts, naming the check in the library.
import kl::list;

i32 main()
{
    kl::list<i32> values = kl::list<i32>::with_capacity( 2 );
    values.push( 10 );
    values.push( 20 );

    if( values[1] != 20 )
    {
        return 1;
    }

    return values[2];
}
