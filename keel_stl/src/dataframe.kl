import algorithm;
import list;
import mask;
import math;
import ndarray;
import optional;
import os;
import string;
import time;

/// What a `series` holds.
enum dtype
{
    /// `f64` values, pandas' `float64`.
    f64s,
    /// `i64` values, pandas' `int64`.
    i64s,
    /// `bool` values.
    bools,
    /// `string` values, pandas' `str`.
    strings,
    /// `timestamp` values, pandas' `datetime64[ns]`.
    times,
    /// `duration` values, pandas' `timedelta64[ns]`.
    durations
};

/// pandas' name for `d`: `float64`, `int64`, `bool`, `str`, `datetime64[ns]` or `timedelta64[ns]`.
str dtype_name( dtype d )
{
    switch( d )
    {
        case dtype::f64s:
            return "float64";
        case dtype::i64s:
            return "int64";
        case dtype::bools:
            return "bool";
        case dtype::strings:
            return "str";
        case dtype::times:
            return "datetime64[ns]";
        case dtype::durations:
            return "timedelta64[ns]";
    }
}

/// Which rows `dataframe::merge` keeps.
enum how
{
    /// The rows whose keys both sides hold, in the left side's order.
    inner,
    /// Every left row, in its order, with gaps where the right side lacks its keys.
    left,
    /// Every right row, in its order, with gaps where the left side lacks its keys.
    right,
    /// Every row of both sides, in sorted key order, a missing key last.
    outer
};

// Whether `d` is `f64s` or `i64s`.
private bool is_number( dtype d )
{
    return d == dtype::f64s || d == dtype::i64s;
}

// Whether `d` holds nanoseconds: `times` or `durations`.
private bool is_time( dtype d )
{
    return d == dtype::times || d == dtype::durations;
}

/// One column of a `dataframe`: values of one `dtype`, any of which may be missing.
///
/// A missing `f64` is a NaN, as in pandas; the other dtypes keep a mask of missing values, so an
/// `i64` column with a gap stays `i64`. `+ - * /` work element by element against a series of
/// the same size or a number: two `i64` sides stay `i64`, `/` always gives `f64`, and a value
/// missing on either side is missing in the result. The comparisons answer a `mask` that is clear
/// where a value is missing, for `dataframe::filtered`. The reductions skip missing values and
/// answer `f64`, a bool counting as 0 or 1. `s.f64s()` and its siblings hand a loop the values, panicking on another dtype.
///
/// `times` and `durations` hold nanoseconds as `i64s` does. A time less a time is a duration, and a
/// time plus or less a duration is a time; `year()` and its siblings read a time's fields, and
/// `to_times` reads text.
class series
{
    dtype        kind_;
    ndarray<f64> f_;
    ndarray<i64> i_; // also `times` and `durations`, as nanoseconds
    mask         b_;
    list<string> s_;
    mask         missing_; // no bits when nothing is missing; never set for `f64s`

    /// `values` as `f64s`.
    public series( move ndarray<f64> values )
    {
        kind_    = dtype::f64s;
        f_       = move values;
        i_       = ndarray<i64>::from_list( list<i64>() );
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// `values` as `i64s`.
    public series( move ndarray<i64> values )
    {
        kind_    = dtype::i64s;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = move values;
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// The bits of `values`, of rank 1, as `bools`.
    public series( move mask values )
    {
        kind_    = dtype::bools;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = ndarray<i64>::from_list( list<i64>() );
        b_       = move values;
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// `values` as `strings`.
    public series( move list<string> values )
    {
        kind_    = dtype::strings;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = ndarray<i64>::from_list( list<i64>() );
        b_       = mask( 0 );
        s_       = move values;
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `f64s`: `series( [ 1.5, 2.0 ] )`.
    public series( const ref f64[] values )
    {
        kind_    = dtype::f64s;
        f_       = ndarray<f64>( values );
        i_       = ndarray<i64>::from_list( list<i64>() );
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `i64s`: `series( [ 1, 2 ] )`.
    public series( const ref i64[] values )
    {
        kind_    = dtype::i64s;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = ndarray<i64>( values );
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `bools`.
    public series( const ref bool[] values )
    {
        kind_ = dtype::bools;
        f_    = ndarray<f64>::from_list( list<f64>() );
        i_    = ndarray<i64>::from_list( list<i64>() );
        b_    = mask( values.size );
        for( u64 i : 0..values.size )
        {
            b_.assign( i, values[i] );
        }
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `strings`: `series( [ "a", "b" ] )`.
    public series( const ref str[] values )
    {
        kind_ = dtype::strings;
        f_    = ndarray<f64>::from_list( list<f64>() );
        i_    = ndarray<i64>::from_list( list<i64>() );
        b_    = mask( 0 );
        s_    = list<string>::with_capacity( values.size );
        for( u64 i : 0..values.size )
        {
            s_.push( string( values[i] ) );
        }
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `times`.
    public series( const ref timestamp[] values )
    {
        list<i64> v = list<i64>::with_capacity( values.size );
        for( u64 i : 0..values.size )
        {
            v.push( values[i].nanoseconds() );
        }
        kind_    = dtype::times;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = ndarray<i64>::from_list( move v );
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    /// A copy of `values` as `durations`.
    public series( const ref duration[] values )
    {
        list<i64> v = list<i64>::with_capacity( values.size );
        for( u64 i : 0..values.size )
        {
            v.push( values[i].nanoseconds() );
        }
        kind_    = dtype::durations;
        f_       = ndarray<f64>::from_list( list<f64>() );
        i_       = ndarray<i64>::from_list( move v );
        b_       = mask( 0 );
        s_       = list<string>();
        missing_ = mask( 0 );
    }

    // `nanoseconds` as `kind`, `i64s`, `times` or `durations`.
    private static series of_kind( move ndarray<i64> nanoseconds, dtype kind )
    {
        series r = series( move nanoseconds );
        r.kind_ = kind;
        return r;
    }

    /// A second series with the same values.
    public series copy() const
    {
        series r = series( list<string>() );
        r.kind_    = kind_;
        r.f_       = f_.copy();
        r.i_       = i_.copy();
        r.b_       = b_.copy();
        r.s_       = list<string>::with_capacity( s_.size() );
        for( u64 i : 0..s_.size() )
        {
            r.s_.push( string( s_[i] ) );
        }
        r.missing_ = missing_.copy();
        return r;
    }

    /// --- Reading ---

    /// What the series holds.
    public dtype kind() const
    {
        return kind_;
    }

    /// How many values there are, missing ones included.
    public u64 size() const
    {
        switch( kind_ )
        {
            case dtype::f64s:
                return f_.size();
            case dtype::i64s:
            case dtype::times:
            case dtype::durations:
                return i_.size();
            case dtype::bools:
                return b_.size();
            case dtype::strings:
                return s_.size();
        }
    }

    /// Whether value `i` is missing.
    public bool is_missing( u64 i ) const
    {
        if( kind_ == dtype::f64s )
        {
            return kl::is_nan( f_[i] );
        }
        return missing_.size() > 0 && missing_.test( i );
    }

    /// Marks value `i` missing; an `f64` becomes NaN.
    public void set_missing( u64 i )
    {
        if( i >= size() )
        {
            panic( "index out of bounds" );
        }
        if( kind_ == dtype::f64s )
        {
            f_[i] = nan();
            return;
        }
        if( missing_.size() == 0 )
        {
            missing_ = mask( size() );
        }
        missing_.assign( i, true );
    }

    /// How many values are not missing.
    public u64 count() const
    {
        if( kind_ == dtype::f64s )
        {
            return size() - kl::is_nan( f_ ).count();
        }
        return size() - missing_.count();
    }

    /// The values of an `f64s` series; panics on another dtype.
    public ref ndarray<f64> f64s() const
    {
        holds( dtype::f64s );
        return f_;
    }

    /// The values of an `i64s` series, missing ones unspecified; panics on another dtype.
    public ref ndarray<i64> i64s() const
    {
        holds( dtype::i64s );
        return i_;
    }

    /// The values of a `bools` series, missing ones unspecified; panics on another dtype.
    public ref mask bools() const
    {
        holds( dtype::bools );
        return b_;
    }

    /// The values of a `strings` series, missing ones unspecified; panics on another dtype.
    public ref list<string> strings() const
    {
        holds( dtype::strings );
        return s_;
    }

    /// The values of a `times` series as nanoseconds since 1970, missing ones unspecified; panics on
    /// another dtype.
    public ref ndarray<i64> times() const
    {
        holds( dtype::times );
        return i_;
    }

    /// The values of a `durations` series as nanoseconds, missing ones unspecified; panics on
    /// another dtype.
    public ref ndarray<i64> durations() const
    {
        holds( dtype::durations );
        return i_;
    }

    /// Value `i` of a `times` series, unspecified when missing; panics on another dtype.
    public timestamp timestamp_at( u64 i ) const
    {
        holds( dtype::times );
        return timestamp::of_nanoseconds( i_[i] );
    }

    /// Value `i` of a `durations` series, unspecified when missing; panics on another dtype.
    public duration duration_at( u64 i ) const
    {
        holds( dtype::durations );
        return duration::of_nanoseconds( i_[i] );
    }

    /// The values at `rows`, in that order: pandas' `take`.
    public series taken( const ref u64[] rows ) const
    {
        series r = series( list<string>() );
        r.kind_ = kind_;
        switch( kind_ )
        {
            case dtype::f64s:
                list<f64> f = list<f64>::with_capacity( rows.size );
                for( u64 k : rows )
                {
                    f.push( f_[k] );
                }
                r.f_ = ndarray<f64>::from_list( move f );
                break;
            case dtype::i64s:
            case dtype::times:
            case dtype::durations:
                list<i64> v = list<i64>::with_capacity( rows.size );
                for( u64 k : rows )
                {
                    v.push( i_[k] );
                }
                r.i_ = ndarray<i64>::from_list( move v );
                break;
            case dtype::bools:
                r.b_ = mask( rows.size );
                for( u64 j : 0..rows.size )
                {
                    r.b_.assign( j, b_.test( rows[j] ) );
                }
                break;
            case dtype::strings:
                r.s_ = list<string>::with_capacity( rows.size );
                for( u64 k : rows )
                {
                    r.s_.push( string( s_[k] ) );
                }
                break;
        }
        if( missing_.size() > 0 )
        {
            r.missing_ = mask( rows.size );
            for( u64 j : 0..rows.size )
            {
                r.missing_.assign( j, missing_.test( rows[j] ) );
            }
        }
        return r;
    }

    /// --- Missing values ---

    /// Where a value is missing.
    public mask isna() const
    {
        if( kind_ == dtype::f64s )
        {
            return kl::is_nan( f_ );
        }
        return missing_.size() == 0 ? mask( size() ) : missing_.copy();
    }

    /// The values present, in order.
    public series dropna() const
    {
        list<u64> picked = list<u64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            if( !is_missing( i ) )
            {
                picked.push( i );
            }
        }
        return taken( picked.as_run() );
    }

    /// Each missing value of an `f64s` series as `x`; panics on another dtype.
    public series fillna( f64 x ) const
    {
        holds( dtype::f64s );
        series r = copy();
        for( u64 i : 0..size() )
        {
            if( kl::is_nan( r.f_[i] ) )
            {
                r.f_[i] = x;
            }
        }
        return r;
    }

    /// Each missing value of an `i64s` or `f64s` series as `x`; panics on another dtype.
    public series fillna( i64 x ) const
    {
        if( kind_ == dtype::f64s )
        {
            return fillna( cast<f64>( x ) );
        }
        holds( dtype::i64s );
        series r = copy();
        for( u64 i : 0..size() )
        {
            if( is_missing( i ) )
            {
                r.i_[i] = x;
            }
        }
        r.missing_ = mask( 0 );
        return r;
    }

    /// Each missing value of a `bools` series as `x`; panics on another dtype.
    public series fillna( bool x ) const
    {
        holds( dtype::bools );
        series r = copy();
        for( u64 i : 0..size() )
        {
            if( is_missing( i ) )
            {
                r.b_.assign( i, x );
            }
        }
        r.missing_ = mask( 0 );
        return r;
    }

    /// Each missing value of a `strings` series as `x`; panics on another dtype.
    public series fillna( const ref textual x ) const
    {
        holds( dtype::strings );
        series r = copy();
        for( u64 i : 0..size() )
        {
            if( is_missing( i ) )
            {
                r.s_[i] = string( x );
            }
        }
        r.missing_ = mask( 0 );
        return r;
    }

    /// --- Mapping ---

    /// The distinct values in the order they first appear, a missing one among them once, as
    /// pandas' `unique`.
    public series unique() const
    {
        list<u64> codes = list<u64>();
        u64 n = factorize( this, ref codes );
        mask seen = mask( n + 1 );
        list<u64> firsts = list<u64>();
        for( u64 i : 0..size() )
        {
            u64 c = codes[i] == u64::max ? n : codes[i];
            if( !seen.test( c ) )
            {
                seen.assign( c, true );
                firsts.push( i );
            }
        }
        return taken( firsts.as_run() );
    }

    /// `f` of each value of a number or bool series, as `f64s`; a missing value stays missing:
    /// `s.map( fn[]( f64 x ) { return x * x; } )`.
    public series map<F>( F f ) const where F : fn( f64 ) -> f64
    {
        ndarray<f64> v = numbers();
        list<f64> r = list<f64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            r.push( is_missing( i ) ? nan() : f( v[i] ) );
        }
        return series( ndarray<f64>::from_list( move r ) );
    }

    /// `f` of each value of a `strings` series; a missing value stays missing:
    /// `s.map( fn[]( const ref string t ) { return t + "!"; } )`.
    public series map<F>( F f ) const where F : fn( const ref string ) -> string
    {
        holds( dtype::strings );
        list<string> v = list<string>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            v.push( is_missing( i ) ? string() : f( s_[i] ) );
        }
        series r = series( move v );
        r.missing_ = missing_.copy();
        return r;
    }

    /// --- Arithmetic ---

    /// Element by element against `o`, of the same size.
    public series operator+( const ref series o ) const
    {
        return combine( o, '+' );
    }

    /// Element by element against `o`, of the same size.
    public series operator-( const ref series o ) const
    {
        return combine( o, '-' );
    }

    /// Element by element against `o`, of the same size.
    public series operator*( const ref series o ) const
    {
        return combine( o, '*' );
    }

    /// Element by element against `o`, of the same size, as `f64`.
    public series operator/( const ref series o ) const
    {
        return combine( o, '/' );
    }

    /// `x` added to each value, as `f64`.
    public series operator+( f64 x ) const
    {
        return combine( series( ndarray<f64>::filled( x, size() ) ), '+' );
    }

    /// `x` taken from each value, as `f64`.
    public series operator-( f64 x ) const
    {
        return combine( series( ndarray<f64>::filled( x, size() ) ), '-' );
    }

    /// Each value times `x`, as `f64`.
    public series operator*( f64 x ) const
    {
        return combine( series( ndarray<f64>::filled( x, size() ) ), '*' );
    }

    /// Each value over `x`, as `f64`.
    public series operator/( f64 x ) const
    {
        return combine( series( ndarray<f64>::filled( x, size() ) ), '/' );
    }

    /// `x` added to each value; an `i64s` series stays `i64s`.
    public series operator+( i64 x ) const
    {
        return combine( series( ndarray<i64>::filled( x, size() ) ), '+' );
    }

    /// `x` taken from each value; an `i64s` series stays `i64s`.
    public series operator-( i64 x ) const
    {
        return combine( series( ndarray<i64>::filled( x, size() ) ), '-' );
    }

    /// Each value times `x`; an `i64s` series stays `i64s`.
    public series operator*( i64 x ) const
    {
        return combine( series( ndarray<i64>::filled( x, size() ) ), '*' );
    }

    /// Each value over `x`, as `f64`.
    public series operator/( i64 x ) const
    {
        return combine( series( ndarray<i64>::filled( x, size() ) ), '/' );
    }

    /// `d` added to each time or duration.
    public series operator+( const ref duration d ) const
    {
        return combine( of_kind( ndarray<i64>::filled( d.nanoseconds(), size() ), dtype::durations ), '+' );
    }

    /// `d` taken from each time or duration.
    public series operator-( const ref duration d ) const
    {
        return combine( of_kind( ndarray<i64>::filled( d.nanoseconds(), size() ), dtype::durations ), '-' );
    }

    /// The duration from `t` to each time.
    public series operator-( const ref timestamp t ) const
    {
        return combine( of_kind( ndarray<i64>::filled( t.nanoseconds(), size() ), dtype::times ), '-' );
    }

    /// --- Comparing ---

    /// Where each value is less than `o`'s.
    public mask less( const ref series o ) const
    {
        return compare( o, relation::less );
    }

    /// Where each value is greater than `o`'s.
    public mask greater( const ref series o ) const
    {
        return compare( o, relation::greater );
    }

    /// Where each value is at most `o`'s.
    public mask less_equal( const ref series o ) const
    {
        return compare( o, relation::less_equal );
    }

    /// Where each value is at least `o`'s.
    public mask greater_equal( const ref series o ) const
    {
        return compare( o, relation::greater_equal );
    }

    /// Where each value equals `o`'s.
    public mask equal_each( const ref series o ) const
    {
        return compare( o, relation::equal );
    }

    /// Where each value differs from `o`'s, a missing one included.
    public mask differs( const ref series o ) const
    {
        return ~compare( o, relation::equal );
    }

    /// Where each value is less than `x`.
    public mask less( f64 x ) const
    {
        return compare( series( ndarray<f64>::filled( x, size() ) ), relation::less );
    }

    /// Where each value is greater than `x`.
    public mask greater( f64 x ) const
    {
        return compare( series( ndarray<f64>::filled( x, size() ) ), relation::greater );
    }

    /// Where each value is at most `x`.
    public mask less_equal( f64 x ) const
    {
        return compare( series( ndarray<f64>::filled( x, size() ) ), relation::less_equal );
    }

    /// Where each value is at least `x`.
    public mask greater_equal( f64 x ) const
    {
        return compare( series( ndarray<f64>::filled( x, size() ) ), relation::greater_equal );
    }

    /// Where each value equals `x`.
    public mask equal_each( f64 x ) const
    {
        return compare( series( ndarray<f64>::filled( x, size() ) ), relation::equal );
    }

    /// Where each value differs from `x`, a missing one included.
    public mask differs( f64 x ) const
    {
        return ~equal_each( x );
    }

    /// Where each value equals the text `x`.
    public mask equal_each( const ref textual x ) const
    {
        holds( dtype::strings );
        mask r = mask( size() );
        string t = string( x );
        for( u64 i : 0..s_.size() )
        {
            r.assign( i, s_[i] == t );
        }
        return without_missing( move r );
    }

    /// Where each value differs from the text `x`, a missing one included.
    public mask differs( const ref textual x ) const
    {
        return ~equal_each( x );
    }

    /// Where each time is before `t`.
    public mask less( const ref timestamp t ) const
    {
        return compare( at_each( t ), relation::less );
    }

    /// Where each time is after `t`.
    public mask greater( const ref timestamp t ) const
    {
        return compare( at_each( t ), relation::greater );
    }

    /// Where each time is at or before `t`.
    public mask less_equal( const ref timestamp t ) const
    {
        return compare( at_each( t ), relation::less_equal );
    }

    /// Where each time is at or after `t`.
    public mask greater_equal( const ref timestamp t ) const
    {
        return compare( at_each( t ), relation::greater_equal );
    }

    /// Where each time is `t`.
    public mask equal_each( const ref timestamp t ) const
    {
        return compare( at_each( t ), relation::equal );
    }

    /// Where each time is not `t`, a missing one included.
    public mask differs( const ref timestamp t ) const
    {
        return ~equal_each( t );
    }

    /// --- Times ---

    /// A `strings` series read as ISO 8601 times, as `timestamp::parse` reads them; a missing
    /// value stays missing. As pandas' `to_datetime` with `format="ISO8601"`.
    ///
    /// ### Errors
    ///
    /// The first row that does not read.
    public result<series, u64> to_times() const
    {
        return read_times( "" );
    }

    /// A `strings` series read as times by `pattern`, as `timestamp::parse` reads them: pandas'
    /// `to_datetime( s, format=pattern )`.
    ///
    /// ### Errors
    ///
    /// The first row that does not read.
    public result<series, u64> to_times( const ref textual pattern ) const
    {
        return read_times( pattern );
    }

    /// Each time's year, as `i64s`.
    public series year() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.year(); } );
    }

    /// Each time's month, 1 to 12.
    public series month() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.month(); } );
    }

    /// Each time's day of the month, from 1.
    public series day() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.day(); } );
    }

    /// Each time's hour, 0 to 23.
    public series hour() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.hour(); } );
    }

    /// Each time's minute, 0 to 59.
    public series minute() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.minute(); } );
    }

    /// Each time's second, 0 to 59.
    public series second() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.second(); } );
    }

    /// Each time's nanoseconds past the second.
    public series nanosecond() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.nanosecond(); } );
    }

    /// Each time's weekday, 0 for Monday.
    public series weekday() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.weekday(); } );
    }

    /// Each time's day of the year, from 1.
    public series day_of_year() const
    {
        return each_field( fn[]( const ref timestamp t ) { return t.day_of_year(); } );
    }

    /// Each duration in seconds, as `f64s`.
    public series total_seconds() const
    {
        holds( dtype::durations );
        list<f64> v = list<f64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            v.push( is_missing( i ) ? nan() : cast<f64>( i_[i] ) / 1e9 );
        }
        return series( ndarray<f64>::from_list( move v ) );
    }

    /// The earliest time present, none when there is none.
    public optional<timestamp> min_time() const
    {
        return extreme_time( true );
    }

    /// The latest time present, none when there is none.
    public optional<timestamp> max_time() const
    {
        return extreme_time( false );
    }

    /// --- Reducing ---

    /// The sum of the values present, 0 when there are none.
    public f64 sum() const
    {
        return present().sum();
    }

    /// The mean of the values present, NaN when there are none.
    public f64 mean() const
    {
        ndarray<f64> v = present();
        return v.size() == 0 ? nan() : v.sum() / cast<f64>( v.size() );
    }

    /// The sample variance of the values present, over n - 1 as pandas' default; NaN for fewer
    /// than two.
    public f64 var() const
    {
        ndarray<f64> v = present();
        u64 n = v.size();
        if( n < 2 )
        {
            return nan();
        }
        ndarray<f64> d = v - v.sum() / cast<f64>( n );
        return ( d * d ).sum() / cast<f64>( n - 1 );
    }

    /// The sample standard deviation of the values present, the square root of `var`.
    public f64 std() const
    {
        return kl::sqrt( var() );
    }

    /// The least value present, NaN when there are none.
    public f64 min() const
    {
        ndarray<f64> v = present();
        return v.size() == 0 ? nan() : v.min();
    }

    /// The greatest value present, NaN when there are none.
    public f64 max() const
    {
        ndarray<f64> v = present();
        return v.size() == 0 ? nan() : v.max();
    }

    /// The `q` quantile of the values present, `q` in [0, 1], interpolated linearly between the
    /// two nearest as pandas' default; NaN when there are none.
    public f64 quantile( f64 q ) const
    {
        if( !( q >= 0.0 && q <= 1.0 ) )
        {
            panic( "the quantile is outside [0, 1]" );
        }
        ndarray<f64> v = present().sorted();
        u64 n = v.size();
        if( n == 0 )
        {
            return nan();
        }
        f64 at = q * cast<f64>( n - 1 );
        u64 lo = kl::floored<u64>( at );
        u64 hi = lo + 1 < n ? lo + 1 : lo;
        f64 t = at - cast<f64>( lo );
        f64 diff = v[hi] - v[lo];
        // numpy's lerp: from the nearer end, so q = 1 lands on the last value exactly.
        return t >= 0.5 ? v[hi] - diff * ( 1.0 - t ) : v[lo] + diff * t;
    }

    /// --- Windows ---

    /// Windows of `window` rows ending at each row, as pandas' `s.rolling( window )`; a window
    /// needs every row present. Panics when `window` is 0 or the series holds no numbers or bools.
    public kl::rolling rolling( u64 window ) const
    {
        return rolling( window, window );
    }

    /// As `rolling( window )`, a window needing only `min_periods` values present.
    public kl::rolling rolling( u64 window, u64 min_periods ) const
    {
        if( min_periods > window )
        {
            panic( "min_periods is more than the window" );
        }
        window_numbers( this );
        return kl::rolling( this, row_starts( size(), window ), min_periods );
    }

    // Panics unless the series holds `k`.
    private void holds( dtype k ) const
    {
        if( kind_ != k )
        {
            panic( "the series holds another dtype" );
        }
    }

    // `t` at every row, as `times`.
    private series at_each( const ref timestamp t ) const
    {
        return of_kind( ndarray<i64>::filled( t.nanoseconds(), size() ), dtype::times );
    }

    // `to_times`, ISO 8601 for an empty `pattern`.
    private result<series, u64> read_times( const ref textual pattern ) const
    {
        holds( dtype::strings );
        bool iso = pattern.as_text().size == 0;
        list<i64> v = list<i64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            if( is_missing( i ) )
            {
                v.push( 0 );
                continue;
            }
            switch( iso ? timestamp::parse( s_[i] ) : timestamp::parse( s_[i], pattern ) )
            {
                case result::ok( t ):
                    v.push( t.nanoseconds() );
                    break;
                case result::err( _ ):
                    return result::err( i );
            }
        }
        series r = of_kind( ndarray<i64>::from_list( move v ), dtype::times );
        r.missing_ = missing_.copy();
        return result::ok( move r );
    }

    // `f` of each time, as `i64s`, missing where the time is.
    private series each_field<F>( F f ) const where F : fn( const ref timestamp ) -> i64
    {
        holds( dtype::times );
        list<i64> v = list<i64>::with_capacity( size() );
        for( u64 i : 0..size() )
        {
            v.push( is_missing( i ) ? 0 : f( timestamp::of_nanoseconds( i_[i] ) ) );
        }
        series r = series( ndarray<i64>::from_list( move v ) );
        r.missing_ = missing_.copy();
        return r;
    }

    // The earliest time present when `least`, else the latest.
    private optional<timestamp> extreme_time( bool least ) const
    {
        holds( dtype::times );
        bool any = false;
        i64 best = 0;
        for( u64 i : 0..size() )
        {
            if( !is_missing( i ) && ( !any || ( least ? i_[i] < best : i_[i] > best ) ) )
            {
                best = i_[i];
                any = true;
            }
        }
        if( !any )
        {
            return optional::none;
        }
        return optional::some( timestamp::of_nanoseconds( best ) );
    }

    // The values missing on either side of a combination with `o`, none when neither has any.
    private mask missing_either( const ref series o ) const
    {
        if( missing_.size() == 0 )
        {
            return o.missing_.copy();
        }
        return o.missing_.size() == 0 ? missing_.copy() : missing_ | o.missing_;
    }

    // The values present, as `f64`.
    private ndarray<f64> present() const
    {
        switch( kind_ )
        {
            case dtype::f64s:
                return f_.selected( ~kl::is_nan( f_ ) );
            case dtype::i64s:
                if( missing_.size() == 0 )
                {
                    return i_.to<f64>();
                }
                return i_.selected( ~missing_ ).to<f64>();
            case dtype::bools:
                list<f64> v = list<f64>::with_capacity( size() );
                for( u64 i : 0..size() )
                {
                    if( !is_missing( i ) )
                    {
                        v.push( b_.test( i ) ? 1.0 : 0.0 );
                    }
                }
                return ndarray<f64>::from_list( move v );
            case dtype::strings:
            case dtype::times:
            case dtype::durations:
                panic( "the series does not hold numbers" );
        }
    }

    // Every value as `f64`, a bool as 0 or 1, missing ones unspecified.
    private ndarray<f64> numbers() const
    {
        switch( kind_ )
        {
            case dtype::f64s:
                return f_.copy();
            case dtype::i64s:
                return i_.to<f64>();
            case dtype::bools:
                list<f64> v = list<f64>::with_capacity( size() );
                for( u64 i : 0..size() )
                {
                    v.push( b_.test( i ) ? 1.0 : 0.0 );
                }
                return ndarray<f64>::from_list( move v );
            case dtype::strings:
            case dtype::times:
            case dtype::durations:
                panic( "the series does not hold numbers" );
        }
    }

    // `op`, one of `+ - * /`, element by element against `o`.
    private series combine( const ref series o, u8 op ) const
    {
        if( size() != o.size() )
        {
            panic( "the series differ in size" );
        }

        if( is_time( kind_ ) || is_time( o.kind_ ) )
        {
            dtype k = time_sum( kind_, o.kind_, op );
            series r = of_kind( op == '+' ? i_ + o.i_ : i_ - o.i_, k );
            r.missing_ = missing_either( o );
            return r;
        }

        if( kind_ == dtype::i64s && o.kind_ == dtype::i64s && op != '/' )
        {
            series r = series( op == '+' ? i_ + o.i_ : op == '-' ? i_ - o.i_ : i_ * o.i_ );
            r.missing_ = missing_either( o );
            return r;
        }

        series r = kind_ == dtype::f64s && o.kind_ == dtype::f64s ? series( arithmetic( f_, o.f_, op ) )
                 : kind_ == dtype::f64s ? series( arithmetic( f_, o.numbers(), op ) )
                 : o.kind_ == dtype::f64s ? series( arithmetic( numbers(), o.f_, op ) )
                 : series( arithmetic( numbers(), o.numbers(), op ) );
        for( u64 i : 0..r.size() )
        {
            if( ( missing_.size() > 0 && missing_.test( i ) ) || ( o.missing_.size() > 0 && o.missing_.test( i ) ) )
            {
                r.f_[i] = nan();
            }
        }
        return r;
    }

    // Where `relation` holds between each value and `o`'s, clear where either is missing.
    private mask compare( const ref series o, relation rel ) const
    {
        if( size() != o.size() )
        {
            panic( "the series differ in size" );
        }

        mask r = mask( 0 );
        if( ( is_time( kind_ ) || is_time( o.kind_ ) ) && kind_ != o.kind_ )
        {
            panic( "the series hold dtypes that do not compare" );
        }
        if( kind_ == o.kind_ && ( kind_ == dtype::i64s || is_time( kind_ ) ) )
        {
            r = relate( i_, o.i_, rel );
        }
        else if( kind_ == dtype::strings && o.kind_ == dtype::strings )
        {
            r = mask( size() );
            for( u64 i : 0..s_.size() )
            {
                r.assign( i, holds_between( s_[i] <=> o.s_[i], rel ) );
            }
        }
        else if( kind_ == dtype::f64s && o.kind_ == dtype::f64s )
        {
            r = relate( f_, o.f_, rel );
        }
        else
        {
            r = relate( numbers(), o.numbers(), rel );
        }

        r = without_missing( move r );
        return o.without_missing( move r );
    }

    // `m` cleared where a value is missing.
    private mask without_missing( move mask m ) const
    {
        if( missing_.size() == 0 )
        {
            return m;
        }
        return m & ~missing_;
    }
};

// What `series::compare` tests.
private enum relation
{
    less,
    less_equal,
    greater,
    greater_equal,
    equal
};

// The dtype of `a` `op` `b`, `op` `+` or `-`, where one is `times` or `durations`; panics on any
// other mix.
private dtype time_sum( dtype a, dtype b, u8 op )
{
    if( op == '+' && is_time( a ) && is_time( b ) && ( a == dtype::durations || b == dtype::durations ) )
    {
        return a == b ? dtype::durations : dtype::times;
    }
    if( op == '-' && is_time( a ) && ( b == a || b == dtype::durations ) )
    {
        return a == b ? dtype::durations : dtype::times;
    }
    panic( "the dtypes do not combine" );
}

// Whether `rel` holds for an ordering of two values.
private bool holds_between( ordering o, relation rel )
{
    switch( rel )
    {
        case relation::less:
            return o == ordering::less;
        case relation::less_equal:
            return o != ordering::greater;
        case relation::greater:
            return o == ordering::greater;
        case relation::greater_equal:
            return o != ordering::less;
        case relation::equal:
            return o == ordering::equal;
    }
}

// Where `rel` holds between each element of `a` and `b`'s.
private mask relate<T>( const ref ndarray<T> a, const ref ndarray<T> b, relation rel ) where T : numeric
{
    switch( rel )
    {
        case relation::less:
            return a.less( b );
        case relation::less_equal:
            return a.less_equal( b );
        case relation::greater:
            return a.greater( b );
        case relation::greater_equal:
            return a.greater_equal( b );
        case relation::equal:
            return a.equal_each( b );
    }
}

// `op`, one of `+ - * /`, element by element.
private ndarray<f64> arithmetic( const ref ndarray<f64> a, const ref ndarray<f64> b, u8 op )
{
    switch( op )
    {
        case '+':
            return a + b;
        case '-':
            return a - b;
        case '*':
            return a * b;
        default:
            return a / b;
    }
}

// A quiet NaN.
private f64 nan()
{
    f64 zero = 0.0;
    return zero / zero;
}

/// Named `series` of one length, in order, with rows numbered from 0, as pandas' `DataFrame`.
///
/// Build one empty and `insert` columns, or read one with `read_csv`. `df["a"]` is a column;
/// `head`, `tail`, `iloc`, `filtered`, `select` and `sort_values` answer new frames holding copies,
/// as pandas' copy-on-write behaves, while `insert`, `set`, `drop` and `rename` change the frame
/// itself. `groupby` answers a `grouped`. `set_index` labels the rows by a column, which `loc`
/// looks up and every selection keeps; arithmetic never aligns by it.
/// `to_string` writes pandas' table.
class dataframe
{
    list<string> names_;
    list<series> columns_;
    list<series> index_; // the index, or none when rows are numbered
    string index_name_;

    /// No columns and no rows.
    public dataframe()
    {
        names_      = list<string>();
        columns_    = list<series>();
        index_      = list<series>();
        index_name_ = string();
    }

    /// A second frame with the same columns.
    public dataframe copy() const
    {
        dataframe r = dataframe();
        for( u64 c : 0..columns_.size() )
        {
            r.names_.push( string( names_[c] ) );
            r.columns_.push( columns_[c].copy() );
        }
        r.keep_index( this );
        return r;
    }

    /// --- Shape ---

    /// How many rows there are.
    public u64 rows() const
    {
        if( columns_.is_empty() )
        {
            return index_.is_empty() ? 0 : index_[0].size();
        }
        return columns_[0].size();
    }

    /// The rows, then the columns.
    public u64[2] shape() const
    {
        u64[2] r = [ rows(), columns_.size() ];
        return r;
    }

    /// The columns' names, in order.
    public const ref list<string> columns() const
    {
        return names_;
    }

    /// The columns' dtypes, in order.
    public list<dtype> dtypes() const
    {
        list<dtype> r = list<dtype>::with_capacity( columns_.size() );
        for( u64 c : 0..columns_.size() )
        {
            r.push( columns_[c].kind() );
        }
        return r;
    }

    /// The column named `name`; panics when there is none.
    public const ref series operator[]( const ref textual name ) const
    {
        return columns_[position( name )];
    }

    /// Whether a column is named `name`.
    public bool has( const ref textual name ) const
    {
        return find( name ) < names_.size();
    }

    /// --- Changing ---

    /// Adds `s` as the last column, named `name`. Panics when the name is taken, or when `s`'s
    /// size is not the frame's rows; the first column sets them.
    public void insert( const ref textual name, move series s )
    {
        if( has( name ) )
        {
            panic( "a column already has that name" );
        }
        if( !columns_.is_empty() && s.size() != rows() )
        {
            panic( "the column's size is not the frame's rows" );
        }
        names_.push( string( name ) );
        columns_.push( move s );
    }

    /// Puts `s` in place of the column named `name`, or adds it last when there is none, as
    /// pandas' `df[name] = s`; panics when `s`'s size is not the frame's rows.
    public void set( const ref textual name, move series s )
    {
        u64 c = find( name );
        if( c == names_.size() )
        {
            insert( name, move s );
            return;
        }
        if( s.size() != rows() )
        {
            panic( "the column's size is not the frame's rows" );
        }
        columns_[c] = move s;
    }

    /// Drops each column in `names`; panics on a name no column has.
    public void drop( str... names )
    {
        for( str n : names )
        {
            u64 c = position( n );
            names_.remove( c );
            columns_.remove( c );
        }
    }

    /// Renames column `from` to `to`; panics when there is no `from` or `to` is taken.
    public void rename( const ref textual from, const ref textual to )
    {
        u64 c = position( from );
        if( has( to ) )
        {
            panic( "a column already has that name" );
        }
        names_[c] = string( to );
    }

    /// --- Selecting ---

    /// The columns in `names`, in that order.
    public dataframe select( str... names ) const
    {
        dataframe r = dataframe();
        for( str n : names )
        {
            r.insert( n, columns_[position( n )].copy() );
        }
        r.keep_index( this );
        return r;
    }

    /// The rows in `at`, those past the end left out, as pandas' `iloc[a:b]`.
    public dataframe iloc( range at ) const
    {
        u64 to = at.to < rows() ? at.to : rows();
        list<u64> picked = list<u64>();
        for( u64 i = at.from; i < to; i++ )
        {
            picked.push( i );
        }
        return taken( picked.as_run() );
    }

    /// The first `n` rows, or all of them.
    public dataframe head( u64 n = 5 ) const
    {
        return iloc( 0..n );
    }

    /// The last `n` rows, or all of them.
    public dataframe tail( u64 n = 5 ) const
    {
        return iloc( ( n < rows() ? rows() - n : 0 )..rows() );
    }

    /// The rows `m` sets, `m` holding one bit per row: `df.filtered( df["a"].greater( 3.0 ) )`.
    public dataframe filtered( const ref mask m ) const
    {
        if( m.size() != rows() )
        {
            panic( "the mask's size is not the frame's rows" );
        }
        list<u64> picked = list<u64>::with_capacity( m.count() );
        for( u64 i : 0..m.size() )
        {
            if( m.test( i ) )
            {
                picked.push( i );
            }
        }
        return taken( picked.as_run() );
    }

    /// The rows at `rows`, in that order: pandas' `take`.
    public dataframe taken( const ref u64[] rows ) const
    {
        dataframe r = dataframe();
        for( u64 c : 0..columns_.size() )
        {
            r.names_.push( string( names_[c] ) );
            r.columns_.push( columns_[c].taken( rows ) );
        }
        if( !index_.is_empty() )
        {
            r.index_.push( index_[0].taken( rows ) );
            r.index_name_ = string( index_name_ );
        }
        return r;
    }

    /// The rows ordered by column `name`, a stable sort, missing values last either way.
    public dataframe sort_values( const ref textual name, bool ascending = true ) const
    {
        const ref series s = columns_[position( name )];
        list<u64> order = present_order( s, ascending );
        for( u64 i : 0..rows() )
        {
            if( s.is_missing( i ) )
            {
                order.push( i );
            }
        }
        return taken( order.as_run() );
    }

    /// The rows where none of `names` is missing, or none of the columns when no name is given.
    public dataframe dropna( str... names ) const
    {
        list<u64> checked = list<u64>();
        for( str n : names )
        {
            checked.push( position( n ) );
        }
        if( checked.is_empty() )
        {
            for( u64 c : 0..columns_.size() )
            {
                checked.push( c );
            }
        }
        list<u64> picked = list<u64>::with_capacity( rows() );
        for( u64 i : 0..rows() )
        {
            bool gap = false;
            for( u64 c : checked )
            {
                gap = gap || columns_[c].is_missing( i );
            }
            if( !gap )
            {
                picked.push( i );
            }
        }
        return taken( picked.as_run() );
    }

    /// --- Index ---

    /// The frame with column `name` moved aside as its index, which labels the rows in place of
    /// their numbers and replaces any index before it; panics when there is no such column.
    public dataframe set_index( const ref textual name ) const
    {
        u64 at = position( name );
        dataframe r = dataframe();
        for( u64 c : 0..columns_.size() )
        {
            if( c != at )
            {
                r.names_.push( string( names_[c] ) );
                r.columns_.push( columns_[c].copy() );
            }
        }
        r.index_.push( columns_[at].copy() );
        r.index_name_ = string( name );
        return r;
    }

    /// The frame with its index put back as the first column, named `index` when the index has no
    /// name, or the row numbers so when there is none; the rows are then numbered.
    public dataframe reset_index() const
    {
        dataframe r = dataframe();
        r.insert( index_name_.is_empty() ? string( "index" ) : string( index_name_ ), labels() );
        for( u64 c : 0..columns_.size() )
        {
            r.insert( names_[c], columns_[c].copy() );
        }
        return r;
    }

    /// The rows labelled `label`, in order, as pandas' `df.loc[[label]]`; without an index the
    /// labels are the row numbers. Panics when no row has it.
    public dataframe loc( f64 label ) const
    {
        return labelled( labels().equal_each( label ) );
    }

    /// The rows labelled `label`, in order; panics when no row has it.
    public dataframe loc( i64 label ) const
    {
        return labelled( labels().equal_each( series( ndarray<i64>::filled( label, rows() ) ) ) );
    }

    /// The rows labelled with the text `label`, in order; panics when no row has it.
    public dataframe loc( const ref textual label ) const
    {
        return labelled( labels().equal_each( label ) );
    }

    /// The rows labelled with the time `label`, in order; panics when no row has it.
    public dataframe loc( const ref timestamp label ) const
    {
        return labelled( labels().equal_each( label ) );
    }

    /// The rows labelled `from` to `to`, both included, as pandas' `df.loc[from:to]`; panics when
    /// the index is not in ascending order or has a gap.
    public dataframe loc( f64 from, f64 to ) const
    {
        series s = sorted_labels();
        return filtered( s.greater_equal( from ) & s.less_equal( to ) );
    }

    /// The rows labelled `from` to `to`, both included; panics as `loc( f64, f64 )`.
    public dataframe loc( i64 from, i64 to ) const
    {
        series s = sorted_labels();
        return filtered( s.greater_equal( series( ndarray<i64>::filled( from, rows() ) ) ) & s.less_equal( series( ndarray<i64>::filled( to, rows() ) ) ) );
    }

    /// The rows labelled with the texts `from` to `to`, both included; panics as `loc( f64, f64 )`.
    public dataframe loc( const ref textual from, const ref textual to ) const
    {
        series s = sorted_labels();
        return filtered( s.greater_equal( repeated( from, rows() ) ) & s.less_equal( repeated( to, rows() ) ) );
    }

    /// The rows labelled with the times `from` to `to`, both included; panics as `loc( f64, f64 )`.
    public dataframe loc( const ref timestamp from, const ref timestamp to ) const
    {
        series s = sorted_labels();
        return filtered( s.greater_equal( from ) & s.less_equal( to ) );
    }

    /// --- Missing values ---

    /// A `bools` column for each column, set where a value is missing.
    public dataframe isna() const
    {
        dataframe r = dataframe();
        for( u64 c : 0..columns_.size() )
        {
            r.insert( names_[c], series( columns_[c].isna() ) );
        }
        r.keep_index( this );
        return r;
    }

    /// Each missing value of the `f64s` columns as `x`.
    public dataframe fillna( f64 x ) const
    {
        dataframe r = copy();
        for( u64 c : 0..columns_.size() )
        {
            if( columns_[c].kind() == dtype::f64s )
            {
                r.columns_[c] = columns_[c].fillna( x );
            }
        }
        return r;
    }

    /// Each missing value of the `i64s` and `f64s` columns as `x`.
    public dataframe fillna( i64 x ) const
    {
        dataframe r = copy();
        for( u64 c : 0..columns_.size() )
        {
            if( columns_[c].kind() == dtype::i64s || columns_[c].kind() == dtype::f64s )
            {
                r.columns_[c] = columns_[c].fillna( x );
            }
        }
        return r;
    }

    /// Each missing value of the `bools` columns as `x`.
    public dataframe fillna( bool x ) const
    {
        dataframe r = copy();
        for( u64 c : 0..columns_.size() )
        {
            if( columns_[c].kind() == dtype::bools )
            {
                r.columns_[c] = columns_[c].fillna( x );
            }
        }
        return r;
    }

    /// Each missing value of the `strings` columns as `x`.
    public dataframe fillna( const ref textual x ) const
    {
        dataframe r = copy();
        for( u64 c : 0..columns_.size() )
        {
            if( columns_[c].kind() == dtype::strings )
            {
                r.columns_[c] = columns_[c].fillna( x );
            }
        }
        return r;
    }

    /// --- Grouping ---

    /// The rows grouped by their values in the columns `names`; panics when none is given.
    public grouped groupby( str... names ) const
    {
        list<string> keys = list<string>();
        for( str n : names )
        {
            keys.push( string( n ) );
        }
        return grouped( this, keys );
    }

    /// How often each distinct row of the columns `names` occurs, missing ones left out: those
    /// columns, then `count`, the most frequent first and ties in the order they first appear.
    public dataframe value_counts( str... names ) const
    {
        list<string> keys = list<string>();
        for( str n : names )
        {
            keys.push( string( n ) );
        }
        list<u64> codes = list<u64>();
        u64 groups = group_codes( this, keys, ref codes );
        list<i64> counts = list<i64>::filled( groups, 0 );
        list<u64> firsts = list<u64>();
        for( u64 i : 0..rows() )
        {
            if( codes[i] != u64::max )
            {
                if( counts[codes[i]] == 0 )
                {
                    firsts.push( i );
                }
                counts[codes[i]] += 1;
            }
        }
        kl::stable_sort( ref firsts, fn[ codes, counts ]( a, b ) { return counts[codes[a]] > counts[codes[b]]; } );

        dataframe r = dataframe();
        for( u64 k : 0..keys.size() )
        {
            r.insert( keys[k], columns_[position( keys[k] )].taken( firsts.as_run() ) );
        }
        list<i64> n = list<i64>::with_capacity( firsts.size() );
        for( u64 i : firsts )
        {
            n.push( counts[codes[i]] );
        }
        r.insert( "count", series( ndarray<i64>::from_list( move n ) ) );
        return r;
    }

    /// `f` of each column, as a frame of one row: `df.apply( fn[]( s ) { return s.max() - s.min(); } )`.
    public dataframe apply<F>( F f ) const where F : fn( const ref series ) -> f64
    {
        dataframe r = dataframe();
        for( u64 c : 0..columns_.size() )
        {
            r.insert( names_[c], series( ndarray<f64>::filled( f( columns_[c] ), 1 ) ) );
        }
        return r;
    }

    /// pandas' `pivot_table` over one values column: the `index` key's values as the first column,
    /// one row each in sorted order, then a column for each value of the `columns` key, sorted and
    /// named as one value prints, holding the mean of `values` where the two meet. A meeting with
    /// no rows, or whose mean is NaN, is a gap, and a row or column of gaps only is left out, as
    /// pandas' `dropna`; a row missing a key is left out too. `.set_index( index )` gives pandas'
    /// look. Panics when `values` is a `strings`, `times` or `durations` column.
    public dataframe pivot_table( str values, str index, str columns ) const
    {
        return pivot_table( values, index, columns, fn[]( s ) { return s.mean(); } );
    }

    /// As `pivot_table( values, index, columns )`, with `agg` of each meeting's values in place of
    /// the mean: `df.pivot_table( "v", "k", "j", fn[]( s ) { return s.sum(); } )`.
    public dataframe pivot_table<F>( str values, str index, str columns, F agg ) const where F : fn( const ref series ) -> f64
    {
        dataframe met = select( index, columns, values ).groupby( index, columns ).agg( agg );
        if( !met.has( values ) )
        {
            panic( "the values column does not aggregate" );
        }
        met = met.filtered( ~met[values].isna() );

        list<string> keys = list<string>();
        keys.push( string( index ) );
        list<u64> row_codes = list<u64>();
        u64 n = group_codes( met, keys, ref row_codes );
        keys[0] = string( columns );
        list<u64> column_codes = list<u64>();
        u64 m = group_codes( met, keys, ref column_codes );

        list<u64> row_firsts = list<u64>::filled( n, u64::max );
        list<u64> column_firsts = list<u64>::filled( m, u64::max );
        f64 zero = 0.0;
        list<f64> cells = list<f64>::filled( n * m, zero / zero );
        const ref ndarray<f64> v = met[values].f64s();
        for( u64 i : 0..met.rows() )
        {
            row_firsts[row_codes[i]] = row_firsts[row_codes[i]] == u64::max ? i : row_firsts[row_codes[i]];
            column_firsts[column_codes[i]] = column_firsts[column_codes[i]] == u64::max ? i : column_firsts[column_codes[i]];
            cells[column_codes[i] * n + row_codes[i]] = v[i];
        }

        dataframe r = dataframe();
        r.insert( index, met[index].taken( row_firsts.as_run() ) );
        for( u64 c : 0..m )
        {
            u64[1] at = [ column_firsts[c] ];
            list<f64> column = list<f64>::of( cells.as_run()[c * n..( c + 1 ) * n] );
            r.insert( cell_texts( met[columns], at[0..1] )[0].trim_start(), series( ndarray<f64>::from_list( move column ) ) );
        }
        return r;
    }

    /// --- Windows ---

    /// Windows of `window` rows ending at each row over each number and bool column, as pandas'
    /// `df.rolling( window )`; a window needs every row present. Panics when `window` is 0.
    public rolling_frame rolling( u64 window ) const
    {
        return rolling( window, window );
    }

    /// As `rolling( window )`, a window needing only `min_periods` values present.
    public rolling_frame rolling( u64 window, u64 min_periods ) const
    {
        if( min_periods > window )
        {
            panic( "min_periods is more than the window" );
        }
        return rolled_frame( row_starts( rows(), window ), min_periods, "" );
    }

    /// Windows of the rows whose times in the `times` column `on`, or in the index when `on` is
    /// empty, fall within `window` before each row's, that row's included, as pandas'
    /// `df.rolling( "2D", on = "t" )`; a window needs `min_periods` values present. The times
    /// column is kept as it is. Panics unless the times ascend with no gap.
    public rolling_frame rolling( const ref duration window, str on = "", u64 min_periods = 1 ) const
    {
        if( on.size == 0 && index_.is_empty() )
        {
            panic( "the frame has no index of times" );
        }
        if( on.size == 0 )
        {
            return rolled_frame( time_starts( index_[0], window ), min_periods, on );
        }
        return rolled_frame( time_starts( this[on], window ), min_periods, on );
    }

    /// --- Combining ---

    /// This frame's rows paired with `right`'s where the columns `on` hold equal values, as pandas'
    /// `merge`; with no `on`, the columns both frames have. A gap in a key pairs with a gap. A row
    /// with several partners gives one row each, in the partners' order. The keys come once, where
    /// this frame has them, then this frame's other columns, then `right`'s, and two with one name
    /// become `_x` and `_y`. A side's columns have gaps where that side lacks the keys and keep
    /// their dtype, where pandas makes an integer column `float64`. An `i64s` key against an `f64s`
    /// one is `f64s`. Panics when a side lacks a key or the two sides' dtypes for it differ otherwise.
    public dataframe merge( const ref dataframe right, how kind, str... on ) const
    {
        list<string> keys = list<string>();
        for( str n : on )
        {
            keys.push( string( n ) );
        }
        if( keys.is_empty() )
        {
            for( u64 c : 0..names_.size() )
            {
                if( right.has( names_[c] ) )
                {
                    keys.push( string( names_[c] ) );
                }
            }
        }
        if( keys.is_empty() )
        {
            panic( "the frames share no column to merge on" );
        }

        dataframe a = dataframe();
        dataframe b = dataframe();
        for( u64 k : 0..keys.size() )
        {
            const ref series x = columns_[position( keys[k] )];
            const ref series y = right[keys[k]];
            if( x.kind() != y.kind() && !( is_number( x.kind() ) && is_number( y.kind() ) ) )
            {
                panic( "the key columns' dtypes differ" );
            }
            a.insert( keys[k], x.copy() );
            b.insert( keys[k], y.copy() );
        }
        u64 l = rows();
        u64 n = right.rows();
        dataframe both = concat( move a, move b );
        list<u64> codes = list<u64>();
        u64 groups = group_codes( both, keys, ref codes, true );
        list<u64> ls = list<u64>();
        list<u64> lrows = bucketed( codes, 0, l, groups, ref ls );
        list<u64> rs = list<u64>();
        list<u64> rrows = bucketed( codes, l, l + n, groups, ref rs );

        list<u64> lp = list<u64>();
        list<u64> rp = list<u64>();
        switch( kind )
        {
            case how::inner:
            case how::left:
                for( u64 i : 0..l )
                {
                    u64 g = codes[i];
                    for( u64 k : rs[g]..rs[g + 1] )
                    {
                        lp.push( i );
                        rp.push( rrows[k] );
                    }
                    if( kind == how::left && rs[g] == rs[g + 1] )
                    {
                        lp.push( i );
                        rp.push( u64::max );
                    }
                }
                break;
            case how::right:
                for( u64 j : 0..n )
                {
                    u64 g = codes[l + j];
                    for( u64 k : ls[g]..ls[g + 1] )
                    {
                        lp.push( lrows[k] );
                        rp.push( j );
                    }
                    if( ls[g] == ls[g + 1] )
                    {
                        lp.push( u64::max );
                        rp.push( j );
                    }
                }
                break;
            case how::outer:
                for( u64 g : 0..groups )
                {
                    for( u64 q : ls[g]..ls[g + 1] )
                    {
                        for( u64 k : rs[g]..rs[g + 1] )
                        {
                            lp.push( lrows[q] );
                            rp.push( rrows[k] );
                        }
                        if( rs[g] == rs[g + 1] )
                        {
                            lp.push( lrows[q] );
                            rp.push( u64::max );
                        }
                    }
                    if( ls[g] == ls[g + 1] )
                    {
                        for( u64 k : rs[g]..rs[g + 1] )
                        {
                            lp.push( u64::max );
                            rp.push( rrows[k] );
                        }
                    }
                }
                break;
        }

        list<u64> kp = list<u64>::with_capacity( lp.size() );
        for( u64 p : 0..lp.size() )
        {
            kp.push( lp[p] != u64::max ? lp[p] : l + rp[p] );
        }
        dataframe r = dataframe();
        for( u64 c : 0..names_.size() )
        {
            const ref string name = names_[c];
            if( kl::contains( keys, name ) )
            {
                r.insert( name, gathered( both[name], kp ) );
            }
            else
            {
                r.insert( right.has( name ) ? name + "_x" : string( name ), gathered( columns_[c], lp ) );
            }
        }
        for( u64 c : 0..right.columns().size() )
        {
            const ref string name = right.columns()[c];
            if( !kl::contains( keys, name ) )
            {
                r.insert( has( name ) ? name + "_y" : string( name ), gathered( right[name], rp ) );
            }
        }
        return r;
    }

    /// --- Summarising ---

    /// pandas' `describe`: the count, mean, standard deviation, least, quartiles and greatest of
    /// each `f64s` and `i64s` column, as `f64s` columns of a frame whose rows are labelled.
    public dataframe describe() const
    {
        dataframe r = dataframe();
        str[8] stats = [ "count", "mean", "std", "min", "25%", "50%", "75%", "max" ];
        r.index_.push( series( stats[0..8] ) );
        for( u64 c : 0..columns_.size() )
        {
            const ref series s = columns_[c];
            if( s.kind() == dtype::f64s || s.kind() == dtype::i64s )
            {
                f64[8] v = [ cast<f64>( s.count() ), s.mean(), s.std(), s.min(), s.quantile( 0.25 ), s.quantile( 0.5 ), s.quantile( 0.75 ), s.max() ];
                r.names_.push( string( names_[c] ) );
                r.columns_.push( series( v[0..8] ) );
            }
        }
        return r;
    }

    /// --- Writing ---

    /// pandas' table: a header, the row labels on the left, each column right-aligned, and of more
    /// than 60 rows the first and last five, then `[n rows x m columns]`.
    public string to_string() const
    {
        u64 n = rows();
        if( columns_.is_empty() || n == 0 )
        {
            string r = string( "Empty DataFrame\nColumns: [" );
            for( u64 c : 0..names_.size() )
            {
                if( c > 0 )
                {
                    r += ", ";
                }
                r += names_[c];
            }
            r += "]\nIndex: []";
            return r;
        }

        bool cut = n > 60;
        list<u64> shown = list<u64>();
        for( u64 i : 0..n )
        {
            if( !cut || i < 5 || i >= n - 5 )
            {
                shown.push( i );
            }
        }

        // Each column's cells, the label column first, with the header as cell 0; a header takes the
    // leading space its cells do, but over text.
        list<list<string>> cells = list<list<string>>();
        list<string> index = list<string>();
        if( index_.is_empty() )
        {
            for( u64 i : shown )
            {
                index.push( string::from( i ) );
            }
        }
        else
        {
            list<string> texts = cell_texts( index_[0], shown.as_run() );
            for( u64 k : 0..texts.size() )
            {
                index.push( texts[k].trim_start() );
            }
        }
        index.insert( 0, string() );
        cells.push( move index );
        for( u64 c : 0..columns_.size() )
        {
            list<string> column = cell_texts( columns_[c], shown.as_run() );
            dtype k = columns_[c].kind();
            column.insert( 0, string( k == dtype::strings || is_time( k ) ? "" : " " ) + names_[c] );
            cells.push( move column );
        }

        list<u64> widths = list<u64>();
        for( u64 c : 0..cells.size() )
        {
            u64 w = 0;
            for( u64 k : 0..cells[c].size() )
            {
                w = cells[c][k].size() > w ? cells[c][k].size() : w;
            }
            widths.push( w );
        }
        widths[0] = index_name_.size() > widths[0] ? index_name_.size() : widths[0];

        string r = string();
        for( u64 k : 0..shown.size() + 1 )
        {
            if( cut && k == 6 )
            {
                pad( ref r, widths[0] > 3 ? "..." : "..", widths[0], false );
                for( u64 c : 1..cells.size() )
                {
                    r += " ";
                    pad( ref r, widths[c] > 3 ? "..." : "..", widths[c], true );
                }
                r += "\n";
            }
            pad( ref r, cells[0][k], widths[0], false );
            for( u64 c : 1..cells.size() )
            {
                r += " ";
                pad( ref r, cells[c][k], widths[c], true );
            }
            if( k < shown.size() )
            {
                r += "\n";
            }
            if( k == 0 && !index_name_.is_empty() )
            {
                pad( ref r, index_name_, widths[0], false );
                for( u64 c : 1..cells.size() )
                {
                    r += " ";
                    pad( ref r, "", widths[c], true );
                }
                r += "\n";
            }
        }
        if( cut )
        {
            r += "\n\n[";
            r += string::from( n );
            r += " rows x ";
            r += string::from( columns_.size() );
            r += " columns]";
        }
        return r;
    }

    /// The frame as CSV: a header, then a line for each row, ended by `\n`; a missing value is
    /// empty (`""` when it is the row's only field), a float written as `string::from` writes it, a
    /// time or duration as the table writes its column, and a field holding `sep`, a quote or a
    /// line break quoted. The row numbers or index are not written, as pandas' `index=False`.
    public string to_csv( u8 sep = ',' ) const
    {
        string r = string();
        for( u64 c : 0..names_.size() )
        {
            if( c > 0 )
            {
                r.push( sep );
            }
            push_field( ref r, names_[c], sep );
        }
        r += "\n";
        list<u64> every = list<u64>::with_capacity( rows() );
        for( u64 i : 0..rows() )
        {
            every.push( i );
        }
        list<list<string>> timed = list<list<string>>(); // each column's text when it holds times
        for( u64 c : 0..columns_.size() )
        {
            timed.push( is_time( columns_[c].kind() ) ? time_texts( columns_[c], every.as_run() ) : list<string>() );
        }
        for( u64 i : 0..rows() )
        {
            for( u64 c : 0..columns_.size() )
            {
                if( c > 0 )
                {
                    r.push( sep );
                }
                const ref series s = columns_[c];
                if( s.is_missing( i ) )
                {
                    if( columns_.size() == 1 )
                    {
                        r += "\"\""; // else the row is a blank line, which a reader skips
                    }
                    continue;
                }
                switch( s.kind() )
                {
                    case dtype::times:
                    case dtype::durations:
                        r += timed[c][i];
                        break;
                    case dtype::f64s:
                        r += string::from( s.f64s()[i] );
                        break;
                    case dtype::i64s:
                        r += string::from( s.i64s()[i] );
                        break;
                    case dtype::bools:
                        r += s.bools().test( i ) ? "True" : "False";
                        break;
                    case dtype::strings:
                        push_field( ref r, s.strings()[i], sep );
                        break;
                }
            }
            r += "\n";
        }
        return r;
    }

    // The column named `name`'s place; panics when there is none.
    private u64 position( const ref textual name ) const
    {
        u64 c = find( name );
        if( c == names_.size() )
        {
            panic( "no column has that name" );
        }
        return c;
    }

    // The column named `name`'s place, or the count when there is none.
    private u64 find( const ref textual name ) const
    {
        string n = string( name );
        for( u64 c : 0..names_.size() )
        {
            if( names_[c] == n )
            {
                return c;
            }
        }
        return names_.size();
    }

    // The number and bool columns, and `on`, with the index, as windows starting at `starts`.
    private rolling_frame rolled_frame( move list<u64> starts, u64 min_periods, const ref textual on ) const
    {
        dataframe r = dataframe();
        string times = string( on );
        for( u64 c : 0..columns_.size() )
        {
            dtype k = columns_[c].kind();
            if( names_[c] == times || is_number( k ) || k == dtype::bools )
            {
                r.names_.push( string( names_[c] ) );
                r.columns_.push( columns_[c].copy() );
            }
        }
        r.keep_index( this );
        return rolling_frame( move r, move starts, min_periods, on );
    }

    // `other`'s index, copied.
    private void keep_index( const ref dataframe other )
    {
        if( !other.index_.is_empty() )
        {
            index_.push( other.index_[0].copy() );
            index_name_ = string( other.index_name_ );
        }
    }

    // A copy of the index, or the row numbers as `i64s`.
    private series labels() const
    {
        if( index_.is_empty() )
        {
            return series( ndarray<i64>::arange( 0, cast<i64>( rows() ) ) );
        }
        return index_[0].copy();
    }

    // `labels()`; panics unless they ascend with no gap.
    private series sorted_labels() const
    {
        series s = labels();
        list<u64> order = present_order( s, true );
        for( u64 i : 0..s.size() )
        {
            if( order.size() != s.size() || order[i] != i )
            {
                panic( "the index is not sorted" );
            }
        }
        return s;
    }

    // The rows `m` sets; panics when it sets none.
    private dataframe labelled( const ref mask m ) const
    {
        if( m.count() == 0 )
        {
            panic( "no row has that label" );
        }
        return filtered( m );
    }
};

// `x`, `n` times, as `strings`.
private series repeated( const ref textual x, u64 n )
{
    list<string> r = list<string>::with_capacity( n );
    for( u64 i : 0..n )
    {
        r.push( string( x ) );
    }
    return series( move r );
}

// The rows of `s` with a value present, ordered by value, ties in row order.
private list<u64> present_order( const ref series s, bool ascending )
{
    list<u64> order = list<u64>::with_capacity( s.size() );
    for( u64 i : 0..s.size() )
    {
        if( !s.is_missing( i ) )
        {
            order.push( i );
        }
    }
    switch( s.kind() )
    {
        case dtype::f64s:
            const ref ndarray<f64> f = s.f64s();
            kl::stable_sort( ref order, fn[ f, ascending ]( a, b ) { return ascending ? f[a] < f[b] : f[b] < f[a]; } );
            break;
        case dtype::i64s:
        case dtype::times:
        case dtype::durations:
            const ref ndarray<i64> v = integers( s );
            kl::stable_sort( ref order, fn[ v, ascending ]( a, b ) { return ascending ? v[a] < v[b] : v[b] < v[a]; } );
            break;
        case dtype::bools:
            const ref mask m = s.bools();
            kl::stable_sort( ref order, fn[ m, ascending ]( a, b ) { return m.test( ascending ? b : a ) && !m.test( ascending ? a : b ); } );
            break;
        case dtype::strings:
            const ref list<string> t = s.strings();
            kl::stable_sort( ref order, fn[ t, ascending ]( a, b ) { return ascending ? t[a] < t[b] : t[b] < t[a]; } );
            break;
    }
    return order;
}

// The values of an `i64s`, `times` or `durations` series.
private const ref ndarray<i64> integers( const ref series s )
{
    switch( s.kind() )
    {
        case dtype::times:
            return s.times();
        case dtype::durations:
            return s.durations();
        default:
            return s.i64s();
    }
}

// Value `i` of an `i64s`, `bools`, `times` or `durations` series as an `i64`, a bool as 0 or 1.
private i64 integer_at( const ref series s, u64 i )
{
    return s.kind() == dtype::bools ? ( s.bools().test( i ) ? 1 : 0 ) : integers( s )[i];
}

// `v` as `kind`, `times` or `durations`.
private series of_nanoseconds( const ref list<i64> v, dtype kind )
{
    if( kind == dtype::times )
    {
        list<timestamp> t = list<timestamp>::with_capacity( v.size() );
        for( i64 x : v )
        {
            t.push( timestamp::of_nanoseconds( x ) );
        }
        return series( t.as_run() );
    }
    list<duration> d = list<duration>::with_capacity( v.size() );
    for( i64 x : v )
    {
        d.push( duration::of_nanoseconds( x ) );
    }
    return series( d.as_run() );
}

// Whether rows `a` and `b` of `s` hold equal values, both present.
private bool same( const ref series s, u64 a, u64 b )
{
    switch( s.kind() )
    {
        case dtype::f64s:
            return s.f64s()[a] == s.f64s()[b];
        case dtype::i64s:
        case dtype::times:
        case dtype::durations:
            return integers( s )[a] == integers( s )[b];
        case dtype::bools:
            return s.bools().test( a ) == s.bools().test( b );
        case dtype::strings:
            return s.strings()[a] == s.strings()[b];
    }
}

// Each row's place among the distinct values of `s` in sorted order, `u64::max` where missing,
// written to `codes`; answers how many distinct values there are.
private u64 factorize( const ref series s, ref list<u64> codes )
{
    codes = list<u64>::filled( s.size(), u64::max );
    list<u64> order = present_order( s, true );
    u64 n = 0;
    for( u64 k : 0..order.size() )
    {
        if( k > 0 && !same( s, order[k - 1], order[k] ) )
        {
            n++;
        }
        codes[order[k]] = n;
    }
    return order.is_empty() ? 0 : n + 1;
}

// `codes` renumbered from 0 in their order, `u64::max` kept; answers how many distinct there are.
private u64 dense( ref list<u64> codes )
{
    list<u64> order = list<u64>::with_capacity( codes.size() );
    for( u64 i : 0..codes.size() )
    {
        if( codes[i] != u64::max )
        {
            order.push( i );
        }
    }
    kl::stable_sort( ref order, fn[ codes ]( a, b ) { return codes[a] < codes[b]; } );
    u64 n = 0;
    u64 last = 0;
    for( u64 k : 0..order.size() )
    {
        u64 v = codes[order[k]];
        if( k > 0 && v != last )
        {
            n++;
        }
        last = v;
        codes[order[k]] = n;
    }
    return order.is_empty() ? 0 : n + 1;
}

// Each row's group among the distinct rows of the columns `keys`, in sorted order, `u64::max`
// where a key is missing, written to `codes`; answers how many groups there are.
// With `gaps_match`, a missing key is a value of its own, after the rest, as `merge` pairs them.
private u64 group_codes( const ref dataframe df, const ref list<string> keys, ref list<u64> codes, bool gaps_match = false )
{
    if( keys.is_empty() )
    {
        panic( "no column is named to group by" );
    }
    u64 groups = coded( df[keys[0]], ref codes, gaps_match );
    for( u64 k : 1..keys.size() )
    {
        list<u64> c = list<u64>();
        u64 m = coded( df[keys[k]], ref c, gaps_match );
        for( u64 i : 0..codes.size() )
        {
            codes[i] = codes[i] == u64::max || c[i] == u64::max ? u64::max : codes[i] * m + c[i];
        }
        groups = dense( ref codes );
    }
    return groups;
}

// `factorize`'s codes, a gap given a last code of its own when `gaps_match`.
private u64 coded( const ref series s, ref list<u64> codes, bool gaps_match )
{
    u64 n = factorize( s, ref codes );
    if( !gaps_match )
    {
        return n;
    }
    bool gap = false;
    for( u64 i : 0..codes.size() )
    {
        if( codes[i] == u64::max )
        {
            codes[i] = n;
            gap = true;
        }
    }
    return gap ? n + 1 : n;
}

// The rows `from..to` of `codes`, as offsets from `from`, grouped by code and each group's in row
// order; `starts` gets where each code's rows begin, then the end.
private list<u64> bucketed( const ref list<u64> codes, u64 from, u64 to, u64 groups, ref list<u64> starts )
{
    starts = list<u64>::filled( groups + 1, 0 );
    for( u64 i : from..to )
    {
        starts[codes[i] + 1] = starts[codes[i] + 1] + 1;
    }
    for( u64 g : 0..groups )
    {
        starts[g + 1] = starts[g + 1] + starts[g];
    }
    list<u64> next = list<u64>::filled( groups + 1, 0 );
    for( u64 g : 0..groups )
    {
        next[g] = starts[g];
    }
    list<u64> rows = list<u64>::filled( to - from, 0 );
    for( u64 i : from..to )
    {
        rows[next[codes[i]]] = i - from;
        next[codes[i]] = next[codes[i]] + 1;
    }
    return rows;
}

// Whether `grouped` works out `op` for a column of `kind`.
private bool reduces( dtype kind, reduction op )
{
    switch( kind )
    {
        case dtype::strings:
            return op == reduction::count;
        case dtype::times:
            return op == reduction::count || op == reduction::min || op == reduction::max;
        case dtype::durations:
            return op == reduction::count || op == reduction::sum || op == reduction::min || op == reduction::max;
        default:
            return true;
    }
}

// What `grouped` works out for each group.
private enum reduction
{
    sum,
    mean,
    var,
    std,
    min,
    max,
    count
};

/// The groups `dataframe::groupby` makes: the rows sharing their values in the key columns, the
/// groups in sorted key order, and rows missing a key left out.
///
/// Each reduction answers a frame of the keys, one row a group, then a column for each other
/// column: `count` counts every column, while the rest skip `strings` columns, as pandas'
/// `numeric_only`. `sum`, `min` and `max` keep an `i64s` column `i64s`, and `min` and `max` keep
/// `bools` `bools`; the others answer `f64s`, a bool counting as 0 or 1. A `times` column is kept
/// by `min` and `max` only, and a `durations` one by `sum` too.
class grouped
{
    dataframe keys_;   // one row a group
    dataframe values_; // the other columns, every row
    list<u64> order_;  // the rows, group by group, each group's in row order
    list<u64> starts_; // where each group starts in `order_`, then its size

    /// The rows of `df` grouped by the columns `keys`.
    public grouped( const ref dataframe df, const ref list<string> keys )
    {
        list<u64> codes = list<u64>();
        u64 n = group_codes( df, keys, ref codes );
        starts_ = list<u64>::filled( n + 1, 0 );
        for( u64 c : codes )
        {
            if( c != u64::max )
            {
                starts_[c + 1] += 1;
            }
        }
        for( u64 g : 0..n )
        {
            starts_[g + 1] += starts_[g];
        }
        list<u64> next = list<u64>::of( starts_.as_run() );
        order_ = list<u64>::filled( starts_[n], 0 );
        for( u64 i : 0..codes.size() )
        {
            if( codes[i] != u64::max )
            {
                order_[next[codes[i]]] = i;
                next[codes[i]] += 1;
            }
        }

        list<u64> firsts = list<u64>::with_capacity( n );
        for( u64 g : 0..n )
        {
            firsts.push( order_[starts_[g]] );
        }
        keys_   = dataframe();
        values_ = dataframe();
        for( u64 c : 0..df.columns().size() )
        {
            const ref string name = df.columns()[c];
            if( kl::contains( keys, name ) )
            {
                continue;
            }
            values_.insert( name, df[name].copy() );
        }
        for( u64 k : 0..keys.size() )
        {
            keys_.insert( keys[k], df[keys[k]].taken( firsts.as_run() ) );
        }
    }

    /// How many groups there are.
    public u64 groups() const
    {
        return starts_.size() - 1;
    }

    /// The keys, then `size`, each group's rows.
    public dataframe size() const
    {
        dataframe r = keys_.copy();
        list<i64> n = list<i64>::with_capacity( groups() );
        for( u64 g : 0..groups() )
        {
            n.push( cast<i64>( starts_[g + 1] - starts_[g] ) );
        }
        r.insert( "size", series( ndarray<i64>::from_list( move n ) ) );
        return r;
    }

    /// Each group's values present in each column.
    public dataframe count() const
    {
        return reduced( reduction::count );
    }

    /// Each group's sum, 0 when no value is present.
    public dataframe sum() const
    {
        return reduced( reduction::sum );
    }

    /// Each group's mean.
    public dataframe mean() const
    {
        return reduced( reduction::mean );
    }

    /// Each group's sample variance, over n - 1.
    public dataframe var() const
    {
        return reduced( reduction::var );
    }

    /// Each group's sample standard deviation.
    public dataframe std() const
    {
        return reduced( reduction::std );
    }

    /// Each group's least value.
    public dataframe min() const
    {
        return reduced( reduction::min );
    }

    /// Each group's greatest value.
    public dataframe max() const
    {
        return reduced( reduction::max );
    }

    /// `f` of each group's rows of each number and bool column, as `f64s`:
    /// `g.agg( fn[]( s ) { return s.max() - s.min(); } )`.
    public dataframe agg<F>( F f ) const where F : fn( const ref series ) -> f64
    {
        dataframe r = keys_.copy();
        for( u64 c : 0..values_.columns().size() )
        {
            const ref series s = values_[values_.columns()[c]];
            if( s.kind() == dtype::strings || is_time( s.kind() ) )
            {
                continue;
            }
            list<f64> v = list<f64>::with_capacity( groups() );
            for( u64 g : 0..groups() )
            {
                v.push( f( part( s, g ) ) );
            }
            r.insert( values_.columns()[c], series( ndarray<f64>::from_list( move v ) ) );
        }
        return r;
    }

    // Group `g`'s rows of `s`.
    private series part( const ref series s, u64 g ) const
    {
        return s.taken( order_.as_run()[starts_[g]..starts_[g + 1]] );
    }

    // The keys, then `op` of each group in each column it applies to.
    private dataframe reduced( reduction op ) const
    {
        dataframe r = keys_.copy();
        for( u64 c : 0..values_.columns().size() )
        {
            const ref series s = values_[values_.columns()[c]];
            if( !reduces( s.kind(), op ) )
            {
                continue;
            }
            r.insert( values_.columns()[c], reduced( s, op ) );
        }
        return r;
    }

    // `op` of each group of `s`.
    private series reduced( const ref series s, reduction op ) const
    {
        bool ints = s.kind() == dtype::i64s || s.kind() == dtype::bools || is_time( s.kind() );
        if( op == reduction::count || ( ints && op == reduction::sum ) || ( ints && ( op == reduction::min || op == reduction::max ) ) )
        {
            list<i64> v = list<i64>::with_capacity( groups() );
            mask gaps = mask( groups() );
            for( u64 g : 0..groups() )
            {
                series p = part( s, g );
                if( op == reduction::count )
                {
                    v.push( cast<i64>( p.count() ) );
                    continue;
                }
                i64 total = 0;
                bool any = false;
                for( u64 i : 0..p.size() )
                {
                    if( p.is_missing( i ) )
                    {
                        continue;
                    }
                    i64 x = integer_at( p, i );
                    total = op == reduction::sum ? total + x : !any ? x : op == reduction::min ? ( x < total ? x : total ) : ( x > total ? x : total );
                    any = true;
                }
                v.push( total );
                gaps.assign( g, !any && op != reduction::sum );
            }
            if( s.kind() == dtype::bools && op != reduction::sum && op != reduction::count )
            {
                mask b = mask( groups() );
                for( u64 g : 0..groups() )
                {
                    b.assign( g, v[g] != 0 );
                }
                return with_gaps( series( move b ), gaps );
            }
            if( is_time( s.kind() ) && op != reduction::count )
            {
                return with_gaps( of_nanoseconds( v, s.kind() ), gaps );
            }
            return with_gaps( series( ndarray<i64>::from_list( move v ) ), gaps );
        }

        list<f64> v = list<f64>::with_capacity( groups() );
        for( u64 g : 0..groups() )
        {
            series p = part( s, g );
            switch( op )
            {
                case reduction::sum:
                    v.push( p.sum() );
                    break;
                case reduction::mean:
                    v.push( p.mean() );
                    break;
                case reduction::var:
                    v.push( p.var() );
                    break;
                case reduction::std:
                    v.push( p.std() );
                    break;
                case reduction::min:
                    v.push( p.min() );
                    break;
                default:
                    v.push( p.max() );
                    break;
            }
        }
        return series( ndarray<f64>::from_list( move v ) );
    }
};

/// The windows `series::rolling` makes: for each row, that row and those before it in its window.
///
/// Each method answers `f64s` the length of the series, a gap where the window holds fewer than
/// `min_periods` values present. Sums add and take away values with Kahan's compensation, and the
/// variance by Welford's updates, so a window of equal values has a variance of exactly 0.
class rolling
{
    series values_;
    list<u64> starts_; // row i's window is starts_[i]..i + 1
    u64 min_periods_;

    /// `s`'s windows; see `series::rolling`.
    public rolling( const ref series s, move list<u64> starts, u64 min_periods )
    {
        values_      = s.copy();
        starts_      = move starts;
        min_periods_ = min_periods;
    }

    /// Each window's sum, 0 for none present when `min_periods` is 0.
    public series sum() const
    {
        return rolled( values_, starts_, min_periods_, reduction::sum );
    }

    /// Each window's mean.
    public series mean() const
    {
        return rolled( values_, starts_, min_periods_, reduction::mean );
    }

    /// Each window's sample variance, over n - 1.
    public series var() const
    {
        return rolled( values_, starts_, min_periods_, reduction::var );
    }

    /// Each window's sample standard deviation.
    public series std() const
    {
        return rolled( values_, starts_, min_periods_, reduction::std );
    }

    /// Each window's least value.
    public series min() const
    {
        return rolled( values_, starts_, min_periods_, reduction::min );
    }

    /// Each window's greatest value.
    public series max() const
    {
        return rolled( values_, starts_, min_periods_, reduction::max );
    }

    /// Each window's values present, a gap where the window has fewer than `min_periods` rows.
    public series count() const
    {
        return rolled( values_, starts_, min_periods_, reduction::count );
    }

    /// `f` of each window's rows, gaps included, recomputed each time:
    /// `r.agg( fn[]( s ) { return s.max() - s.min(); } )`.
    public series agg<F>( F f ) const where F : fn( const ref series ) -> f64
    {
        return rolled_by( values_, starts_, min_periods_, f );
    }
};

/// The windows `dataframe::rolling` makes, applied to each number and bool column as
/// `kl::rolling` applies them to a series, each method answering a frame. `strings`, `times` and
/// `durations` columns are left out, where pandas refuses them, but the times a window is measured
/// by stay as they are. The index is kept.
class rolling_frame
{
    dataframe frame_;  // the columns to roll, and the times column
    list<u64> starts_; // row i's window is starts_[i]..i + 1
    u64 min_periods_;
    string on_;        // the times column, or empty

    /// `df`'s windows; see `dataframe::rolling`.
    public rolling_frame( move dataframe df, move list<u64> starts, u64 min_periods, const ref textual on )
    {
        frame_       = move df;
        starts_      = move starts;
        min_periods_ = min_periods;
        on_          = string( on );
    }

    /// Each window's sum in each column.
    public dataframe sum() const
    {
        return reduced( reduction::sum );
    }

    /// Each window's mean in each column.
    public dataframe mean() const
    {
        return reduced( reduction::mean );
    }

    /// Each window's sample variance in each column.
    public dataframe var() const
    {
        return reduced( reduction::var );
    }

    /// Each window's sample standard deviation in each column.
    public dataframe std() const
    {
        return reduced( reduction::std );
    }

    /// Each window's least value in each column.
    public dataframe min() const
    {
        return reduced( reduction::min );
    }

    /// Each window's greatest value in each column.
    public dataframe max() const
    {
        return reduced( reduction::max );
    }

    /// Each window's values present in each column.
    public dataframe count() const
    {
        return reduced( reduction::count );
    }

    /// `f` of each window's rows in each column.
    public dataframe agg<F>( F f ) const where F : fn( const ref series ) -> f64
    {
        dataframe r = frame_.copy();
        for( u64 c : 0..frame_.columns().size() )
        {
            const ref string name = frame_.columns()[c];
            if( name != on_ )
            {
                r.set( name, rolled_by( frame_[name], starts_, min_periods_, f ) );
            }
        }
        return r;
    }

    // `op` of each window in each column but the times.
    private dataframe reduced( reduction op ) const
    {
        dataframe r = frame_.copy();
        for( u64 c : 0..frame_.columns().size() )
        {
            const ref string name = frame_.columns()[c];
            if( name != on_ )
            {
                r.set( name, rolled( frame_[name], starts_, min_periods_, op ) );
            }
        }
        return r;
    }
};

// Each row's window start for windows of `window` rows.
private list<u64> row_starts( u64 n, u64 window )
{
    if( window == 0 )
    {
        panic( "the window is empty" );
    }
    list<u64> r = list<u64>::with_capacity( n );
    for( u64 i : 0..n )
    {
        r.push( i + 1 >= window ? i + 1 - window : 0 );
    }
    return r;
}

// Each row's window start for the times within `window` before it, the earlier end open; panics
// unless the times ascend with no gap.
private list<u64> time_starts( const ref series t, const ref duration window )
{
    if( t.kind() != dtype::times )
    {
        panic( "the window is a duration, but the rows are not times" );
    }
    if( window.nanoseconds() <= 0 )
    {
        panic( "the window is not a positive duration" );
    }
    const ref ndarray<i64> ns = t.times();
    list<u64> r = list<u64>::with_capacity( t.size() );
    u64 lo = 0;
    for( u64 i : 0..t.size() )
    {
        if( t.is_missing( i ) || ( i > 0 && ns[i] < ns[i - 1] ) )
        {
            panic( "the times are not sorted" );
        }
        while( ns[lo] <= ns[i] - window.nanoseconds() )
        {
            lo += 1;
        }
        r.push( lo );
    }
    return r;
}

// `s` as `f64`, a bool as 0 or 1 and a gap NaN; panics on any other dtype.
private ndarray<f64> window_numbers( const ref series s )
{
    if( !is_number( s.kind() ) && s.kind() != dtype::bools )
    {
        panic( "the series does not hold numbers" );
    }
    list<f64> v = list<f64>::with_capacity( s.size() );
    for( u64 i : 0..s.size() )
    {
        if( s.is_missing( i ) )
        {
            v.push( nan() );
            continue;
        }
        switch( s.kind() )
        {
            case dtype::f64s:
                v.push( s.f64s()[i] );
                break;
            case dtype::i64s:
                v.push( cast<f64>( s.i64s()[i] ) );
                break;
            default:
                v.push( s.bools().test( i ) ? 1.0 : 0.0 );
                break;
        }
    }
    return ndarray<f64>::from_list( move v );
}

// The running state of one window's sum, mean or variance.
private struct window_sums
{
    f64 total;
    f64 add_error;    // Kahan's compensation for adding
    f64 remove_error; // and for taking away
    f64 mean;         // Welford's
    f64 peak;         // the most `squares` has been since it was last added up afresh
    f64 squares;      // Welford's sum of squared differences from the mean
    u64 present;
    u64 negatives;
};

// Adds `x`, unless it is NaN.
private void add( ref window_sums w, f64 x, bool welford )
{
    if( kl::is_nan( x ) )
    {
        return;
    }
    w.present += 1;
    w.negatives += x < 0.0 ? 1 : 0;
    if( welford )
    {
        f64 before = w.mean;
        w.mean += ( x - before ) / cast<f64>( w.present );
        w.squares += ( x - before ) * ( x - w.mean );
        return;
    }
    f64 y = x - w.add_error;
    f64 t = w.total + y;
    w.add_error = t - w.total - y;
    w.total = t;
}

// Takes away `x`, unless it is NaN.
private void remove( ref window_sums w, f64 x, bool welford )
{
    if( kl::is_nan( x ) )
    {
        return;
    }
    w.present -= 1;
    w.negatives -= x < 0.0 ? 1 : 0;
    if( welford )
    {
        if( w.present == 0 )
        {
            w.mean = 0.0;
            w.squares = 0.0;
            return;
        }
        f64 before = w.mean;
        w.mean -= ( x - before ) / cast<f64>( w.present );
        w.squares -= ( x - before ) * ( x - w.mean );
        return;
    }
    f64 y = -x - w.remove_error;
    f64 t = w.total + y;
    w.remove_error = t - w.total - y;
    w.total = t;
}

// How many of `x`'s first i values are present, for each i up to its size.
private list<u64> present_before( const ref ndarray<f64> x )
{
    list<u64> r = list<u64>::filled( x.size() + 1, 0 );
    for( u64 i : 0..x.size() )
    {
        r[i + 1] = r[i] + ( kl::is_nan( x[i] ) ? 0 : 1 );
    }
    return r;
}

// `op` of each window of `s`, a gap where fewer than `min_periods` values are present.
private series rolled( const ref series s, const ref list<u64> starts, u64 min_periods, reduction op )
{
    ndarray<f64> x = window_numbers( s );
    u64 n = x.size();
    list<f64> r = list<f64>::with_capacity( n );
    if( op == reduction::count )
    {
        list<u64> present = present_before( x );
        for( u64 i : 0..n )
        {
            u64 k = present[i + 1] - present[starts[i]];
            r.push( i + 1 - starts[i] >= min_periods ? cast<f64>( k ) : nan() );
        }
        return series( ndarray<f64>::from_list( move r ) );
    }
    if( op == reduction::min || op == reduction::max )
    {
        return rolled_extreme( x, starts, min_periods, op == reduction::min );
    }

    bool welford = op == reduction::var || op == reduction::std;
    window_sums fresh = window_sums { .total = 0.0, .add_error = 0.0, .remove_error = 0.0, .mean = 0.0, .squares = 0.0, .peak = 0.0, .present = 0, .negatives = 0 };
    window_sums w = fresh;
    u64 same = 0; // the latest values present that equal the last of them
    f64 last = nan();
    for( u64 i : 0..n )
    {
        if( i == 0 || starts[i] == i )
        {
            // A window sharing no row with the last starts afresh.
            w = fresh;
        }
        else
        {
            for( u64 j : starts[i - 1]..starts[i] )
            {
                remove( ref w, x[j], welford );
            }
        }
        add( ref w, x[i], welford );
        if( welford && w.squares < w.peak * 0.01 )
        {
            // Taking away cancelled most of the digits: add the window up afresh.
            w = fresh;
            for( u64 j : starts[i]..i + 1 )
            {
                add( ref w, x[j], true );
            }
        }
        w.peak = w.squares > w.peak ? w.squares : w.peak;
        if( !kl::is_nan( x[i] ) )
        {
            same = x[i] == last ? same + 1 : 1;
            last = x[i];
        }

        u64 k = w.present;
        if( k < min_periods || ( k == 0 && op != reduction::sum ) )
        {
            r.push( nan() );
            continue;
        }
        if( op == reduction::sum )
        {
            r.push( k == 0 ? 0.0 : same >= k ? last * cast<f64>( k ) : w.total );
            continue;
        }
        if( op == reduction::mean )
        {
            f64 m = same >= k ? last : w.total / cast<f64>( k );
            // A mean of values of one sign keeps that sign.
            m = w.negatives == 0 && m < 0.0 ? 0.0 : w.negatives == k && m > 0.0 ? 0.0 : m;
            r.push( m );
            continue;
        }
        if( k < 2 )
        {
            r.push( nan() );
            continue;
        }
        f64 v = same >= k ? 0.0 : ( w.squares > 0.0 ? w.squares : 0.0 ) / cast<f64>( k - 1 );
        r.push( op == reduction::std ? kl::sqrt( v ) : v );
    }
    return series( ndarray<f64>::from_list( move r ) );
}

// The least or greatest value present in each window of `x`, by a deque of rows whose values
// only grow (or shrink) from its front.
private series rolled_extreme( const ref ndarray<f64> x, const ref list<u64> starts, u64 min_periods, bool least )
{
    u64 n = x.size();
    list<f64> r = list<f64>::with_capacity( n );
    list<u64> rows = list<u64>::with_capacity( n );
    list<u64> present = present_before( x );
    u64 front = 0;
    for( u64 i : 0..n )
    {
        if( !kl::is_nan( x[i] ) )
        {
            while( rows.size() > front && ( least ? x[rows.last()] >= x[i] : x[rows.last()] <= x[i] ) )
            {
                rows.pop();
            }
            rows.push( i );
        }
        while( rows.size() > front && rows[front] < starts[i] )
        {
            front += 1;
        }
        u64 k = present[i + 1] - present[starts[i]];
        r.push( k >= min_periods && k > 0 ? x[rows[front]] : nan() );
    }
    return series( ndarray<f64>::from_list( move r ) );
}

// `f` of each window of `s`, a gap where fewer than `min_periods` values are present.
private series rolled_by<F>( const ref series s, const ref list<u64> starts, u64 min_periods, F f ) where F : fn( const ref series ) -> f64
{
    list<u64> all = list<u64>::with_capacity( s.size() );
    list<u64> present = list<u64>::filled( s.size() + 1, 0 );
    for( u64 i : 0..s.size() )
    {
        all.push( i );
        present[i + 1] = present[i] + ( s.is_missing( i ) ? 0 : 1 );
    }
    list<f64> r = list<f64>::with_capacity( s.size() );
    for( u64 i : 0..s.size() )
    {
        bool enough = present[i + 1] - present[starts[i]] >= min_periods;
        r.push( enough ? f( s.taken( all.as_run()[starts[i]..i + 1] ) ) : nan() );
    }
    return series( ndarray<f64>::from_list( move r ) );
}

// `text` padded with spaces to `width`, on the left when `right`.
private void pad( ref string to, const ref textual text, u64 width, bool right )
{
    u64 n = text.as_text().size;
    if( right )
    {
        for( u64 i = n; i < width; i++ )
        {
            to.push( ' ' );
        }
    }
    to += text;
    if( !right )
    {
        for( u64 i = n; i < width; i++ )
        {
            to.push( ' ' );
        }
    }
}

// The values of `s` at `rows` as pandas prints them, each after a space or its sign, but a float NaN.
private list<string> cell_texts( const ref series s, const ref u64[] rows )
{
    if( is_time( s.kind() ) )
    {
        return time_texts( s, rows );
    }
    list<string> r = list<string>::with_capacity( rows.size );
    if( s.kind() == dtype::f64s )
    {
        r = float_texts( s.f64s(), rows );
    }
    else
    {
        for( u64 k : rows )
        {
            if( s.is_missing( k ) )
            {
                r.push( string( s.kind() == dtype::strings ? "NaN" : "<NA>" ) );
                continue;
            }
            switch( s.kind() )
            {
                case dtype::i64s:
                    r.push( string::from( s.i64s()[k] ) );
                    break;
                case dtype::bools:
                    r.push( string( s.bools().test( k ) ? "True" : "False" ) );
                    break;
                default:
                    r.push( string( s.strings()[k] ) );
                    break;
            }
        }
    }

    bool floats = s.kind() == dtype::f64s;
    for( u64 i : 0..r.size() )
    {
        if( floats && r[i] == "NaN" )
        {
            continue;
        }
        if( r[i].is_empty() || r[i][0] != '-' )
        {
            r[i] = string( " " ) + r[i];
        }
    }
    return r;
}

// The values of a `times` or `durations` series at `rows` as pandas writes the column, `NaT` where
// missing: the date or whole days alone when every value is midnight or whole days, else to the
// second, then the fraction digits the finest value needs, 3, 6 or 9 for times and 6 or 9 for
// durations.
private list<string> time_texts( const ref series s, const ref u64[] rows )
{
    const ref ndarray<i64> v = integers( s );
    bool times = s.kind() == dtype::times;
    i64 second = 1000000000;
    bool whole = true;
    u64 digits = 0;
    for( u64 k : rows )
    {
        if( s.is_missing( k ) )
        {
            continue;
        }
        i64 tod = within( v[k], 86400 * second );
        i64 fraction = tod % second;
        whole = whole && tod == 0;
        u64 need = fraction == 0 ? 0 : fraction % 1000000 == 0 && times ? 3 : fraction % 1000 == 0 ? 6 : 9;
        digits = need > digits ? need : digits;
    }

    list<string> r = list<string>::with_capacity( rows.size );
    for( u64 k : rows )
    {
        if( s.is_missing( k ) )
        {
            r.push( string( "NaT" ) );
            continue;
        }
        i64 tod = within( v[k], 86400 * second );
        string t = string();
        if( times )
        {
            t = timestamp::of_nanoseconds( v[k] ).format( whole ? "%Y-%m-%d" : "%Y-%m-%d %H:%M:%S" );
        }
        else
        {
            t = string::from( ( v[k] - tod ) / ( 86400 * second ) );
            t += whole ? " days" : v[k] < 0 ? " days +" : " days ";
            if( !whole )
            {
                t += timestamp::of_nanoseconds( tod ).format( "%H:%M:%S" );
            }
        }
        if( digits > 0 )
        {
            string f = string::from( tod % second );
            string padded = string( "." );
            for( u64 i = f.size(); i < 9; i++ )
            {
                padded.push( '0' );
            }
            padded += f;
            t.append( padded.as_text()[0..digits + 1] );
        }
        r.push( move t );
    }
    return r;
}

// `x` modulo `m`, from 0 to `m` - 1.
private i64 within( i64 x, i64 m )
{
    i64 r = x % m;
    return r < 0 ? r + m : r;
}

// pandas' float column: six places, the trailing zeros all values share trimmed down to one, or
// six places of scientific when a value is below 1e-6, or above 1e6 with a fixed text past 12.
private list<string> float_texts( const ref ndarray<f64> v, const ref u64[] rows )
{
    u64 places = 1;
    bool small = false;
    bool large = false;
    for( u64 k : rows )
    {
        f64 x = v[k];
        if( kl::is_nan( x ) || kl::is_inf( x ) )
        {
            continue;
        }
        f64 a = kl::abs( x );
        small = small || ( a > 0.0 && a < 1e-6 );
        large = large || a > 1e6;
        string t = string::fixed( x, 6 );
        u64 zeros = 0;
        while( zeros < 6 && t[t.size() - 1 - zeros] == '0' )
        {
            zeros++;
        }
        places = 6 - zeros > places ? 6 - zeros : places;
    }

    list<string> r = list<string>::with_capacity( rows.size );
    u64 longest = 0;
    for( u64 k : rows )
    {
        r.push( kl::is_nan( v[k] ) ? string( "NaN" ) : string::fixed( v[k], places ) );
        longest = r.last().size() > longest ? r.last().size() : longest;
    }
    if( small || ( large && longest > 12 ) )
    {
        for( u64 j : 0..rows.size )
        {
            f64 x = v[rows[j]];
            if( !kl::is_nan( x ) )
            {
                r[j] = string::scientific( x, 6 );
            }
        }
    }
    return r;
}

// `text` as a CSV field: quoted, its quotes doubled, when it holds `sep`, a quote or a line break.
private void push_field( ref string to, const ref string text, u8 sep )
{
    bool quote = false;
    for( u64 i : 0..text.size() )
    {
        u8 b = text[i];
        quote = quote || b == sep || b == '"' || b == '\n' || b == '\r';
    }
    if( !quote )
    {
        to += text;
        return;
    }
    to.push( '"' );
    for( u64 i : 0..text.size() )
    {
        if( text[i] == '"' )
        {
            to.push( '"' );
        }
        to.push( text[i] );
    }
    to.push( '"' );
}

/// --- CSV ---

/// Why `parse_csv` or `read_csv` failed.
enum csv_error
{
    /// The file could not be read.
    unreadable( file_error error ),
    /// The row starting on `line` has more fields than the header.
    too_many_fields( u64 line ),
    /// A quoted field runs to the end of the text.
    unclosed_quote
};

/// The frame CSV `text` holds, read as RFC 4180 with pandas' defaults.
///
/// The first line names the columns. Fields are split at `sep`; a quoted field may hold `sep`,
/// line breaks and doubled quotes. Blank lines are skipped, but not one holding `""`, and a row short of fields has the rest
/// missing, as are pandas' missing tokens (an empty field, `NA`, `NaN`, `null`, `None` and the
/// like). Each column takes the first dtype every value present reads as, `i64s`, `f64s`, then
/// `bools` (`True`, `False`, and lower or upper case), else `strings`; a column with no values
/// present is `f64s`.
result<dataframe, csv_error> parse_csv( const ref textual text, u8 sep = ',' )
{
    const ref u8[] t = text.as_text();
    list<string> header = list<string>();
    list<list<string>> raw = list<list<string>>();
    bool started = false;
    u64 i = 0;
    u64 line = 1;

    while( i < t.size )
    {
        u64 first_line = line;
        list<string> record = list<string>();
        bool quoted = false;
        while( true )
        {
            string f = string();
            if( i < t.size && t[i] == '"' )
            {
                quoted = true;
                i++;
                while( true )
                {
                    if( i >= t.size )
                    {
                        return result::err( csv_error::unclosed_quote );
                    }
                    if( t[i] == '"' )
                    {
                        i++;
                        if( i < t.size && t[i] == '"' )
                        {
                            f.push( '"' );
                            i++;
                            continue;
                        }
                        break;
                    }
                    if( t[i] == '\n' )
                    {
                        line++;
                    }
                    f.push( t[i] );
                    i++;
                }
            }
            u64 from = i;
            while( i < t.size && t[i] != sep && t[i] != '\n' && t[i] != '\r' )
            {
                i++;
            }
            f.append( t[from..i] );
            record.push( move f );

            if( i < t.size && t[i] == sep )
            {
                i++;
                continue;
            }
            if( i < t.size && t[i] == '\r' )
            {
                i++;
            }
            if( i < t.size && t[i] == '\n' )
            {
                i++;
            }
            line++;
            break;
        }

        if( record.size() == 1 && record[0].is_empty() && !quoted )
        {
            continue;
        }
        if( !started )
        {
            started = true;
            header = move record;
            for( u64 c : 0..header.size() )
            {
                raw.push( list<string>() );
            }
            continue;
        }
        if( record.size() > header.size() )
        {
            return result::err( csv_error::too_many_fields( first_line ) );
        }
        for( u64 c : 0..header.size() )
        {
            raw[c].push( c < record.size() ? string( record[c] ) : string() );
        }
    }

    dataframe r = dataframe();
    for( u64 c : 0..header.size() )
    {
        r.insert( header[c], column_of( raw[c] ) );
    }
    return result::ok( move r );
}

/// The frame the CSV file at `path` holds, as `parse_csv` reads it.
result<dataframe, csv_error> read_csv( const ref textual path, u8 sep = ',' )
{
    switch( kl::read_file( path ) )
    {
        case result::ok( text ):
            return parse_csv( text, sep );
        case result::err( e ):
            return result::err( csv_error::unreadable( e ) );
    }
}

// Whether `f` is one of pandas' missing tokens.
private bool is_na_token( const ref string f )
{
    str[19] tokens = [ "", "#N/A", "#N/A N/A", "#NA", "-1.#IND", "-1.#QNAN", "-NaN", "-nan", "1.#IND", "1.#QNAN", "<NA>", "N/A", "NA", "NULL", "NaN", "None", "n/a", "nan", "null" ];
    for( str k : tokens )
    {
        if( f.size() == k.size && f.starts_with( k ) )
        {
            return true;
        }
    }
    return false;
}

// Whether `f` reads as a bool, and which.
private bool is_bool_token( const ref string f, ref bool value )
{
    str[3] yes = [ "True", "true", "TRUE" ];
    str[3] no = [ "False", "false", "FALSE" ];
    for( u64 k : 0..3 )
    {
        if( f.size() == yes[k].size && f.starts_with( yes[k] ) )
        {
            value = true;
            return true;
        }
        if( f.size() == no[k].size && f.starts_with( no[k] ) )
        {
            value = false;
            return true;
        }
    }
    return false;
}

// Whether `f` reads as an `i64`, written to `value`.
private bool reads_i64( const ref string f, ref i64 value )
{
    switch( f.parse_i64() )
    {
        case result::ok( x ):
            value = x;
            return true;
        case result::err( _ ):
            return false;
    }
}

// Whether `f` reads as an `f64`, written to `value`.
private bool reads_f64( const ref string f, ref f64 value )
{
    switch( f.parse_f64() )
    {
        case result::ok( x ):
            value = x;
            return true;
        case result::err( _ ):
            return false;
    }
}

// A column of CSV fields as the first dtype every value present reads as.
private series column_of( const ref list<string> fields )
{
    u64 n = fields.size();
    mask gaps = mask( n );
    bool ints = true;
    bool floats = true;
    bool bools = true;
    u64 present = 0;
    for( u64 i : 0..n )
    {
        const ref string f = fields[i];
        if( is_na_token( f ) )
        {
            gaps.assign( i, true );
            continue;
        }
        present++;
        i64 x = 0;
        f64 y = 0.0;
        bool b = false;
        ints = ints && reads_i64( f, ref x );
        floats = floats && ( ints || reads_f64( f, ref y ) );
        bools = bools && is_bool_token( f, ref b );
    }

    if( present == 0 )
    {
        return series( ndarray<f64>::filled( nan(), n ) );
    }
    if( ints )
    {
        list<i64> v = list<i64>::with_capacity( n );
        for( u64 i : 0..n )
        {
            i64 x = 0;
            _ = !gaps.test( i ) && reads_i64( fields[i], ref x );
            v.push( x );
        }
        return with_gaps( series( ndarray<i64>::from_list( move v ) ), gaps );
    }
    if( floats )
    {
        list<f64> v = list<f64>::with_capacity( n );
        for( u64 i : 0..n )
        {
            f64 y = nan();
            _ = !gaps.test( i ) && reads_f64( fields[i], ref y );
            v.push( y );
        }
        return series( ndarray<f64>::from_list( move v ) );
    }
    if( bools )
    {
        mask v = mask( n );
        for( u64 i : 0..n )
        {
            bool b = false;
            v.assign( i, !gaps.test( i ) && is_bool_token( fields[i], ref b ) && b );
        }
        return with_gaps( series( move v ), gaps );
    }
    list<string> v = list<string>::with_capacity( n );
    for( u64 i : 0..n )
    {
        v.push( gaps.test( i ) ? string() : string( fields[i] ) );
    }
    return with_gaps( series( move v ), gaps );
}

// `s` with each value `gaps` sets missing.
private series with_gaps( move series s, const ref mask gaps )
{
    for( u64 i : 0..gaps.size() )
    {
        if( gaps.test( i ) )
        {
            s.set_missing( i );
        }
    }
    return s;
}

/// The rows of each of `frames`, one frame after another and numbered afresh, as pandas'
/// `concat( frames, ignore_index=True )`. The columns are every frame's, in the order they first
/// appear, and a frame without one has gaps there in its dtype. `i64s` beside `f64s` becomes
/// `f64s`; any other mix of dtypes panics. Pass the frames with `move`, or a `copy()` of each.
dataframe concat( dataframe... frames )
{
    list<string> names = list<string>();
    for( u64 f : 0..frames.size )
    {
        const ref list<string> own = frames[f].columns();
        for( u64 c : 0..own.size() )
        {
            if( !kl::contains( names, own[c] ) )
            {
                names.push( string( own[c] ) );
            }
        }
    }
    dataframe r = dataframe();
    for( u64 c : 0..names.size() )
    {
        dtype kind = stacked_kind( frames, names[c] );
        list<series> parts = list<series>::with_capacity( frames.size );
        for( u64 f : 0..frames.size )
        {
            const ref dataframe d = frames[f];
            if( !d.has( names[c] ) )
            {
                parts.push( gaps_of( kind, d.rows() ) );
            }
            else if( kind == dtype::f64s && d[names[c]].kind() == dtype::i64s )
            {
                parts.push( with_gaps( series( d[names[c]].i64s().to<f64>() ), d[names[c]].isna() ) );
            }
            else
            {
                parts.push( d[names[c]].copy() );
            }
        }
        r.insert( names[c], stacked( parts, kind ) );
    }
    return r;
}

// The dtype `concat` gives column `name` of `frames`.
private dtype stacked_kind( const ref dataframe[] frames, const ref string name )
{
    bool found = false;
    dtype kind = dtype::f64s;
    for( u64 f : 0..frames.size )
    {
        if( !frames[f].has( name ) )
        {
            continue;
        }
        dtype k = frames[f][name].kind();
        if( !found || k == kind )
        {
            found = true;
            kind = k;
        }
        else if( is_number( k ) && is_number( kind ) )
        {
            kind = dtype::f64s;
        }
        else
        {
            panic( "the frames hold a column in dtypes that do not concatenate" );
        }
    }
    return kind;
}

// The values of `parts`, one after another, each holding `kind`.
private series stacked( const ref list<series> parts, dtype kind )
{
    u64 n = 0;
    for( u64 p : 0..parts.size() )
    {
        n += parts[p].size();
    }
    mask gaps = mask( n );
    u64 at = 0;
    for( u64 p : 0..parts.size() )
    {
        for( u64 i : 0..parts[p].size() )
        {
            gaps.assign( at, parts[p].is_missing( i ) );
            at++;
        }
    }
    switch( kind )
    {
        case dtype::f64s:
            list<f64> f = list<f64>::with_capacity( n );
            for( u64 p : 0..parts.size() )
            {
                const ref ndarray<f64> x = parts[p].f64s();
                for( u64 i : 0..x.size() )
                {
                    f.push( x[i] );
                }
            }
            return series( ndarray<f64>::from_list( move f ) );
        case dtype::i64s:
        case dtype::times:
        case dtype::durations:
            list<i64> v = list<i64>::with_capacity( n );
            for( u64 p : 0..parts.size() )
            {
                const ref ndarray<i64> x = integers( parts[p] );
                for( u64 i : 0..x.size() )
                {
                    v.push( x[i] );
                }
            }
            if( kind == dtype::i64s )
            {
                return with_gaps( series( ndarray<i64>::from_list( move v ) ), gaps );
            }
            return with_gaps( of_nanoseconds( v, kind ), gaps );
        case dtype::bools:
            mask b = mask( n );
            at = 0;
            for( u64 p : 0..parts.size() )
            {
                for( u64 i : 0..parts[p].size() )
                {
                    b.assign( at, parts[p].bools().test( i ) );
                    at++;
                }
            }
            return with_gaps( series( move b ), gaps );
        case dtype::strings:
            list<string> t = list<string>::with_capacity( n );
            for( u64 p : 0..parts.size() )
            {
                const ref list<string> x = parts[p].strings();
                for( u64 i : 0..x.size() )
                {
                    t.push( string( x[i] ) );
                }
            }
            return with_gaps( series( move t ), gaps );
    }
}

// `n` gaps of dtype `kind`.
private series gaps_of( dtype kind, u64 n )
{
    mask all = mask( n );
    for( u64 i : 0..n )
    {
        all.assign( i, true );
    }
    switch( kind )
    {
        case dtype::f64s:
            return series( ndarray<f64>::filled( nan(), n ) );
        case dtype::i64s:
            return with_gaps( series( ndarray<i64>::filled( 0, n ) ), all );
        case dtype::times:
        case dtype::durations:
            return with_gaps( of_nanoseconds( list<i64>::filled( n, 0 ), kind ), all );
        case dtype::bools:
            return with_gaps( series( mask( n ) ), all );
        case dtype::strings:
            list<string> t = list<string>::with_capacity( n );
            for( u64 i : 0..n )
            {
                t.push( string() );
            }
            return with_gaps( series( move t ), all );
    }
}

// The values of `s` at `rows`, a gap where a row is `u64::max`.
private series gathered( const ref series s, const ref list<u64> rows )
{
    if( s.size() == 0 )
    {
        return gaps_of( s.kind(), rows.size() );
    }
    mask gaps = mask( rows.size() );
    list<u64> at = list<u64>::with_capacity( rows.size() );
    for( u64 j : 0..rows.size() )
    {
        gaps.assign( j, rows[j] == u64::max );
        at.push( rows[j] == u64::max ? 0 : rows[j] );
    }
    return with_gaps( s.taken( at.as_run() ), gaps );
}
