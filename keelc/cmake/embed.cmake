# Writes a .cpp holding INPUT's bytes as keel::NAME and keel::NAME_size. Run with
# cmake -DINPUT=... -DOUTPUT=... -DNAME=... -P embed.cmake.
file(READ "${INPUT}" hex HEX)
file(SIZE "${INPUT}" size)
string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")

# Rewrites the file only when the bytes change, so an unchanged runtime recompiles nothing.
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT [[// Generated by keelc/cmake/embed.cmake, so edit that instead.
#include <cstddef>

namespace keel
{
extern const unsigned char @NAME@[];
extern const std::size_t   @NAME@_size;

const unsigned char @NAME@[] = { @bytes@ };
const std::size_t   @NAME@_size = @size@;
} // namespace keel
]] @ONLY)
