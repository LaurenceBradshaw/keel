// A map the body already computes as cheaply as any circuit keeps its body, silently.

@real_arithmetic
void butterfly( ref f64[2] x )
{
    const f64 a = x[0];
    x[0] = a + x[1];
    x[1] = a - x[1];
}

i32 main()
{
    f64[2] x = [ 1.0, 2.0 ];
    butterfly( ref x );
    return x[1] == -1.0 ? 0 : 1;
}
