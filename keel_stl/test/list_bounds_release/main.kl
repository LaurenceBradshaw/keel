// Without --debug, `kl::list` still checks its index: its guard is a `panic`, not an `assert`.
import kl::list;

i32 main()
{
    kl::list<i32> values = kl::list<i32>::with_capacity( 2 );
    values.push( 10 );
    values.push( 20 );

    if( values[1] != 20 )
    {
        return 1;
    }

    return values[2];
}
