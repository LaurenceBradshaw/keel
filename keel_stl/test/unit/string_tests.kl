// `kl::string`: `split`, `rfind`, `replace`, trimming and stripping, `kl::join`, and `from( f64 )`
// against Python. An empty separator or pattern panics, so `programs/string_split_empty_separator`
// and `string_replace_empty_pattern` cover it.
import kl::list;
import kl::math;
import kl::optional;
import kl::string;
import kl::test::context;

private void check_split( ref kl::test::context c, str text, str separator, const ref str[] expected )
{
    kl::string s = kl::string::from( text );
    kl::list<kl::string> pieces = s.split( separator );
    c.require( pieces.size() == expected.size );
    for( u64 i : 0..expected.size )
    {
        c.check_eq( pieces.as_run()[i], expected[i] );
    }
}

private void split_gives_the_pieces_between( ref kl::test::context c )
{
    str[3] plain = [ "a", "bc", "d" ];
    check_split( ref c, "a,bc,d", ",", plain );
    str[1] whole = [ "abc" ];
    check_split( ref c, "abc", ",", whole );
}

private void split_keeps_empty_pieces( ref kl::test::context c )
{
    str[3] middle = [ "a", "", "b" ];
    check_split( ref c, "a,,b", ",", middle );
    str[3] trailing = [ "a", "b", "" ];
    check_split( ref c, "a\nb\n", "\n", trailing );
    str[2] leading = [ "", "a" ];
    check_split( ref c, ",a", ",", leading );
    str[1] empty = [ "" ];
    check_split( ref c, "", ",", empty );
}

private void split_on_a_longer_separator( ref kl::test::context c )
{
    str[3] words = [ "a", "b", "c" ];
    check_split( ref c, "a::b::c", "::", words );
    str[2] overlap = [ "", "a" ];
    check_split( ref c, "aaa", "aa", overlap );
    str[1] longer = [ "ab" ];
    check_split( ref c, "ab", "abc", longer );
}

private void check_rfind( ref kl::test::context c, str text, str needle, u64 expected )
{
    kl::string s = kl::string::from( text );
    kl::optional<u64> found = s.rfind( needle );
    c.require( kl::is_some( found ) );
    c.check_eq( kl::unwrap( move found ), expected );
}

private void rfind_finds_the_last( ref kl::test::context c )
{
    check_rfind( ref c, "abc", "a", 0 );
    check_rfind( ref c, "abc", "c", 2 );
    check_rfind( ref c, "a.b.c", ".", 3 );
    check_rfind( ref c, "aaa", "aa", 1 );
    check_rfind( ref c, "abc", "", 3 );
    check_rfind( ref c, "", "", 0 );
    kl::string s = "ab";
    c.check( kl::is_none( s.rfind( "abc" ) ) );
    c.check( kl::is_none( s.rfind( "x" ) ) );
}

private void check_replace( ref kl::test::context c, str text, str pattern, str replacement, str expected )
{
    kl::string s = kl::string::from( text );
    c.check_eq( s.replace( pattern, replacement ), expected );
}

private void replace_every_occurrence( ref kl::test::context c )
{
    check_replace( ref c, "a.b.c", ".", "-", "a-b-c" );
    check_replace( ref c, "abc", "x", "-", "abc" );
    check_replace( ref c, "", "x", "-", "" );
    check_replace( ref c, "aaa", "aa", "b", "ba" );
    check_replace( ref c, "a.b", ".", "::", "a::b" );
    check_replace( ref c, "a::b::", "::", "", "ab" );
    check_replace( ref c, "abab", "ab", "abab", "abababab" );
}

private void check_trims( ref kl::test::context c, str text, str start, str end, str both )
{
    kl::string s = kl::string::from( text );
    c.check_eq( s.trim_start(), start );
    c.check_eq( s.trim_end(), end );
    c.check_eq( s.trim(), both );
}

private void trim_removes_ascii_whitespace( ref kl::test::context c )
{
    check_trims( ref c, "  a b  ", "a b  ", "  a b", "a b" );
    check_trims( ref c, "\t\n\x0B\x0C\r a \t\n\x0B\x0C\r", "a \t\n\x0B\x0C\r", "\t\n\x0B\x0C\r a", "a" );
    check_trims( ref c, "   ", "", "", "" );
    check_trims( ref c, "", "", "", "" );
    check_trims( ref c, "ab", "ab", "ab", "ab" );
}

private void strip_answers_the_rest( ref kl::test::context c )
{
    kl::string s = "--name=value";
    c.check_eq( kl::unwrap( s.strip_prefix( "--name=" ) ), "value" );
    c.check_eq( kl::unwrap( s.strip_suffix( "=value" ) ), "--name" );
    c.check_eq( kl::unwrap( s.strip_prefix( "--name=value" ) ), "" );
    c.check_eq( kl::unwrap( s.strip_suffix( "" ) ), "--name=value" );
    c.check( kl::is_none( s.strip_prefix( "-x" ) ) );
    c.check( kl::is_none( s.strip_suffix( "valu" ) ) );
    c.check( kl::is_none( s.strip_prefix( "--name=value!" ) ) );
}

private void join_puts_the_separator_between( ref kl::test::context c )
{
    str[3] three = [ "a", "b", "c" ];
    c.check_eq( kl::join( three, ", " ), "a, b, c" );
    c.check_eq( kl::join( three, "" ), "abc" );
    str[1] one = [ "a" ];
    c.check_eq( kl::join( one, ", " ), "a" );
    str[2] empties = [ "", "" ];
    c.check_eq( kl::join( empties, "-" ), "-" );

    kl::list<kl::string> none = kl::list<kl::string>();
    c.check_eq( kl::join( none.as_run(), ", " ), "" );
    kl::list<kl::string> owned = kl::list<kl::string>();
    owned.push( "x" );
    owned.push( "yz" );
    c.check_eq( kl::join( owned.as_run(), " " ), "x yz" );
}

private void string_orders_by_bytes( ref kl::test::context c )
{
    kl::string ab = kl::string::from( "ab" );
    kl::string b = kl::string::from( "b" );
    kl::string abc = kl::string::from( "abc" );
    kl::string x = kl::string::from( "x" );
    c.check( ab < b );
    c.check( ab < abc );
    c.check( !( b < ab ) );
    c.check( ( x <=> x ) == ordering::equal );
}

// Each against Python's `repr`: zeros, subnormals, the largest and
// smallest normals, both sides of 1e-4 and 1e16, 2^53, a NaN, and a sample of random bits.
private void from_f64_writes_the_shortest_digits( ref kl::test::context c )
{
    u64[60] bits = [
        0x0000000000000000, 0x8000000000000000, 0x0000000000000001, 0x8000000000000001,
        0x0010000000000000, 0x000fffffffffffff, 0x7fefffffffffffff, 0x7ff0000000000000,
        0xfff0000000000000, 0x4341c37937e08000, 0x430c6bf526340000, 0x4341c37937e07fff,
        0x3f1a36e2eb1c432d, 0x3ee4f8b588e368f1, 0x3f202c9dedbc309d, 0x3fb999999999999a,
        0x3fc999999999999a, 0x3fd3333333333333, 0x3fd5555555555555, 0x4340000000000000,
        0x4340000000000001, 0x43e0000000000000, 0x43f0000000000000, 0x4480f0cf064dd592,
        0x44b52d02c7e14af6, 0x437b69b4ba630f35, 0x00005c0ab9347ed7, 0x3ff8000000000000,
        0x4059000000000000, 0x444b1ae4d6e2ef50, 0x4011666666666666, 0x3efa36e2eb1c432d,
        0x3ff0000000000000, 0x4024000000000000, 0x7e37e43c8800759c, 0x01a56e1fc2f8f359,
        0x3fe0000000000000, 0x4376345785d8a000, 0x4345eddb25e04800, 0xdc1b77ae0bf34dad,
        0xd66c85180967af3a, 0xa66ad67f14c75d9f, 0x6f3eb3cb081b1eb1, 0xcb86be60fcd09b7f,
        0x1001d49d65d74891, 0x4fce85b52d7c0733, 0x340727a5fedcf3c9, 0xa864c7cd7d6bbd46,
        0x64374bbe7d946223, 0x27d623534d875393, 0xdb6412655b0102a3, 0xdc0a04ab45cd6913,
        0xd19e5c8cf2383415, 0x87b90093b22a1d72, 0x7f11b35c84d28156, 0xe5101323863fffc3,
        0x85ebc8514bcec667, 0x2899a036b97aee0a, 0xd3fa5674fab5bb96, 0x7ff8000000000000
    ];
    str[60] text = [
        "0.0", "-0.0", "5e-324",
        "-5e-324", "2.2250738585072014e-308", "2.225073858507201e-308",
        "1.7976931348623157e+308", "inf", "-inf",
        "1e+16", "1000000000000000.0", "9999999999999998.0",
        "0.0001", "1e-05", "0.0001234",
        "0.1", "0.2", "0.3",
        "0.3333333333333333", "9007199254740992.0", "9007199254740994.0",
        "9.223372036854776e+18", "1.8446744073709552e+19", "1e+22",
        "1e+23", "1.2345678901234568e+17", "5e-310",
        "1.5", "100.0", "1e+21",
        "4.35", "2.5e-05", "1.0",
        "10.0", "1e+300", "1e-300",
        "0.5", "1e+17", "1.2345e+16",
        "-4.9911105725155504e+135", "-2.0931310924971078e+108", "-1.268702929091445e-123",
        "7.273239480106977e+227", "-6.970913778577059e+55", "1.435613438943334e-231",
        "2.7611253118923143e+76", "4.6109808350495785e-58", "-4.219171820611504e-114",
        "5.761778216598602e+174", "8.7788954118438e-117", "-1.7808843304237417e+132",
        "-2.3638829021087335e+135", "-1.4745597858875224e+85", "-1.8486856783277906e-271",
        "1.2138481860502355e+304", "-6.513913109885398e+178", "-3.8263546419332154e-280",
        "4.1623602456969977e-113", "-3.5160646085414046e+96", "nan"
    ];
    for( u64 i : 0..60 )
    {
        c.check_eq( kl::string::from( kl::from_bits( bits[i] ) ), text[i] );
    }
}

// Whether `text` parses to the `f64` with `bits`.
private void check_parse_f64( ref kl::test::context c, const ref textual text, u64 bits )
{
    switch( kl::string( text ).parse_f64() )
    {
    case result::ok( x ):
        c.check_eq( kl::bits_of( x ), bits );
        break;
    case result::err( e ):
        c.check( false );
        break;
    }
}

// The index `parse_f64` refuses `text` at, -1 for `no_digits`, or -2 if it parses.
private i64 f64_refusal( str text )
{
    switch( kl::string( text ).parse_f64() )
    {
    case result::ok( x ):
        return -2;
    case result::err( e ):
        switch( e )
        {
        case kl::parse_error::invalid_digit( at ):
            return cast<i64>( at );
        case kl::parse_error::no_digits:
            return -1;
        case kl::parse_error::overflow:
            return -3;
        }
    }
}

private void parse_f64_rounds_to_nearest( ref kl::test::context c )
{
    u64[21] bits = [
        0x0000000000000000, 0x8000000000000000, 0x3ff8000000000000, 0x3fe0000000000000,
        0x4014000000000000, 0x7fe1ccf385ebc8a0, 0x7fefffffffffffff, 0x7ff0000000000000,
        0xfff0000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000,
        0x000fffffffffffff, 0x4340000000000000, 0x4340000000000001, 0x3fb999999999999a,
        0x400921fb54442d18, 0x45f8ee90ff6c373e, 0x3ee4f8b588e368f1, 0x7ff0000000000000,
        0xfff0000000000000
    ];
    str[21] text = [
        "0", "-0", "1.5", ".5",
        "5.", "1e308", "1.7976931348623158e308", "1e309",
        "-1e400", "5e-324", "2.4703282292062328e-324", "2.4703282292062327e-324",
        "2.2250738585072011e-308", "9007199254740993", "9007199254740993.0000000000000000000001", "0.1",
        "3.141592653589793", "123456789012345678901234567890", "1E-5", "inf",
        "-Infinity"
    ];
    for( u64 i : 0..21 )
    {
        check_parse_f64( ref c, text[i], bits[i] );
    }
}

// Past 769 digits only whether any is not zero matters, both before the point and after it.
private void parse_f64_reads_every_digit( ref kl::test::context c )
{
    kl::string ones = kl::string( "1" );
    kl::string tenth = kl::string( "0." );
    for( u64 i : 0..400 )
    {
        ones.push( '0' );
        tenth.push( '0' );
    }
    ones += "e-400";
    tenth += "1e401";
    check_parse_f64( ref c, ones, 0x3ff0000000000000 );
    check_parse_f64( ref c, tenth, 0x3ff0000000000000 );
}

private void parse_f64_reads_back_from_f64( ref kl::test::context c )
{
    u64[6] bits = [
        0x3fd5555555555555, 0x00005c0ab9347ed7, 0x7fefffffffffffff, 0xdc1b77ae0bf34dad,
        0x0000000000000001, 0x4341c37937e07fff
    ];
    for( u64 i : 0..6 )
    {
        check_parse_f64( ref c, kl::string::from( kl::from_bits( bits[i] ) ), bits[i] );
    }
}

private void parse_f64_refuses_at_the_first_bad_byte( ref kl::test::context c )
{
    c.check_eq( f64_refusal( "" ), -1 );
    c.check_eq( f64_refusal( "-." ), -1 );
    c.check_eq( f64_refusal( "1e+" ), -1 );
    c.check_eq( f64_refusal( "+1" ), 0 );
    c.check_eq( f64_refusal( "1 " ), 1 );
    c.check_eq( f64_refusal( "1.2.3" ), 3 );
    c.check_eq( f64_refusal( "1ex" ), 2 );
    c.check_eq( f64_refusal( "-infinit" ), 1 );
    c.check_eq( f64_refusal( "NaN" ), -2 );
}

private bool u64_parses( str text )
{
    switch( kl::string( text ).parse_u64() )
    {
    case result::ok( x ):
        return true;
    case result::err( e ):
        return false;
    }
}

private void parse_u64_reads_the_whole_range( ref kl::test::context c )
{
    switch( kl::string( "18446744073709551615" ).parse_u64() )
    {
    case result::ok( x ):
        c.check_eq( x, u64::max );
        break;
    case result::err( e ):
        c.check( false );
        break;
    }
    c.check( !u64_parses( "18446744073709551616" ) );
    c.check( !u64_parses( "-1" ) );
    c.check( !u64_parses( "" ) );
}

private void fixed_rounds_the_exact_value( ref kl::test::context c )
{
    c.check_eq( kl::string::fixed( 3.14159265, 6 ), "3.141593" );
    c.check_eq( kl::string::fixed( 2.675, 2 ), "2.67" );
    c.check_eq( kl::string::fixed( 0.125, 2 ), "0.12" );
    c.check_eq( kl::string::fixed( 0.375, 2 ), "0.38" );
    c.check_eq( kl::string::fixed( 2.5, 0 ), "2" );
    c.check_eq( kl::string::fixed( 9.9999999, 6 ), "10.000000" );
    c.check_eq( kl::string::fixed( 0.0004, 3 ), "0.000" );
    c.check_eq( kl::string::fixed( -0.001, 2 ), "-0.00" );
    c.check_eq( kl::string::fixed( 1152921504606846976.0, 1 ), "1152921504606846976.0" );
    c.check_eq( kl::string::fixed( 5e-324, 2 ), "0.00" );
}

private void scientific_rounds_the_exact_value( ref kl::test::context c )
{
    c.check_eq( kl::string::scientific( 31415.9, 6 ), "3.141590e+04" );
    c.check_eq( kl::string::scientific( 0.0, 2 ), "0.00e+00" );
    c.check_eq( kl::string::scientific( 9.5, 0 ), "1e+01" );
    c.check_eq( kl::string::scientific( 1.7976931348623157e308, 3 ), "1.798e+308" );
    c.check_eq( kl::string::scientific( 5e-324, 20 ), "4.94065645841246544177e-324" );
}

private void fixed_and_scientific_write_specials_as_from( ref kl::test::context c )
{
    c.check_eq( kl::string::fixed( kl::from_bits( 0x7ff8000000000000 ), 2 ), "nan" );
    c.check_eq( kl::string::fixed( kl::from_bits( 0x7ff0000000000000 ), 2 ), "inf" );
    c.check_eq( kl::string::scientific( kl::from_bits( 0xfff0000000000000 ), 2 ), "-inf" );
    c.check_eq( kl::string::fixed( -0.0, 1 ), "-0.0" );
}

private void a_string_copies_a_run_of_bytes( ref kl::test::context c )
{
    u8[3] bytes = [ 'a', 0, 'b' ];
    kl::string s = kl::string( bytes[0..3] );
    c.require( s.size() == 3 );
    c.check( s[1] == 0 );
    bytes[0] = 'z';
    c.check( s[0] == 'a' );
    c.check( kl::string( bytes[1..1] ).is_empty() );
}
